<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="GP_007" header="false" pageCloseWarn="false">
    <form id="formObj" div="f146312e7313407e8a41053f68e9f1" form-id="file:///resource/ux/grid_personalization/form/PREVIEW_LABEL_FORM.js"/>
    <variable>
        <var name="previewGridArea" value="$($sObject._vp).find('#b301e303d4634672860fca8356e44c')[0]"/>
        <var name="a34248c966ec4bbc8e75baf4900315" value="$($sObject._vp).find('#a34248c966ec4bbc8e75baf4900315')[0]"/>
        <var name="b020b753f68140d58246be8bdaf9b7" value="$($sObject._vp).find('#b020b753f68140d58246be8bdaf9b7')[0]"/>
        <var name="a6a8747ef92b442c8baf156b775020" value="$($sObject._vp).find('#a6a8747ef92b442c8baf156b775020')[0]"/>
    </variable>
    <onloadscript/>
    <userscript>
        <var name="$share" value="{}"/>
        <var name="events" value="{}"/>
        <var name="gridObj"/>
        <function name="setGridInfo" args="obj">
        <![CDATA[
            $share.gridObj = obj;
        ]]>
        </function>
        <function name="doRenderPreviewGrid" args="headerData">
        <![CDATA[
            if (gridObj && gridObj.destructor) {
                gridObj.destructor();
            }
            
            gridObj = $sObject.gridObj = new SepoaDhtmlXGridObject(previewGridArea, 'gridObj', {});
            gridObj._onDnDFlag = false;
            gridObj.setGridDraw();
            gridObj.setSizes();
            gridObj.setEditable(false);
            gridObj.setDataOutput(dataOutput);
            gridObj.setReadOnly(true);
            gridObj.enableColumnMove(false);
            
            gridObj.attachEvent("onBeforeContextMenu", ()=>{
                return false;
            });
            
            gridObj.attachEvent("onHeaderClick", () => {
                return false;
            });
            
            events.onLoad = Sepoa.attachEvent('onLoad', function() {
                gridObj.setSizes();
            });
            events.resize = SUX.attachEvent('onWindowResize', function() {
                gridObj.setSizes();
            });
            
            var freezeColId;
            var columnCnt = 0;
            for(var data of headerData) {
                var colName = data.COLUMN_NAME;
                var type = data.TYPE;
                var width = data.STANDARD_WIDTH;
                var freeze = data.FREEZE;
                
                if(['tree', 'grid', 'template', 'comboro', 'comboro2'].indexOf(type) + 1) {
                    type = 'edtxt';
                }
                
                if(data.CUSTOM_WIDTH !== undefined && data.CUSTOM_WIDTH != '') {
                    width = data.CUSTOM_WIDTH
                }
                
                if(freeze == true || freeze == 'true') {
                    freezeColId = data.COLUMN_ID;
                }
                
                gridObj.insertColumn(columnCnt, data.COLUMN_NAME, type, width, null, data.ALIGN, 'center', null, 'white');
                gridObj.setColumnId(columnCnt, data.COLUMN_ID);
                
                columnCnt++;
            }
            
            var rowIds = gridObj.getAllRowIds();
            if(!rowIds) {
                gridObj.addRow(1, '', 0);
            }
            
            if(freezeColId) {
                setGridFreeze(freezeColId, true);
            }
            
            gridObj.setSizes();
        ]]>
        </function>
        <function name="setGridFreeze" args="colId, flag">
        <![CDATA[
            var colIndex = gridObj.getColIndexById(colId); 
            
            $share.freezeColId = colId;
            
            if(flag) {
                gridObj.splitAt(colIndex + 1);
            } else {
                gridObj.unSplitAt();
            }
        ]]>
        </function>
        <function name="setGridWidth" args="colId, width">
        <![CDATA[
            if(width) {
                gridObj.deleteRow(1);
                var colIndex = gridObj.getColIndexById(colId);
                
                if(colIndex !== undefined) {
                    gridObj.setColWidth(colIndex, width);
                }
                
                gridObj.addRow(1, '', 0);
                
                gridObj.setSizes();
            }
        ]]>
        </function>
        <function name="doClearGrid">
        <![CDATA[
            if(gridObj) {
                gridObj.clearAll(true);
            }
        ]]>
        </function>
    </userscript>
