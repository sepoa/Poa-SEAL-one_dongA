<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="GP_006" header="false" pageCloseWarn="false">
    <grid id="widthGridObj" div="bbd6aa492a9b462f8699a0e70816ea" grid-id="file:///resource/ux/grid_personalization/grid/WIDTH_GRID.js" drag="false" merge="false" dynamic="false" exceldownload="true">
        <event type="onEditCell" callback="onEditCell"/>
    </grid>
    <variable>
        <var name="$share" value="{}" />
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <function name="setGridInfo" args="obj">
        <![CDATA[
            $share.gridObj = obj;
        ]]>
        </function>
        <function name="init">
        <![CDATA[
            widthGridObj.attachEvent("onBeforeContextMenu", ()=>{
                return false;
            });
            
            widthGridObj.attachEvent("onHeaderClick", () => {
                return false;
            });
            
            widthGridObj.disableHeaderFilter();
            
            callFunction('GP_003', 'setObj', ['WIDTH', widthGridObj]);
        ]]>
        </function>
        <function name="onEditCell" args="stage, rId, cInd, value">
        <![CDATA[
            if(stage == 2) {
                var originalWidth = widthGridObj.cells(rId, widthGridObj.getColIndexById("STANDARD_WIDTH")).getValue();
                var columnId = widthGridObj.cells(rId, widthGridObj.getColIndexById("COLUMN_ID")).getValue();
                
                if(value == originalWidth) {
                    Alert(Sepoa.cache.text.get('GP_006.MESSAGE_SET_WIDTH'));
                    
                    return;
                }
                
                callFunction('GP_007', 'setGridWidth', [columnId, value]);
                
                return true;
            }
        ]]>
        </function>
        <function name="setColumnWidth">
        <![CDATA[
            var allData = widthGridObj.getAllDataObject();
            
            for(var data of allData) {
                var colId = data.COLUMN_ID;
                var customWidth = data.CUSTOM_WIDTH;
                
                if(customWidth != '') {
                    callFunction('GP_007', 'setGridWidth', [colId, customWidth]);
                }
            }
        ]]>
        </function>
        <function name="doMoveColumn" args="data">
        <![CDATA[
            var originalGridData = widthGridObj.getAllDataObject();
            
            widthGridObj.clearAll(false);
            
            for(var row of data) {
                var colId = row.COLUMN_ID;
                var colName = row.COLUMN_NAME;
                var hideFlag = false;
                
                if(colName == '#cspan') {
                    hideFlag = true;
                }
                
                var originalData = originalGridData.filter(x => x.COLUMN_ID == colId);
                callFunction('GP_003', 'addData', [widthGridObj, row.gr_id, widthGridObj.getRowsNum(), row, false, hideFlag]);
                if(originalData.length > 0 && originalData[0].CUSTOM_WIDTH != '') {
                    widthGridObj.cells(row.gr_id, widthGridObj.getColIndexById('CUSTOM_WIDTH')).setValue(originalData[0].CUSTOM_WIDTH);
                }
            }
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
    </template>
</body>