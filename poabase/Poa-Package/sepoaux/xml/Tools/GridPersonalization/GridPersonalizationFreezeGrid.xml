<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="GP_005" header="false" pageCloseWarn="false">
    <grid id="freezeGridObj" div="b45bfeaa83ef472983e86a5c0d607c" grid-id="file:///resource/ux/grid_personalization/grid/FREEZE_GRID.js" drag="false" merge="false" dynamic="false" exceldownload="true">
        <event type="onEditCell" callback="onEditCell"/>
    </grid>
    <variable>
        <var name="$share" value="{}" />
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <function name="setGridInfo" args="obj">
        <![CDATA[
            $share.gridObj = obj;
        ]]>
        </function>
        <function name="init">
        <![CDATA[
            freezeGridObj.attachEvent("onBeforeContextMenu", ()=>{
                return false;
            });

            freezeGridObj.attachEvent("onHeaderClick", () => {
                return false;
            });
            
            freezeGridObj.disableHeaderFilter();
            
            callFunction('GP_003', 'setObj', ['FREEZE', freezeGridObj]);
        ]]>
        </function>
        <function name="onEditCell" args="stage, rId, cInd">
        <![CDATA[
            var header = freezeGridObj.getColumnId(cInd);
            if(header == 'SELECTED') {
                if(stage == 1) {
                    var selectedIds = freezeGridObj.getGridChangedRows('SELECTED');
                
                    if(selectedIds && selectedIds.length > 1) {
                        var releaseIds = selectedIds.filter(x => x != rId);
                        
                        if(releaseIds.length > 0) {
                            releaseIds.forEach((rowId) => {
                                freezeGridObj.cells(rowId, freezeGridObj.getColIndexById("SELECTED")).setValue(0);
                            });
                            
                            callFunction('GP_007', 'setGridFreeze', [columnId, false]);
                        }
                    }
                    
                    var selected = freezeGridObj.cells(rId, freezeGridObj.getColIndexById("SELECTED")).getValue();
                    var columnId = freezeGridObj.cells(rId, freezeGridObj.getColIndexById("COLUMN_ID")).getValue();
                    var cspan = freezeGridObj.cells(rId, freezeGridObj.getColIndexById("CSPAN")).getValue();
                    
                    if(cspan != undefined && cspan != '') {
                        var cspanIds = cspan.split(',');
                        
                        if(cspanIds.length > 0) {
                            columnId = cspanIds[cspanIds.length - 1];
                        }
                    }
                    
                    var flag = false;
                    
                    if(selected == 1) {
                        flag = true;
                    }
                    
                    callFunction('GP_007', 'setGridFreeze', [columnId, flag]);
                    callFunction('GP_006', 'setColumnWidth', []);
                }
                
                return true;
            }
        ]]>
        </function>
        <function name="doMoveColumn" args="data">
        <![CDATA[
            var selectedRow = freezeGridObj.getSelectedRows('SELECTED');
            
            freezeGridObj.clearAll(false);
            
            for(var row of data) {
                var colName = row.COLUMN_NAME;
                var hideFlag = false;
                
                if(colName == '#cspan') {
                    hideFlag = true;
                }
                
                callFunction('GP_003', 'addData', [freezeGridObj, row.gr_id, freezeGridObj.getRowsNum(), row, false, hideFlag]);
            }
            
            if(selectedRow.length > 0) {
                freezeGridObj.cells(selectedRow[0], freezeGridObj.getColIndexById('SELECTED')).setValue(1);
            }
        ]]>
        </function>
        <function name="setFreezeValue" args="rowId">
        <![CDATA[
            if(rowId !== undefined) {
                freezeGridObj.cells(rowId, freezeGridObj.getColIndexById('SELECTED')).setValue(1);
            }
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
    </template>
</body>