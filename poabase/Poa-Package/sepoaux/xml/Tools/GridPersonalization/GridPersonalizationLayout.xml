<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="GP_001" header="false" pageCloseWarn="false">
    <link>
    <![CDATA[
        <script type="text/javascript">
            Sepoa.cache.text.load([{
                url: CONTEXT_NAME + '/resource/ux/grid_personalization/langs/' + Sepoa.info.LANGUAGE + '/grid_personalization.js',
                def: CONTEXT_NAME + '/resource/ux/grid_personalization/langs/KO/grid_personalization.js'
            }, {
                url: CONTEXT_NAME + '/resource/ux/admin/langs/' + Sepoa.info.LANGUAGE + '/POA_BASE.js',
                def: CONTEXT_NAME + '/resource/ux/admin/langs/KO/POA_BASE.js'
            }]);
        </script>
        
        <link href="<%=CONTEXT_NAME%>/resource/plugin/sepoasoft/personalization/css/personalization.css" rel="stylesheet" type="text/css" />
    ]]>
    </link>
    <layout id="layoutObj" div="MjewVNhsuQhrGbFhuG" pattern="3L">
        <cell>
            <id>a</id>
            <fix_size>true,true</fix_size>
            <header view="true" type="list"/>
            <collapse icon="false" collapsed="false"/>
            <icon>menu</icon>
            <width>400</width>
            <attach file="/Tools/GridPersonalization/GridPersonalizationList.xml"/>
        </cell>
        <cell>
            <id>b</id>
            <fix_size>true,true</fix_size>
            <header view="true" type="contents"/>
            <collapse icon="false" collapsed="false"/>
            <height>500</height>
            <attach file="/Tools/GridPersonalization/GridPersonalizationWrite.xml"/>
        </cell>
        <cell>
            <id>c</id>
            <fix_size>true,true</fix_size>
            <header view="false" type="contents"/>
            <collapse icon="false" collapsed="false"/>
            <height>200</height>
            <attach file="/Tools/GridPersonalization/GridPersonalizationGridPreview.xml"/>
        </cell>
    </layout>
    <variable>
        <var name="$share" value="{}" />
        <var name="callbackFn"/>
    </variable>
    <onloadscript>
        <call name="init"/>
        <call name="setGridInfo"/>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <function name="init">
        <![CDATA[
            if (Sepoa.params.callback) {
                callbackFn = Sepoa.params.callback;
            }
        ]]>
        </function>
        <function name="setGridInfo">
        <![CDATA[
            for (var i = 2; i <= 7; i++) {
                callFunction('GP_00' + i, 'setGridInfo', [Sepoa.params.gridObj]);
            }
        ]]>
        </function>
        <function name="doQuery">
        <![CDATA[
            $share.gridObj = Sepoa.params.gridObj;
            callFunction('GP_002', 'doQueryList', []);
        ]]>
        </function>
        <function name="doEnd" args="flag, oGridObj">
        <![CDATA[
            callbackFn.apply(this, [flag, oGridObj]);
            selfObj.close();
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
    </template>
</body>