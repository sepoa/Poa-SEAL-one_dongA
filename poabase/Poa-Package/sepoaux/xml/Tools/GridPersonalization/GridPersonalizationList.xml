    <button id="btnObj">
        <btn div="fe4a847c58084e408aafc006a13463" id="NEW_PRESET" type="icon" img="xi-plus" position="left" toggle="false" reverse="false" onclick="doNew()"/>
    </button>
    <list id="listObj" div="MjewVNhgWghrGbiSTO">
        <type>
            <template><![CDATA[<table width=100% class=sepoa_list_design><col width=55% /><col width=45%><tr><td class=sepoa_list_secondary>#name#</td><td class=\"sepoa_list_font_bold sepoa_list_align_right\">#use_flag_text#</td></tr><tr><td colspan=2 class=\"sepoa_list_primary sepoa_list_align_right\"></td></tr></table>]]></template>
        </type>
        <event type="onItemClick" callback="onItemClick"/>
        <event type="onXLE" callback="onXLE"/>
    </list>
    <variable>
        <var name="eb02b6fe53494098894f19843986bf" value="$($sObject._vp).find('#eb02b6fe53494098894f19843986bf')[0]"/>
        <var name="f0f4898d5ccd492987add74aa1d389" value="$($sObject._vp).find('#f0f4898d5ccd492987add74aa1d389')[0]"/>
        <var name="e3fe1163491b43b5849f2d0f6b2f7b" value="$($sObject._vp).find('#e3fe1163491b43b5849f2d0f6b2f7b')[0]"/>
        <var name="$share" value="{}" />
    </variable>
    <onloadscript/>
    <userscript>
        <function name="setGridInfo" args="obj">
        <![CDATA[
            $share.gridObj = obj;
        ]]>
        </function>
        <function name="doQueryList" args="">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            dataOutput.setValue('CLASS', 'GRID-' + $share.gridObj.SCREEN_ID)
            listObj.load(window.CONTEXT_NAME + '/SepoaList.sux?PROCESS_ID=sepoa.svc.tools.Personalization&mode=doList&METHOD=doQueryList' + dataOutput.getParams());
        ]]>
        </function>
        
        <function name="onItemClick" args="id, ev, html">
        <![CDATA[
            callFunction('GP_003', 'doRenderGridData', [listObj.get(id)]);
        ]]>
        </function>
        
        <function name="onXLE" args="">
        <![CDATA[
            if (listObj.dataCount() > 0) {
                var id = listObj.idByIndex(0);
                listObj.select(id);
                onItemClick(id);
            }
        ]]>
        </function>
        
        <function name="doNew">
        <![CDATA[
            listObj.unselectAll();
            callFunction('GP_003', 'doRenderGridData', []);
        ]]>
        </function>
    </userscript>
