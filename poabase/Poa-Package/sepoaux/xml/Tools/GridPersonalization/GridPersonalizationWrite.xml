<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="GP_003" header="false" pageCloseWarn="false">
    <form id="PRESET_INFO_FORM" div="a671fef75e034c5683704f9008f974" form-id="file:///resource/ux/grid_personalization/form/PRESET_INFO_FORM.js"/>
    <button id="btnObj">
        <btn div="MjewVNhERthrGbWhdO" id="btn_save" type="default" text="{GP_003.BTN_SAVE}" onclick="onButtonClick( 'SAVE' )"/>
        <btn div="MjewVNhERthrGbWhdO" id="btn_delete" type="default" text="{GP_003.BTN_DELETE}" onclick="onButtonClick( 'DELETE' )"/>
    </button>
    <tabbar id="tabbarObj" div="bab416d3e10b488a8d3738bd1b35f3">
        <item id="ViewOrder" name="GP_003.TABBAR_VIEWORDER_NAME" selected="true">
            <attach file="/Tools/GridPersonalization/GridPersonalizationViewOrderGrid.xml"/>
        </item>
        <item id="Freeze" name="GP_003.TABBAR_FREEZE_NAME" selected="false">
            <attach file="/Tools/GridPersonalization/GridPersonalizationFreezeGrid.xml"/>
        </item>
        <item id="Width" name="GP_003.TABBAR_WIDTH_NAME" selected="false">
            <attach file="/Tools/GridPersonalization/GridPersonalizationWidthGrid.xml"/>
        </item>
    </tabbar>
    <variable>
        <var name="f9ac7e01fcc14c9487d23f78dab108" value="$($sObject._vp).find('#f9ac7e01fcc14c9487d23f78dab108')[0]"/>
        <var name="fc40affdeabf43b587e5e46f71a17c" value="$($sObject._vp).find('#fc40affdeabf43b587e5e46f71a17c')[0]"/>
        <var name="bb146a1fc92c4e638349b90f20071e" value="$($sObject._vp).find('#bb146a1fc92c4e638349b90f20071e')[0]"/>
        <var name="$share" value="{}" />
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <function name="init">
        <![CDATA[
            $share.headerData = [];
        ]]>
        </function>
        <function name="setGridInfo" args="obj">
        <![CDATA[
            $share.gridObj = obj;
        ]]>
        </function>
        <function name="setObj" args="id, obj">
        <![CDATA[
            $share[id] = obj;
        ]]>
        </function>
        <function name="setHeaderData" args="header">
        <![CDATA[
            if(header instanceof Array) {
                $share.headerData = header;
            } else if(header instanceof Object) {
                $share.headerData.push(header);
            }   

            callFunction('GP_007', 'doRenderPreviewGrid', [$share.headerData]);
        ]]>
        </function>
        <function name="removeHeaderData" args="headers">
        <![CDATA[
            for(var header of headers) {
                $share.headerData = $share.headerData.filter(x => x.COLUMN_ID != header.COLUMN_ID)
            }
            
            callFunction('GP_007', 'doRenderPreviewGrid', [$share.headerData]);
        ]]>
        </function>
        <function name="initBtn" args="mode">
        <![CDATA[
            var showBtn = [];
            var hideBtn = [];
            
            if(mode == 'NEW') {
                showBtn = ['btn_save'];
                hideBtn = ['btn_delete'];
            } else if(mode == 'USE') {
                showBtn = ['btn_save', 'btn_delete'];
            } else if(mode == 'NOT_USE') {
                showBtn = ['btn_save', 'btn_delete'];
            }
            
            for(var btn of showBtn) {
                btnObj.btn(btn).setShow();
            }
            
            for(var btn of hideBtn) {
                btnObj.btn(btn).setHide();
            }
        ]]>
        </function>
        <function name="doRenderGridData" args="data">
        <![CDATA[
            doClearAllComponent();
            
            $share.info = data;
            
            var param = undefined;
            var newFlag = true;
            
            if (data) {
                if(data.use_flag == 'Y') {
                    initBtn('USE');
                } else {
                    initBtn('NOT_USE');
                }
                
                var jsonData = JSON.parse(data.data);
                PRESET_INFO_FORM.setData(data, "json");
                param = jsonData.state;
                newFlag = false;
            } else {
                $share.newFlag = true;
                initBtn('NEW');
                PRESET_INFO_FORM.setValue('CLASS', 'GRID-' + $share.gridObj.SCREEN_ID);
            }
            
            callFunction('GP_004', 'doRenderGrid', [newFlag, param]);
        ]]>
        </function>
        <function name="addData" args="gridObj, rowId, itemIndex, data, allFlag, hideFlag">
        <![CDATA[
            var gridObjArray;
            if(allFlag) {
                gridObjArray = [$share.CUSTOM, $share.FREEZE, $share.WIDTH];
            } else {
                gridObjArray = [gridObj];
            }
            
            for(var obj of gridObjArray) {
                obj.addRow(rowId, '', itemIndex);
                if(hideFlag == true) {
                    obj.setRowHidden(rowId, true);
                } else {
                    obj.showRow(rowId);
                }
                for(var [key, value] of Object.entries(data)) {
                    if(obj.getColIndexById(key) != undefined) {
                        obj.cells(rowId, obj.getColIndexById(key)).setValue(value);                
                    }
                }
            }
        ]]>
        </function>
        <function name="deleteData" args="rowId">
        <![CDATA[
            $share.CUSTOM.deleteRow(rowId);
            $share.FREEZE.deleteRow(rowId);
            $share.WIDTH.deleteRow(rowId);
        ]]>
        </function>
        <function name="doClearAllComponent">
        <![CDATA[
            PRESET_INFO_FORM.clear();
            $share.VIEW_ORDER.clearAll(false);
            $share.CUSTOM.clearAll(false);
            $share.FREEZE.clearAll(false);
            $share.WIDTH.clearAll(false);
            setHeaderData([]);
        ]]>
        </function>
        <function name="onButtonClick" args="name">
        <![CDATA[
            if (name == 'SAVE') {
                doSave();
            } else if (name == 'DELETE') {
                doDelete();
            }
        ]]>
        </function>
        <function name="doPrepareSave">
        <![CDATA[
            var name = PRESET_INFO_FORM.getValue('NAME');
            var description = PRESET_INFO_FORM.getValue('DESCRIPTION');
            var useFlag = PRESET_INFO_FORM.getValue('USE_FLAG') == 1 ? true : false;
            
            dataOutput.setValue('USE_FLAG', useFlag);
            
            if(name == '') {
                Alert(Sepoa.cache.text.get('GP_003.MESSAGE_ADD_PRESET_NAME'));
                
                return;
            }
            
            var viewOrderObj = $share.VIEW_ORDER;
            var customObj = $share.CUSTOM;
            var freezeObj = $share.FREEZE;
            var widthObj = $share.WIDTH;
            
            viewOrderObj.editStop();
            customObj.editStop();
            freezeObj.editStop();
            widthObj.editStop();
            
            $share.data = {info : {}, state : {}};
            
            $share.data.info.grid_id = $share.gridObj.SCREEN_ID;
            
            var customRowId = customObj.getAllRowIds();
            var freezeRowId = freezeObj.getGridChangedRows('SELECTED');
            var cwRowId = widthObj.getGridChangedRows('CUSTOM_WIDTH');
            
            if(freezeRowId.length > 0) {
                var freezeCspan = freezeObj.cells(freezeRowId[0], freezeObj.getColIndexById('CSPAN')).getValue();
                
                if(freezeCspan != undefined && freezeCspan != '') {
                    var ids = freezeCspan.split(',');
                    $share.data.state.freeze = ids[ids.length - 1];
                } else {
                    $share.data.state.freeze = freezeObj.cells(freezeRowId[0], freezeObj.getColIndexById('COLUMN_ID')).getValue();
                }
            }
            
            if(customRowId.length == 0) {
                Alert(Sepoa.cache.text.get('GP_003.MESSAGE_SELECT_CUSTOM_COLUMN'));
                
                return false;
            }
            
            if(customRowId != '' && $share.ORIGINAL !== undefined) {
                $share.data.state.headers = [];
                var allCustomData = customObj.getAllDataObject();
                var cusRowIdArray = customRowId.split(',');
                
                for(var i = 0; i < cusRowIdArray.length; i++) {
                    var rowId = cusRowIdArray[i];
                    var width = widthObj.cells(rowId, widthObj.getColIndexById('CUSTOM_WIDTH')).getValue();
                    var label = customObj.cells(rowId, customObj.getColIndexById('COLUMN_NAME')).getValue();
                    var cspan = customObj.cells(rowId, customObj.getColIndexById('CSPAN')).getValue();
                    
                    if(label == '#cspan') {
                        continue;
                    }
                    
                    var obj = {
                        id : customObj.cells(rowId, customObj.getColIndexById('COLUMN_ID')).getValue(),
                        label : customObj.cells(rowId, customObj.getColIndexById('COLUMN_NAME')).getValue(),
                        hidden : false,
                        width : width
                    };
                    
                    $share.data.state.headers.push(obj);
                    
                    if(cspan != undefined && cspan != '') {
                        var cspanIds = cspan.split(',');
                    
                        if(cspanIds.length == 0) {
                            continue;
                        }
                        
                        for(var id of cspanIds) {
                            var cspanData = customObj.getAllDataObject().filter(x => x.COLUMN_ID == id);
                            
                            if(cspanData.length == 0) {
                                continue;
                            }
                            
                            var obj = {
                                id : cspanData[0].COLUMN_ID,
                                label : cspanData[0].COLUMN_NAME,
                                hidden : false,
                                width : cspanData[0].STANDARD_WIDTH
                            };
                            
                            $share.data.state.headers.push(obj);
                        }
                    }
                }
                
                var customGridData = customObj.getAllDataObject();
                
                for(var i = 0; i < $share.ORIGINAL.length; i++) {
                    var row = $share.ORIGINAL[i];
                    
                    if($share.data.state.headers.find(x => x.id == row.COLUMN_ID)) {
                        continue;
                    }
                    
                    var obj = {
                        id : row.COLUMN_ID,
                        label : row.COLUMN_NAME,
                        hidden : true,
                        width : ''
                    };
                    
                    $share.data.state.headers.push(obj);
                }
            }
            
            return true;
        ]]>
        </function>
        <function name="doSave" args="">
        <![CDATA[
            if(!doPrepareSave()) {
                return;
            }
            
            var message = Sepoa.cache.text.get('GP_003.MESSAGE_SAVE_PRESET');
            
            Confirm(Sepoa.cache.text.get('GP_003.MESSAGE_SAVE_PRESET'), function(flag) {
			    if (flag) {
                    dataOutput.setValue('DATA', JSON.stringify($share.data));
			        doServiceAjax('sepoa.svc.tools.Personalization', 'TRANSACTION', 'doSavePreset', null, function(so) {
			            if (so.status == '1') {
                            Confirm(Sepoa.cache.text.get('GP_003.MESSAGE_POPUP_CLOSE'), function(closeFlag) {
                                if(closeFlag) {
                                    callFunction('GP_001', 'doEnd', [true, $share.gridObj]);
                                } else {
                                    $share.newFlag = false;
                                    Alert(Sepoa.cache.text.get('GP_003.MESSAGE_SAVE_COMPLETE'));
                                    callFunction('GP_002', 'doQueryList', []);
                                }
                            });
			            } else {
			                Alert(so.message);
                            return;
			            }
			        });
			    }
			});
        ]]>
        </function>
        <function name="doDelete">
        <![CDATA[
             Confirm(Sepoa.cache.text.get('GP_003.MESSAGE_DELETE_PRESET'), function(flag) {
                if (flag) {
                    doServiceAjax('sepoa.svc.tools.Personalization', 'TRANSACTION', 'doDeletePreset', null, function(so) {
                        if (so.status == '1') {
                            Alert(Sepoa.cache.text.get('GP_003.MESSAGE_DELETE_COMPLETE'));
                            doClearAllComponent();
                            callFunction('GP_002', 'doQueryList', []);
                        } else {
                            Alert(so.message);
                            return;
                        }
                    });
                }
            });
        ]]>
        </function>
    </userscript>
