<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="COMMON_LIST" header="false">
    <link>
    <![CDATA[
        <link href="<%=CONTEXT_NAME%>/resource/plugin/sepoasoft/screenbuilder/css/screenbuilder.css" rel="stylesheet" type="text/css" />
    ]]>
    </link>
    <filterbar id="filterObj2" div="WrsMoJbmHCOoJbYPnI">
        <keyword id="url" placeholder="직접입력"/>
        <event type="onSearch" callback="doOpen"/>
    </filterbar>
    <filterbar id="filterObj" div="lxtGmJbdoMHmJbdGxg">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="doQuery"/>
    </filterbar>
    <button id="btnObj">
        <btn div="NGttOHbAHQuOHbpHAd" id="CANCEL" type="cancel" text="{BUTTON.cancel}" toggle="false" reverse="false" onclick="doCancel(  )"/>
    </button>
    <list id="listObj" div="NGttOHbDEfuOHbCsYx">
        <type>
            <template></template>
        </type>
        <event type="onItemClick" callback="onItemClick"/>
    </list>
    <usercss>
    <![CDATA[
        
    ]]>
    </usercss>
    <variable>
        <var name="wLgnZHbPljnZHbSsNp" value="$($sObject._vp).find('#wLgnZHbPljnZHbSsNp')[0]"/>
        <var name="wLgnZHbZMmnZHbiDVU" value="$($sObject._vp).find('#wLgnZHbZMmnZHbiDVU')[0]"/>
        <var name="wLgnZHbPljnZHbcXoc" value="$($sObject._vp).find('#wLgnZHbPljnZHbcXoc')[0]"/>
        <var name="NGttOHbHLVuOHbHVpA" value="$($sObject._vp).find('#NGttOHbHLVuOHbHVpA')[0]"/>
        <var name="NGttOHbHLVuOHbLpvY" value="$($sObject._vp).find('#NGttOHbHLVuOHbLpvY')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <function name="init" args="">
        <![CDATA[
            $sObject._vp[0].parentElement.classList.add("sepoa_form_label_top");
            
            listObj.type_setter({
                template: Sepoa.params.TEMPLATE,
                height: "auto"
            });
        ]]>
        </function>
        <function name="doCancel" args="">
        <![CDATA[
            selfObj.close();
        ]]>
        </function>
        <function name="onItemClick" args="id">
        <![CDATA[
            var item = listObj.get(id);
            
            var so = null;
            if (Sepoa.params.callObj) {
                so = Sepoa.params.callback.apply(Sepoa.params.callObj, [item]);
            } else {
                so = Sepoa.params.callback(item);
            }
            
            if (so.status == "1") {
                selfObj.close();
            } else {
                Alert(so.message);
            }
        ]]>
        </function>
        <function name="doSelectAll" args="">
        <![CDATA[
            listObj.selectAll();
        ]]>
        </function>
        <function name="doOpen" args="">
        <![CDATA[
            var item = this.getFilterData();
            var so = null;
            if (Sepoa.params.callObj) {
                so = Sepoa.params.callback.apply(Sepoa.params.callObj, [item]);
            } else {
                so = Sepoa.params.callback(item);
            }
            
            if (so.status) {
                selfObj.close();
            } else {
                Alert(so.message);
            }
        ]]>
        </function>
        <function name="doQuery" args="">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            listObj.postConnection(Sepoa.params.SERVLET_URL, [
                "PROCESS_ID=" + Sepoa.params.PROCESS_ID,
                "METHOD=" + Sepoa.params.METHOD,
                "mode=doList"
            ])
        ]]>
        </function>
    </userscript>
