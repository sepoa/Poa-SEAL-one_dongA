<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="NEW_PROJECT_TAB" header="false" tpl="editor.tpl">
    <dataview id="listObj" div="DzaFLPcazEGLPcjBWy">
        <type width="250" height="220">
            <template><![CDATA[<table><tr><td><div class="list_template" style='width:250px;height:220px;background-size :100% 100%;background-repeat:no-repeat;background-image:url(#img#);background-position:center'></div></td></tr></table>]]></template>
        </type>
        <event type="onItemClick" callback="onItemClick"/>
        <event type="onMouseOver" callback="onMouseOver"/>
    </dataview>
    <onloadscript>
        <call name="doQueryTemplate" args="$sObject.aliasCode"/>
    </onloadscript>
    <userscript>
        <function name="doQueryTemplate" args="id">
        <![CDATA[
            dataOutput.setValue("LAYOUT_PATTERN",id,true);
            var params = dataOutput.getParams();
            listObj.load('/SepoaList.sux?PROCESS_ID=sepoa.svc.tools.ScreenBuilder&METHOD=doListTemplate&mode=doList'+params);
        ]]>
        </function>
        <function name="onItemClick" args="id, ev, html">
        <![CDATA[
            callFunction("NEW_PROJECT_OPTION","drawForm",[this.get(id)]);
        ]]>
        </function>
        <function name="onMouseOver" args="id, ev, html">
        <![CDATA[
       		var targetElement = html.getElementsByClassName("list_template"); 
        	targetElement[0].style.backgroundImage = "url("+listObj.get(id).prehover+")";
        	
        	html.data = listObj.get(id);
        	html.onmouseout = function(e){
        		var target = this.getElementsByClassName("list_template"); 
        		target[0].style.backgroundImage = "url("+this.data.img+")";
        	}
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
    </template>
</body>