    </variable>
    <onloadscript>
        <![CDATA[
            var guideObject = {
                layout : {
                    title : "Layout",
                    path : "/resource/plugin/sepoasoft/screenbuilder/guide/LayoutGuide.html"
                },
                css : {
                	title: "CSS",
                	path : "/resource/plugin/sepoasoft/screenbuilder/guide/SC_CSS.html"
                },
                tabbar : {
                	title : "Tabbar",
                	path : "/resource/plugin/sepoasoft/screenbuilder/guide/TabbarGuide.html"
                }
            }
            
			var attachFilePath;
			if(guideObject[Sepoa.params.type]){
                attachFilePath = guideObject[Sepoa.params.type].path;
            } else {
                attachFilePath =  "";
            }
            
            selfObj.mcover.d.hidden = true
            var url = window.CONTEXT_NAME + attachFilePath;;
            if(Sepoa.params.scroll){
            	url += "#SCREEN_"+Sepoa.params.scroll;
            }
            
            window.document.location = url;
        ]]>
