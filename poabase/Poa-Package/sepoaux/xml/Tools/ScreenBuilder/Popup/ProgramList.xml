<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="PROGRAM_LIST" header="false" tpl="editor.tpl">
    <button id="btnObj">
        <btn div="wLgnZHbaRpnZHbkdgM" id="SELECT_ALL" text="{BUTTON.selectall}" onclick="doSelectAll(  )"/>
        <btn div="NGttOHbAHQuOHbpHAd" id="CANCEL" type="cancel" text="{BUTTON.cancel}" onclick="doCancel(  )"/>
        <btn div="NGttOHbAHQuOHbpHAd" id="SAVE" type="save" text="{BUTTON.save}" onclick="doSave(  )"/>
    </button>
    <list id="listObj" div="NGttOHbDEfuOHbCsYx">
        <type>
            <template><![CDATA[<table width=100% class=list_template><th><col width=50%><col width=50%></th><tr><td class=listBold>#menu_profile_code#</td><td class=listRight >#menu_profile_name#</td></tr><tr><td class=listBold>#company_code#</td><td class=listRight >#company_name_loc#</td></tr></table>]]></template>
        </type>
    </list>
    <variable>
        <var name="wLgnZHbPljnZHbSsNp" value="$($sObject._vp).find('#wLgnZHbPljnZHbSsNp')[0]"/>
        <var name="wLgnZHbZMmnZHbiDVU" value="$($sObject._vp).find('#wLgnZHbZMmnZHbiDVU')[0]"/>
        <var name="wLgnZHbPljnZHbcXoc" value="$($sObject._vp).find('#wLgnZHbPljnZHbcXoc')[0]"/>
        <var name="NGttOHbHLVuOHbHVpA" value="$($sObject._vp).find('#NGttOHbHLVuOHbHVpA')[0]"/>
        <var name="NGttOHbHLVuOHbLpvY" value="$($sObject._vp).find('#NGttOHbHLVuOHbLpvY')[0]"/>
    </variable>
    <onloadscript>
    	<call name="init" />
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
    	<function name="init" args="">
    	<![CDATA[
    		$sObject._vp[0].parentElement.classList.add("sepoa_form_label_top");
    	]]>
    	</function>
        <function name="doCancel" args="">
        <![CDATA[
            selfObj.close();
        ]]>
        </function>
        <function name="doSave" args="">
        <![CDATA[
        	var ids = listObj.getSelected();
        	if(!ids){
        		Alert(Sepoa.cache.text.get('MESSAGE.1004'));	 
        		return;
        	}
        	if(typeof(ids) == "string"){
        		ids = [ids];
        	}
        	var profileList = [];
        	for(var i in ids){
        		profileList.push(listObj.get(ids[i]).menu_profile_code);
        	}
        	doServiceAjaxFile("sepoa.svc.tools.ProgramList", "CONNECTION", "doExcelDownload", {PROFILE_CODE:profileList.join('#')}, false);
        ]]>
        </function>
        <function name="doSelectAll" args="">
        <![CDATA[
            listObj.selectAll();
        ]]>
        </function>
        <function name="doQuery" args="">
        <![CDATA[
            var params = dataOutput.getParams();
            params += '&PROCESS_ID=sepoa.svc.admin.AD_021&METHOD=doQueryProfile'
            listObj.load('/SepoaList.sux?mode=doList'+params);
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
    </template>
</body>