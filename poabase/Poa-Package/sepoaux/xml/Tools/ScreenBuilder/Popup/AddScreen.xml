<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="ADD_SCREEN_POPUP" header="false" tpl="editor.tpl">
    <button id="btnObj">
        <btn div="bKzzoEcEnBTdQiCwon" id="SAVE" type="save" text="{BUTTON.save}" onclick="onButtonClick( 'SAVE' )"/>
        <btn div="bKzzoEcEnBTdQiCwon" id="CANCEL" type="cancel" text="{BUTTON.cancel}" onclick="onButtonClick( 'CANCEL' )"/>
    </button>
    <link>
    <![CDATA[
    	<link href="<%=CONTEXT_NAME%>/resource/plugin/sepoasoft/screenbuilder/css/screenbuilder.css" rel="stylesheet" type="text/css" />
    ]]>
    </link>
    <usercss>
    <![CDATA[
        div.multi_form_box{
            display:table !important;
            margin:0 auto !important;
        }
        div.form_area{
        	display:inline-flex;
        }
        div.form_area .multi_form_box{
        	margin:0 auto;
        }
    ]]>
    </usercss>
    <variable>
        <var name="PLzzoEcZRuApEcTXki" value="$($sObject._vp).find('#PLzzoEcZRuApEcTXki')[0]"/>
        <var name="PLzzoEcYRuApEcFWAM" value="$($sObject._vp).find('#PLzzoEcYRuApEcFWAM')[0]"/>
        <var name="formDiv" value="$($sObject._vp).find('#PLzzoEceFYApEcbFFa')[0]"/>
        <var name="PLzzoEcdFYApEcjIEO" value="$($sObject._vp).find('#PLzzoEcdFYApEcjIEO')[0]"/>
    </variable>
    <onloadscript>
        <event obj="Sepoa" type="onButtonClick" callback="onButtonClick"/>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <var name="formObj"/>
        <function name="init" args="">
        <![CDATA[
        	$sObject._vp[0].parentElement.classList.add("sepoa_form_label_top");
        	
            formObj = $sObject.formObj = new SepoaMultiDhtmlXFormObject(formDiv, 'formObj', [Sepoa.params.formOption]);
            formObj.attachEvent('onChange', onChange)
            
            formObj.dataMapper(Sepoa.params.data, "json")
            setSize();
        ]]>
        </function>
        <function name="onButtonClick" args="id">
        <![CDATA[
            if(id == 'CANCEL'){
                selfObj.close();
            }else if(id == 'SAVE'){
                if(!formObj.validate()){
                    return
                }
                
                var ro = Sepoa.params.callback.apply( Sepoa.params.callObj,[{info:formObj.getFormData()}]);
                if(ro.status){
                    selfObj.close();
                }else{
                    Alert(ro.message);
                }
            }
        ]]>
        </function>
        <function name="setSize" args="">
        <![CDATA[
            var s = {width:400, height:500}
            
            var tArray = [formObj];
            for(var i in tArray){
                var t = tArray[i];
                if(t){
                    var c = t._parent.children[0]
                    var w = c.offsetWidth + 100;
                    var h = c.offsetHeight + $sObject._vp.find("#PLzzoEcZRuApEcTXki").outerHeight() + 100;
                    if(w > s.width) s.width = w;
                    if(h > s.height) s.height = h;
                }
            }
            
            selfObj[selfObj.name].setDimension(s.width, s.height);
            selfObj[selfObj.name].center();
        ]]>
        </function>
        <function name="onChange" args="name, value">
        <![CDATA[
            if(name == "NONSTD_PATH"){
                if(value == 'Y'){
                    this.enableItem('PATH_3');
                    this.hideItem('PATH_2')
                    this.setItemWidth('PATH_1', '274')
                    this.setItemValue('PATH_2', '', true)
                    this.setItemValue('PATH_3', '')
                }else{
                    this.setItemWidth('PATH_1', '129')
                    this.disableItem('PATH_3');
                    this.showItem('PATH_2')
                    this.setItemValue('PATH_1', '', true)
                    this.setItemValue('PATH_2', '')
                }
            }else if(["PATH_1","PATH_2", "PATH_3", "NAME"].indexOf(name) + 1){
                var PATH_1 = formObj.getValue("PATH_1").trim();
                var PATH_2 = formObj.getValue("PATH_2").trim();
                var PATH_3 = formObj.getValue("PATH_3").trim();
                var NAME = formObj.getValue("NAME").trim();
                var NONSTD_PATH = formObj.getValue('NONSTD_PATH').trim();
                
                var pathArray = [];
                if(PATH_1 && PATH_2){
                    PATH_3 = PATH_1+""+PATH_2;
                    formObj.setValue("PATH_3", PATH_3, true)
                    
                    if(NAME){
                        pathArray.push(PATH_1, PATH_2, PATH_3+NAME);
                    }
                }else if(PATH_1 && NONSTD_PATH == 'Y' && (PATH_3+NAME)){
                    pathArray.push(PATH_1, PATH_3+NAME);
                }
                
                if(NAME){
                    formObj.setValue("PATH", "/"+pathArray.join("/")+".xml", true);
                }
            }
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
        
    </template>
</body>