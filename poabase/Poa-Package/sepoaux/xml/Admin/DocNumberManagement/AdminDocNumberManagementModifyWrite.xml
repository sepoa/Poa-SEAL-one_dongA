<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_330_2" header="false">
    <form id="formObj" div="kWKYYPbAvtfcTxylkS" form-id="file:///resource/ux/admin/form/AD_330_1.js"/>
    <button id="layoutBtnObj">
        <btn div="kWKYYPbkiBhcTxyxFE" id="new" type="new" text="{BUTTON.new}" toggle="false" reverse="false" onclick="doNew(  )"/>
        <btn div="kWKYYPbkiBhcTxyxFE" id="update" type="update" text="{BUTTON.update}" toggle="false" reverse="false" onclick="doUpdate(  )"/>
        <btn div="kWKYYPbkiBhcTxyxFE" id="cancel" type="cancel" text="{BUTTON.cancel}" toggle="false" reverse="false" onclick="doCancel(  )"/>
        <btn div="kWKYYPbkiBhcTxyxFE" id="save" type="save" text="{BUTTON.save}" toggle="false" reverse="false" onclick="doSave(  )"/>
        <btn div="kWKYYPbkiBhcTxyxFE" id="delete" type="deleted" text="{BUTTON.delete}" toggle="false" reverse="false" onclick="doDelete(  )"/>
    </button>
    <button id="btnObj">
        <btn div="kWKYYPbAfBgcTxySkG" id="addRow" text="{BUTTON.rowadd}" onclick="doAddRow(  )"/>
        <btn div="kWKYYPbAfBgcTxySkG" id="deleteRow" text="{BUTTON.rowdelete}" onclick="doDeleteRow(  )"/>
    </button>
    <grid id="gridObj" div="kWKYYPbsZrgcTxyUjz" grid-id="file:///resource/ux/admin/grid/AD_330.js" drag="false" merge="false" dynamic="false">
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onTXE" callback="doSaveEnd"/>
    </grid>
    <variable>
        <var name="yXKYYPbFIMYYPbxXMm" value="$($sObject._vp).find('#yXKYYPbFIMYYPbxXMm')[0]"/>
        <var name="yXKYYPbOoNYYPbBFVU" value="$($sObject._vp).find('#yXKYYPbOoNYYPbBFVU')[0]"/>
        <var name="yXKYYPbEIMYYPbOkqd" value="$($sObject._vp).find('#yXKYYPbEIMYYPbOkqd')[0]"/>
    </variable>
    <onloadscript>
        <call name="changeMode" args="'VIEW'"/>
    </onloadscript>
    <userscript>
        <function name="doQuery" args="docType">
        <![CDATA[
            if (docType) formObj.setValue('DOC_TYPE', docType);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.admin.AD_330']);
            formObj.clear();
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="obj, rowCnt">
        <![CDATA[
            var msg = obj.getUserData("", "message");
            var status = obj.getUserData("", "status");
            if (status != "true") {
                Alert(msg);
            } else {
                var sf = new SepoaFormater(obj.getUserData("", "headerData"));
                if (sf.getRowCount() > 0) {
                    formObj.dataMapper(sf);
                    changeMode('VIEW');
                } else {
                    changeMode('CLEAR');
                }
            }
        ]]>
        </function>
        <function name="changeMode" args="mode">
        <![CDATA[
            if (mode == 'VIEW') {
                changeMode('CLEAR');
                layoutBtnObj.showButton('update,delete,new');
                formObj.setViewMode(true);
                gridObj.setReadOnly(true);
            } else if (mode == 'INSERT') {
                changeMode('CLEAR');
                layoutBtnObj.showButton('save,cancel');
                btnObj.forEachBtn(function(id) {
                    btnObj.showButton(id, true);
                })
                formObj.setViewMode(false);
                gridObj.setReadOnly(false);
            } else if (mode == 'CLEAR') {
                layoutBtnObj.showButton(null, false);
                btnObj.forEachBtn(function(id) {
                    btnObj.showButton(id, false);
                })
                formObj.setViewMode(false);
                gridObj.setReadOnly(false);
            }
            SUX.callEvent('onWindowResize', [])
        ]]>
        </function>
        <function name="doNew" args="">
        <![CDATA[
            dataOutput.setValue('beforeDoc', formObj.getValue("DOC_TYPE"));
            formObj.clear();
            gridObj.clearAll();
            dataOutput.setValue('SAVE_MODE', 'INSERT');
            changeMode('INSERT');
        ]]>
        </function>
        <function name="doCancel" args="">
        <![CDATA[
            formObj.setValue('DOC_TYPE', dataOutput.getValue('beforeDoc'));
            dataOutput.setValue('SAVE_MODE', '');
            doQuery();
        ]]>
        </function>
        <function name="doUpdate" args="">
        <![CDATA[
            dataOutput.setValue('beforeDoc', formObj.getValue("DOC_TYPE"));
            dataOutput.setValue('SAVE_MODE', 'UPDATE');
            changeMode('INSERT');
        ]]>
        </function>
        <function name="doDelete" args="">
        <![CDATA[
            Confirm(Sepoa.cache.text.get('MESSAGE.1015'), function(result) {
                if (result) {
                    doServiceAjax('sepoa.svc.admin.AD_330', 'TRANSACTION', 'doDelete', null, function(so) {
                        if (so.status != '1') {
                            Alert(so.message);
                        } else {
                            callFunction('AD_330_1', 'doQuery');
                        }
                    });
                }
            });
        ]]>
        </function>
        <function name="doAddRow" args="">
        <![CDATA[
            var maxRowId = new Date().getTime() + '' + dhx4.newId();
            gridObj.addRow(maxRowId, '', gridObj.getRowsNum());
            gridObj.cells(maxRowId, gridObj.getColIndexById('SELECTED')).setValue("1");
            gridObj.cells(maxRowId, gridObj.getColIndexById('YEAR_FLAG')).setValue("0");
            gridObj.cells(maxRowId, gridObj.getColIndexById('MONTH_FLAG')).setValue("0");
            gridObj.cells(maxRowId, gridObj.getColIndexById('DAY_FLAG')).setValue("0");
            gridObj.cells(maxRowId, gridObj.getColIndexById('USE_FLAG')).setValue("1");
            gridObj.showRow(maxRowId);
        ]]>
        </function>
        <function name="doDeleteRow" args="">
        <![CDATA[
            var grid_array = gridObj.getGridChangedRows("SELECTED");
            if (grid_array.length < 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.MSG_1001'));
            } else {
                Confirm(Sepoa.cache.text.get('MESSAGE.1015'), function(result) {
                    if (result) {
                        for (var i in grid_array) {
                            var flag = gridObj.cells(grid_array[i], gridObj.getColIndexById('SAVED')).getValue();
                            if (flag != 'Y') {
                                gridObj.deleteRow(grid_array[i]);
                            }
                        }
                        grid_array = gridObj.getGridChangedRows("SELECTED");
                        if (grid_array.length > 0) {
                            gridObj.editStop();
                            gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.admin.AD_330', 'METHOD=doDelete'], 'SELECTED');
                        }
                    }
                });
            }
        ]]>
        </function>
        <function name="doSave" args="">
        <![CDATA[
            gridObj.editStop();
            if (!gridObj.validate('SELECTED') || !formObj.validate()) {
                Alert(Sepoa.cache.text.get('MESSAGE.0002'));
                return;
            }
            Confirm(Sepoa.cache.text.get('MESSAGE.1018'), function(result) {
                if (result) {
                    gridObj.editStop();
                    gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.admin.AD_330', 'METHOD=doSave'], 'SELECTED');
                }
            });
        ]]>
        </function>
        <function name="doSaveEnd" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if (status == "true") {
                doQuery();
                callFunction('AD_300_1', 'doQuery', [true]);
            } else {
                Alert(message);
            }
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
    </template>
</body>