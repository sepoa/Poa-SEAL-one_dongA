<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_019_1" header="false">	<template>    <![CDATA[        <div class="container" id="container">        	<div class="topBackground topBackground_list">        		<div id="filterArea" class="filterArea"></div>        	</div>        	<div id="listdiv" class="ListTabBar lowerDiv"></div>        </div>    ]]>	</template>	<tabbar id="leftTabbar" div="listdiv">		<item id="tabbar1" name="AD_019.USER">
			<attach>				<list id="UserList">					<type>						<template>	            		<![CDATA[	                            <table width=100% class=list_template>	                                <col width=55% />	                                <col width=45%>	                                <tr>	                                    <td class=listBold>#company_name_loc#</td>	                                    <td class=listRight>#dept_name_loc#</td>	                                </tr>	                                <tr>	                                    <td class=listBold>#position#</td>	                                    <td class=listRight>#employee_no#</td>	                                </tr>	                                <tr>	                                    <td>#user_name_loc#</td>	                                    <td class=\"listRight listRed listBold\">#user_id#</td>	                                </tr>	                            </table>	                    ]]>						</template>					</type>					<page size="25" />					<event type="onItemClick" callback="doRowSelect_UserList" />
					<event type="onXLE" callback="doQuery_UserListEnd"/>				</list>
			</attach>		</item>		<item id="tabbar2" name="AD_019.STANBYUSER">
			<attach>				<list id="standbyUserList">					<type>						<template>	            		<![CDATA[	                            <table width=100% class=list_template>	                                <col width=55% />	                                <col width=45%>	                                <tr>	                                    <td class=listBold>#company_name_loc#</td>	                                    <td class=listRight>#dept_name_loc#</td>	                                </tr>	                                <tr>	                                    <td class=listBold>#position#</td>	                                    <td class=listRight>#employee_no#</td>	                                </tr>	                                <tr>	                                    <td>#user_name_loc#</td>	                                    <td class=\"listRight listRed listBold\">#user_id#</td>	                                </tr>	                            </table>	                    ]]>						</template>					</type>					<event type="onItemClick" callback="doRowSelect_standbyUserList" />				</list>
			</attach>		</item>	</tabbar>	<filterbar div="filterArea" id="filterObj">		<keyword id="F_KEYWORD" />		<status id="F_STATUS" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#AD011,P" />	</filterbar>	<onloadscript>		<call name="doQuery_standbyUserList" />		<call name="doQuery_UserList" />	    <![CDATA[	            leftTabbar.tabs("tabbar1").setActive();	    ]]>		<event obj="filterObj" type="onSearch">			<function args="id">            <![CDATA[                    if(id == 'filter' || id == 'search'){                    if(leftTabbar.getActiveTab() == 'tabbar1'){                        doQuery_UserList();                    }else{                        doQuery_standbyUserList();                    }                }                ]]>			</function>		</event>	</onloadscript>	<userscript>		<function name="doQuery_standbyUserList" args="">        <![CDATA[                dataOutput.addFilter(filterObj);                    standbyUserList.load('/SepoaList.sux?mode=doList&PROCESS_ID=sepoa.svc.admin.AD_019_1&SIGN_STATUS=B'+dataOutput.getParams());                standbyUserList.clearAll(false)            ]]>		</function>		<function name="doQuery_UserList" args="">        <![CDATA[                dataOutput.addFilter(filterObj);                UserList.load('/SepoaList.sux?mode=doList&PROCESS_ID=sepoa.svc.admin.AD_019_1&SIGN_STATUS=A'+dataOutput.getParams());                UserList.clearAll(false)            ]]>		</function>
		
		<function name="doQuery_UserListEnd" args="">
        <![CDATA[
            if(UserList.dataCount() > 0){
                var id = UserList.first();
                UserList.select(id);
                UserList.show(id);
                callFunction(['AD_019_2'],'doFormLoad', [UserList.get(id).user_id]);
            }
        ]]>
        </function>		<function name="doRowSelect_standbyUserList" args="id, ev, html">        <![CDATA[                callFunction(['AD_019_2'],'doFormLoad', [standbyUserList.get(id).user_id]);            ]]>		</function>		<function name="doRowSelect_UserList" args="id, ev, html">        <![CDATA[                callFunction(['AD_019_2'],'doFormLoad', [UserList.get(id).user_id]);            ]]>		</function>	</userscript></body>