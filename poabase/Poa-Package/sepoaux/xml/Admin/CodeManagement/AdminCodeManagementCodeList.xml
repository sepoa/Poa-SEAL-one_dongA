<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_014_2" header="false">
    <filterbar id="filterObj" div="yrjmeQbMlKJtfdzGOz">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <list id="listObj" div="yrjmeQbMplHtfdzcsW">
        <type>
            <template><![CDATA[<table width=100% class=sepoa_list_design><col width=55% /><col width=45%><tr><td class=sepoa_list_secondary>#code#</td><td class=\"sepoa_list_font_bold sepoa_list_align_right\">#text1#</td></tr><tr><td colspan=2 class=\"sepoa_list_primary sepoa_list_align_right\"></td></tr></table>]]></template>
        </type>
        <event type="onItemClick" callback="doRowSelect"/>
        <event type="onXLE" callback="doQueryEnd"/>
    </list>
    <onloadscript/>
    <userscript>
        <function name="doQuery" args="flag">
        <![CDATA[
            queryDataFlag = flag;
            dataOutput.addFilter(filterObj);
            listObj.load(window.CONTEXT_NAME + '/SepoaList.sux?PROCESS_ID=sepoa.svc.admin.AD_014&mode=doList&METHOD=doListCode' + dataOutput.getParams());
        ]]>
        </function>
        <function name="doQueryEnd" args="">
        <![CDATA[
            if (!queryDataFlag) {
                if (listObj.dataCount() > 0) {
                    var id = listObj.idByIndex(0);
                    listObj.select(id);
                    doRowSelect(id);
                } else {
                    callFunction('AD_014_4', 'doNew', []);
                }
            }
        ]]>
        </function>
        <function name="doRowSelect" args="id">
        <![CDATA[
            callFunction('AD_014_4', 'doQuery', [listObj.get(id)]);
        ]]>
        </function>
        <function name="onSearch" args="id">
        <![CDATA[
            doQuery();
        ]]>
        </function>
        <var name="queryDataFlag"/>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
    </template>
</body>