    <onloadscript>
        <event obj="Sepoa" type="onButtonClick">
            <function args="id">
            <![CDATA[
                var getTabbarId = getChildScreenId(tabbarObj.tabs(tabbarObj.getActiveTab()).cell);
                SUX.pools[getTabbarId].Sepoa.callEvent('onButtonClick', [id]);
            ]]>
            </function>
        </event>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <function name="changeCarousel" args="id">
        <![CDATA[
            tabbarObj.tabs(id).setActive();
            callFunction('p', 'changeHeaderText', ['b', Sepoa.cache.text.get('AD_014.' + id)]);
            doQuery();
        ]]>
        </function>
        <function name="doQuery" args="">
        <![CDATA[
            var activeTab = tabbarObj.getActiveTab();
            var sId = '';
            if (activeTab == 'COMMON_CODE') {
                sId = 'AD_014_2'
            } else if (activeTab == 'COMMON_MODULE') {
                sId = 'AD_014_3'
            } else {
                return;
            }
            callFunction(sId, 'doQuery', []);
        ]]>
        </function>
        <function name="onButtonClick" args="id">
        <![CDATA[
            var getTabbarId = getChildScreenId(tabbarObj.tabs(tabbarObj.getActiveTab()).cell);
            SUX.pools[getTabbarId].Sepoa.callEvent('onButtonClick', [id]);
        ]]>
        </function>
