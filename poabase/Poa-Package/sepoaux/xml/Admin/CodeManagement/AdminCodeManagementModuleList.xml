<body screen_id="AD_014_3" header="false">
    <filterbar id="filterObj" div="UsjmeQbwVONwfdzdnU">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <list id="listObj" div="UsjmeQbQiDNwfdzSKI">
        <type>
            <template><![CDATA[<table width=100% class=list_template><col width=55% /><col width=45%><tr><td class=listColorR>#code#</td><td class=\"listBold listRight\">#text1#</td></tr><tr><td colspan=2 class=\"listColorB listRight\"></td></tr><tr class=listHidden><td>#text2##language##module#</td></tr></table>]]></template>
        </type>
        <event type="onItemClick" callback="doRowSelect"/>
        <event type="onXLE" callback="doQueryEnd"/>
    </list>
    <onloadscript/>
    <userscript>
        <function name="doQuery" args="flag">
        <![CDATA[
            queryDataFlag = flag;
            dataOutput.addFilter(filterObj);
            listObj.load(window.CONTEXT_NAME + '/SepoaList.sux?PROCESS_ID=sepoa.svc.admin.AD_014&mode=doList&METHOD=doListModule' + dataOutput.getParams());
        ]]>
        </function>
        <function name="doQueryEnd" args="">
        <![CDATA[
            if (!queryDataFlag) {
                if (listObj.dataCount() > 0) {
                    var id = listObj.idByIndex(0);
                    listObj.select(id);
                    doRowSelect(id);
                } else {
                    callFunction('AD_014_5', 'doNew', []);
                }
            }
        ]]>
        </function>
        <function name="doRowSelect" args="id">
        <![CDATA[
            callFunction('AD_014_5', 'doQuery', [listObj.get(id)]);
        ]]>
        </function>
        <function name="onSearch" args="id">
        <![CDATA[
            doQuery();
        ]]>
        </function>
        <var name="queryDataFlag"/>
    </userscript>
