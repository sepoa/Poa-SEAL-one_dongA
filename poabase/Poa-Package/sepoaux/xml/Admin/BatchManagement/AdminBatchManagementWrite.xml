<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_300_3" header="false">
    <filterbar id="filterObj" div="ABlIqNbosftpMGoTUR">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <button id="layoutBtnObj">
        <btn div="CBlIqNbgnHBqMGoWOQ" id="add" type="rowadd" text="{BASE_BUTTON.ROW_ADD}" toggle="false" reverse="false" onclick="addRow(  )"/>
        <btn div="CBlIqNbgnHBqMGoWOQ" id="delete" type="rowdelete" text="{BASE_BUTTON.ROW_DELETE}" toggle="false" reverse="false" onclick="doDelete(  )"/>
        <btn div="CBlIqNbgnHBqMGoWOQ" id="run" text="{BASE_BUTTON.RUN}" toggle="false" reverse="false" onclick="doRun(  )"/>
        <btn div="CBlIqNbgnHBqMGoWOQ" id="save" type="save" text="{BASE_BUTTON.SAVE}" toggle="false" reverse="false" onclick="doSave(  )"/>
    </button>
    <grid id="gridObj" div="yAlIqNboMddpMGozMA" grid-id="file:///resource/ux/admin/grid/AD_300.js" drag="false" merge="false" dynamic="false">
        <event type="onTXE" callback="doSaveEnd_grid"/>
    </grid>
    <variable>
        <var name="yClIqNbSRvIqNbVoDn" value="$($sObject._vp).find('#yClIqNbSRvIqNbVoDn')[0]"/>
        <var name="yClIqNbNlyIqNbEYFA" value="$($sObject._vp).find('#yClIqNbNlyIqNbEYFA')[0]"/>
        <var name="yClIqNbRRvIqNbMbHW" value="$($sObject._vp).find('#yClIqNbRRvIqNbMbHW')[0]"/>
    </variable>
    <onloadscript/>
    <userscript>
        <var name="clickHouseCode" />
        <function name="doQuery" args="houseCode">
        <![CDATA[
            clickHouseCode = houseCode;
            dataOutput.addFilter(filterObj);
            dataOutput.setValue('HOUSE_CODE', clickHouseCode);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.admin.AD_300_3', 'METHOD=doQuery']);
            gridObj.clearAll(false);
            //조회시 부모화면의 id가 a인 것의 아이콘중 add,delete,save 아이콘을 활성화 한다.
            callFunction('parent', 'changeHeaderIcon', ['a', 'show', 'add,delete,run,save']);
        ]]>
        </function>
        <function name="onSearch" args="flag">
        <![CDATA[
        	if(flag == "filter" || flag == "search"){
        		doQuery(clickHouseCode);
        	}
        ]]>
        </function>
        <![CDATA[
            //행추가 버튼 클릭시 호출되는 함수
        ]]>
        <function name="addRow" args="mode">
        <![CDATA[
            //추가될 행의 아이디를 정의
            var maxRowId = gridObj.getRowsNum() + 1;
            //행의 제일 마지막에 행추가. 행의 아이디는 1부터 인댁스는 0부터 이다.
            gridObj.addRow(maxRowId, '', gridObj.getRowsNum());
            gridObj.showRow(maxRowId);
            gridObj.cells(maxRowId, gridObj.getColIndexById("HOUSE_CODE")).setValue(clickHouseCode);
        ]]>
        </function>
        <function name="doDelete" args="">
        <![CDATA[
            var selectedRow = gridObj.getGridChangedRows("SELECTED");
            var countRow = gridObj.getGridChangedRows("SELECTED").length;
            if (countRow < 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.MSG_1001')); //대상건을 선택하십시오.
            }
            if (gridObj.getGridChangedRows("SELECTED").length > 0 && Confirm(Sepoa.cache.text.get('MESSAGE.1015'), function(result) {
                if (result) {
                    gridObj.editStop();
                    gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.admin.AD_300_3', 'METHOD=doDelete'], 'SELECTED');
                }
            }));
        ]]>
        </function>
        <function name="doSave" args="">
        <![CDATA[
            //유효성 검사
            var countRow = gridObj.getGridChangedRows("SELECTED").length;
            if (countRow < 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.MSG_1001'));
            } else {
                var selectedRow = gridObj.getGridChangedRows("SELECTED");
                for (var i = 0; i < selectedRow.length; i++) {
                    //필수요소는 4개이다.
                    for (var j = 0; j < 2; j++) {
                        var colId = '';
                        switch (j) {
                            case 0:
                                colId = 'PROCESS_ID';
                                break;
                            case 1:
                                colId = 'METHOD_NAME';
                                break;
                        }
                        var col_index = gridObj.getColIndexById(colId);
                        var cellvalue = gridObj.cells(selectedRow[i], col_index).getValue();
                        if (cellvalue == '' || cellvalue.length < 1) {
                            Alert(Sepoa.cache.text.get('AD_300.' + colId) + Sepoa.cache.text.get('MESSAGE.0055'));
                            //셀 선택하여 edit모드로 전환
                            gridObj.selectCell(gridObj.getRowIndex(selectedRow[i]), col_index);
                            gridObj.editCell();
                            return;
                        }
                    }
                }
                Confirm(Sepoa.cache.text.get('MESSAGE.1018'), function(result) {
                    if (result) {
                        gridObj.editStop();
                        gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.admin.AD_300_3', 'METHOD=doSave'], 'SELECTED');
                    } else {
                        return false;
                    }
                });
            }
        ]]>
        </function>
        <function name="doSaveEnd_grid" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if (status == 'true') {
                Alert(message);
                doQuery(clickHouseCode);
            } else {
                Alert(message);
            }
        ]]>
        </function>
        <function name="doRun" args="">
        <![CDATA[
            var countRow = gridObj.getGridChangedRows("SELECTED").length;
            if (countRow > 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.5401'));
                return;
            } else if (countRow < 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.5402'));
                return;
            } else if (countRow = 1) {
                Confirm(Sepoa.cache.text.get('MESSAGE.5403'), function(result) {
                    if (result) {
                        gridObj.editStop();
                        gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.admin.AD_300_3', 'METHOD=doRun'], 'SELECTED');
                    } else {
                        return false;
                    }
                });
            }
        ]]>
        </function>
    </userscript>
