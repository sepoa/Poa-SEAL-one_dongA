<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_021_3" header="false">
    <link>
    <![CDATA[
        <script src="<%=CONTEXT_NAME%>/resource/plugin/jquery/jquery-ui-1.12.1/jquery-ui.js" type="text/javascript"></script>
        <script src="<%=CONTEXT_NAME%>/resource/plugin/sepoasoft/menumanagement/menumanagement.js" type="text/javascript"></script>
        <link href="<%=CONTEXT_NAME%>/resource/plugin/sepoasoft/menumanagement/menumanagement.css" rel="stylesheet" type="text/css" />
        <%
                String al = "";
                
                Object[] o = new Object[]{new HashMap<String, Object>()};
                SepoaOut so = ServiceConnector.doService(info, "sepoa.svc.common.COMMON", "CONNECTION", "getActiveLanguage", o);
                for(Map<String, String> map : new SepoaFormater(so.result[0]).getListMap()){
                    al += "activeLanguage.push('" + map.get("LANGUAGE") + "');\n			";
                }
                %>
            <script type="text/javascript">
                var activeLanguage = [];
                <%=al%>
            </script>
    ]]>
    </link>
    <variable>
        <var name="menuArea" value="$($sObject._vp).find('#HUQfjZbPmSfjZbZbqH')[0]"/>
        <var name="HUQfjZbOmSfjZbPujW" value="$($sObject._vp).find('#HUQfjZbOmSfjZbPujW')[0]"/>
    </variable>
    <onloadscript>
        <call name="initPage"/>
    </onloadscript>
    <userscript>
        <var name="menuObj"/>
        <function name="initPage">
        <![CDATA[
            menuObj = $sObject.menuObj = new SepoaMenuManagement(menuArea, {
                PROCESS_ID: 'sepoa.svc.admin.AD_021',
                dataOutput: dataOutput,
                language: activeLanguage
            });
            menuObj.attachEvent("onChangeProfile", function() {
                callFunction("AD_021_2", "doQuery", [])
            })
            SUX.callEvent('onWindowResize', []);
        ]]>
        </function>
        <function name="doQuery" args="item">
        <![CDATA[
            if (menuObj != null) {
                menuObj.clearAll();
                menuObj.loadProfile(item);
            } else {
                //
            }
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
    </template>
</body>