        <event type="onSearch" callback="doQuery"/>
    </filterbar>
    <list id="listObj" div="MiPYuUbaJvYuUbxOXV" drag="false">
        <type>
            <template><![CDATA[<table class=sepoa_list_design><tr><td>#menu_profile_name#</td><td class=sepoa_list_align_right>#menu_profile_code#</td></tr><tr><td colspan=2>#company_name_loc#</td></tr></table>]]></template>
        </type>
        <event type="onItemClick" callback="doRowSelect"/>
    </list>
    <onloadscript>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <function name="doQuery">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            listObj.postConnection(window.CONTEXT_NAME + '/SepoaList.sux', ['mode=doList', 'PROCESS_ID=sepoa.svc.admin.AD_021', 'METHOD=doQueryProfile']);
            listObj.clearAll(false);
        ]]>
        </function>
        <function name="doRowSelect" args="id, ev, html">
        <![CDATA[
            var item = listObj.get(id);
            callFunction('AD_021_3', 'doQuery', [item]);
        ]]>
        </function>
    </userscript>
