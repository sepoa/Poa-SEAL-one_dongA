<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_420" header="false" tpl="editor.tpl">
	<link>
	<![CDATA[
		<script type="text/javascript">
			Sepoa.cache.text.load({
				url:CONTEXT_NAME+'/resource/ux/admin/langs/'+Sepoa.info.LANGUAGE+'/AD_420.js',
				def:CONTEXT_NAME+'/resource/ux/admin/langs/KO/AD_420.js'
			});
		</script>
	]]>
	</link>
    <layout id="KZIDqsddzPDqsdnlyZ" div="KZIDqsddzPDqsdnlyZ" pattern="2U">
        <cell>
            <id>a</id>
            <fix_size>true,true</fix_size>
            <header view="true" type="list" text="AD_420.LAYOUT_A_HEADER"/>
            <collapse icon="false" collapsed="false"/>
            <icon>menu</icon>
            <width>300</width>
            <attach file="/Admin/MenuFilterManagement/AdminMenuFilterManagementListTabbar.xml"/>
        </cell>
        <cell>
            <id>b</id>
            <fix_size>true,true</fix_size>
            <header view="true" type="contents" text="AD_420.LAYOUT_B_HEADER"/>
            <collapse icon="false" collapsed="false"/>
            <attach file="/Admin/MenuFilterManagement/AdminMenuFilterManagementWriteTabbar.xml"/>
        </cell>
    </layout>
    <onloadscript/>
    <userscript>
    	<function name="onSelectItem" args="item">
        <![CDATA[
            if(item){
                var headerText ="["+item.house_code +"]"
                if(item.company_name){
                    headerText = item.company_name+headerText
                }
                if(item.contents){
                    headerText += " "+item.contents;
                }
                changeHeaderText('b', headerText)
            }else{
                changeHeaderText('b', Sepoa.cache.text.get("AD_420.LAYOUT_B_HEADER"));
            }
            callFunction('AD_422_T', 'onSelectItem', [item]);
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
    </template>
</body>