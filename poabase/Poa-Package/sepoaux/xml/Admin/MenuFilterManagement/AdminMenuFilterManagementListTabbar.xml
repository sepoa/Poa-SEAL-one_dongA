<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_421_T" header="false" tpl="editor.tpl">
    <tabbar id="tabbarObj" div="cRJFqsdjOtGqsdlqvr">
        <item id="SERVICE" name="AD_421_T.TABBAR_SERVICE_NAME" selected="true">
            <attach file="/Admin/MenuFilterManagement/AdminMenuFilterManagementClientList.xml"/>
        </item>
        <item id="CLIENT" name="AD_421_T.TABBAR_CLIENT_NAME" selected="false">
            <attach file="/Admin/MenuFilterManagement/AdminMenuFilterManagementSelectList.xml"/>
        </item>
    </tabbar>
    <onloadscript>
        <call name="pageInit"/>
    </onloadscript>
    <userscript>
        <var name="$clientData">
        <![CDATA[
            {house_code:Sepoa.info.HOUSE_CODE}
        ]]>
        </var>
        <function name="pageInit" args="">
        <![CDATA[
            if(Sepoa.info.HOUSE_CODE == "000"){
                tabbarObj.tabs('CLIENT').hide();
                callFunction('AD_421_1', 'doQuery', []);
            }else{
                tabbarObj.tabs('CLIENT').setActive();
                tabbarObj.hideTabsArea();
            }
            callFunction('AD_421_2', 'doQuery', []);
        ]]>
        </function>
        
        <function name="onSelectItem" args="type, item">
        <![CDATA[
            if(type == "SERVICE"){
                tabbarObj.tabs('CLIENT').setText(item.company_name);
                tabbarObj.tabs('CLIENT').show();
                tabbarObj.tabs('CLIENT').setActive();
                $.extend($clientData, item);
                callFunction('p', 'onSelectItem', [$clientData]);
            }else{
                callFunction(['p'], 'onSelectItem', [$.extend({}, item, $clientData)]);
            }
        ]]>
        </function>
        
        <function name="onTabChange" args="id, before">
        <![CDATA[
            if(before){
                if(id == "SERVICE"){
                    tabbarObj.tabs('CLIENT').hide();
                    callFunction('p', 'onSelectItem', []);
                }else if(id == "CLIENT"){
                    callFunction('AD_023_1', 'showFirstRow', []);
                }
            }
            return true;
        ]]>
        </function>
    </userscript>
