<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_416" header="false" tpl="editor.tpl">
    <button id="btnObj">
        <btn div="mgDUHsdxpvVHsdrfCF" id="NEW" type="new" text="{AD_416.CREATE_NEW}" onclick="doNew(  )"/>
        <btn div="mgDUHsdxpvVHsdrfCF" id="DELETE" type="delete" text="{BUTTON.delete}" onclick="doDelete(  )"/>
    </button>
    <tabbar id="tabbarObj" div="IubXHsdAzTYHsdPRzn">
        <item id="BASIC" name="AD_416.TABBAR_BASIC_NAME" selected="true">
            <attach file="/Admin/ConfigManagement/AdminConfigManagementBasicInfoWrite.xml"/>
        </item>
        <item id="MODULE" name="AD_416.TABBAR_MODULE_NAME" selected="false">
            <attach file="/Admin/SystemClientManagement/AdminSystemClientManagementModule.xml"/>
        </item>
    </tabbar>
    <onloadscript>
        <call name="pageInit"/>
    </onloadscript>
    <userscript>
        <function name="pageInit" args="">
        <![CDATA[
            SUX.callEvent('onWindowResize', []);
        ]]>
        </function>
        <function name="doQuery" args="item">
        <![CDATA[
            dataOutput.setValue('CLIENT_CODE', item.client_code);
            dataOutput.setValue('COMPANY_CODE', item.company_code);
            
            setLayoutHeaderText(item);
            checkMasterCompany(item);
            
            var tabs = tabbarObj.t;
            
            for(var key in tabs) {
            	var t = tabs[key].cell;
            	var sid = getChildScreenId(t.cell);
            	
            	tabActivate(t, true);
            	callFunction(sid, 'doQuery', [item.client_code, item.company_code]); // AdminConfigManagementConfigurationWrite.xml, AdminSystemClientManagementModule.xml
            }
        ]]>
        </function>
        <function name="tabActivate" args="t, flag">
        <![CDATA[
        	if(flag == true) {
        		t.show();
        		t.enable();
        	} else {
        		t.hide();
        		t.disable();
        	}
        ]]>
        </function>
        <function name="setLayoutHeaderText" args="item">
        <![CDATA[
            var name = getOAObject('AD_411').tabbarObj.tabs('COMPANY').getText();
            
            var str = '[' + item.client_code + ' - ' + item.company_code + '] ' + name + ' - ' + item.company_name;
            callFunction(['p', 'p'], 'changeHeaderText', ['b', str]);
        ]]>
        </function>
        <function name="checkMasterCompany" args="item">
        <![CDATA[
            btnObj.btn('DELETE').setHide();
            if (item.company_code != '1000') {
                btnObj.btn('DELETE').setShow();
            }
        ]]>
        </function>
        <function name="doNew" args="">
        <![CDATA[
            PopupOpenPost('/Admin/SystemCompanyManagement/AdminSystemCompanyManagementCreateNew.sux', {}, createNewPopupCallbackFn, 350, 200, Sepoa.cache.text.get('AD_416.CREATE_NEW'));
        ]]>
        </function>
        <function name="createNewPopupCallbackFn" args="item">
        <![CDATA[
            var selectList = getOAObject('AD_413').listObj;
            
            selectList.unselectAll();
            callFunction(['p', 'p'], 'changeHeaderText', ['b', '-']);
            callFunction('AD_342_1', 'doQuery', [item.CLIENT_CODE, item.COMPANY_CODE]);
                        
            tabActivate(tabbarObj.tabs('MODULE'), false);
        ]]>
        </function>
        <function name="doDelete" args="">
        <![CDATA[
            Confirm(Sepoa.cache.text.get('MESSAGE.1015'), function(flag) {
                if (flag) {
                    doServiceAjax('sepoa.svc.admin.AD_416', 'TRANSACTION', 'doDeleteCompany', null, function(so) {
                        if (so.status != 1) {
                            Alert(Sepoa.cache.text.get('MESSAGE.1002'));
                            return;
                        }
            
                        Alert(Sepoa.cache.text.get('MESSAGE.0001'));
                        callFunction('AD_413', 'doQuery', [{
                            SERVICE_CODE: dataOutput.getValue('CLIENT_CODE')
                        }]);
                    });
                }
            });
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
    </template>
</body>