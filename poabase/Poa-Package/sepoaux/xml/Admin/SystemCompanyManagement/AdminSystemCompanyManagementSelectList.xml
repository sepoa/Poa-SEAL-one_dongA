<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_413" header="false" tpl="editor.tpl">
    <filterbar id="filterObj" div="rmzrFsdJuBsFsdnron">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <list id="listObj" div="rmzrFsdPlFsFsdrvNb">
        <type>
            <template><![CDATA[<table class=list_template width=100%><tr><td width="20%" class=listBold>#company_code#</td><td class=listRight>#company_name#</td></tr><tr class=listHidden><td colspan=2>#client_code#</td></tr></table>]]></template>
        </type>
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onItemClick" callback="onItemClick"/>
    </list>
    <onloadscript/>
    <userscript>
    	<function name="doQuery" args="item">
    	<![CDATA[
    		if(item) {
    			dataOutput.setValue('CLIENT_CODE', item.client_code || item.CLIENT_CODE);
    		}
    		dataOutput.addFilter(filterObj);
    		listObj.clearAll(false);
    		listObj.load(window.CONTEXT_NAME+'/SepoaList.sux?PROCESS_ID=sepoa.svc.admin.AD_413&mode=doList&METHOD=doQueryList'+ dataOutput.getParams());
    	]]>
    	</function>
    	
    	<function name="doQueryEnd" args="">
    	<![CDATA[
    		if(listObj.dataCount() > 0) {
				var id = listObj.first();
				listObj.show(id);
				listObj.select(id);
				onItemClick(id);
			}
    	]]>
    	</function>
    	
    	<function name="onItemClick" args="id">
    	<![CDATA[
    		var item = listObj.get(id);
    		
    		callFunction('AD_410', 'changeTab', [item]);
    	]]>
    	</function>
    	
    	<function name="onSearch" args="">
    	<![CDATA[
    		doQuery();
    	]]>
    	</function>
    </userscript>
