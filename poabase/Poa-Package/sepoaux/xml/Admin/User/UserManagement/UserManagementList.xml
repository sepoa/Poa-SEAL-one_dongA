<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_025_1" header="false" tpl="editor.tpl">
    <filterbar id="filterObj" div="OJJKiudomXSnMjqMmS">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="doQueryList"/>
    </filterbar>
    <list id="listObj" div="OJJKiudUZvSnMjqjRz">
        <type>
            <template><![CDATA[<table width=100% class=list_template><tr><td class=listBold> #user_name_loc# </td><td class=listRight listBold> #dept_name_loc# </td></tr><tr><td> #position# </td><td class=listRight> #user_id# </td></tr></table>]]></template>
        </type>
        <event type="onXLE" callback="doQueryListEnd"/>
        <event type="onItemClick" callback="doRowSelect"/>
    </list>
    <onloadscript>
        <call name="doQueryList"/>
    </onloadscript>
    <userscript>
        <function name="doQueryList" args="">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            
            var params = dataOutput.getParams();
            params += "&PROCESS_ID=sepoa.svc.admin.AD_025&METHOD=doQueryList";
            
            listObj.load('/SepoaList.sux?mode=doList' + params);
        ]]>
        </function>
        <function name="doQueryListEnd" args="">
        <![CDATA[
            if (listObj.dataCount() > 0) {
                doRowSelect(listObj.first());
                listObj.select(listObj.first());
            } else {
                callFunction('AD_025_2', 'doFormClear', []);
            }
        ]]>
        </function>
        <function name="doRowSelect" args="id">
        <![CDATA[
            var item = listObj.get(id);
            var param = [];
            
            param.push(item.house_code);
            param.push(item.user_id);
            
            callFunction('AD_025_2', 'doQueryForm', param);
        ]]>
        </function>
        <function name="doRowUnSelect" args="">
        <![CDATA[
            listObj.unselect();
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
    </template>
</body>