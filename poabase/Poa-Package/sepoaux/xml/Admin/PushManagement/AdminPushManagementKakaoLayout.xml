    </form>
    <tabbar id="tabbarObj" div="CuaEiVeCsyEiVeYwwE">
        <item id="TEMPLATE" name="AD_450_6.TABBAR_TEMPLATE_NAME" selected="true">
            <attach file="/Admin/PushManagement/AdminPushManagementKakaoWrite.xml"/>
        </item>
    </tabbar>
    <usercss>
    <![CDATA[
    	.CodeMirror {
            width: 100%;
            height: 100%;
            border: 1px solid #ddd;
        }
    ]]>
    </usercss>
    <onloadscript>
    	<call name="init" />
    </onloadscript>
    <userscript>
    	<var name="$share" value="{}"/>
        <function name="init">
        <![CDATA[
            callFunction('p', 'childScreenLoad', [{
                id:"KAKAO",
                fn:{
                    onBeforeSave:onBeforeSave,
                    doClear:doClear,
                    doRefresh: doRefresh
                }
            }])
        ]]>
        </function>
        
        <function name="onBeforeSave" args="data">
        <![CDATA[
            var vendor = formObj.getValue("KAKAO_VENDOR");
            var templateCode = formObj.getValue("KAKAO_TEMPLATE_CODE");
            
            if(!sUtils.string.isBlank(vendor)){
                data.KAKAO_VENDOR = vendor;
            }
            
            if(!sUtils.string.isBlank(templateCode)){
                data.KAKAO_TEMPLATE_CODE = templateCode;
            }
            
            $share.children.fn.onBeforeSave(data);
        ]]>
        </function>
        
        <function name="doClear">
        <![CDATA[
            formObj.clear();
            $share.children.fn.doClear();
        ]]>
        </function>
        
        <function name="childScreenLoad" args="config">
        <![CDATA[
            $share.children = config;
        ]]>
        </function>
        
        <function name="load" args="data">
        <![CDATA[
        	doClear();
            formObj.setData(data, "json");
            if(data.KAKAO_TEMPLATE){
                callFunction('AD_450_7', 'load', [data.KAKAO_TEMPLATE]);
            }
        ]]>
        </function>
        
        <function name="onButtonClick" args="id">
        <![CDATA[
        	if(id == 'KAKAO_BIZPLUS_MOVE') {
        		PopupOpenPostReal('https://www.ibizplus.co.kr/main', window.screen.width, window.screen.height, '', '', true);
        	}
        ]]>
        </function>
        
        <function name="doRefresh">
        <![CDATA[
        	$share.children.fn.doRefresh();
        ]]>
        </function>
    </userscript>
