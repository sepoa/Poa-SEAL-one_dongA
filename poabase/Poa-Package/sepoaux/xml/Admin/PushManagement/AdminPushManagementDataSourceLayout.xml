<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_450_8" header="false">
    <tabbar id="tabbarObj" div="zjpRIbeCCQSIberfHJ">
        <item id="CONTENTS" name="AD_450_8.TABBAR_CONTENTS_NAME" selected="true">
            <attach file="/Admin/PushManagement/AdminPushManagementDataSourceContentsWrite.xml"/>
        </item>
        <item id="RECEIVER" name="AD_450_8.TABBAR_RECEIVER_NAME" selected="false">
            <attach file="/Admin/PushManagement/AdminPushManagementDataSourceReceiverWrite.xml"/>
        </item>
        <event type="onTabChanged" callback="onTabChanged"/>
    </tabbar>
    <onloadscript>
        <call name="init" />
    </onloadscript>
    <userscript>
    	<var name="$share" value="{children:{}}"/>
        <function name="init">
        <![CDATA[
            callFunction('p', 'childScreenLoad', [{
                id:"DATASOURCE",
                fn:{
                    onBeforeSave:onBeforeSave,
                    doClear:doClear,
                    doRefresh: doRefresh
                }
            }])
        ]]>
        </function>
        
        <function name="onBeforeSave" args="data">
        <![CDATA[
        	data.ACTIVE_DATASOURCE_ID = tabbarObj.getActiveTab();
        	for (var i in $share.children) {
                var c = $share.children[i];
                if (c && c.fn && c.fn.onBeforeSave) {
                    c.fn.onBeforeSave(data);
                }
            }
        ]]>
        </function>
        
        <function name="doClear">
        <![CDATA[
        	for (var i in $share.children) {
                var c = $share.children[i];
                if (c && c.fn && c.fn.doClear) {
                    c.fn.doClear();
                }
            }
        ]]>
        </function>
        
        <function name="childScreenLoad" args="config">
        <![CDATA[
            $share.children[config.id] = config;
        ]]>
        </function>
        
        <function name="load" args="data">
        <![CDATA[
        	doClear();
            if(data.DATASOURCE_CONTENTS){
                callFunction('AD_450_9', 'load', [data.DATASOURCE_CONTENTS]);
            }
            
            if(data.DATASOURCE_RECEIVER) {
            	callFunction('AD_450_10', 'load', [data.DATASOURCE_RECEIVER]);
            }
        ]]>
        </function>
        
        <function name="doRefresh">
        <![CDATA[
        	for (var i in $share.children) {
                var c = $share.children[i];
                if (c && c.fn && c.fn.doRefresh) {
                    c.fn.doRefresh();
                }
            }
        ]]>
        </function>
        <function name="onTabChanged" args="id">
        <![CDATA[
            var c = $share.children[id];
            if (c && c.fn && c.fn.doRefresh) {
                c.fn.doRefresh();
            }
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
    </template>
</body>