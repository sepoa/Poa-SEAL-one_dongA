<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_450_9" header="false">
    <usercss>
    <![CDATA[
        .CodeMirror {
            width: 100%;
            height: 100%;
            border: 1px solid #ddd;
        }
    ]]>
    </usercss>
    <variable>
        <var name="codeMirrorContentsArea" value="$($sObject._vp).find('#XtMVIbeNeNVIbeQdDx')[0]"/>
        <var name="XtMVIbeNeNVIbeojub" value="$($sObject._vp).find('#XtMVIbeNeNVIbeojub')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <var name="$share" value="{}"/>
        <function name="init">
        <![CDATA[
            callFunction('p', 'childScreenLoad', [{
            	id:"CONTENTS",
                fn: {
                    onBeforeSave: onBeforeSave,
                    doClear: doClear,
                    doRefresh: doRefresh
                }
            }]);
            
            CodeMirror.commands.autocomplete = function(cm) {
                cm.showHint({
                    hint: CodeMirror.hint.html
                });
            }
            
            $share.codeObj = CodeMirror(codeMirrorContentsArea, {
                lineNumbers: true,
                theme: "default",
                viewportMargin: 0,
                indentUnit: 4,
                extraKeys: {
                    "Ctrl-Q": "toggleComment",
                    "Ctrl-Space": "autocomplete"
                },
                mode: "text/html"
            });
            
            SUX.callEvent('onWindowResize', []);
        ]]>
        </function>
        <function name="onBeforeSave" args="data">
        <![CDATA[
            var contents = $share.codeObj.getValue();
            if (!sUtils.string.isBlank(contents)) {
                data.DATASOURCE_CONTENTS = contents;
            }
        ]]>
        </function>
        <function name="doClear">
        <![CDATA[
            $share.codeObj.setValue('');
        ]]>
        </function>
        <function name="load" args="html">
        <![CDATA[
            $share.codeObj.setValue(html.replaceAll("'", "'"));
        ]]>
        </function>
        <function name="doRefresh">
        <![CDATA[
            $share.codeObj.refresh();
        ]]>
        </function>
    </userscript>
