<body screen_id="AD_450_SMS" header="false">
    <form id="formObj" div="YAWUPLggNWUfRPGtHv" form-id="file:///resource/ux/admin/form/AD_450_SMS.js"/>
    <tabbar id="tabbarObj" div="CuaEiVeCsyEiVeYwwE">
        <item id="TEMPLATE" name="AD_450_SMS.TABBAR_TEMPLATE_NAME" selected="true">
            <attach file="/Admin/PushManagement/AdminPushManagementSMSWrite.xml"/>
        </item>
    </tabbar>
    <usercss>
    <![CDATA[
        .CodeMirror {
            width: 100%;
            height: 100%;
            border: 1px solid #ddd;
        }
    ]]>
    </usercss>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <var name="$share" value="{}"/>
        <function name="init">
        <![CDATA[
            callFunction('p', 'childScreenLoad', [{
                id: "SMS",
                fn: {
                    onBeforeSave: onBeforeSave,
                    doClear: doClear,
                    doRefresh: doRefresh
                }
            }])
        ]]>
        </function>
        <function name="onBeforeSave" args="data">
        <![CDATA[
            var subject = formObj.getValue("SMS_SUBJECT");
            if(!sUtils.string.isBlank(subject)){
                data.SMS_SUBJECT = subject;
            }
            $share.children.fn.onBeforeSave(data);
        ]]>
        </function>
        <function name="doClear">
        <![CDATA[
            formObj.clear();
            $share.children.fn.doClear();
        ]]>
        </function>
        <function name="childScreenLoad" args="config">
        <![CDATA[
            $share.children = config;
        ]]>
        </function>
        <function name="load" args="data">
        <![CDATA[
            doClear();
            formObj.setData(data, "json");
            if (data.SMS_CONTENTS) {
                callFunction('AD_450_SMS_W', 'load', [data.SMS_CONTENTS]);
            }
        ]]>
        </function>
        <function name="doRefresh">
        <![CDATA[
            $share.children.fn.doRefresh();
        ]]>
        </function>
    </userscript>
