<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_450_SMS_W" header="false">
    <variable>
        <var name="codeMirrorArea" value="$($sObject._vp).find('#nKxIiVeUNyIiVeoiDN')[0]"/>
        <var name="nKxIiVeUNyIiVexgRU" value="$($sObject._vp).find('#nKxIiVeUNyIiVexgRU')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <var name="$share" value="{}"/>
        <function name="init">
        <![CDATA[
            callFunction('p', 'childScreenLoad', [{
                fn: {
                    onBeforeSave: onBeforeSave,
                    doClear: doClear,
                    doRefresh: doRefresh
                }
            }]);
            
            CodeMirror.commands.autocomplete = function(cm) {
                cm.showHint({
                    hint: CodeMirror.hint.html
                });
            }
            
            $share.codeObj = CodeMirror(codeMirrorArea, {
                lineNumbers: true,
                theme: "default",
                viewportMargin: 0,
                indentUnit: 4,
                extraKeys: {
                    "Ctrl-Q": "toggleComment",
                    "Ctrl-Space": "autocomplete"
                },
                mode: "text/html"
            });
            
            SUX.callEvent('onWindowResize', []);
        ]]>
        </function>
        <function name="onBeforeSave" args="data">
        <![CDATA[
            var contents = $share.codeObj.getValue();
            if (!sUtils.string.isBlank(contents)) {
            	contents = contents.replaceAll("\n", "\\n");
                data.SMS_CONTENTS = contents;
            }
        ]]>
        </function>
        <function name="doClear">
        <![CDATA[
            $share.codeObj.setValue('');
        ]]>
        </function>
        <function name="doRefresh" args="">
        <![CDATA[
        	$share.codeObj.refresh();
        ]]>
        </function>
        <function name="load" args="html">
        <![CDATA[
        	html = html.replaceAll("'", "'");
        	html = html.replaceAll("\\n", "\n");
            $share.codeObj.setValue(html);
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
