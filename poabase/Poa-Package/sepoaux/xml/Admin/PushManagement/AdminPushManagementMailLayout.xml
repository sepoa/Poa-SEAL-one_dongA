<body screen_id="AD_450_3" header="false">
    <form id="formObj" div="CEDJYVeoQRJYVegmrr" form-id="file:///resource/ux/admin/form/AD_450_3.js"/>
    <button id="btnObj">
        <btn div="ZrifgReERthrGbWhdO" id="UPLOAD" type="primary" text="{BASE_BUTTON.UPLOAD}" toggle="false" reverse="false" onclick="doUpload()"/>
    </button>
    <tabbar id="tabbarObj" div="UuXFqRelIjFqReXPKU">
        <item id="TEMPLATE" name="AD_450_3.TABBAR_TEMPLATE_NAME" selected="true">
            <attach file="/Admin/PushManagement/AdminPushManagementMailWrite.xml"/>
        </item>
        <item id="PREVIEW" name="AD_450_3.TABBAR_PREVIEW_NAME" selected="false">
            <attach file="/Admin/PushManagement/AdminPushManagementMailPreview.xml"/>
        </item>
    </tabbar>
    <usercss>
    <![CDATA[
        #DfoFpReDkqFpReothW {
            width: 1150px;
            height: 600px;
            margin-top: 40px;
        }
        
        .CodeMirror {
            width: 100%;
            height: 100%;
            border: 1px solid #ddd;
        }
    ]]>
    </usercss>
    <variable>
        <var name="CEDJYVeptIJYVemHcz" value="$($sObject._vp).find('#CEDJYVeptIJYVemHcz')[0]"/>
        <var name="CEDJYVeeBLJYVelfNT" value="$($sObject._vp).find('#CEDJYVeeBLJYVelfNT')[0]"/>
        <var name="CEDJYVeptIJYVeCvFx" value="$($sObject._vp).find('#CEDJYVeptIJYVeCvFx')[0]"/>
    </variable>
    <onloadscript>
        <call name="init" />
    </onloadscript>
    <userscript>
        <var name="$share" value="{}"/>
        <function name="init">
        <![CDATA[
            callFunction('p', 'childScreenLoad', [{
                id:"MAIL",
                fn:{
                    onBeforeSave:onBeforeSave,
                    doClear:doClear,
                    doRefresh: doRefresh
                }
            }])
        ]]>
        </function>
        
        <function name="onBeforeSave" args="data">
        <![CDATA[
            var subject = formObj.getValue("MAIL_SUBJECT");
            if(!sUtils.string.isBlank(subject)){
                data.MAIL_SUBJECT = subject;
            }
            $share.children.fn.onBeforeSave(data);
        ]]>
        </function>
        
        <function name="doClear">
        <![CDATA[
            formObj.clear();
            $share.children.fn.doClear();
        ]]>
        </function>
        
        <function name="childScreenLoad" args="config">
        <![CDATA[
            $share.children = config;
        ]]>
        </function>
        
        <function name="load" args="data">
        <![CDATA[
        	doClear();
            formObj.setData(data, "json");
            if(data.MAIL_CONTENTS){
                callFunction('AD_450_4', 'load', [data.MAIL_CONTENTS]);
            }
        ]]>
        </function>
    
        <function name="doUpload">
        <![CDATA[
            var input = document.createElement("input");
            input.type = "file";
            input.accept = "text/plain, text/html";
            input.onchange = function(event) {
                var fileExt = event.path[0].files[0].type;
                if (fileExt == 'text/plain' || fileExt == 'text/html') {
                    readFile(event.target.files[0]);
                }else{
                    Alert(sUtils.cache.text.get('AD_450_3.MESSAGE_0001'));
                }
                this.value="";
            };
            input.click();
        ]]>
        </function>
        <function name="readFile" args="file">
        <![CDATA[
            var reader = new FileReader();
            reader.onload = function() {
                callFunction('AD_450_4', 'load', [this.result]);
            };
            reader.readAsText(file, "UTF-8");
        ]]>
        </function>
        <function name="doRefresh">
        <![CDATA[
        	$share.children.fn.doRefresh();
        ]]>
        </function>
    </userscript>
