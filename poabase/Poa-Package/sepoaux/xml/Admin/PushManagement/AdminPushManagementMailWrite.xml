<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_450_4" header="false">
    <variable>
        <var name="codeMirrorArea" value="$($sObject._vp).find('#cPMWsReuIZWsReTFHN')[0]"/>
        <var name="cPMWsReuIZWsReXwvr" value="$($sObject._vp).find('#cPMWsReuIZWsReXwvr')[0]"/>
    </variable>
    <onloadscript>
        <call name="init" />
    </onloadscript>
    <userscript>
        <var name="$share" value="{}"/>
        <function name="init">
        <![CDATA[
            callFunction('p', 'childScreenLoad', [{
                fn:{
                    onBeforeSave:onBeforeSave,
                    doClear:doClear,
                    doRefresh:doRefresh
                }
            }]);
            
            CodeMirror.commands.autocomplete = function(cm) {
                cm.showHint({
                    hint: CodeMirror.hint.html
                });
            }
            
            $share.codeObj = CodeMirror(codeMirrorArea, {
                lineNumbers: true,
                theme: "default",
                viewportMargin: 0,
                indentUnit: 4,
                extraKeys: {
                    "Ctrl-Q": "toggleComment",
                    "Ctrl-Space": "autocomplete"
                },
                mode: "text/html"
            });
            
            $share.codeObj.on("change", function(obj, e) {
                callFunction('AD_450_5', 'load', [$share.codeObj.getValue()]);
            });
            
            SUX.callEvent('onWindowResize', []);
        ]]>
        </function>
        
        <function name="onBeforeSave" args="data">
        <![CDATA[
            var contents = $share.codeObj.getValue();
            if(!sUtils.string.isBlank(contents)){
                data.MAIL_CONTENTS = contents;
            }
        ]]>
        </function>
        
        <function name="doClear">
        <![CDATA[
            $share.codeObj.setValue('');
        ]]>
        </function>
        
        <function name="load" args="html">
        <![CDATA[
            $share.codeObj.setValue(html.replaceAll("'", "'"));
        ]]>
        </function>
        
        <function name="doRefresh">
        <![CDATA[
        	$share.codeObj.refresh();
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
