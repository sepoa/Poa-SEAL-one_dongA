<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_452" header="false">
    <form id="formObj" div="NpxBpRexBzBpReUIcV" form-id="file:///resource/ux/admin/form/AD_450.js"/>
    <button id="btnObj">
        <btn div="ZrifgReERthrGbWhdO" id="NEW" type="new" text="신규" onclick="onButtonClick( 'NEW' )"/>
        <btn div="ZrifgReERthrGbWhdO" id="SAVE" type="save" text="저장" onclick="onButtonClick( 'SAVE' )"/>
        <btn div="ZrifgReERthrGbWhdO" id="DELETE" type="delete" text="삭제" onclick="onButtonClick( 'DELETE' )"/>
        <btn div="ZrifgReERthrGbWhdO" id="업로드" type="default" text="업로드" onclick="onButtonClick( 'UPLOAD' )"/>
    </button>
    <tabbar id="tabbarObj" div="UuXFqRelIjFqReXPKU">
        <item id="WRITE" name="AD_452.TABBAR_WRITE_NAME" selected="true">
            <attach file="/Admin/MailTemplateManagement/AdminMailTemplateManagementTabbarWrite.xml"/>
        </item>
        <item id="PREVIEW" name="AD_452.TABBAR_PREVIEW_NAME" selected="false">
            <attach file="/Admin/MailTemplateManagement/AdminMailTemplateManagementTabbarPreview.xml"/>
        </item>
    </tabbar>
    <usercss>
    <![CDATA[
        #DfoFpReDkqFpReothW {
            width: 1150px;
            height: 600px;
            margin-top: 40px;
        }
        
        .CodeMirror {
            width: 100%;
            height: 100%;
            border: 1px solid #ddd;
        }
    ]]>
    </usercss>
    <variable>
        <var name="formBox" value="$($sObject._vp).find('#SsifgReDxTpgReGGlV')[0]"/>
        <var name="SsifgRekaYpgReHxbK" value="$($sObject._vp).find('#SsifgRekaYpgReHxbK')[0]"/>
        <var name="SsifgReDxTpgRedTtP" value="$($sObject._vp).find('#SsifgReDxTpgRedTtP')[0]"/>
    </variable>
    <onloadscript/>
    <userscript>
        <function name="onButtonClick" args="id">
        <![CDATA[
            if (id == 'SAVE') {
                doSave();
            } else if (id == 'DELETE') {
                doDelete();
            } else if (id == 'UPLOAD') {
                doUpload();
            } else if(id == 'NEW'){
                doNew();
            }
        ]]>
        </function>
        <function name="doQuery" args="templateCode">
        <![CDATA[
            dataOutput.setValue('TEMPLATE_CODE', templateCode);
            doServiceAjax('sepoa.svc.admin.AD_450', 'CONNECTION', 'doQuery', null, function(so) {
                if (so.status != 1) {
                    Alert(so.message);
                    return;
                }
                var sf = new SepoaFormater(so.result[0]);
            
                if (sf.getRowCount() > 0) {
                    for (var idx = 0; idx < sf.getRowCount(); idx++) {
                        formObj.setValue('TEMPLATE_CODE', sf.getValue('TEMPLATE_CODE'));
                        formObj.setValue('DESCRIPTION', sf.getValue('DESCRIPTION'));
            
                        callFunction('AD_453', 'setCmData', [sf.getValue('HTML')]);
                        callFunction('AD_454', 'setFrameCode', [sf.getValue('HTML')]);
                    }
                }
            }, false);
        ]]>
        </function>
        <function name="doNew">
        <![CDATA[
            formObj.clear();
            callFunction('AD_453', 'clearCmData', []);
        ]]>
        </function>
        <function name="doSave">
        <![CDATA[
            var templateCode = formObj.getValue('TEMPLATE_CODE');
            
            if(templateCode == '' || templateCode == null){
                Alert('템플릿 코드를 입력해주세요 (다국어지정필요)');
                return;
            }
            
            Confirm(Sepoa.cache.text.get('MESSAGE.1018'), function(result) {
                if(result) {
                    var description = formObj.getValue('DESCRIPTION');
                    var codeValue = callFunction('AD_453', 'getCmData', []);
                    dataOutput.setValue('HTML', codeValue);
                    dataOutput.setValue('TEMPLATE_CODE', templateCode);
                    dataOutput.setValue('DESCRIPTION', description);
                    
                    doServiceAjax("sepoa.svc.admin.AD_450", "TRANSACTION", "doSave", null, function(so) {
                        if (so.status == "1") {
                            Message(Sepoa.cache.text.get("MESSAGE.0001"));
                    
                            callFunction('AD_451', 'doQuery', []);
                        } else {
                            Alert(so.message);
                        }
                    });
                }
            });
        ]]>
        </function>
        <function name="doDelete">
        <![CDATA[
            Confirm(Sepoa.cache.text.get("MESSAGE.1015"), function(result){
                if(result) {
                    var templateCode = formObj.getValue('TEMPLATE_CODE');
                    dataOutput.setValue('TEMPLATE_CODE', templateCode);
                    doServiceAjax("sepoa.svc.admin.AD_450", "TRANSACTION", "doDelete", null, function(so) {
                        if (so.status == "1") {
                            Alert(Sepoa.cache.text.get("MESSAGE.0001"));
                    
                            callFunction('AD_451', 'doQuery', []);
                        } else {
                            Alert(so.message);
                        }
                    });
                }
            });
        ]]>
        </function>
        <function name="doUpload">
        <![CDATA[
            var input = document.createElement("input");
            input.type = "file";
            input.accept = "text/plain, text/html"; 
            input.onchange = function (event) {
                var fileExt = event.path[0].files[0].type;
                if(fileExt == 'text/plain' || fileExt == 'text/html'){
                    readFile(event.target.files[0]);
                }
            };
            input.click();
        ]]>
        </function>
        
        <function name="readFile" args="file">
        <![CDATA[
            var reader = new FileReader();
            reader.onload = function () {
                callFunction('AD_453', 'clearCmData', []);
                callFunction('AD_453', 'setCmData', [reader.result]);
                callFunction('AD_454', 'setFrameCode', [reader.result]);
            };
             reader.readAsText(file, "UTF-8");
        ]]>
        </function>
    </userscript>
