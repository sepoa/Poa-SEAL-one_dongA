<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_451" header="false">
    <filterbar id="filterObj" div="ZrifgRedWfhrGbDwCt">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="doQuery"/>
    </filterbar>
    <list id="listObj" div="ZrifgRegWghrGbiSTO">
        <type>
            <template><![CDATA[<table width=100% class=sepoa_list_design><tr><td class=sepoa_list_font_bold>#template_code#</td></tr><tr><td class=\"sepoa_list_primary sepoa_list_align_right\"></td></tr></table>]]></template>
        </type>
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onItemClick" callback="onItemClick"/>
    </list>
    <onloadscript>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <function name="doQuery">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            listObj.load(window.CONTEXT_NAME + '/SepoaList.sux?PROCESS_ID=sepoa.svc.admin.AD_450&mode=doList' + dataOutput.getParams());
            listObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="">
        <![CDATA[
            if (listObj.dataCount() > 0) {
                var id = listObj.first();
                listObj.select(id);
                listObj.show(id);
                onItemClick(id);
            }
        ]]>
        </function>
        <function name="onItemClick" args="id, ev, html">
        <![CDATA[
            var item = listObj.get(id);
            callFunction('AD_452', 'doQuery', [item.template_code]);
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
    </template>
</body>