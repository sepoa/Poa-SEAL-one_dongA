<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_453" header="false">
    <variable>
        <var name="codeMirrorArea" value="$($sObject._vp).find('#cPMWsReuIZWsReTFHN')[0]"/>
        <var name="cPMWsReuIZWsReXwvr" value="$($sObject._vp).find('#cPMWsReuIZWsReXwvr')[0]"/>
    </variable>
    <onloadscript>
        <call name="pageInit"/>
    </onloadscript>
    <userscript>
        <var name="formObj_S"/>
        <var name="codeObj" value="{}"/>
        <function name="pageInit">
        <![CDATA[
            CodeMirror.commands.autocomplete = function(cm) {
                cm.showHint({
                    hint: CodeMirror.hint.javascript
                });
            }
            
            var codeMode = "text/html"
            
            formObj_S = $sObject.formObj_S = new SepoaMultiDhtmlXFormObject(codeMirrorArea, 'formObj_S', []);
            
            codeObj = $sObject.codeObj = CodeMirror(codeMirrorArea, {
                lineNumbers: true,
                theme: "default",
                viewportMargin: 0,
                indentUnit: 4,
                extraKeys: {
                    "Ctrl-Q": "toggleComment",
                    "Ctrl-Space": "autocomplete"
                },
                mode: codeMode
            });
            
            codeObj.on("change", function(obj, e) {
                callFunction('AD_454', 'setFrameCode', [codeObj.getValue()]);
            });
            
            SUX.callEvent('onWindowResize', []);
        ]]>
        </function>
        <function name="setCmData" args="html">
        <![CDATA[
            codeObj.setValue(html.replaceAll("'", "'"));
        ]]>
        </function>
        <function name="getCmData">
        <![CDATA[
            var codeValue = codeObj.getValue();
            
            return codeValue;
        ]]>
        </function>
        <function name="clearCmData">
        <![CDATA[
            codeObj.setValue('');
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
