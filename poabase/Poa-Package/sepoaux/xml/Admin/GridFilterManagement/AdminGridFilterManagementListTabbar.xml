<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_023_T" header="false" tpl="editor.tpl">
    <tabbar id="tabbarObj" div="WSKbVudFPMbVudNlXq">
        <item id="CLIENT" name="AD_023_T.TABBAR_CLIENT_NAME" selected="true">
            <attach file="/Admin/GridFilterManagement/AdminGridFilterManagementClientList.xml"/>
        </item>
        <item id="GRID" name="" selected="false">
            <attach file="/Admin/GridFilterManagement/AdminGridFilterManagementList.xml"/>
        </item>
        <event type="onSelect" callback="onTabChange" />
    </tabbar>
    <onloadscript>
    	<call name="pageInit"/>
    </onloadscript>
    <userscript>
        <var name="$clientData">
        <![CDATA[
            {house_code:Sepoa.info.HOUSE_CODE}
        ]]>
        </var>
    	<function name="pageInit" args="">
        <![CDATA[
            if(Sepoa.info.HOUSE_CODE == "000"){
                tabbarObj.tabs('GRID').hide();
                callFunction('AD_023_3', 'doQuery', []);
            }else{
                tabbarObj.tabs('GRID').setActive();
                tabbarObj.hideTabsArea();
            }
        ]]>
        </function>
        <function name="onSelectItem" args="type, item">
        <![CDATA[
            if(type == "CLIENT"){
                tabbarObj.tabs('GRID').setText(item.company_name);
                tabbarObj.tabs('GRID').show();
                tabbarObj.tabs('GRID').setActive();
                $.extend($clientData, item);
                callFunction('p', 'onSelectItem', [$clientData]);
            }else{
                callFunction(['p'], 'onSelectItem', [$.extend({}, item, $clientData)]);
            }
        ]]>
        </function>
        <function name="onTabChange" args="id, before">
        <![CDATA[
            if(before){
                if(id == "CLIENT"){
                    tabbarObj.tabs('GRID').hide();
                    callFunction('p', 'onSelectItem', []);
                }else if(id == "GRID"){
                    callFunction('AD_023_1', 'doQuery', []);
                }
            }
            return true;
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
    </template>
</body>