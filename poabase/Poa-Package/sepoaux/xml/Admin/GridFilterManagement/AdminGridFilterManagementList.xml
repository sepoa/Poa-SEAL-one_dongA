            listObj.load(window.CONTEXT_NAME + '/SepoaList.sux?PROCESS_ID=sepoa.svc.admin.AD_023&mode=doList' + dataOutput.getParams());
            listObj.clearAll(false);
        ]]>
        </function>
        <function name="onItemClick" args="id, ev, html">
