<body screen_id="AD_036_1" header="false" tpl="editor.tpl">
    <filterbar id="filterObj" div="PggrvUbEwMoXajdodL">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="doQuery"/>
    </filterbar>
    <list id="listObj" div="OggrvUbsiwhXajdpuX">
        <type>
            <template><![CDATA[<table width=100% class=list_template><tr><td class=listBold>#process_id#</td><td class=\"listColorR listRight\">#description#</td></tr><tr><td colspan=2 class=\"listColorB listRight\"></td></tr></table>]]></template>
        </type>
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onItemClick" callback="doRowSelect"/>
    </list>
    <onloadscript>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <var name="doRowSelectFlag"/>
        <function name="doQuery" args="flag">
        <![CDATA[
            doRowSelectFlag = flag;
            dataOutput.addFilter(filterObj);
            listObj.load(window.CONTEXT_NAME + '/SepoaList.sux?PROCESS_ID=sepoa.svc.admin.AD_036_1&mode=doList'+ dataOutput.getParams());
            listObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="flag">
        <![CDATA[
            if(listObj.dataCount() > 0 && !doRowSelectFlag){
                var id = listObj.idByIndex(0);
                listObj.select(id);
                listObj.show(id);
                doRowSelect(id);
            }
        ]]>
        </function>
        <function name="doRowSelect" args="id, ev, html">
        <![CDATA[
            callFunction('AD_036_3','doQuery', [listObj.get(id).process_id]);
        ]]>
        </function>
    </userscript>
