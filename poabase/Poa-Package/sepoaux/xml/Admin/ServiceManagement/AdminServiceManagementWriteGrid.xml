<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_036_3" header="false">
    <filterbar id="filterObj" div="RhgrvUboyHJfajdUNx">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <button id="layoutBtnObj">
        <btn div="ShgrvUbUyyPfajdfwd" id="new" type="new" text="{BUTTON.new}" toggle="false" reverse="false" onclick="doNew(  )"/>
        <btn div="ShgrvUbUyyPfajdfwd" id="add" type="add" text="{BUTTON.add}" toggle="false" reverse="false" onclick="addRow(  )"/>
        <btn div="ShgrvUbUyyPfajdfwd" id="delete" type="delete" text="{BUTTON.delete}" toggle="false" reverse="false" onclick="doDelete(  )"/>
        <btn div="ShgrvUbUyyPfajdfwd" id="copy" text="{BUTTON.copy}" toggle="false" reverse="false" onclick="addRow( &#39;copy&#39; )"/>
        <btn div="ShgrvUbUyyPfajdfwd" id="save" type="save" text="{BUTTON.save}" toggle="false" reverse="false" onclick="doSave(  )"/>
    </button>
    <grid id="gridObj" div="RhgrvUbwjCIfajdihT" grid-id="file:///resource/ux/admin/grid/AD_036.js" drag="false" merge="false" dynamic="false">
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onTXE" callback="doSaveEnd_grid"/>
        <event type="onEditCell" callback="onEditCell"/>
    </grid>
    <variable>
        <var name="xNcuvUbjYeuvUbccaX" value="$($sObject._vp).find('#xNcuvUbjYeuvUbccaX')[0]"/>
        <var name="xNcuvUbVhguvUbOdSm" value="$($sObject._vp).find('#xNcuvUbVhguvUbOdSm')[0]"/>
        <var name="xNcuvUbjYeuvUbegPJ" value="$($sObject._vp).find('#xNcuvUbjYeuvUbegPJ')[0]"/>
    </variable>
    <onloadscript/>
    <userscript>
        <function name="onSearch" args="">
        <![CDATA[
            doQuery();
        ]]>
        </function>
        <function name="doQuery" args="pro_id">
        <![CDATA[
            if (pro_id) {
                dataOutput.setValue('PROCESS_ID', pro_id);
            }
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.admin.AD_036_3']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="obj, rowCnt">
        <![CDATA[
            var msg = obj.getUserData("", "message");
            var status = obj.getUserData("", "status");
            if (status == "true") {
                var data = gridObj.serializeToTextArea();
                callFunction('AD_036_4', 'setTextArea', [data]);
            }
        ]]>
        </function>
        <function name="doNew" args="">
        <![CDATA[
            gridObj.clearAll(false);
            callFunction('AD_036_4', 'setTextArea', ['']);
            dataOutput.remove('PROCESS_ID');
        ]]>
        </function>
        <function name="doSaveTextArea" args="data">
        <![CDATA[
            gridObj.clearAll(false);
            var row = data.split('\n');
            for (var _idx in row) {
                var col = row[_idx].split('\t');
                if (col.length < 4) {
                    continue;
                }
                var maxRowId = gridObj.getRowsNum() + 1;
                gridObj.addRow(maxRowId, '', gridObj.getRowsNum());
                gridObj.cells(maxRowId, gridObj.getColIndexById('SELECTED')).setValue("1");
                gridObj.cells(maxRowId, gridObj.getColIndexById('PROCESS_ID')).setValue(col[0]);
                gridObj.cells(maxRowId, gridObj.getColIndexById('METHOD')).setValue(col[1]);
                gridObj.cells(maxRowId, gridObj.getColIndexById('SERVICE_CLASS')).setValue(col[2]);
                gridObj.cells(maxRowId, gridObj.getColIndexById('DESCRIPTION')).setValue(col[3]);
            }
            doSave();
        ]]>
        </function>
        <function name="addRow" args="mode">
        <![CDATA[
            var maxRowId = new Date().getTime() + '' + dhx4.newId();;
            if (mode == 'copy') {
                var selectedRow = gridObj.getGridChangedRows("SELECTED");
                if (selectedRow.length < 1) {
                    Alert(Sepoa.cache.text.get('MESSAGE.9999'));
                }
                for (var i = 0; i < selectedRow.length; i++) {
                    gridObj.addRow(maxRowId, '', gridObj.getRowsNum());
                    gridObj.copyRowContent(selectedRow[i], maxRowId);
                    gridObj.cells(maxRowId, gridObj.getColIndexById('SAVED')).setValue("");
                    gridObj.cells(maxRowId++, gridObj.getColIndexById('SELECTED')).setValue("1");
                }
            } else {
                gridObj.addRow(maxRowId, '', 0);
                gridObj.cells(maxRowId, gridObj.getColIndexById('SELECTED')).setValue("1");
                if (gridObj.getRowsNum() > 1) {
                    var sc = gridObj.cells(gridObj.getRowId(gridObj.getRowsNum() - 1), gridObj.getColIndexById('SERVICE_CLASS')).getValue();
                    var po = gridObj.cells(gridObj.getRowId(gridObj.getRowsNum() - 1), gridObj.getColIndexById('PROCESS_ID')).getValue();
                    gridObj.cells(maxRowId, gridObj.getColIndexById('SERVICE_CLASS')).setValue(sc);
                    gridObj.cells(maxRowId, gridObj.getColIndexById('PROCESS_ID')).setValue(po);
                }
            }
        ]]>
        </function>
        <function name="doDelete" args="">
        <![CDATA[
            var selectedRow = gridObj.getGridChangedRows("SELECTED");
            for (var i = selectedRow.length - 1; i >= 0; i--) {
                var a = gridObj.cells(selectedRow[i], gridObj.getColIndexById('PROCESS_ID')).getValue();
                if (a == "") {
                    gridObj.deleteRow(selectedRow[i]);
                }
            }
            if (gridObj.getGridChangedRows("SELECTED").length > 0 && Confirm(Sepoa.cache.text.get('MESSAGE.1015'), function(result) {
                    if (result) {
                        gridObj.editStop();
                        gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.admin.AD_036_3', 'METHOD=doDelete'], 'SELECTED');
                    }
                }));
        ]]>
        </function>
        <function name="doSave" args="">
        <![CDATA[
            if (!gridObj.validate('SELECTED')) {
                Alert(Sepoa.cache.text.get('MESSAGE.0003'));
                return;
            }
            Confirm(Sepoa.cache.text.get('MESSAGE.1018'), function(result) {
                if (result) {
                    gridObj.editStop();
                    gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.admin.AD_036_3'], 'SELECTED');
                }
            });
        ]]>
        </function>
        <function name="doSaveEnd_grid" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if (status == 'true') {
                Alert(message);
                callFunction('AD_036_1', 'doQuery', [true]);
                doQuery();
            } else {
                Alert(message);
            }
        ]]>
        </function>
        <function name="onEditCell" args="stage, rId, cInd, nValue, oValue">
        <![CDATA[
            var header = gridObj.getColumnId(cInd);
            if (stage == 0) {
                return true;
            } else if (stage == 1) {
                return true;
            } else if (stage == 2) {
                var gId = gridObj.cells(rId, gridObj.getColIndexById('PROCESS_ID')).getValue();
                if (gId != '') {
                    dataOutput.setValue('PROCESS_ID', gId);
                }
                return true;
            }
            return false;
        ]]>
        </function>
    </userscript>
