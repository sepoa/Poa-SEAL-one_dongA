<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_122" header="false">
    <button id="btnObj">
        <btn div="JluDlIeeEiElIeCnVI" id="CLEAR" type="default" text="{BUTTON.clear}" toggle="false" reverse="false" onclick="doSave(false)"/>
        <btn div="JluDlIeeEiElIeCnVI" id="SAVE" type="save" text="{BUTTON.save}" toggle="false" reverse="false" onclick="doSave(true)"/>
    </button>
    <form id="formObj" div="JluDlIebozElIeiehf" form-id="file:///resource/ux/admin/form/AD_122.js"/>
    <onloadscript>
    	<call name="pageInit" args=""/>
    </onloadscript>
    <userscript>
    	<function name="pageInit" args="">
    	<![CDATA[
    		var selectedValue = Sepoa.params.selectedValue;
    		
    		if(selectedValue) {
    			var inequality = selectedValue.split(',')[0];
    			var value = selectedValue.split(',')[1];
    			
    			formObj.setValue('INEQUALITY_TYPE', inequality);
    			formObj.setValue('VALUE', value);
    		}
    	]]>
    	</function>
    	<function name="doSave" args="flag">
    	<![CDATA[
    		if(flag) {
    			if(!formObj.validate()) {
	    			Alert(Sepoa.cache.text.get('MESSAGE.0002'));
	    			return;
	    		}
    		}
    		
    		if(Sepoa.params.callback) {
    			var data = {};
    			if(flag) {
    				data = $.extend(true, data, formObj.getFormData());
    				
    				var combo = formObj.getCombo('INEQUALITY_TYPE');
    				var text = combo.options[combo.selectedIndex].text;
    				
    				data.INEQUALITY_TYPE_STR = text;
    			} else {
    				data = void 0;
    			}
    			
    			Sepoa.params.callback.apply(null, [data, Sepoa.params]);
    		}
    		
    		selfObj.close();
    	]]>
    	</function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
    </template>
</body>