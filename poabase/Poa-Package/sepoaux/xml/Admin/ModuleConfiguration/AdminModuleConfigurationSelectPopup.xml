<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_121" header="false">
    <link>
    <![CDATA[
        <script type="text/javascript">
            Sepoa.cache.text.load([{
                    url: CONTEXT_NAME + '/resource/ux/admin/langs/' + Sepoa.info.LANGUAGE + '/AD_121.js',
                    def: CONTEXT_NAME + '/resource/ux/admin/langs/KO/AD_121.js'
                },
                {
                    url: CONTEXT_NAME + '/resource/ux/admin/langs/' + Sepoa.info.LANGUAGE + '/POA_BASE.js',
                    def: CONTEXT_NAME + '/resource/ux/admin/langs/KO/POA_BASE.js'
                }
            ]);
        </script>
    ]]>
    </link>
    <filterbar id="filterObj" div="pbSJiGeYWSNiGebGta">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="doQuery"/>
    </filterbar>
    <button id="btnObj">
        <btn div="vnpKwGeVBMLwGeKJZM" id="CLEAR" type="default" text="{BUTTON.clear}" toggle="false" reverse="false" onclick="doClear(  )"/>
        <btn div="vnpKwGeVBMLwGeKJZM" id="SAVE" type="save" text="{BUTTON.save}" toggle="false" reverse="false" onclick="doSave(  )"/>
    </button>
    <grid id="gridObj" div="pbSJiGeTLoMiGeFswb" grid-id="file:///resource/ux/admin/grid/AD_121.js" drag="false" merge="false" dynamic="false">
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onRowSelect" callback="doRowSelect"/>
    </grid>
    <variable>
        <var name="vnpKwGeMYrKwGeELHC" value="$($sObject._vp).find('#vnpKwGeMYrKwGeELHC')[0]"/>
        <var name="vnpKwGexwJLwGePuJJ" value="$($sObject._vp).find('#vnpKwGexwJLwGePuJJ')[0]"/>
        <var name="vnpKwGeLYrKwGeyJpv" value="$($sObject._vp).find('#vnpKwGeLYrKwGeyJpv')[0]"/>
    </variable>
    <onloadscript>
        <call name="pageInit"/>
    </onloadscript>
    <userscript>
        <var name="callbackFn"/>
        <var name="selectedValue"/>
        <function name="pageInit" args="">
        <![CDATA[
            if (!Sepoa.params.isPopup) return;
            
            if (Sepoa.params.callback) {
                callbackFn = Sepoa.params.callback;
            }
            
            if (Sepoa.params.selectedValue) {
                selectedValue = Sepoa.params.selectedValue;
            }
            
            doQuery();
        ]]>
        </function>
        <function name="doQuery" args="">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            
            var params = [];
            params.push('mode=doTreeGridQuery');
            params.push('PROCESS_ID=sepoa.svc.admin.AD_121');
            params.push('METHOD=doTreeGridQuery');
            gridObj.postConnection('/SepoaGrid.sux', params);
        ]]>
        </function>
        <function name="doQueryEnd" args="">
        <![CDATA[
            if (gridObj.getRowsNum() == 0) {
                return;
            }
            
            gridObj.expandAll();
            
            if (selectedValue) {
                var values = selectedValue.split(',');
                var count = gridObj.getRowsNum()
                for (var i = 0; i < count; i++) {
                    var rID = gridObj.getRowId(i);
                    var item = gridObj.getRowDataObject(rID);
            
                    if (values.indexOf(item.MODULE) + 1) {
                        var chCell = gridObj.cells(rID, gridObj.getColIndexById('SELECTED'));
                        chCell.setChecked(true);
                    }
                }
            }
        ]]>
        </function>
        <function name="doRowSelect" args="rID, cIn">
        <![CDATA[
            var header = gridObj.getColumnId(cIn);
            
            if (header != 'SELECTED') {
                var chCell = gridObj.cells(rID, gridObj.getColIndexById('SELECTED'));
                chCell.setChecked(!chCell.isChecked());
            }
        ]]>
        </function>
        <function name="doSave" args="">
        <![CDATA[
            var selectRowIDS = gridObj.getSelectedRows('SELECTED');
            var returnArray = [];
            
            for (var idx in selectRowIDS) {
                var rID = selectRowIDS[idx];
                returnArray.push(gridObj.getRowDataObject(rID).MODULE);
            }
            
            if (callbackFn) {
                callbackFn.apply(this, [Sepoa.params.target, returnArray.join(','), Sepoa.params.customParam]);
                selfObj.close();
            }
        ]]>
        </function>
        <function name="doClear" args="">
        <![CDATA[
            if (callbackFn) {
                callbackFn.apply(this, [Sepoa.params.target, '', Sepoa.params.customParam]);
                selfObj.close();
            }
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
    </template>
</body>