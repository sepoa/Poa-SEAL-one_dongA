<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_401" header="false">
    <filterbar id="filterObj" div="cOUTXrdJMVTXrdQhNo">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="doQuery"/>
    </filterbar>
    <button id="btnObj">
        <btn div="mXIHzAefHaHzAeiXsq" id="NEW_CLIENT" type="icon" img="xi-plus" position="left" toggle="false" reverse="false" onclick="addClient(  )"/>
    </button>
    <list id="listObj" div="BJpOXrdvftOXrdUZPc">
        <type>
            <template><![CDATA[<table class=sepoa_list_design><tr><td class=sepoa_list_font_bold>#client_code#</td><td class=sepoa_list_align_right>#company_name#</td></tr></table>]]></template>
        </type>
        <event type="onItemClick" callback="onItemClick"/>
        <event type="onXLE" callback="doQueryEnd"/>
    </list>
    <usercss>
    <![CDATA[
        .client-manager-new-client {
            width: 100%;
            font-weight: bold;
            text-align: center;
        }
    ]]>
    </usercss>
    <variable>
        <var name="mXIHzAeMmJHzAeLTH" value="$($sObject._vp).find('#mXIHzAeMmJHzAeLTH')[0]"/>
        <var name="mXIHzAelhPHzAeXNPA" value="$($sObject._vp).find('#mXIHzAelhPHzAeXNPA')[0]"/>
        <var name="mXIHzAeLmJHzAexsUp" value="$($sObject._vp).find('#mXIHzAeLmJHzAexsUp')[0]"/>
    </variable>
    <onloadscript>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <function name="doQuery" args="">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            listObj.clearAll(false);
            listObj.load(window.CONTEXT_NAME + '/SepoaList.sux?PROCESS_ID=sepoa.svc.admin.AD_401&mode=doList&METHOD=doQuery' + dataOutput.getParams());
        ]]>
        </function>
        <function name="doQueryEnd" args="">
        <![CDATA[
            if (listObj.dataCount() > 0) {
                var id = "0";
                listObj.select(id);
                listObj.show(id);
                onItemClick(id);
            }
        ]]>
        </function>
        <function name="onItemClick" args="id">
        <![CDATA[
            if (id != 9999999) {
                var item = listObj.get(id);
                callFunction('p', 'changeHeaderText', ['b', sUtils.string.dataReplacer("[$.{client_code}] $.{company_name}", item)]);
                callFunction('AD_402', 'doQuery', [item.client_code, item.company_code]);
            }
        ]]>
        </function>
        <function name="addClient" args="">
        <![CDATA[
            callFunction('AD_402', 'doNew', []);
        ]]>
        </function>
        <function name="listUnselectAll" args="">
        <![CDATA[
            callFunction('p', 'changeHeaderText', ['b', sUtils.cache.text.get('AD_401.ADD_NEW_CLIENT')]);
            listObj.unselectAll();
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
    </template>
</body>