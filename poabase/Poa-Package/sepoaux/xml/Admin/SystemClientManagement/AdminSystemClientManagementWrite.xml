<body screen_id="AD_402" header="false">
    <tabbar id="tabbarObj" div="hmrOXrdndEPXrdQWPu">
        <item id="BASIC" name="AD_402.TABBAR_BASIC_NAME" selected="true">
            <attach file="/Admin/SystemClientManagement/AdminSystemClientManagementBasic.xml"/>
        </item>
        <item id="MODULE" name="AD_402.TABBAR_MODULE_NAME" selected="false">
            <attach file="/Admin/SystemClientManagement/AdminSystemClientManagementModule.xml"/>
        </item>
        <item id="DESIGN" name="AD_402.TABBAR_DESIGN_NAME" selected="false">
            <attach file="/Admin/SystemClientManagement/AdminSystemClientManagementDesign.xml"/>
        </item>
        <item id="NOTIFICATION" name="AD_402.TABBAR_NOTIFICATION_NAME" selected="false">
            <attach file="/Admin/SystemClientManagement/AdminSystemClientManagementNotification.xml"/>
        </item>
    </tabbar>
    <onloadscript/>
    <userscript>
        <function name="doQuery" args="clientCode, companyCode">
        <![CDATA[
            dataOutput.setValue('CLIENT_CODE', clientCode);
            
            if (!companyCode) {
                var basicSID = getChildScreenId(tabbarObj.tabs('BASIC').cell);
                callFunction(basicSID, 'doQuery', [clientCode, '1000']);
                return;
            }
            
            var tabs = tabbarObj.t;
            
            for (var key in tabs) {
                var t = tabs[key].cell;
                var sid = getChildScreenId(t.cell);
            
                tabActivate(t, true);
                callFunction(sid, 'doQuery', [clientCode, companyCode]);
            }
        ]]>
        </function>
        <function name="tabActivate" args="t, flag">
        <![CDATA[
            if (flag == true) {
                t.show();
                t.enable();
            } else {
                t.hide();
                t.disable();
            }
        ]]>
        </function>
        <function name="doDelete" args="">
        <![CDATA[
            Confirm(Sepoa.cache.text.get('MESSAGE.1015'), function(flag) {
                if (flag) {
                    ConfirmE(Sepoa.cache.text.get('AD_402.CLIENT_DELETE_CONFIRM'), function(confirmFlag) {
                        if (confirmFlag) {
                            doServiceAjax('sepoa.svc.admin.AD_402', 'TRANSACTION', 'doDeleteService', null, function(so) {
                                if (so.status != 1) {
                                    Alert(Sepoa.cache.text.get('MESSAGE.1002'));
                                    return;
                                }
            
                                Alert(Sepoa.cache.text.get('MESSAGE.0001'));
            
                                callFunction('AD_401', 'doQuery', []);
                            })
                        }
                    })
                }
            });
        ]]>
        </function>
        <function name="doNew" args="">
        <![CDATA[
            callFunction('AD_405', 'createNew', []);
        ]]>
        </function>
    </userscript>
