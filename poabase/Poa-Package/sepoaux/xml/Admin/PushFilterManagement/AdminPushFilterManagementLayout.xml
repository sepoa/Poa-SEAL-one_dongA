<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_462" header="false">
	<link>
    <![CDATA[
        <script type="text/javascript">
            sUtils.cache.text.load({
                url: CONTEXT_NAME + '/resource/ux/admin/langs/' + Sepoa.info.LANGUAGE + '/AD_450.js',
                def: CONTEXT_NAME + '/resource/ux/admin/langs/KO/AD_450.js'
            });
        </script>
    ]]>
    </link>
    <form id="formObj" div="RFQiWVeOaXjWVefHwU" form-id="file:///resource/ux/admin/form/AD_450.js"/>
    <button id="btnObj">
        <btn div="YwHnXVeWrRnXVeRfdN" id="DELETE" type="delete" text="{BASE_BUTTON.CLEAR}" toggle="false" reverse="false" onclick="doDelete(  )"/>
        <btn div="YwHnXVeWrRnXVeRfdN" id="SAVE" type="save" text="{BASE_BUTTON.SAVE}" toggle="false" reverse="false" onclick="doSave(  )"/>
    </button>
    <tabbar id="tabbarObj" div="vLfaWVeLvnaWVeKorr">
    	<item id="DATASOURCE" name="AD_462.TABBAR_DATASOURCE_NAME" selected="true">
            <attach file="/Admin/PushManagement/AdminPushManagementDataSourceLayout.xml"/>
        </item>
        <item id="MAIL" name="AD_462.TABBAR_MAIL_NAME" selected="false">
            <attach file="/Admin/PushManagement/AdminPushManagementMailLayout.xml"/>
        </item>
        <item id="KAKAO" name="AD_462.TABBAR_KAKAO_NAME" selected="false">
            <attach file="/Admin/PushManagement/AdminPushManagementKakaoLayout.xml"/>
        </item>
        <item id="SMS" name="AD_462.TABBAR_SMS_NAME" selected="false">
            <attach file="/Admin/PushManagement/AdminPushManagementSMSLayout.xml"/>
        </item>
        <event type="onTabChanged" callback="onTabChanged"/>
    </tabbar>
    <usercss>
    <![CDATA[
    	.dhxtabbar_cont .dhxtabbar_tabs.dhxtabbar_tabs_top {
            display: block;
        }
    ]]>
    </usercss>
    <variable>
        <var name="YwHnXVePvMnXVeLzo" value="$($sObject._vp).find('#YwHnXVePvMnXVeLzo')[0]"/>
        <var name="YwHnXVeQCQnXVeQyqf" value="$($sObject._vp).find('#YwHnXVeQCQnXVeQyqf')[0]"/>
        <var name="YwHnXVePvMnXVekAoD" value="$($sObject._vp).find('#YwHnXVePvMnXVekAoD')[0]"/>
    </variable>
    <onloadscript>
    	<call name="pageInit"/>
    </onloadscript>
    <userscript>
    	<var name="$clientData" value="{}"/>
        <var name="$share" value="{children:{}}"/>
        <function name="pageInit" args="">
        <![CDATA[
        	formObj.setViewMode(true);
        ]]>
        </function>
        <function name="onSelectItem" args="item">
        <![CDATA[
        	if(item) {
        		$clientData = item;
        	}
        ]]>
        </function>
        <function name="doQuery" args="data">
        <![CDATA[
        	if(!$clientData['HOUSE_CODE']) {
        		$clientData['HOUSE_CODE'] = Sepoa.info.HOUSE_CODE;
        	}
        
        	var binder = $.extend({}, $clientData, data);
        	binder['TYPE'] = Object.keys(tabbarObj.t).join(',');

            doServiceAjax("sepoa.svc.admin.AD_460", "TRANSACTION", "doQueryTemplate", binder, function(so) {
                if (so.status == "1") {
                    var data = new SepoaFormater(so.result[0]).getArrayMap()[0];
                    formObj.setData(data, "json");
                    callFunction("AD_450_3", "load", [data]);
                    callFunction("AD_450_6", "load", [data]);
                    callFunction("AD_450_8", "load", [data]);
                    callFunction("AD_450_SMS", "load", [data]);
                } else {
                    Alert(so.message);
                }
            });
        ]]>
        </function>
        <function name="doSave">
        <![CDATA[
            var data = formObj.getFormData();
            data.ACTIVE_MODULE_ID = tabbarObj.getActiveTab();
            for (var i in $share.children) {
                var c = $share.children[i];
                if (c && c.fn && c.fn.onBeforeSave) {
                    c.fn.onBeforeSave(data);
                }
            }
            
            if (data.CODE == "") {
                Alert(sUtils.cache.text.get("AD_462.MESSAGE_0001"));
                return;
            }
            if (data.DESCRIPTION == "") {
                Alert(sUtils.cache.text.get("AD_462.MESSAGE_0002"));
                return;
            }
            
            var binder = $.extend({}, data, $clientData);
            Confirm(Sepoa.cache.text.get('MESSAGE.1018'), function(flag) {
                if (flag) {
                    doServiceAjax("sepoa.svc.admin.AD_460", "TRANSACTION", "doSave", binder, function(so) {
                        if (so.status == "1") {
                            Sepoa.cache.client.clear();
                            Alert(sUtils.cache.text.get("BASE_MESSAGE.0002"));
                        } else {
                            Alert(so.message);
                        }
                    });
                }
            });
        ]]>
        </function>
        <function name="doClear">
        <![CDATA[
            formObj.clear();
            for (var i in $share.children) {
                var c = $share.children[i];
                if (c && c.fn && c.fn.doClear) {
                    c.fn.doClear();
                }
            }
        ]]>
        </function>
        <function name="doDelete">
        <![CDATA[
            var data = formObj.getFormData();
            
            if (data.CODE == "") {
                Alert(sUtils.cache.text.get("AD_462.MESSAGE_0001"));
                return;
            }
            
            data.ACTIVE_MODULE_ID = tabbarObj.getActiveTab();
            for (var i in $share.children) {
                var c = $share.children[i];
                if (c && c.fn && c.fn.onBeforeSave) {
                    c.fn.onBeforeSave(data);
                }
            }
            
            var binder = $.extend({}, data, $clientData);
            Confirm(Sepoa.cache.text.get('AD_462.MESSAGE_0003'), function(flag) {
                if (flag) {
                    doServiceAjax("sepoa.svc.admin.AD_460", "TRANSACTION", "doDelete", binder, function(so) {
                        if (so.status == "1") {
                            Alert(Sepoa.cache.text.get('MESSAGE.0001'));
                            
                            var selectOption = {
                            	CODE: binder['CODE'],
                            	DESCRIPTION: binder['DESCRIPTION']
                            };
                            
                            doQuery(selectOption);
                        } else {
                            Alert(so.message);
                        }
                    });
                }
            });
        ]]>
        </function>
        <function name="childScreenLoad" args="config">
        <![CDATA[
            $share.children[config.id] = config;
        ]]>
        </function>
        <function name="onTabChanged" args="id">
        <![CDATA[
            var c = $share.children[id];
            if (c && c.fn && c.fn.doRefresh) {
                c.fn.doRefresh();
            }
        ]]>
        </function>
    </userscript>
