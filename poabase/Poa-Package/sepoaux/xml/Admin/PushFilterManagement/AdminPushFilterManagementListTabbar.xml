<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_460_LIST_T" header="false">
    <tabbar id="tabbarObj" div="hYRtgWexqktgWegjMZ">
        <item id="CLIENT" name="AD_460_LIST_T.TABBAR_CLIENT_NAME" selected="true">
            <attach file="/Admin/PushFilterManagement/AdminPushFilterManagementClientList.xml"/>
        </item>
        <item id="NOTIFICATION" name="AD_460_LIST_T.TABBAR_NOTIFICATION_NAME" selected="false">
            <attach file="/Admin/PushFilterManagement/AdminPushFilterManagementList.xml"/>
        </item>
        <event type="onSelect" callback="onTabChange"/>
    </tabbar>
    <onloadscript>
        <call name="pageInit"/>
    </onloadscript>
    <userscript>
        <var name="$clientData">
        <![CDATA[
            {
                house_code: Sepoa.info.HOUSE_CODE
            }
        ]]>
        </var>
        <function name="pageInit" args="">
        <![CDATA[
            if (Sepoa.info.HOUSE_CODE == "000") {
                tabbarObj.tabs('NOTIFICATION').hide();
                callFunction('AD_460_C_LIST', 'doQuery', []);
            } else {
                tabbarObj.tabs('NOTIFICATION').setActive();
                tabbarObj.hideTabsArea();
            }
        ]]>
        </function>
        <function name="onSelectItem" args="type, item">
        <![CDATA[
            if (type == "CLIENT") {
                tabbarObj.tabs('NOTIFICATION').setText(item.COMPANY_NAME);
                tabbarObj.tabs('NOTIFICATION').show();
                tabbarObj.tabs('NOTIFICATION').setActive();
                $.extend($clientData, item);
                callFunction('p', 'onSelectItem', [$clientData]);
            } else {
                callFunction(['p'], 'onSelectItem', [$.extend({}, item, $clientData)]);
            }
        ]]>
        </function>
        <function name="onTabChange" args="id, before">
        <![CDATA[
            if (before) {
                if (id == "CLIENT") {
                    tabbarObj.tabs('NOTIFICATION').hide();
                    callFunction('AD_460_WRITE_T', 'setTabActive', ['DUMMY']);
                    callFunction('p', 'onSelectItem', []);
                } else if (id == "NOTIFICATION") {
                    callFunction('AD_461', 'doQuery', []);
                }
            }
            return true;
        ]]>
        </function>
    </userscript>
