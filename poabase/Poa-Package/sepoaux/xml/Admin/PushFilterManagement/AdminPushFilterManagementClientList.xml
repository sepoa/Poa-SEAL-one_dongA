<body screen_id="AD_460_C_LIST" header="false" pageCloseWarn="false">
    <filterbar id="filterObj" div="AABtgWenYcugWejFzh">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <list id="listObj" div="AABtgWentGugWeiIUH">
        <type>
            <template><![CDATA[<table class=sepoa_list_design width=100%><tr><td width=sepoa_list_font_bold>#house_code#</td><td class=sepoa_list_align_right>#company_name#</td></tr></table>]]></template>
        </type>
        <event type="onItemClick" callback="onItemClick"/>
    </list>
    <onloadscript/>
    <userscript>
        <function name="doQuery">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            listObj.clearAll(false);
            listObj.load(window.CONTEXT_NAME + '/SepoaList.sux?PROCESS_ID=sepoa.svc.admin.AD_460&mode=doList&METHOD=doQueryClient' + dataOutput.getParams());
        ]]>
        </function>
        <function name="onItemClick" args="id, ev, html">
        <![CDATA[
            callFunction(['p'], 'onSelectItem', ["CLIENT", listObj.get(id, true)]);
            return;
            
            callFunction('AD_462_1', 'clearCmData', []);
        ]]>
        </function>
        <function name="onSearch" args="flag">
        <![CDATA[
            if (flag == "filter" || flag == "search") {
            	doQuery();
            }
        ]]>
        </function>
    </userscript>
