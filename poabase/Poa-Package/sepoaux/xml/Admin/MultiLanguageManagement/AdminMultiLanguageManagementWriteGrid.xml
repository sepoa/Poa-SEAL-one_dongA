<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_018_3" header="false">
    <filterbar id="filterObj" div="LGujeQbgOAWYjJzMMv">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <button id="btnObj">
        <btn div="MGujeQbINibYjJzzuQ" id="new" type="new" text="{BUTTON.new}" toggle="false" reverse="false" onclick="doNew(  )"/>
        <btn div="MGujeQbINibYjJzzuQ" id="add" type="rowadd" text="{BUTTON.rowadd}" toggle="false" reverse="false" onclick="addRow(  )"/>
        <btn div="MGujeQbINibYjJzzuQ" id="delete" type="deleted" text="{BUTTON.delete}" toggle="false" reverse="false" onclick="doDelete(  )"/>
        <btn div="MGujeQbINibYjJzzuQ" id="copy" text="{BUTTON.copy}" toggle="false" reverse="false" onclick="addRow( &#39;copy&#39; )"/>
        <btn div="MGujeQbINibYjJzzuQ" id="save" type="save" text="{BUTTON.save}" toggle="false" reverse="false" onclick="doSave(  )"/>
    </button>
    <grid id="gridObj" div="LGujeQbUeWVYjJzcWe" grid-id="file:///resource/ux/admin/grid/AD_018.js" drag="false" merge="false" dynamic="false">
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onTXE" callback="doSaveEnd_grid"/>
        <event type="onEditCell" callback="onEditCell"/>
    </grid>
    <variable>
        <var name="RHujeQbyNvkeQbTTil" value="$($sObject._vp).find('#RHujeQbyNvkeQbTTil')[0]"/>
        <var name="RHujeQbQlxkeQbnOQo" value="$($sObject._vp).find('#RHujeQbQlxkeQbnOQo')[0]"/>
        <var name="RHujeQbwNvkeQbYeNk" value="$($sObject._vp).find('#RHujeQbwNvkeQbYeNk')[0]"/>
    </variable>
    <onloadscript>
        <call name="setGrid"/>
        <call name="initialize"/>
    </onloadscript>
    <userscript>
        <![CDATA[
            //행추가 버튼 클릭시 호출되는 함수
        ]]>
        <function name="addRow" args="mode">
        <![CDATA[
            var maxRowId = new Date().getTime() + '' + dhx4.newId();;
            if (mode == 'copy') {
                var selectedRow = gridObj.getGridChangedRows("SELECTED");
                if (selectedRow.length < 1) {
                    Alert(Sepoa.cache.text.get('MESSAGE.9999'));
                }
                for (var i = 0; i < selectedRow.length; i++) {
                    gridObj.addRow(maxRowId, '', i);
                    gridObj.copyRowContent(selectedRow[i], maxRowId);
                    gridObj.cells(maxRowId, gridObj.getColIndexById('SAVED')).setValue("");
                    gridObj.cells(maxRowId++, gridObj.getColIndexById('SELECTED')).setValue("1");
                }
            } else {
                gridObj.addRow(maxRowId, '', 0);
                gridObj.cells(maxRowId, gridObj.getColIndexById('SELECTED')).setValue("1");
                if (gridObj.getRowsNum() > 1) {
                    var sId = gridObj.cells(gridObj.getRowId(gridObj.getRowsNum() - 1), gridObj.getColIndexById('SCREEN_ID')).getValue();
                    gridObj.cells(maxRowId, gridObj.getColIndexById('SCREEN_ID')).setValue(sId);
                }
            }
        ]]>
        </function>
        <function name="doDelete" args="">
        <![CDATA[
            var selectedRow = gridObj.getGridChangedRows("SELECTED");
            if(selectedRow == 0){
            	Alert(Sepoa.cache.text.get('MESSAGE.0003')); // 필수 입력컬럼을 입력해주세요.
            	return;
            }
            
            if (gridObj.getGridChangedRows("SELECTED").length > 0 && Confirm(Sepoa.cache.text.get('MESSAGE.1015'), function(result) {
                    if (result) {
                        gridObj.editStop();
                        gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.admin.AD_018_3', 'METHOD=doDelete'], 'SELECTED');
                    }
                }));
        ]]>
        </function>
        <function name="doNew" args="">
        <![CDATA[
            gridObj.clearAll(false);
            dataOutput.remove('SCREEN_ID');
            callFunction('AD_018_4', 'setTextArea', ['']);
        ]]>
        </function>
        <function name="doQuery" args="screen_id">
        <![CDATA[
            if (screen_id) {
                dataOutput.setValue('SCREEN_ID', screen_id);
            }
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.admin.AD_018_3']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="obj, rowCnt">
        <![CDATA[
            var msg = obj.getUserData("", "message");
            var status = obj.getUserData("", "status");
            if (status == "true") {
                var data = gridObj.serializeToTextArea();
                callFunction('AD_018_4', 'setTextArea', [data]);
            }
        ]]>
        </function>
        <function name="doSave" args="">
        <![CDATA[
            if (!gridObj.validate('SELECTED')) {
                Alert(Sepoa.cache.text.get('MESSAGE.0003'));
                return;
            }
            Confirm(Sepoa.cache.text.get('MESSAGE.1018'), function(result) {
                if (result) {
                    gridObj.editStop();
                    gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.admin.AD_018_3'], 'SELECTED');
                }
            });
        ]]>
        </function>
        <function name="doSaveEnd_grid" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if (status == 'true') {
                Alert(message);
                Sepoa.cache.clear();
                callFunction('AD_018_1', 'doQuery', [true]);
                doQuery();
            } else {
                Alert(message);
            }
        ]]>
        </function>
        <function name="doSaveTextArea" args="data">
        <![CDATA[
            gridObj.clearAll(false);
            var row = data.split('\n');
            for (var _idx in row) {
                var col = row[_idx].split('\t');
                if (col.length < 4) {
                    continue;
                }
                var maxRowId = gridObj.getRowsNum() + 1;
                gridObj.addRow(maxRowId, '', gridObj.getRowsNum());
                gridObj.cells(maxRowId, gridObj.getColIndexById('SELECTED')).setValue("1");
                gridObj.cells(maxRowId, gridObj.getColIndexById('SCREEN_ID')).setValue(col[0]);
                gridObj.cells(maxRowId, gridObj.getColIndexById('CODE')).setValue(col[1]);
                gridObj.cells(maxRowId, gridObj.getColIndexById('CONTENTS')).setValue(col[2]);
            }
            doSave();
        ]]>
        </function>
        <function name="onEditCell" args="stage, rId, cInd, nValue, oValue">
        <![CDATA[
            var header = gridObj.getColumnId(cInd);
            if (stage == 0) {
                return true;
            } else if (stage == 1) {
                return true;
            } else if (stage == 2) {
                var gId = gridObj.cells(rId, gridObj.getColIndexById('SCREEN_ID')).getValue();
                if (gId != '') {
                    dataOutput.setValue('SCREEN_ID', gId);
                }
                return true;
            }
            return false;
        ]]>
        </function>
        <function name="onSearch" args="">
        <![CDATA[
            doQuery();
        ]]>
        </function>
        <function name="setGrid" args="">
        <![CDATA[
            doServiceAjax('sepoa.svc.common.COMMON', 'CONNECTION', 'getActiveLanguage', void 0, function(so) {
                if (so.status != 1) {
                    Alert(so.message);
                    return;
                }
                var sf = new SepoaFormater(so.result[0]);
            
                for (var i = 0; i < sf.getRowCount(); i++) {
                    var ind = gridObj.getColumnsNum();
                    var code = 'CONTENTS_' + sf.getValue('LANGUAGE', i);
                    var header = sf.getValue('TEXT1', i);
                    var type = 'edtxt';
                    var width = 300;
                    var sort = 'str';
                    var align = 'left';
            
                    gridObj.insertColumn(ind, header, type, width, sort, align, 'center', void 0, 'white');
                    gridObj.setColumnId(ind, code);
                    for (var _idx in gridObj._validators.data) {
                        if (gridObj._validators.data[_idx] == void 0) {
                            gridObj._validators.data[_idx] = "";
                        }
                    }
                    gridObj.grid_col_id = gridObj.getColIdsArray();
                }
            }, false);
        ]]>
        </function>
        <function name="initialize" args="">
        <![CDATA[
            if (Sepoa.request.LANGUAGE_ID) {
                doQuery(Sepoa.request.LANGUAGE_ID);
            }
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
    </template>
</body>