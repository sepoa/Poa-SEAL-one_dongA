<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_018_1" header="false">
    <filterbar id="filterObj" div="IFujeQbEccxQjJzApk">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="doQuery"/>
    </filterbar>
    <list id="listObj" div="IFujeQbYTPxQjJzvyM">
        <type>
            <template><![CDATA[<table width=100% class=sepoa_list_design><tr><td class=sepoa_list_font_bold>#screen_id#</td></tr><tr><td class=\"sepoa_list_primary sepoa_list_align_right\"></td></tr></table>]]></template>
        </type>
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onItemClick" callback="doRowSelect"/>
    </list>
    <onloadscript>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <function name="doQuery" args="flag">
        <![CDATA[
            doRowSelectFlag = flag;
            dataOutput.addFilter(filterObj);
            listObj.load(window.CONTEXT_NAME + '/SepoaList.sux?PROCESS_ID=sepoa.svc.admin.AD_018_1&mode=doList' + dataOutput.getParams());
            listObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="flag">
        <![CDATA[
            if (listObj.dataCount() > 0 && !doRowSelectFlag) {
                var id = listObj.idByIndex(0);
                listObj.select(id);
                listObj.show(id);
                doRowSelect(id);
            }
        ]]>
        </function>
        <function name="doRowSelect" args="id, ev, html">
        <![CDATA[
            var item = listObj.get(id);
            callFunction('AD_018_3', 'doQuery', [item.screen_id]);
        ]]>
        </function>
        <var name="doRowSelectFlag"/>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
    </template>
</body>