<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_042_T" header="false" tpl="editor.tpl">
    <tabbar id="tabbarObj" div="zuiaXudKGlaXudSavt">
        <item id="CLIENT" name="AD_042_T.TABBAR_CLIENT_NAME" selected="true">
            <attach file="/Admin/FormFilterManagement/AdminFormFilterManagementClientList.xml"/>
        </item>
        <item id="FORM" name="AD_042_T.TABBAR_FORM_NAME" selected="false">
            <attach file="/Admin/FormFilterManagement/AdminFormFilterManagementList.xml"/>
        </item>
    </tabbar>
    <onloadscript>
    	<call name="pageInit"/>
    </onloadscript>
    <userscript>
        <var name="$clientData">
        <![CDATA[
            {house_code:Sepoa.info.HOUSE_CODE}
        ]]>
        </var>
    	<function name="pageInit" args="">
        <![CDATA[
            if(Sepoa.info.HOUSE_CODE == "000"){
                tabbarObj.tabs('FORM').hide();
                callFunction('AD_042_5', 'doQuery', []);
            }else{
                tabbarObj.tabs('FORM').setActive();
                tabbarObj.hideTabsArea();
            }
            callFunction('AD_042_1', 'doQuery', []);
        ]]>
        </function>
        <function name="onSelectItem" args="type, item">
        <![CDATA[
            if(type == "CLIENT"){
                tabbarObj.tabs('FORM').setText(item.company_name);
                tabbarObj.tabs('FORM').show();
                tabbarObj.tabs('FORM').setActive();
                $.extend($clientData, item);
                callFunction('p', 'onSelectItem', [$clientData]);
            }else{
                callFunction(['p'], 'onSelectItem', [$.extend({}, item, $clientData)]);
            }
        ]]>
        </function>
        <function name="onTabChange" args="id, before">
        <![CDATA[
            if(before){
                if(id == "CLIENT"){
                    tabbarObj.tabs('FORM').hide();
                    callFunction('p', 'onSelectItem', []);
                }else if(id == "FORM"){
                    callFunction('AD_042_1', 'showFirstRow', []);
                }
            }
            return true;
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
    </template>
</body>