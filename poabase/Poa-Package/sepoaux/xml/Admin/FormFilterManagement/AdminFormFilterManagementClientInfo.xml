<body screen_id="AD_042_7" header="false">
    <button id="btnObj">
        <btn div="BHwUqAehQHVqAewPHq" id="SAVE" type="save" text="{BUTTON.save}" toggle="false" reverse="false" onclick="doSave(  )"/>
    </button>
    <variable>
        <var name="formbox" value="$($sObject._vp).find('#BHwUqAeJqHVqAeKVvw')[0]"/>
        <var name="olcTrAeOVfTrAelVCm" value="$($sObject._vp).find('#olcTrAeOVfTrAelVCm')[0]"/>
        <var name="BHwUqAeJqHVqAeivIc" value="$($sObject._vp).find('#BHwUqAeJqHVqAeivIc')[0]"/>
    </variable>
    <onloadscript>
        <call name="pageInit"/>
    </onloadscript>
    <userscript>
        <function name="pageInit" args="">
        <![CDATA[
            var formOption = [{
                    type: "settings",
                    inputWidth: 300,
                    position: "label-top"
                },
                {
                    type: "block",
                    list: [{
                        type: "block",
                        width: "auto",
                        list: [{
                                type: "input",
                                name: "CLIENT_INFO",
                                readonly: true,
                                label: Sepoa.cache.text.get('AD_042_7.CLIENT_INFO')
                            },
                            {
                                type: "newcolumn"
                            },
                            {
                                type: "input",
                                name: "FORM_ID",
                                readonly: true,
                                offsetLeft: 150,
                                label: Sepoa.cache.text.get('AD_042_7.FORM_ID')
                            }
                        ]
                    }]
                }
            ];
            
            formObj = $sObject.formObj = new SepoaMultiDhtmlXFormObject(formbox, 'formObj', [formOption], true);
        ]]>
        </function>
        <function name="doSave" args="">
        <![CDATA[
            callFunction('AD_042_4', 'doSave', []);
        ]]>
        </function>
        <function name="doQuery" args="item">
        <![CDATA[
            doServiceAjax('sepoa.svc.admin.AD_042_7', 'CONNECTION', 'doQuery', {
                HOUSE_CODE: item.house_code
            }, function(so) {
                if (so.status != 1) {
                    Alert(Sepoa.cache.text.get('AD_042_7.CLIENT_INFO_ERROR'));
                    console.log(so.message);
                    return;
                }
            
                var sf = new SepoaFormater(so.result[0]);
                if (sf.getRowCount() > 0) {
            
                    var data = sf.getArrayMap()[0];
            
                    formObj.setValue('CLIENT_INFO', data.HOUSE_CODE + ' / ' + data.COMPANY_NAME);
                    formObj.setValue('FORM_ID', item.form_id);
            
                } else {
                    Alert(Sepoa.cache.text.get('AD_042_7.CLIENT_INFO_ERROR'));
                    return;
                }
            });
        ]]>
        </function>
    </userscript>
