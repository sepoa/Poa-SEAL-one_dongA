<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="IFH_002" header="false">
	<link>
	<![CDATA[
		<script type="text/javascript">
			Sepoa.cache.text.load([{
				url:CONTEXT_NAME+'/resource/ux/admin/langs/'+Sepoa.info.LANGUAGE+'/IFH_001.js',
				def:CONTEXT_NAME+'/resource/ux/admin/langs/KO/IFH_001.js'
			},{
                url:CONTEXT_NAME+'/resource/ux/admin/langs/'+Sepoa.info.LANGUAGE+'/POA_BASE.js',
                def:CONTEXT_NAME+'/resource/ux/admin/langs/KO/POA_BASE.js'
            }]);
		</script>
	]]>
	</link>
    <filterbar id="filterObj" div="SKmMlzeuesMlzeNqkK">
        <calendar id="F_CALENDAR" button="year:0,month:0,week:-4,day:0" default="day:0"/>
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <grid id="gridObj" div="SKmMlzeFuyMlzeteeS" grid-id="file:///resource/ux/admin/grid/IFH_002.js" drag="false" merge="false" dynamic="false">
        <event type="onRowSelect" callback="onRowSelect"/>
    </grid>
    <onloadscript>
        <![CDATA[
            doQuery();
        ]]></onloadscript>
    <userscript>
        <function name="doQuery" args="">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.admin.IFH_001', 'METHOD=doQuery']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="onSearch" args="">
        <![CDATA[
            doQuery();
        ]]>
        </function>
        <function name="onRowSelect" args="id, ind">
        <![CDATA[
            var dataIconIdx = gridObj.getColIndexById("DATA_ICON");
            var functionName = gridObj.cells(id, gridObj.getColIndexById("FUNCTION_NAME")).getValue();
            var transactionCode = gridObj.cells(id, gridObj.getColIndexById("TRANSACTION_CODE")).getValue();
            
            if (ind === dataIconIdx) {
                doOpenPopup(functionName, transactionCode);
            }
        ]]>
        </function>
        <function name="doOpenPopup" args="functionName, transactionCode">
        <![CDATA[
            var height = SUX.root.innerHeight * 0.5;
            var params = {
                MODE: 'POPUP',
                FUNCTION_NAME: functionName,
                TRANSACTION_CODE: transactionCode
            }
            PopupOpenPost('/Admin/InterfaceHistory/InterfaceHistoryPopupLayout.sux', params, popupCallback, 1200, height, '');
        ]]>
        </function>
        <function name="popupCallback" args="">
        <![CDATA[
            
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
    </template>
</body>