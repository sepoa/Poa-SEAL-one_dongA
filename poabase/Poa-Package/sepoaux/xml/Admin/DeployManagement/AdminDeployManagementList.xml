<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_350_1" header="false">
    <filterbar id="filterObj" div="GTHxLPboQVmHtuNrnD">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="doQuery"/>
    </filterbar>
    <list id="listObj" div="GTHxLPbUbImHtuNdEB">
        <type>
            <template><![CDATA[<table width=100% class=sepoa_list_design><tr><td class=\"sepoa_list_font_bold\">#server_url#</td><td>#description#</td></tr></table>]]></template>
        </type>
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onItemClick" callback="doRowSelect"/>
    </list>
    <onloadscript>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <var name="doRowSelectFlag"/>
        <function name="doQuery" args="flag">
        <![CDATA[
            doRowSelectFlag = (flag == true);
            dataOutput.addFilter(filterObj);
            var params = dataOutput.getParams();
            params += '&PROCESS_ID=sepoa.svc.admin.AD_350&METHOD=doList'
            listObj.load(window.CONTEXT_NAME + '/SepoaList.sux?mode=doList' + params);
            listObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="">
        <![CDATA[
            if (listObj.dataCount() > 0 && !doRowSelectFlag) {
                var id = listObj.idByIndex(0);
                listObj.select(id);
                listObj.show(id);
                doRowSelect(id);
            }
        ]]>
        </function>
        <function name="doRowSelect" args="id, ev, html">
        <![CDATA[
            var item = listObj.get(id);
            callFunction('AD_350_2', 'doQuery', [item.deploy_id]);
        ]]>
        </function>
    </userscript>
