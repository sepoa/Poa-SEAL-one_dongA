<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_041_1" header="false">
    <filterbar id="filterObj" div="nMkAeQbQPwnXVTuWEV">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="doQuery"/>
    </filterbar>
    <list id="formList" div="nMkAeQbwZjnXVTuliZ">
        <type>
            <template><![CDATA[<table width=100% class=sepoa_list_design><th><col width=100%></th><tr><td class=sepoa_list_font_bold>#form_id#</td></tr><tr><td class=\"sepoa_list_primary sepoa_list_align_right\"></td></tr></table>]]></template>
        </type>
        <event type="onItemClick" callback="doRowSelect"/>
        <event type="onXLE" callback="doQueryEnd"/>
    </list>
    <onloadscript>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <function name="doQuery" args="">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            var params = dataOutput.getParams();
            params += '&PROCESS_ID=sepoa.svc.admin.AD_041_1&METHOD=doQueryFormList'
            formList.load(window.CONTEXT_NAME + '/SepoaList.sux?mode=doList' + params);
            formList.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="">
        <![CDATA[
            var id = '';
            if (formList.dataCount() > 0) {
                if (dataOutput.getValue("selectItem").length < 1) {
                    id = formList.idByIndex(0);
                } else {
                    id = dataOutput.getValue("selectItem");
                }
                formList.select(id);
                formList.show(id);
                doRowSelect(id);
            }
        ]]>
        </function>
        <function name="doRowSelect" args="id, ev, html">
        <![CDATA[
            dataOutput.setValue("selectItem", id);
            callFunction('AD_041_2', 'doQuery', [formList.get(id).form_id]);
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
    </template>
</body>