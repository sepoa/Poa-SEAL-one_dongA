<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_461" header="false">
    <tabbar id="tabbarObj" div="KpwbDSeaOysOPcSFXM">
        <item id="CLIENT" name="AD_461.TABBAR_CLIENT_NAME" selected="true">
            <attach file="/Admin/MailTemplateFilterManagement/AdminMailTemplateFilterManagementClientList.xml"/>
        </item>
        <item id="LIST" name="AD_461.TABBAR_LIST_NAME" selected="false">
            <attach file="/Admin/MailTemplateFilterManagement/AdminMailTemplateFilterManagementList.xml"/>
        </item>
        <event type="onSelect" callback="onTabChange"/>
    </tabbar>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <function name="init">
        <![CDATA[
            tabbarObj.tabs('LIST').hide();
        ]]>
        </function>
        <function name="onTabChange" args="id, before">
        <![CDATA[
            if (before) {
                if (id == "CLIENT") {
                    tabbarObj.tabs('LIST').hide();
                    callFunction('AD_462', 'clearForm', []);
                    callFunction('AD_462_1', 'clearCmData', []);
                }
            }
            return true;
        ]]>
        </function>
        <function name="onSelectItem" args="type, item">
        <![CDATA[
            if (type == "CLIENT") {
                var houseCode = item.house_code;
                tabbarObj.tabs('LIST').setText(item.company_name);
                tabbarObj.tabs('LIST').show();
                tabbarObj.tabs('LIST').setActive();
                callFunction('AD_461_2', 'doQueryList', [houseCode]);
                callFunction('AD_462', 'initForm', [item]);
            }
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
    </template>
</body>