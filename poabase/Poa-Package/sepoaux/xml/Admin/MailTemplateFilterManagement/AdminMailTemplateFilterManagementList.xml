<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_461_2" header="false">
    <filterbar id="filterObj" div="mRBlDSeDqLlDSeRPPD">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="doQueryList"/>
    </filterbar>
    <list id="listObj" div="mRBlDSeeVMlDSeQjZr">
        <type>
            <template><![CDATA[<table width=100% class=sepoa_list_design><tr><td class=sepoa_list_font_bold>#template_code#</td></tr><tr><td class=\"sepoa_list_primary sepoa_list_align_right\"></td></tr></table>]]></template>
        </type>
        <event type="onItemClick" callback="onItemClick"/>
    </list>
    <onloadscript/>
    <userscript>
        <var name="house_code" />
        <function name="doQueryList" args="houseCode">
        <![CDATA[
        	if(houseCode) {
        		if(['filter', 'search'].indexOf(houseCode) + 1) {
        			// filter keyword ignore
        		} else {
        			house_code = houseCode;
	            	dataOutput.setValue('HOUSE_CODE', houseCode);
        		}
        	}
        	
            dataOutput.addFilter(filterObj);
            listObj.load(window.CONTEXT_NAME + '/SepoaList.sux?PROCESS_ID=sepoa.svc.admin.AD_460&mode=doList&METHOD=doQueryTemplateList' + dataOutput.getParams());
            listObj.clearAll(false);
        ]]>
        </function>
        <function name="onItemClick" args="id, ev, html">
        <![CDATA[
            callFunction('AD_462', 'doQuery', [listObj.get(id).template_code, house_code]);
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
    </template>
</body>