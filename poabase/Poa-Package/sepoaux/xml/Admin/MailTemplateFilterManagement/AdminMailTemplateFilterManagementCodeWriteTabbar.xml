<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_462" header="false">
    <form id="formObj" div="KpwbDSesjssOPchQIu" form-id="file:///resource/ux/admin/form/AD_460.js"/>
    <button id="btnObj">
        <btn div="KpwbDSeMHmsOPcIjSK" id="NEW" type="new" text="{BUTTON.new}" onclick="onButtonClick( 'NEW' )"/>
        <btn div="KpwbDSeMHmsOPcIjSK" id="SAVE" type="save" text="{BUTTON.save}" onclick="onButtonClick( 'SAVE' )"/>
        <btn div="KpwbDSeMHmsOPcIjSK" id="DELETE" type="delete" text="{BUTTON.delete}" onclick="onButtonClick( 'DELETE' )"/>
        <btn div="KpwbDSeMHmsOPcIjSK" id="UPLOAD" type="default" text="{AD_460.BTN_UPLOAD}" onclick="onButtonClick( 'UPLOAD' )"/>
    </button>
    <tabbar id="tabbarObj" div="hweQESedAhQESeDbQB">
        <item id="WRITE" name="AD_462.TABBAR_WRITE_NAME" selected="true">
            <attach file="/Admin/MailTemplateFilterManagement/AdminMailTemplateFilterManagementCodeWrite.xml"/>
        </item>
        <item id="PREVIEW" name="AD_462.TABBAR_PREVIEW_NAME" selected="false">
            <attach file="/Admin/MailTemplateFilterManagement/AdminMailTemplateFilterManagementCodePreview.xml"/>
        </item>
    </tabbar>
    <usercss>
    <![CDATA[
        .codeTabbar .dhxtabbar_cont .dhxtabbar_tabs.dhxtabbar_tabs_top {
            display: block;
        }
    ]]>
    </usercss>
    <variable>
        <var name="dDXPESeJnePESeqacm" value="$($sObject._vp).find('#dDXPESeJnePESeqacm')[0]"/>
        <var name="dDXPESeyOgPESecZBX" value="$($sObject._vp).find('#dDXPESeyOgPESecZBX')[0]"/>
        <var name="dDXPESeJnePESeioJm" value="$($sObject._vp).find('#dDXPESeJnePESeioJm')[0]"/>
    </variable>
    <onloadscript/>
    <userscript>
        <var name="house_code"/>
        <var name="client_name"/>
        <function name="initForm" args="item">
        <![CDATA[
            formObj.setValue('CLIENT_NAME', item.company_name);
            formObj.setValue('HOUSE_CODE', item.house_code);
        ]]>
        </function>
        <function name="clearForm">
        <![CDATA[
            formObj.clear();
        ]]>
        </function>
        <function name="clearFormAfterDelete">
        <![CDATA[
            formObj.setValue('TEMPLATE_CODE', '');
            formObj.setValue('DESCRIPTION', '');
        ]]>
        </function>
        <function name="onButtonClick" args="id">
        <![CDATA[
            if (id == 'NEW') {
                doNew();
            } else if (id == 'SAVE') {
                doSave();
            } else if (id == 'DELETE') {
                doDelete();
            } else if (id == 'UPLOAD') {
                doUpload();
            }
        ]]>
        </function>
        <function name="doQuery" args="templateCode, houseCode">
        <![CDATA[
            dataOutput.setValue('HOUSE_CODE', houseCode);
            dataOutput.setValue('TEMPLATE_CODE', templateCode);
            doServiceAjax('sepoa.svc.admin.AD_460', 'CONNECTION', 'doQuery', null, function(so) {
                if (so.status != 1) {
                    Alert(so.message);
                    return;
                }
                var sf = new SepoaFormater(so.result[0]);
            
                if (sf.getRowCount() > 0) {
                    for (var idx = 0; idx < sf.getRowCount(); idx++) {
                        formObj.setValue('TEMPLATE_CODE', sf.getValue('TEMPLATE_CODE'));
                        formObj.setValue('DESCRIPTION', sf.getValue('DESCRIPTION'));
            			
            			var htmlCode = sf.getValue('HTML');
                        callFunction('AD_462_1', 'setCmData', [htmlCode]);
                        callFunction('AD_462_2', 'setFrameCode', [htmlCode]);
                    }
                }
            });
        ]]>
        </function>
        <function name="doNew">
        <![CDATA[
            house_code = formObj.getValue('HOUSE_CODE');
            client_name = formObj.getValue('CLIENT_NAME');
            formObj.clear();
            callFunction('AD_462_1', 'clearCmData', []);
            formObj.setValue('HOUSE_CODE', house_code);
            formObj.setValue('CLIENT_NAME', client_name);
        ]]>
        </function>
        <function name="doSave">
        <![CDATA[
            var templateCode = formObj.getValue('TEMPLATE_CODE');
            
            if (!formObj.validateItem('TEMPLATE_CODE')) {
                Alert(Sepoa.cache.text.get('AD_460.MSG_VALIDATE_TEMPLATE_CODE'));
                return;
            }
            
            Confirm(Sepoa.cache.text.get('MESSAGE.1018'), function(result) {
                if (result) {
                    var description = formObj.getValue('DESCRIPTION');
                    var houseCode = formObj.getValue('HOUSE_CODE');
                    var codeValue = callFunction('AD_462_1', 'getCmData', []);
                    dataOutput.setValue('HTML', codeValue);
                    dataOutput.setValue('TEMPLATE_CODE', templateCode);
                    dataOutput.setValue('DESCRIPTION', description);
                    dataOutput.setValue('HOUSE_CODE', houseCode);
            
                    doServiceAjax("sepoa.svc.admin.AD_460", "TRANSACTION", "doSave", null, function(so) {
                        if (so.status == "1") {
                            Message(Sepoa.cache.text.get("MESSAGE.0001"));
            
                            callFunction('AD_461_2', 'doQueryList', [houseCode]);
                        } else {
                            Alert(so.message);
                        }
                    });
                }
            });
        ]]>
        </function>
        <function name="doDelete">
        <![CDATA[
            Confirm(Sepoa.cache.text.get("MESSAGE.1015"), function(result) {
                if (result) {
                    var templateCode = formObj.getValue('TEMPLATE_CODE');
                    var houseCode = formObj.getValue('HOUSE_CODE');
                    dataOutput.setValue('TEMPLATE_CODE', templateCode);
                    dataOutput.setValue('HOUSE_CODE', houseCode);
                    doServiceAjax("sepoa.svc.admin.AD_460", "TRANSACTION", "doDelete", null, function(so) {
                        if (so.status == "1") {
                            Alert(Sepoa.cache.text.get("MESSAGE.0001"));
            
                            clearFormAfterDelete();
                            callFunction('AD_462_1', 'clearCmData', []);
                            callFunction('AD_461_2', 'doQueryList', [houseCode]);
                        } else {
                            Alert(so.message);
                        }
                    });
                }
            });
        ]]>
        </function>
        <function name="doUpload">
        <![CDATA[
        	Confirm(Sepoa.cache.text.get('AD_460.MSG_UPLOAD'), function(uploadFlag) {
        		if(uploadFlag) {
        			Confirm(Sepoa.cache.text.get('AD_460.MSG_NEW_TEMPLATE_UPLOAD'), function(flag) {
	        		
		        		var newWirteFlag = flag; // true == 신규 || false == 덮어쓰기
		        		var input = document.createElement("input");
			            input.type = "file";
			            input.accept = "text/plain, text/html";
			            input.onchange = function(event) {
			                var fileExt = event.path[0].files[0].type;
			                if (fileExt == 'text/plain' || fileExt == 'text/html') {
			                    readFile(event.target.files[0], newWirteFlag);
			                }
			            };
			            input.click();
		        		
		        	}, null, Sepoa.cache.text.get('AD_460.BTN_INSERT_NEW'), Sepoa.cache.text.get('AD_460.BTN_INSERT_EXIST'));
        		}
        	})
        ]]>
        </function>
        <function name="readFile" args="file, newWriteFlag">
        <![CDATA[
            var reader = new FileReader();
            reader.onload = function() {
            	if(newWriteFlag == true) {
            		doNew();
            	}
                callFunction('AD_462_1', 'setCmData', [reader.result]);
                callFunction('AD_462_2', 'setFrameCode', [reader.result]);
            };
            reader.readAsText(file, "UTF-8");
        ]]>
        </function>
    </userscript>
