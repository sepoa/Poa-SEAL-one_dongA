<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_462_1" header="false">
    <usercss>
    <![CDATA[
        .CodeMirror {
            width: 100%;
            height: 100%;
            border: 1px solid #ddd;
        }
    ]]>
    </usercss>
    <variable>
        <var name="codeMirrorArea" value="$($sObject._vp).find('#EDPDKTefoDGKTeVhCx')[0]"/>
        <var name="EDPDKTeeoDGKTejhLA" value="$($sObject._vp).find('#EDPDKTeeoDGKTejhLA')[0]"/>
    </variable>
    <onloadscript>
        <call name="pageInit"/>
    </onloadscript>
    <userscript>
        <function name="pageInit">
        <![CDATA[
            CodeMirror.commands.autocomplete = function(cm) {
            	/*
                cm.showHint({
                    hint: CodeMirror.hint.html
                });
                */
            }
            
            var codeMode = "text/html";
            
            formObj_S = $sObject.formObj_S = new SepoaMultiDhtmlXFormObject(codeMirrorArea, 'formObj_S', []);
            
            codeObj = $sObject.codeObj = CodeMirror(codeMirrorArea, {
                lineNumbers: true,
                theme: "default",
                viewportMargin: 0,
                indentUnit: 4,
                extraKeys: {
                    "Ctrl-Q": "toggleComment",
                    "Ctrl-Space": "autocomplete"
                },
                mode: codeMode
            });
            
            codeObj.on("change", function(obj, e) {
                callFunction('AD_462_2', 'setFrameCode', [codeObj.getValue()]);
            });
            
            SUX.callEvent('onWindowResize', []);
        ]]>
        </function>
        <function name="setCmData" args="html">
        <![CDATA[
        	clearCmData();
            codeObj.setValue(html.replaceAll("'", "'"));
        ]]>
        </function>
        <function name="getCmData">
        <![CDATA[
            var codeValue = codeObj.getValue();
            
            return codeValue;
        ]]>
        </function>
        <function name="clearCmData">
        <![CDATA[
            codeObj.setValue('');
        ]]>
        </function>
    </userscript>
