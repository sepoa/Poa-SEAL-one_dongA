<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="ADDFILE" header="false">
    <vault id="vaultObj" div="uGfKlydHRILlydfujz" type="NOT"/>
    <variable>
        <var name="vaultBox" value="$($sObject._vp).find('#uGfKlydIqEMlydTFKs')[0]"/>
        <var name="uGfKlydHqEMlydlVBZ" value="$($sObject._vp).find('#uGfKlydHqEMlydlVBZ')[0]"/>
    </variable>
    <onloadscript>
        <call name="initPage" />
    </onloadscript>
    <userscript>
        <var name="$data" value="{}"/>
        <function name="initPage">
        <![CDATA[
            vaultObj.setCallBack(fileUploadCallback);
            SUX.attachEvent('onWindowResize', function(){
                vaultObj.setSizes();
            })
            init($.extend(true, {},Sepoa.request, Sepoa.params));
        ]]>
        </function>
        <function name="init" args="conf">
        <![CDATA[
            $data.conf = {};
            if(conf){
                $data.conf = conf;
                if(conf.type){
                    setType(conf.type);
                }
                if(conf.attach_key){
                    setAttachKey(conf.attach_key);
                }
                if(conf.mode){
                    setViewMode(conf.mode);
                }
                if(conf.callback){
                    setAttachCallback(conf.callback);
                }
            }
        ]]>
        </function>
        <function name="setViewMode" args="flag">
        <![CDATA[
            if (flag == 'NODEL') {
                vaultObj.changeMode('NODEL');
            } else if (flag == 'VI' || flag === true) {
                vaultObj.changeMode('VI');
            } else {
                vaultObj.changeMode('');
            }
        ]]>
        </function>
        <function name="setType" args="v">
        <![CDATA[
            vaultObj.setType(v);
        ]]>
        </function>
        <function name="setAttachKey" args="v">
        <![CDATA[
            vaultObj.setAttachKey(v);
        ]]>
        </function>
        <function name="getAttachKey" args="">
        <![CDATA[
            return vaultObj.getAttachKey();
        ]]>
        </function>
        <function name="setAttachCallback" args="fn">
        <![CDATA[
            if(fn){
                $data.conf.callback = fn;
            }
        ]]>
        </function>
        <function name="fileUploadCallback" args="e, a">
        <![CDATA[
            if($data.conf && $data.conf.callback){
                if(typeof($data.conf.callback) == "string"){
                    callFunction('p', $data.conf.callback, [e, a, $data.conf]);
                }else{
                    $data.conf.callback.apply(this, [e, a, $data.conf]);
                }
            }
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
    </template>
</body>