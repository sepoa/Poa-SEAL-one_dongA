<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="COMMON_POPUP" header="false">
    <filterbar id="filterObj" div="TxecjKcuJlcjKcdWzw">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <button id="btnObj"/>
    <usercss>
    <![CDATA[
        >#TxecjKcTxecjKcaMva>div {
            width: calc(100% - 40px);
            padding: 20px 20px;
        }
    ]]>
    </usercss>
    <variable>
        <var name="wSTckKckmVckKcbouF" value="$($sObject._vp).find('#wSTckKckmVckKcbouF')[0]"/>
        <var name="wSTckKcSGackKcdlKU" value="$($sObject._vp).find('#wSTckKcSGackKcdlKU')[0]"/>
        <var name="wSTckKckmVckKctFzX" value="$($sObject._vp).find('#wSTckKckmVckKctFzX')[0]"/>
        <var name="gridBox" value="$($sObject._vp).find('#TxecjKctXgcjKcBEml')[0]"/>
        <var name="TxecjKcsXgcjKcdyXx" value="$($sObject._vp).find('#TxecjKcsXgcjKcdyXx')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <var name="config"/>
        <function name="callback" args="obj">
        <![CDATA[
            if (typeof(Sepoa.params.callback) == 'function') {
                Sepoa.params.callback.apply(null, obj);
            } else if (typeof(Sepoa.params.callback) == 'string') {
                var s = Sepoa.params.callback.split('.');
                var t = fakeParent;
                var base = fakeParent;
                for (var i = 0; i < s.length; i++) {
                    t = t[s[i]];
                    if (i == s.length - 2) base = t;
                }
                t.apply(base, obj);
            }
            window.selfObj.close();
        ]]>
        </function>
        <function name="doClear" args="">
        <![CDATA[
            if (config.multi) {
                callback([
                    []
                ]);
            } else {
                var result = [];
                for (var i = 0; i < 10; i++) {
                    result.push("");
                }
                callback(result);
            }
        ]]>
        </function>
        <function name="doOnRowSelected" args="rId,cInd">
        <![CDATA[
            if (config.multi) {
                var cell = gridObj.cells(rId, gridObj.getColIndexById("SELECTED"));
                if (cell.isChecked()) {
                    cell.setValue(0);
                } else {
                    cell.setValue(1);
                }
            } else {
                var result = [];
                for (var i = 0; i < config.column_name.length; i++) {
                    result.push(gridObj.cells(rId, i).getValue());
                }
            
                callback(result);
            }
        ]]>
        </function>
        <function name="doQuery" args="">
        <![CDATA[
            var str = $.extend(true, [], config.values);
            for (var i in config.column_name) {
                str.push(filterObj.getFilterData().F_KEYWORD || "")
            }
            str = str.join(',');
            
            dataOutput.setValue("CODE", config.code, true)
            dataOutput.setValue("param", str, true)
            
            var param = [];
            param.push("PROCESS_ID=sepoa.svc.co.CO_012")
            param.push("METHOD=getCodeSearch")
            param.push("mode=doQuery")
            
            gridObj.postConnection("/SepoaGrid.sux", param);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="doReturnForMP" args="">
        <![CDATA[
            var grid_array = gridObj.getSelectedRows('SELECTED');
            
            if (grid_array.length <= 0) {
                Alert(Sepoa.cache.text.get("MESSAGE.1004"));
                return
            }
            
            var result = [];
            for (var i = 0; i < grid_array.length; i++) {
                result[i] = [];
                for (var j = 0; j < config.column_name.length; j++) {
                    result[i][j] = gridObj.cells(grid_array[i], j + 1).getValue();
                }
            }
            
            callback([result]);
        ]]>
        </function>
        <function name="init" args="">
        <![CDATA[
            var codeInfo = null;
            doServiceAjax("sepoa.svc.co.CO_012", "CONNECTION", "getCodeInfo", {
                CODE: Sepoa.params.code
            }, function(so) {
                if (so.status == 1) {
                    codeInfo = new SepoaFormater(so.result[0]);
                    codeInfo = codeInfo.getArrayMap();
                    if (codeInfo.length > 0) {
                        codeInfo = codeInfo[0];
                    } else {
                        codeInfo = null;
                    }
                } else {
                    Alert(so.message);
                }
            }, false)
            if (codeInfo == null) {
                Alert(so.message);
                return;
            }
            
            config = {
                code: Sepoa.params.code,
                values: (Sepoa.params.values) ? Sepoa.params.values.split(Sepoa.common.FIELD) : [''],
                auto_search: (Sepoa.params.auto_flag == void 0) ? ((codeInfo.TEXT5 === "N") ? false : true) : dhx.s2b(Sepoa.params.auto_flag),
                column_name: (codeInfo.TEXT3) ? codeInfo.TEXT3.split('#') : ['Code', 'Description(1)', 'Description(2)'],
                multi: (codeInfo.FLAG === "MP") ? true : false,
                title: codeInfo.TEXT1,
                visible_cnt: 0
            }
            
            for (var i in config.column_name) {
                if (config.column_name[i] != "hidden") {
                    config.visible_cnt++;
                }
            }
            
            initGrid(config);
            initButton(config.multi);
            
            if (config.auto_search) {
                doQuery();
            }
            
            SUX.callEvent('onWindowResize', []);
        ]]>
        </function>
        <function name="initButton" args="">
        <![CDATA[
            if (config.multi) {
                btnObj.addButton({
                    "div": wSTckKciRcckKcHUEe,
                    "id": "SUBMIT",
                    "text": "{BUTTON.confirm}",
                    "type": "save",
                    onclick: function() {
                        onButtonClick('SUBMIT')
                    }
                });
            }
            btnObj.addButton({
                "div": wSTckKciRcckKcHUEe,
                "id": "CLEAR",
                "text": "{BUTTON.clear}",
                "type": "delete",
                onclick: function() {
                    onButtonClick('CLEAR')
                }
            });
        ]]>
        </function>
        <function name="initGrid">
        <![CDATA[
            var width = gridBox.offsetWidth - 21;
            var gridOptions = {};
            
            if (config.multi) {
                gridOptions.SELECTED = {
                    LANGUAGE: "KO",
                    SELECTED_YN: "Y",
                    COL_FORMAT: "",
                    COL_SEQ: "0",
                    TEXT_STYLE: "",
                    NOT_NULL: "0",
                    COL_WIDTH: "40",
                    COL_MAX_LEN: "10000",
                    CONTENTS: "선택",
                    COL_SORT: "",
                    COL_VISIBLE: "true",
                    CODE: "SELECTED",
                    COL_TYPE: "ch",
                    COL_ALIGN: "center",
                    COL_COLOR: "Rcolor",
                    TEMPLATE: "",
                    COL_COMBO: ""
                }
                width -= 40;
            }
            
            for (var i = 0; i < config.column_name.length; i++) {
                gridOptions["TEXT" + i] = {
                    LANGUAGE: "KO",
                    SELECTED_YN: "Y",
                    COL_FORMAT: "",
                    COL_SEQ: (i + 1),
                    TEXT_STYLE: "",
                    NOT_NULL: "0",
                    COL_WIDTH: (Math.ceil(width / config.visible_cnt)) + "",
                    COL_MAX_LEN: "10000",
                    CONTENTS: config.column_name[i],
                    COL_SORT: "",
                    COL_VISIBLE: (config.column_name[i] == "hidden") ? "false" : "true",
                    CODE: "TEXT" + i,
                    COL_TYPE: "ro",
                    COL_ALIGN: "center",
                    COL_COLOR: "Rcolor",
                    TEMPLATE: "",
                    COL_COMBO: ""
                }
            }
            
            gridObj = $sObject.gridObj = new SepoaDhtmlXGridObject(gridBox, 'gridObj', gridOptions);
            gridObj._onDnDFlag = true;
            gridObj.setGridDraw();
            gridObj.setSizes();
            gridObj.setDataOutput(dataOutput)
            gridObj.attachEvent("onRowSelect", doOnRowSelected);
            Sepoa.attachEvent('onLoad', function() {
                gridObj.setSizes();
            });
            SUX.attachEvent('onWindowResize', function() {
                gridObj.setSizes();
            });
            gridObj.ednNullEnabled(true);
        ]]>
        </function>
        <function name="onButtonClick" args="id">
        <![CDATA[
            if (id == "SUBMIT") {
                doReturnForMP();
            } else if (id == "CLEAR") {
                doClear();
            }
        ]]>
        </function>
        <function name="onSearch" args="flag">
        <![CDATA[
            if (flag == "filter" || flag == "search") {
                doQuery();
            }
        ]]>
        </function>
    </userscript>
