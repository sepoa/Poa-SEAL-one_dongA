<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="COMMON_EDITOR" header="false">
    <link>
    <![CDATA[
        <script src="<%=CONTEXT_NAME%>/resource/plugin/tinymce/tinymce.min.js" type="text/javascript"></script>
        <script src="<%=CONTEXT_NAME%>/resource/plugin/tinymce/webeditor.js" type="text/javascript"></script>
    ]]>
    </link>
    <button id="btnObj">
        <btn div="vSpzpoeztszpoenCLa" id="CLOSE" text="{BASE_BUTTON.CLOSE}" type="back" toggle="false" reverse="false" onclick="doClose()"/>
        <btn div="vSpzpoeztszpoenCLa" id="SAVE" text="{BASE_BUTTON.SAVE}" type="save" toggle="false" reverse="false" onclick="doSave()"/>
    </button>
    <usercss>
    <![CDATA[
        .sepoa-popup-editor-wrapper {
            height: calc(100% - 32px - 70px);
            margin: 16px 2px 0;
        }
        
        .sepoa-popup-editor-base {
            width: 100%;
            height: 100%;
        }
    ]]>
    </usercss>
    <variable>
        <var name="editorContainer" value="$($sObject._vp).find('#vSpzpoeDyGAqoepBa')[0]"/>
        <var name="vSpzpoeCyGAqoenyrO" value="$($sObject._vp).find('#vSpzpoeCyGAqoenyrO')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <var name="$var" value="{}"/>
        <function name="init">
        <![CDATA[
            $var.config = {
                mode:Sepoa.params.mode,
                data:Sepoa.params.data,
                callback:Sepoa.params.callback,
                isEncode:Sepoa.params.isEncode
            }
            
            $var.selfObj = selfObj;
            $var.winObj = selfObj[selfObj.name];
            $var.elem = {}
            $var.elem.wrapper = editorContainer.appendChild($('<div class="sepoa-popup-editor-wrapper"><div class="sepoa-popup-editor-base"></div></div>')[0]);
            $var.elem.base = $var.elem.wrapper.children[0];
            
            setTitle(Sepoa.params.title || "");
            initTinyMCE($var.elem.base, onEditorLoadEnd, Sepoa.info.LANGAUGE);
        ]]>
        </function>
        <function name="onEditorLoadEnd">
        <![CDATA[
            $var.editor = tinyMCE.activeEditor;
            
            setViewMode($var.config.mode);
            setData($var.config.data);
            
        ]]>
        </function>
        
        <function name="setTitle" args="title">
        <![CDATA[
            $var.winObj.setText(title);
        ]]>
        </function>
        <function name="setViewMode" args="mode">
        <![CDATA[
            if(mode === 'view'){
                btnObj.showButton('SAVE', false);
                //$var.editor.setMode("readonly");
            }else{
                $var.editor.setMode("code");
            }
        ]]>
        </function>
        <function name="setData" args="data">
        <![CDATA[
            if(data){
                var content = $var.config.data;
                if($var.config.isEncode !== false){
                    content = sUtils.string.decodeHTML(content);
                }
                $var.editor.setContent(content);
            }
        ]]>
        </function>
        <function name="doClose">
        <![CDATA[
            $var.selfObj.close();
        ]]>
        </function>
        <function name="doSave">
        <![CDATA[
            if($var.config.callback){
                $var.config.callback(tinyMCE.activeEditor.getContent());
            }
            $var.selfObj.close();
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
