<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="REMARK" header="false">
    <variable>
        <var name="formbox" value="$($sObject._vp).find('#aHNvbydoJUvbydvqXk')[0]"/>
        <var name="aHNvbydnJUvbydxcHO" value="$($sObject._vp).find('#aHNvbydnJUvbydxcHO')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <var name="formObj"/>
        <var name="viewMode"/>
        <var name="g_fn"/>
        <function name="init" args="">
        <![CDATA[
            var formOptions = [{
                    "type": "settings",
                    "position": "label-top"
                },
                {
                    "type": "block",
                    "width": "auto",
                    "list": [{
                        "type": "editor",
                        "name": "REMARK",
                        "inputWidth": formbox.offsetWidth - 2,
                        "inputHeight": formbox.offsetHeight - 11,
                        "value": ""
                    }]
                }
            ];
            
            formObj = $sObject.formObj = new SepoaMultiDhtmlXFormObject(formbox, 'formObj', [formOptions], true);
            formObj.enableLiveValidation(true);
            formObj.attachEvent('onBlur', function(id) {
                if (id == "REMARK") {
                    remarkCallback('onBlur', formObj.getEditor("REMARK").getContent());
                }
            });
            
            SUX.attachEvent('onWindowResize', function(){
                var editor = formObj.getEditor('REMARK');
                editor.base.style.height = formbox.offsetHeight - 11 + 'px'
                editor.base.style.width = formbox.offsetWidth - 2 + 'px'
                editor.setSizes();
            })
            
            if(Sepoa.request.isPopup) {
            	var remark = Sepoa.params.remark;
	            var viewMode = Sepoa.params.viewMode;
	            
	            if(remark) {
	            	setRemark(remark);
	            }
	            
	            if(viewMode) {
	            	setViewMode(viewMode);
	            }
            }
        ]]>
        </function>
        <function name="getRemark" args="">
        <![CDATA[
            if (viewMode) {
                formObj.setViewMode(viewMode);
            }
            
            return formObj.getEditor("REMARK").getContent();
        ]]>
        </function>
        <function name="setRemark" args="c">
        <![CDATA[
            if (viewMode) {
                formObj.setViewMode(viewMode);
            }
            
            formObj.getEditor("REMARK").setContent(c);
        ]]>
        </function>
        <function name="setViewMode" args="mode">
        <![CDATA[
        	if(typeof(mode) == 'string') {
        		if(mode.toLocaleLowerCase() === 'true') {
        			mode = true;
        		} else {
        			mode = false;
        		}
        	}
        
            viewMode = mode;
            formObj.setViewMode(mode);
        ]]>
        </function>
        <function name="setRemarkCallback" args="fn">
        <![CDATA[
            g_fn = fn;
        ]]>
        </function>
        <function name="remarkCallback" args="type, data">
        <![CDATA[
            if (viewMode) return;
            if (!g_fn) return;
            
			if(typeof(g_fn) == "string"){
				callFunction('p', g_fn, [getScreenId(formbox), type, data]);
			}else{
				g_fn.apply(this, [getScreenId(formbox), type, data]);
			}
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
