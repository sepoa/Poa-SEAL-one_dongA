<?xml version="1.0" encoding="UTF-8"?>
<body>
	<item ignore-error="true">
		<query vendor="ORACLE">
		<![CDATA[
CREATE TABLE "UTOKN" (
	"TOKEN_ID"       varchar2(50) not null,
	"ADD_DATE"	     varchar2(8)  ,
	"ADD_TIME"	     varchar2(6)  ,
	"CHANGE_DATE"	 varchar2(8)  ,
	"CHANGE_TIME"	 varchar2(6)  ,
	"CREATE_DATE"	 varchar2(20) ,
	"EXPIRE_DATE"    varchar2(20) ,
	"UNIT_TIME"	     varchar2(10) ,
	"DISPOSABLE"	 varchar2(2)  ,
	"AUTORENEWAL"	 varchar2(2)  ,
	"EXT_DATA"		 CLOB,
CONSTRAINT PK_UTOKN PRIMARY KEY ("TOKEN_ID")
)
		]]>
		</query>
	</item>
	<item ignore-error="true"><query vendor="ORACLE"><![CDATA[ COMMENT ON TABLE UTOKN IS '[F/W] 토큰관리'  ]]></query></item>
