	<item ignore-error="true"><query vendor="ORACLE"><![CDATA[ COMMENT ON COLUMN UTOKN.CHANGE_TIME IS '변경시간' ]]></query></item>
	<item ignore-error="true"><query vendor="ORACLE"><![CDATA[ COMMENT ON COLUMN UTOKN.CREATE_DATE IS '토큰 생성 시간 long']]></query></item>
	<item ignore-error="true"><query vendor="ORACLE"><![CDATA[ COMMENT ON COLUMN UTOKN.EXPIRE_DATE IS '토큰 만료 시간 long']]></query></item>
	<item ignore-error="true"><query vendor="ORACLE"><![CDATA[ COMMENT ON COLUMN UTOKN.UNIT_TIME   IS '토큰 갱신 단위 시간']]></query></item>
	<item ignore-error="true"><query vendor="ORACLE"><![CDATA[ COMMENT ON COLUMN UTOKN.DISPOSABLE  IS '일회용 여부']]></query></item>
