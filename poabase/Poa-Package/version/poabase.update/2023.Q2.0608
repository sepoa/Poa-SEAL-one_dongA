	<item ignore-error="true">
		<query vendor="MARIADB">
		<![CDATA[
CREATE TABLE `UTOKN` (
	`TOKEN_ID`       varchar(50) not null COMMENT '토큰 ID',
	`ADD_DATE`	     varchar(8)  default null COMMENT '생성일',
	`ADD_TIME`	     varchar(6)  default null COMMENT '생성시간',
	`CHANGE_DATE`	 varchar(8)  default null COMMENT '변경일',
	`CHANGE_TIME`	 varchar(6)  default null COMMENT '변경시간',
	`CREATE_DATE`	 varchar(20) default null COMMENT '토큰 생성 시간 long',
	`EXPIRE_DATE`    varchar(20) default null COMMENT '토큰 만료 시간 long',
	`UNIT_TIME`	     varchar(10) default null COMMENT '토큰 갱신 단위 시간',
	`DISPOSABLE`	 varchar(2)  default null COMMENT '일회용 여부',
	`AUTORENEWAL`	 varchar(2)  default null COMMENT '자동 갱신 여부',
	`EXT_DATA`		 mediumtext  default null COMMENT '추가 데이터',
	PRIMARY KEY (`TOKEN_ID`)
) COMMENT = '[F/W] 토큰관리'
		]]>
		</query>
	</item>
	<item ignore-error="true">
		<query vendor="MSSQL">
		<![CDATA[
CREATE TABLE [UTOKN] (
	[TOKEN_ID]       nvarchar(50) not null,
	[ADD_DATE]	     nvarchar(8)  ,
	[ADD_TIME]	     nvarchar(6)  ,
	[CHANGE_DATE]	 nvarchar(8)  ,
	[CHANGE_TIME]	 nvarchar(6)  ,
	[CREATE_DATE]	 nvarchar(20) ,
	[EXPIRE_DATE]    nvarchar(20) ,
	[UNIT_TIME]	     nvarchar(10) ,
	[DISPOSABLE]	 nvarchar(2)  ,
	[AUTORENEWAL]	 nvarchar(2)  ,
	[EXT_DATA]		 text  ,
	CONSTRAINT PK_UTOKN PRIMARY KEY ([TOKEN_ID])
)		]]>
		</query>
	</item>
	<item ignore-error="true"><query vendor="MSSQL"><![CDATA[ EXEC sp_addextendedproperty 'MS_Description', '[F/W] 토큰관리'     , 'USER', dbo, 'TABLE', UTOKN  ]]></query></item>
