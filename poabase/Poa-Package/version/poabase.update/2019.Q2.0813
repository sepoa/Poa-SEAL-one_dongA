	<item ignore-error="true">
		<query vendor="ORACLE">
		<![CDATA[
			CREATE TABLE SDPGL
		   	(	DEPLOY_ID VARCHAR2(20), 
				SERVER_URL VARCHAR2(50), 
				DESCRIPTION VARCHAR2(200), 
				ADD_DATE VARCHAR2(8), 
				ADD_TIME VARCHAR2(6), 
				ADD_USER_ID VARCHAR2(20), 
				CHANGE_DATE VARCHAR2(8), 
				CHANGE_TIME VARCHAR2(6), 
				CHANGE_USER_ID VARCHAR2(20), 
				SOURCE_TEMP_DIR VARCHAR2(200), 
				TARGET_TEMP_DIR VARCHAR2(200), 
				CONSTRAINT PK_SDPGL PRIMARY KEY (DEPLOY_ID)
			)
		]]>
		</query>
	</item>
