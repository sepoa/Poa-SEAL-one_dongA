<?xml version="1.0" encoding="UTF-8"?>
<body>
	<item ignore-error="true">
		<query vendor="MARIADB">
		<![CDATA[
			CREATE TABLE SLANG_HISTORY
			(
				  HISTORY_KEY VARCHAR(20) NOT NULL
				, ACTION_MODE VARCHAR(10) NOT NULL
				, HOUSE_CODE VARCHAR(10) NOT NULL
				, SCREEN_ID VARCHAR(30) NOT NULL
				, LANGUAGE VARCHAR(5) NOT NULL
				, CODE VARCHAR(60) NOT NULL
				, CONTENTS TEXT
				, ADD_USER_ID VARCHAR(20)
				, ADD_DATE VARCHAR(8)
				, ADD_TIME VARCHAR(6)
				, GRID_WIDTH VARCHAR(10)
				, FORM_WIDTH VARCHAR(10)
				, PRIMARY KEY (HISTORY_KEY, HOUSE_CODE, SCREEN_ID, LANGUAGE, CODE)
			)
		]]>
		</query>
	</item>
	<item ignore-error="true">
		<query vendor="MARIADB">
		<![CDATA[
			CREATE TABLE SGRID_HISTORY
			(
				  HISTORY_KEY VARCHAR(20) NOT NULL
				, ACTION_MODE VARCHAR(10) NOT NULL
				, HOUSE_CODE VARCHAR(50)
				, GRID_ID VARCHAR(50) NOT NULL
				, CODE VARCHAR(50) NOT NULL
				, ADD_USER_ID VARCHAR(60)
				, ADD_DATE VARCHAR(50)
				, ADD_TIME VARCHAR(50)
				, COL_TYPE VARCHAR(50)
				, COL_FORMAT VARCHAR(50)
				, COL_WIDTH VARCHAR(50)
				, COL_MAX_LEN VARCHAR(50)
				, COL_ALIGN VARCHAR(50)
				, COL_VISIBLE VARCHAR(50)
				, SELECTED_YN VARCHAR(50)
				, COL_SEQ DECIMAL(22, 2)
				, COL_COLOR VARCHAR(50)
				, COL_COMBO VARCHAR(100)
				, COL_SORT VARCHAR(50)
				, ACC_DATE VARCHAR(50)
				, NOT_NULL VARCHAR(50)
				, TEMPLATE TEXT
				, TEXT_STYLE VARCHAR(50)
				, MODULE VARCHAR(50)
				, PRIMARY KEY (HISTORY_KEY, HOUSE_CODE, GRID_ID, CODE)
			)
		]]>
		</query>
	</item>
	
	<item ignore-error="true">
		<query vendor="MARIADB">
		<![CDATA[
			CREATE TABLE SFORM_HISTORY
			(
				  HISTORY_KEY VARCHAR(20) NOT NULL
				, ACTION_MODE VARCHAR(10) NOT NULL
				, HOUSE_CODE VARCHAR(50)
				, FORM_ID VARCHAR(50)
				, FORM_JSON MEDIUMTEXT
				, ADD_USER_ID VARCHAR(60)
				, ADD_DATE VARCHAR(50)
				, ADD_TIME VARCHAR(50)
				, PRIMARY KEY (HISTORY_KEY, HOUSE_CODE, FORM_ID)
			)
		]]>
		</query>
	</item>
	
	<item ignore-error="true">
		<query vendor="MARIADB">
		<![CDATA[
			CREATE TABLE SMUID_HISTORY
			(
				  HISTORY_KEY VARCHAR(20) NOT NULL
				, ACTION_MODE VARCHAR(10) NOT NULL
				, HOUSE_CODE VARCHAR(10) NOT NULL
				, SCREEN_ID VARCHAR(30) NOT NULL
				, PARENT_ID VARCHAR(30)
				, URL TEXT
				, AUTH_URL TEXT
				, ADD_DATE VARCHAR(8)
				, ADD_TIME VARCHAR(6)
				, ADD_USER_ID VARCHAR(50)
				, DEL_FLAG VARCHAR(2)
				, MENU_IMG TEXT
				, SUMMARY_FLAG VARCHAR(1)
				, ATTACH_NO VARCHAR(20)
				, HIDDEN_FLAG VARCHAR(5)
				, PRIMARY KEY (HISTORY_KEY, HOUSE_CODE, SCREEN_ID)
			)
		]]>
		</query>
	</item>
	
	<item ignore-error="true">
		<query vendor="MARIADB">
		<![CDATA[
			CREATE TABLE SMUPD_HISTORY
			(
				  HISTORY_KEY VARCHAR(20) NOT NULL
				, ACTION_MODE VARCHAR(10) NOT NULL
				, HOUSE_CODE VARCHAR(10) NOT NULL
				, COMPANY_CODE VARCHAR(10)
				, MENU_PROFILE_CODE VARCHAR(20) NOT NULL
				, MENU_ID VARCHAR(20) NOT NULL
				, SCREEN_ID VARCHAR(30)
				, PARENT_MENU_ID VARCHAR(20) NOT NULL
				, MENU_SEQ VARCHAR(3)
				, ITEM_SEQ VARCHAR(3)
				, ADD_DATE VARCHAR(8)
				, ADD_TIME VARCHAR(6)
				, ADD_USER_ID VARCHAR(50)
				, DEL_FLAG VARCHAR(1)
				, ETC_FLAG VARCHAR(1)
				, HIDDEN_FLAG VARCHAR(2)
				, ICON_TYPE VARCHAR(20)
				, MENU_IMG VARCHAR(20)
				, MODULE VARCHAR(50)
				, PRIMARY KEY (HISTORY_KEY, HOUSE_CODE, MENU_PROFILE_CODE, MENU_ID, PARENT_MENU_ID)
			)
		]]>
		</query>
	</item>
</body>