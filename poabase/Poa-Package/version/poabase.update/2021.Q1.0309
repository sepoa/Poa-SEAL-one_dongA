				CHANGE_DATE VARCHAR(8), 
				CHANGE_TIME VARCHAR(6), 
				CHANGE_USER_ID VARCHAR(20), 
				CONSTRAINT "SCMAM_PK" PRIMARY KEY (HOUSE_CODE, COMPANY_CODE, MODULE)
			)
		]]>
