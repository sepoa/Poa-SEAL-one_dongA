	<item ignore-error="true">
		<query vendor="ORACLE">
		<![CDATA[
			CREATE TABLE SCMAM 
			(	
				HOUSE_CODE VARCHAR2(10) NOT NULL, 
				COMPANY_CODE VARCHAR2(20) NOT NULL, 
				MODULE VARCHAR2(50) NOT NULL, 
				OPTION VARCHAR2(100), 
				ADD_DATE VARCHAR2(8), 
				ADD_TIME VARCHAR2(6), 
				ADD_USER_ID VARCHAR2(20), 
				CHANGE_DATE VARCHAR2(8), 
				CHANGE_TIME VARCHAR2(6), 
				CHANGE_USER_ID VARCHAR2(20), 
				CONSTRAINT SCMAM_PK PRIMARY KEY (HOUSE_CODE, COMPANY_CODE, MODULE)
			)
		]]>
		</query>
	</item>
	<item ignore-error="true">
