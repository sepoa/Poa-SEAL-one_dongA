<body>
	<item ignore-error="true">
		<query vendor="ORACLE">
		<![CDATA[
			CREATE TABLE SMUFP
			(
				  HOUSE_CODE VARCHAR2(10) NOT NULL
				, MENU_PROFILE_CODE VARCHAR2(20) NOT NULL
				, MENU_ID VARCHAR2(20) NOT NULL
				, ADD_USER_ID VARCHAR2(100) NOT NULL
				, ADD_DATE VARCHAR2(8) NOT NULL
				, ADD_TIME VARCHAR2(6) NOT NULL
				, CONSTRAINT "SMUFP_PK" PRIMARY KEY (HOUSE_CODE, MENU_PROFILE_CODE, MENU_ID)
			)
		]]>
		</query>
	</item>
