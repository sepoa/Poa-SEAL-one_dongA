	<item ignore-error="true">
		<query vendor="ORACLE">
		<![CDATA[
			CREATE TABLE USERVICE
			(
				  HOUSE_CODE VARCHAR2(10) NOT NULL
				, COMPANY_CODE VARCHAR2(10) NOT NULL
				, COMPANY_NAME VARCHAR2(100) NOT NULL
				, IRS_NO VARCHAR2(10) NOT NULL
