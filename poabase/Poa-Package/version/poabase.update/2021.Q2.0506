				, ADD_USER_ID VARCHAR2(100) NOT NULL
				, ADD_DATE VARCHAR2(8) NOT NULL
				, ADD_TIME VARCHAR2(6) NOT NULL
				, CHANGE_USER_ID VARCHAR2(100) NOT NULL
				, CHANGE_DATE VARCHAR2(8) NOT NULL
				, CHANGE_TIME VARCHAR2(6) NOT NULL
				, DEL_FLAG VARCHAR2(1) DEFAULT 'N' NOT NULL
				, CONSTRAINT "USERVICE_PK" PRIMARY KEY (HOUSE_CODE, COMPANY_CODE)
			)
		]]>
		</query>
	</item>
