	<item ignore-error="true">
		<query name="sepoa.svc.admin.AD_014" method="doInsertHeader" />
		<params>
			<list>
				<map>
					<entry key="MODULE_TYPE" val="S000" />
					<entry key="TYPE" val="UX0001" />
					<entry key="LANGUAGE" val="EN" />
					<entry key="FLAG" val="SL" />
					<entry key="USE_FLAG" val="Y" />
					<entry key="TEXT1" val="ClientCombo" />
					<entry key="TEXT2" val="ClientCombo" />
					<entry key="TEXT4" val="SELECT HOUSE_CODE AS CODE, HOUSE_CODE AS TEXT FROM USERVICE WHERE DEL_FLAG = ? GROUP BY HOUSE_CODE" />
					<entry key="DEL_FLAG" val="N" />
				</map>
				<map>
					<entry key="MODULE_TYPE" val="S000" />
					<entry key="TYPE" val="UX0001" />
					<entry key="LANGUAGE" val="KO" />
					<entry key="FLAG" val="SL" />
					<entry key="USE_FLAG" val="Y" />
					<entry key="TEXT1" val="클라이언트콤보" />
					<entry key="TEXT2" val="클라이언트콤보" />
					<entry key="TEXT4" val="SELECT HOUSE_CODE AS CODE, HOUSE_CODE AS TEXT FROM USERVICE WHERE DEL_FLAG = ? GROUP BY HOUSE_CODE" />
					<entry key="DEL_FLAG" val="N" />
				</map>
			</list>
		</params>
	</item>
