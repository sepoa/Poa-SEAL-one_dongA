				</map>
				<map>
					<entry key="GRID_ID" val="AD_120" />
					<entry key="LANGUAGE" val="KO" />
					<entry key="CODE" val="MESSAGE_0001" />
					<entry key="CONTENTS" val="의 옵션을 선택하세요" />
				</map>
				<map>
					<entry key="GRID_ID" val="AD_120" />
					<entry key="LANGUAGE" val="KO" />
					<entry key="CODE" val="MESSAGE_0002" />
					<entry key="CONTENTS" val="모듈코드는 중복될 수 없습니다." />
				</map>
				<map>
					<entry key="GRID_ID" val="AD_120" />
