	</item>
	<item ignore-error="true">
		<query name="sepoa.svc.admin.AD_022_3" method="doInsertData" />
		<params>
			<list>
				<map>
					<entry key="GRID_ID" val="AD_120" />
					<entry key="CODE" val="DESCRIPTION" />
					<entry key="COL_TYPE" val="txttxt" />
					<entry key="COL_MAX_LEN" val="10000" />
					<entry key="COL_ALIGN" val="left" />
					<entry key="COL_VISIBLE" val="true" />
					<entry key="COL_SEQ" val="60.00" />
					<entry key="COL_COLOR" val="Rcolor" />
					<entry key="NOT_NULL" val="0" />
				</map>
				<map>
					<entry key="GRID_ID" val="AD_120" />
					<entry key="CODE" val="MODULE" />
					<entry key="COL_TYPE" val="edtxt" />
					<entry key="COL_MAX_LEN" val="10000" />
					<entry key="COL_ALIGN" val="left" />
					<entry key="COL_VISIBLE" val="true" />
					<entry key="COL_SEQ" val="30.00" />
					<entry key="COL_COLOR" val="Rcolor" />
					<entry key="NOT_NULL" val="1" />
				</map>
				<map>
					<entry key="GRID_ID" val="AD_120" />
					<entry key="CODE" val="PARENT" />
					<entry key="COL_TYPE" val="ro" />
					<entry key="COL_MAX_LEN" val="10000" />
					<entry key="COL_ALIGN" val="left" />
					<entry key="COL_VISIBLE" val="false" />
					<entry key="COL_SEQ" val="35.00" />
					<entry key="COL_COLOR" val="Rcolor" />
					<entry key="NOT_NULL" val="1" />
				</map>
				<map>
					<entry key="GRID_ID" val="AD_120" />
					<entry key="CODE" val="SELECTED" />
					<entry key="COL_TYPE" val="ch" />
					<entry key="COL_MAX_LEN" val="10000" />
					<entry key="COL_ALIGN" val="center" />
					<entry key="COL_VISIBLE" val="true" />
					<entry key="SELECTED_YN" val="Y" />
					<entry key="COL_SEQ" val="10" />
					<entry key="COL_COLOR" val="Rcolor" />
					<entry key="NOT_NULL" val="0" />
				</map>
				<map>
					<entry key="GRID_ID" val="AD_120" />
					<entry key="CODE" val="SORT" />
					<entry key="COL_TYPE" val="ro" />
					<entry key="COL_MAX_LEN" val="10000" />
					<entry key="COL_ALIGN" val="center" />
					<entry key="COL_VISIBLE" val="false" />
					<entry key="COL_SEQ" val="70" />
					<entry key="COL_COLOR" val="Rcolor" />
					<entry key="NOT_NULL" val="0" />
				</map>
				<map>
					<entry key="GRID_ID" val="AD_120" />
					<entry key="CODE" val="TREE_ID" />
					<entry key="COL_TYPE" val="tree" />
					<entry key="COL_MAX_LEN" val="10000" />
					<entry key="COL_ALIGN" val="left" />
					<entry key="COL_VISIBLE" val="true" />
					<entry key="COL_SEQ" val="20" />
					<entry key="COL_COLOR" val="Rcolor" />
					<entry key="NOT_NULL" val="0" />
				</map>
				<map>
					<entry key="GRID_ID" val="AD_120" />
					<entry key="CODE" val="USE_FLAG" />
					<entry key="COL_TYPE" val="ch" />
					<entry key="COL_MAX_LEN" val="10000" />
					<entry key="COL_ALIGN" val="center" />
					<entry key="COL_VISIBLE" val="true" />
					<entry key="COL_SEQ" val="15" />
					<entry key="COL_COLOR" val="Rcolor" />
					<entry key="NOT_NULL" val="0" />
				</map>
			</list>
		</params>
	</item>
</body>