<?xml version="1.0" encoding="UTF-8"?>
<body>
	<item ignore-error="true">
		<query vendor="common">
		<![CDATA[
			DELETE FROM SLANG WHERE SCREEN_ID  = 'AD_120' 
		]]>
		</query>
	</item>
	<item ignore-error="true">
		<query vendor="common">
		<![CDATA[
			DELETE FROM SGRID WHERE GRID_ID  = 'AD_120' 
		]]>
		</query>
	</item>
	<item ignore-error="true">
		<query name="sepoa.svc.admin.AD_022_3" method="doInsertDataSLANG" />
		<params>
			<list>
				<map>
					<entry key="GRID_ID" val="AD_120" />
					<entry key="LANGUAGE" val="KO" />
					<entry key="CODE" val="BTN_ADD_CHILD_NODE" />
					<entry key="CONTENTS" val="자식노드추가" />
				</map>
				<map>
					<entry key="GRID_ID" val="AD_120" />
					<entry key="LANGUAGE" val="KO" />
					<entry key="CODE" val="BTN_ADD_NODE" />
					<entry key="CONTENTS" val="노드추가" />
				</map>
				<map>
					<entry key="GRID_ID" val="AD_120" />
					<entry key="LANGUAGE" val="KO" />
					<entry key="CODE" val="COMBO" />
					<entry key="CONTENTS" val="콤보코드" />
					<entry key="COL_WIDTH" val="300" />
				</map>
				<map>
					<entry key="GRID_ID" val="AD_120" />
					<entry key="LANGUAGE" val="KO" />
					<entry key="CODE" val="DESCRIPTION" />
					<entry key="CONTENTS" val="비고" />
					<entry key="COL_WIDTH" val="500" />
