				, COL_SORT VARCHAR2(10) DEFAULT NULL
				, COL_COLOR VARCHAR2(20) DEFAULT NULL
				, COL_SEQ VARCHAR2(20) DEFAULT NULL
				, ADD_USER_ID VARCHAR2(20) NOT NULL
				, ADD_DATE VARCHAR2(8) NOT NULL
				, ADD_TIME VARCHAR2(6) NOT NULL
				, CHANGE_USER_ID VARCHAR2(20) NOT NULL
				, CHANGE_DATE VARCHAR2(8) NOT NULL
				, CHANGE_TIME VARCHAR2(6) NOT NULL
				, CONSTRAINT SGRFT_PK PRIMARY KEY (HOUSE_CODE, GRID_ID, CODE)
			)
		]]>
		</query>
	</item>
