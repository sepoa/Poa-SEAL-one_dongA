<?xml version="1.0" encoding="UTF-8"?>
<body>
	<item ignore-error="true">
		<query vendor="ORACLE">
		<![CDATA[
			CREATE TABLE SFFDT
			(				
			      HOUSE_CODE VARCHAR2(10) NOT NULL
				, FORM_ID VARCHAR2(30) NOT NULL
				, BLOCK_NAME VARCHAR2(100) NOT NULL
				, REQUIRED VARCHAR2(2) DEFAULT NULL
				, ADD_USER_ID VARCHAR2(20) NOT NULL
				, ADD_DATE VARCHAR2(8) NOT NULL
				, ADD_TIME VARCHAR2(6) NOT NULL
				, CHANGE_USER_ID VARCHAR2(20) NOT NULL
				, CHANGE_DATE VARCHAR2(8) NOT NULL
				, CHANGE_TIME VARCHAR2(6) NOT NULL
				, CONSTRAINT SFFDT_PK PRIMARY KEY (HOUSE_CODE, FORM_ID, BLOCK_NAME)
			)
		]]>
		</query>
	</item>
	<item ignore-error="true">
		<query vendor="ORACLE">
		<![CDATA[
			CREATE TABLE SGRFT
