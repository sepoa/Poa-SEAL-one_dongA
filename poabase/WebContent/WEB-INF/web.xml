    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/UxDefault/Error/SystemError.sux</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/UxDefault/Error/PageNotFound.sux</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/UxDefault/Error/SystemError.sux</location>
