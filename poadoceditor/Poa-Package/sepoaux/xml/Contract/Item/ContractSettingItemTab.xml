<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="CT_108" header="false" tpl="editor.tpl">
    <tabbar id="tabbarObj" div="RwARElddRDREldqqTI">
        <event type="onTabChanged" callback="onTabChanged"/>
        <event type="onContentLoaded" callback="onContentLoaded"/>
        
    </tabbar>
    <onloadscript>
        <call name="setTabbar"/>
    </onloadscript>
    <userscript>
        <function name="onTabChanged" args="id">
        <![CDATA[
        	var selectedCategory = callFunction('CT_105_'+ id, 'getSelectedCategory', []);
        	gridColumnInit(id);
			doQuery(id, selectedCategory);        
        ]]>
        </function>
        <function name="onContentLoaded" args="id">
        <![CDATA[
        	var fistTabId = tabbarObj.getAllTabs()[0];
        	
        	if(id == fistTabId) {
 		    	tabbarObj._setTabActive(fistTabId);
        	}
        ]]>
        </function>
        <function name="setTabbar" args="">
        <![CDATA[
        	//공통코드 SYSTEM_TYPE를 보고 탭바를 system(cont_type)별로 만들어줌
        	var house_code = Sepoa.info.HOUSE_CODE;
        	var language = Sepoa.info.LANGUAGE;
    		var contTypeList = Sepoa.cache.combo.get('SL0001,'+house_code+'#'+language+'#SYSTEM_TYPE');
        	contTypeList.forEach(function(type){
 		    	tabbarObj.addTab(type.value, type.text);
	 			tabbarObj.cells(type.value).attachURL("/Contract/Item/ContractSettingItemWrite.sux?alias="+type.value);
        	})
        ]]>
        </function>
        <function name="doQuery" args="contType, selectedCategory">
        <![CDATA[
        	callFunction('CT_105_'+ contType, 'doQuery', [contType, selectedCategory]);
        ]]>
        </function>
        <function name="getActiveTabId" args="">
        <![CDATA[
        	return tabbarObj.getActiveTab()
        ]]>
        </function>
        <function name="gridColumnInit" args="id">
        <![CDATA[
        	callFunction('CT_105_'+ id, 'gridColumnInit', [id]);
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
    </template>
</body>