<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="TEXTAREA" header="false">
    <button id="btnObj">
        <btn div="CwJmfPgvNOmfPgcEcA" id="CANCEL" type="back" text="{BUTTON.cancel}" toggle="false" reverse="false" onclick="doClose()"/>
        <btn div="CwJmfPgvNOmfPgcEcA" id="SAVE" type="save" text="{BUTTON.save}" toggle="false" reverse="false" onclick="doSave()"/>
    </button>
    <usercss>
    <![CDATA[
        .sepoaux_component_outer_wrapper.sepoaux_body_outer {
            height: 100%;
        }
        
        .sepoaux_component_inner_wrapper.sepoaux_body_inner {
            height: 100%;
            display: flex;
            flex-direction: column;
        }
        
        .textContainer,
        .textContainer * {
            height: 100%;
        }
        
        .btnContainer {
            padding-bottom: 10px;
        }
    ]]>
    </usercss>
    <variable>
        <var name="textArea" value="$($sObject._vp).find('#CwJmfPguyMmfPgHpBv')[0]"/>
        <var name="textContainer" value="$($sObject._vp).find('#CwJmfPgtyMmfPgqfvR')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <var name="$share" value="{}"/>
        <function name="init">
        <![CDATA[
            textArea.innerHTML = `<textarea id="textbox" style="box-sizing:border-box;width:calc(100% - 20px);height:calc(100% - 20px);resize:none;padding:10px;margin:10px;" placeholder="${placeHolder}"></textarea>`
            $share.text = textArea.children[0];
            if (Sepoa.params.value) {
                $share.text.value = Sepoa.params.value;
            }
        ]]>
        </function>
        <function name="doSave">
        <![CDATA[
            var text = $share.text.value||'';
            if (Sepoa.params.requiredMessage && text.trim().length <= 0) {
                Alert(Sepoa.params.requiredMessage);
                return;
            }
            
            if (Sepoa.params.callback && Sepoa.params.callback(text) !== false) {
                selfObj.close();
            }
        ]]>
        </function>
        
        <function name="doClose">
        <![CDATA[
            selfObj.close();
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
    </template>
</body>