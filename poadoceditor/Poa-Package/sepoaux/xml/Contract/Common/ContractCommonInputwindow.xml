<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="INPUT_POPUP" header="false">
    <button id="btnObj">
        <btn div="wAFAVsdVXRKVsdaeor" id="SAVE" type="save" text="{BUTTON.save}" toggle="false" reverse="false" onclick="onButtonClick( 'SAVE' )"/>
        <btn div="wAFAVsdVXRKVsdaeor" id="CANCEL" type="default" text="{BUTTON.cancel}" toggle="false" reverse="false" onclick="onButtonClick( 'CANCEL' )"/>
    </button>
    <variable>
        <var name="inputWrapper" value="$($sObject._vp).find('#wAFAVsdBKGKVsdvVeJ')[0]"/>
        <var name="inputContainer" value="$($sObject._vp).find('#wAFAVsdBKGKVsdtcDc')[0]"/>
        <var name="wAFAVsdUUWAVsdnFMu" value="$($sObject._vp).find('#wAFAVsdUUWAVsdnFMu')[0]"/>
        <var name="buttonContainer" value="$($sObject._vp).find('#wAFAVsdUUWAVsdohxX')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <var name="formObj"/>
        <function name="init">
        <![CDATA[
            var formOption = [{
                type: "block",
                width: "auto",
                list: [{
                    type: "input",
                    name: "INPUT",
                    position: "label-left",
                    inputWidth: (inputWrapper.parentElement.offsetWidth),
                    inputHeight: ($sObject._vp.children().innerHeight() * 0.2 + '')
                }]
            }]
            formObj = $sObject.formObj = new SepoaMultiDhtmlXFormObject(inputWrapper, 'form', [formOption], true);
        ]]>
        </function>
        <function name="onButtonClick" args="id">
        <![CDATA[
            switch (id) {
                case 'SAVE':
                    if (Sepoa.params && Sepoa.params.callback) {
                        Sepoa.params.callback(formObj.getValue('INPUT'));
                    }
                    selfObj.close();
                    break;
                case 'CANCEL':
                    selfObj.close();
                    break;
                default:
                    break;
            }
        ]]>
        </function>
    </userscript>
