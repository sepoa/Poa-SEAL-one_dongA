<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="CT_102" header="false">
    <filterbar id="filterObj" div="MCtsZhdfjwsZhdSknL">
        <calendar id="F_CALENDAR" button="year:0,month:0,week:-4,day:0" default="ADD_DATE#week:-4" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#CT102"/>
        <keyword id="F_KEYWORD"/>
        <filter>
            <option id="F_CONT_CATEGORY" type="select" combo="CT0004,{HOUSE_CODE}#{LANGUAGE}"/>
            <option id="F_SEQ_LAST_VIEW" type="flag"/>
            <option id="F_EXPIRED_VIEW" type="flag"/>
            <option id="F_CONT_FORM_NAME" type="popup">
                <popup code="CT0005" value="{HOUSE_CODE}#{COMPANY_CODE}"/>
            </option>
        </filter>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <button id="btnObj">
        <btn div="EtvofadQkWpfadeRTN" id="ALTERATION" type="default" text="{POA_CONTRACT.BUTTON_ALTERATION}" onclick="doAlteration(  )" module="CT1634260430709"/>
        <!-- <btn div="EtvofadQkWpfadeRTN" id="DESTRUCTION" type="default" text="{POA_CONTRACT.BUTTON_DESTRUCTION}" onclick="doDestruction(  )"/> 
        <btn div="EtvofadQkWpfadeRTN" id="AFTER_PROCESS_RESTART" type="secondary" text="{POA_CONTRACT.BUTTON_AFTER_PROCESS_RESTART}" onclick="doAfterProcess(  )"/>-->
    </button>
    <grid id="gridObj" div="ASYDyZdgLzEyZdMSyF" grid-id="CT_102_CC" drag="false" merge="false" dynamic="false">
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onRowSelect" callback="onRowSelect"/>
        <event type="onEditCell" callback="onEditCell"/>
        <event type="onRowInserted" callback="onRowInserted"/>
    </grid>
    <usercss>
    <![CDATA[
        .attach-status-box {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .attach-status-box div {
            float: left;
        }
        
        .attach-status-attach-icon {
            display: none;
        }
        
        .attach-status-attach-icon-G {
            display: block;
            width: 29px;
            height: 29px;
            margin-left: 10px;
            background: center / cover url(/resource/design/imgs/grid/ATTAH_IMG.png);
        }
        
        .expired-bold-flag-Y {
            font-weight: bold;
            color: #d12832;
        }
    ]]>
    </usercss>
    <variable>
        <var name="EtvofadWPxofadpUNx" value="$($sObject._vp).find('#EtvofadWPxofadpUNx')[0]"/>
        <var name="EtvofadAXSpfadiCyX" value="$($sObject._vp).find('#EtvofadAXSpfadiCyX')[0]"/>
        <var name="EtvofadWPxofaddSxt" value="$($sObject._vp).find('#EtvofadWPxofaddSxt')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <var name="$share" value="{}"/>
        <var name="$shareFnNames">
        <![CDATA[
            ['doQuery']
        ]]>
        </var>
        <function name="init">
        <![CDATA[
            $share.fn={};
            for(var i in $shareFnNames){
                var fnName = $shareFnNames[i];
                $share.fn[fnName] = $sObject[fnName]; 
            }    
            
            callFunction('p', 'onChildScreenReady', [$share]);
            dataOutput.setValue('TYPE', $share.config.TYPE);
            initDesign();
            initFilter();
            initButton();
            doQuery();
        ]]>
        </function>
        
        <function name="initDesign">
        <![CDATA[
            var styleText = '.sepoa-contract-last-gl-Y{\n'
                          + '    background-color:$.{GRID_CELL_TYPE_SECONDARY_COLOR};\n'
                          + '    color:$.{GRID_CELL_TYPE_SECONDARY_TEXT_COLOR};\n'
                          + '    font-size:$.{GRID_CELL_TYPE_SECONDARY_FONT_SIZE}px;\n'
                          + '    font-weight:$.{GRID_CELL_TYPE_SECONDARY_FONT_WEIGHT};\n'
                          + '    font-style:$.{GRID_CELL_TYPE_SECONDARY_FONT_STYLE};\n'
                          + '    text-decoration:$.{GRID_CELL_TYPE_SECONDARY_FONT_STYLE};\n'
                          + '}'
                          
            sUtils.cache.client.get('DESIGN.GRID_CELL_TYPE_SECONDARY_COLOR');
            styleText = sUtils.string.dataReplacer(styleText, sUtils.cache.client.data.server.DESIGN);
            
            document.body.appendChild($('<style>'+styleText+'</style>')[0]);
        ]]>
        </function>
        
        <function name="initFilter" args="">
        <![CDATA[
            if ($share.config.FILTER && $share.config.FILTER.F_EXPIRED_VIEW) {
                filterObj.getItemById("F_EXPIRED_VIEW").setDefault("checked");
                filterObj.getItemById("F_EXPIRED_VIEW").setValue(true);
            }
        ]]>
        </function>
        
        <function name="initButton">
        <![CDATA[
            if (Sepoa.info.USER_TYPE == 'S') {
                btnObj.showButton('ALTERATION', false);
                btnObj.showButton('DESTRUCTION', false);
                btnObj.showButton('AFTER_PROCESS_RESTART', false);
            }
        ]]>
        </function>
        
        <function name="onSearch" args="id">
        <![CDATA[
            doQuery();
        ]]>
        </function>
        
        <function name="doQuery" args="">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.contract.SepoaContractService', 'METHOD=doDocumentList']);
            gridObj.clearAll(false);
        ]]>
        </function>
        
        <function name="doQueryEnd" args="obj, rowCnt">
        <![CDATA[
            var status = obj.getUserData("", "status");
            var message = obj.getUserData("", "message");
            if (status != 'true') {
                Alert(message);
            }
        ]]>
        </function>
        
        <function name="onRowSelect" args="id, cind">
        <![CDATA[
            var header = gridObj.getColumnId(cind);
            var gridData = gridObj._getRowData(id);
            
            if (!(['SELECTED', 'EXPIRED_ALARM', 'CATEGORY'].indexOf(header) + 1)) {
                $share.fn.doChangeView(gridData);
            }
        ]]>
        </function>
        
        <function name="onEditCell" args="stage,rowId,cellInd,nValue,oValue">
        <![CDATA[
            var header = gridObj.getColumnId(cellInd);
            var gridData = gridObj.getRowDataObject(rowId);
            if (stage == 2) {
                if (header == "EXPIRED_ALARM" || header == "CATEGORY") {
                    gridObj._doOnRowSelect(rowId, gridObj.getColIndexById('SELECTED'));
                    
                    var params = {
                        CONT_NO: gridData.CONT_NO,
                        CONT_GL_SEQ: gridData.CONT_GL_SEQ,
                    };
                    params[header] = nValue;
                    
                    var mode = null;
                    if(header == "EXPIRED_ALARM"){
                        mode = "doChangeAlarm";
                    }else if(header == "CATEGORY"){
                        mode = "doChangeCategory";
                    }
                    return $share.fn.doUpdateDocumentInfo(mode, params);
                }
            }
            return true;
        ]]>
        </function>
        
        <function name="onRowInserted" args="tr">
        <![CDATA[
            $share.fn.doQueryDocumentExtraData(gridObj, tr);
        ]]>
        </function>
      
        <function name="doAlteration" args="">
        <![CDATA[
            var selectedRow = gridObj.getSelectedRows("SELECTED");
            var dataArray = [];
            for(var i in selectedRow){
                dataArray.push(gridObj.getRowDataObject(selectedRow[i]));
            }
            $share.fn.doAlterationDocument(dataArray, doQuery);
        ]]>
        </function>
        
        <function name="doTermination">
        <![CDATA[
            var selectedRow = gridObj.getSelectedRows("SELECTED");
            var dataArray = [];
            for(var i in selectedRow){
                dataArray.push(gridObj.getRowDataObject(selectedRow[i]));
            }
            $share.fn.doTerminationDocument(dataArray, doQuery);
        ]]>
        </function>
        
        <function name="doAfterProcess">
        <![CDATA[
            var selectedRow = gridObj.getSelectedRows("SELECTED");
            var dataArray = [];
            for(var i in selectedRow){
                dataArray.push(gridObj.getRowDataObject(selectedRow[i]));
            }

			$share.fn.doAfterProcess(dataArray, doQuery);
        ]]>
        </function>
    </userscript>
