<?xml version="1.0" encoding="UTF-8"?>
<body>
	<item ignore-error="true">
		<query vendor="MARIADB">
		<![CDATA[
			CREATE TABLE SCTRV (
				HOUSE_CODE varchar(5) NOT NULL COMMENT '하우스 코드',
				CONT_NO varchar(20) NOT NULL COMMENT '계약 문서 번호',
				CONT_GL_SEQ varchar(4) NOT NULL COMMENT '계약 문서 시퀀스 번호',
				SEQ varchar(6) NOT NULL COMMENT '검토 요청 횟수',
				REVIEWER_NO varchar(20) NOT NULL COMMENT '검토자 번호',
				ADD_DATE varchar(8) NOT NULL COMMENT '생성 일자',
				ADD_TIME varchar(6) NOT NULL COMMENT '생성 시간',
				ADD_USER_ID varchar(4000) NOT NULL COMMENT '생성자',
				CHANGE_DATE varchar(8) DEFAULT NULL COMMENT '변경 일자',
				CHANGE_TIME varchar(6) DEFAULT NULL COMMENT '변경 시간',
				CHANGE_USER_ID varchar(4000) DEFAULT NULL COMMENT '변경자',
				REVIEW_SEQ varchar(6) NOT NULL COMMENT '검토 순서 번호',
				REVIEWER_ID varchar(4000) NOT NULL COMMENT '검토자 계정 ID',
				REVIEWER_NAME varchar(300) DEFAULT NULL COMMENT '검토자 이름',
				REVIEWER_EMAIL varchar(300) DEFAULT NULL COMMENT '검토자 E메일',
				REVIEWER_PHONE varchar(100) DEFAULT NULL COMMENT '검토자 연락처',
				REVIEWER_COMPANY_CODE varchar(20) NOT NULL COMMENT '검토자 회사 코드',
				REVIEWER_COMPANY_NAME varchar(300) DEFAULT NULL COMMENT '검토자 회사 이름',
				REVIEWER_COMPANY_OWNER varchar(300) DEFAULT NULL COMMENT '검토자 회사 대표자 이름',
				REVIEWER_COMPANY_ADDR varchar(300) DEFAULT NULL COMMENT '검토자 회사 주소',
				DEL_FLAG varchar(1) NOT NULL COMMENT '삭제 FLAG',
				REVIEW_FLAG varchar(10) NOT NULL COMMENT '검토 상태 코드',
				REVIEW_COMMENT varchar(4000) DEFAULT NULL COMMENT '검토자 코멘트',
				PRIMARY KEY (HOUSE_CODE,CONT_NO,CONT_GL_SEQ,SEQ,REVIEWER_NO)
			)
		]]>
		</query>
	</item>
	
	<item ignore-error="true">
		<query vendor="MSSQL">
		<![CDATA[
			CREATE TABLE SCTRV (
				HOUSE_CODE varchar(5) NOT NULL,
				CONT_NO varchar(20) NOT NULL,
				CONT_GL_SEQ varchar(4) NOT NULL,
				SEQ varchar(6) NOT NULL,
				REVIEWER_NO varchar(20) NOT NULL,
				ADD_DATE varchar(8) NOT NULL,
				ADD_TIME varchar(6) NOT NULL,
				ADD_USER_ID varchar(4000) NOT NULL,
				CHANGE_DATE varchar(8) DEFAULT NULL NULL,
				CHANGE_TIME varchar(6) DEFAULT NULL NULL,
				CHANGE_USER_ID varchar(4000) DEFAULT NULL NULL,
				REVIEW_SEQ varchar(6) NOT NULL,
				REVIEWER_ID varchar(4000) NOT NULL,
				REVIEWER_NAME varchar(300) DEFAULT NULL NULL,
				REVIEWER_EMAIL varchar(300) DEFAULT NULL NULL,
				REVIEWER_PHONE varchar(100) DEFAULT NULL NULL,
				REVIEWER_COMPANY_CODE varchar(20) NOT NULL,
				REVIEWER_COMPANY_NAME varchar(300) DEFAULT NULL NULL,
				REVIEWER_COMPANY_OWNER varchar(300) DEFAULT NULL NULL,
				REVIEWER_COMPANY_ADDR varchar(300) DEFAULT NULL NULL,
				DEL_FLAG varchar(1) NOT NULL,
				REVIEW_FLAG varchar(10) NOT NULL,
				REVIEW_COMMENT varchar(4000) DEFAULT NULL NULL,
				CONSTRAINT SCTRV_PK PRIMARY KEY (HOUSE_CODE,CONT_NO,CONT_GL_SEQ,SEQ,REVIEWER_NO)
			)
		]]>
		</query>
	</item>
	
	<item ignore-error="true">
		<query vendor="ORACLE">
		<![CDATA[
			CREATE TABLE SCTRV (
				HOUSE_CODE VARCHAR2(5) NOT NULL,
				CONT_NO VARCHAR2(20) NOT NULL,
				CONT_GL_SEQ VARCHAR2(4) NOT NULL,
				SEQ VARCHAR2(6) NOT NULL,
				REVIEWER_NO VARCHAR2(20) NOT NULL,
				ADD_DATE VARCHAR2(8) NOT NULL,
				ADD_TIME VARCHAR2(6) NOT NULL,
				ADD_USER_ID VARCHAR2(4000) NOT NULL,
				CHANGE_DATE VARCHAR2(8),
				CHANGE_TIME VARCHAR2(6),
				CHANGE_USER_ID VARCHAR2(4000),
				REVIEW_SEQ VARCHAR2(6) NOT NULL,
				REVIEWER_ID VARCHAR2(4000) NOT NULL,
				REVIEWER_NAME VARCHAR2(300),
				REVIEWER_EMAIL VARCHAR2(300),
				REVIEWER_PHONE VARCHAR2(100),
				REVIEWER_COMPANY_CODE VARCHAR2(20) NOT NULL,
				REVIEWER_COMPANY_NAME VARCHAR2(300),
				REVIEWER_COMPANY_OWNER VARCHAR2(300),
				REVIEWER_COMPANY_ADDR VARCHAR2(300),
				DEL_FLAG VARCHAR2(1) NOT NULL,
				REVIEW_FLAG VARCHAR2(10) NOT NULL,
				REVIEW_COMMENT VARCHAR2(4000),
				CONSTRAINT PK_SCTRV PRIMARY KEY (HOUSE_CODE,CONT_NO,CONT_GL_SEQ,SEQ,REVIEWER_NO)
			)
		]]>
		</query>
	</item>

