#######################################################################################
# Database
#######################################################################################
# Application database & pool
sepoa.app.name=TOMCAT
sepoa.app.use=true

# Pool Name
#sepoa.app.tomcat.datasource = jdbc/poa-oracle-datasource
sepoa.app.tomcat.datasource=jdbc/poa-mariadb-datasource
#sepoa.app.tomcat.datasource = jdbc/poa-mariadb-datasource

# Join Transaction datasource
sepoa.app.mssql.datasource = jdbc/poa-mssql-datasource
sepoa.app.oracle.datasource = jdbc/poa-oracle-datasource
sepoa.app.mariadb.datasource = jdbc/poa-mariadb-datasource

# Join Transaction use vendor
sepoa.admin.sync.jndi=mssql;mariadb;oracle;


#######################################################################################
# System Configuration
#######################################################################################
# Context
sepoa.context.name =

# Development Flag
sepoa.server.development.flag = true

# SSL
sepoa.system.ssl.use_flag=false
sepoa.system.was.ssl.port=7777
sepoa.system.domain.name=http://192.168.50.9:17790/

# Encoding
sepoa.was.encoding = UTF-8

# dashboard 
sepoa.dashboard.url=/Summary/DashBoard/SummaryDashBoard.sux

#######################################################################################
# Logger
#######################################################################################
# Default
sepoa.logger.dir = D:/Dev/Log/poa-seal-ONE/
sepoa.logger.driver = sepoa.fw.log.HouseCodeLoggerWriter
sepoa.logger.autoflush = true

# Trace Level
sepoa.logger.sys.trace = true
sepoa.logger.err.trace = true
sepoa.logger.warn.trace = true
sepoa.logger.info.trace = true
sepoa.logger.debug.trace = true
sepoa.logger.dbwrap.trace = true
sepoa.logger.dev.trace = true

#######################################################################################
# Sepoa F/W Configuration
#######################################################################################
# Auto database update
sepoa.auto.update=true

# Auto session invalidate in index page
sepoa.index.session.invalidate = false

# Service call log
sepoa.userlog.use.flag = true
sepoa.userlog.no_use.program = CO_012.getCodeSearch;CO_012.getCodeInfo;CO_004.setLogout;CO_004.setlogin;CO_004.setLoginProcess

# Sepoa Formatter
sepoa.separator.field = ~
sepoa.separator.line = _

# Service Config
sepoa.service.checkinterval =
sepoa.service.lifetime =
sepoa.service.pool.size.max = 100

# ServicePath
sepoa.license.root=D:/Dev/07.license
sepoa.work.base= D:/Dev/03.WorkSpace/Poa-SEAL-one
sepoa.service.root = $config{sepoa.work.base}/poabase/Poa-Package/
sepoa.doc.base = $config{sepoa.work.base}/poabase/WebContent
sepoa.doc.docCV=$config{sepoa.work.base}/poadoceditor/WebContent
sepoa.doc.seal=$config{sepoa.work.base}/poaseal/WebContent

# Sepoa.properties (Regexp support)
sepoa.javascript.use.config=sepoa.attach.maxsize;sepoa.frame.*;sepoa.context.name;sepoa.debug.*;sepoa.frame.basic.menu.position;sepoa.frame.basic.menu.top.row.max;sepoa.business.module;\
                            sepoa.form.position;sepoa.approval.type.*;sepoa.server.development.flag;sepoa.NICE.URL;sepoa.rm.dept.code;sepoa.seal.manager.porfile.code;sepoa.seal.manager.porfile.code;sepoa.system.manager.profile.code;sepoa.legal.porfile.code;\
                            css.*;sepoa.default.porfile.code;sepoa.user.default.*;sepoa.seal.process;sepoa.dashboard.url;
                            
sepoa.javascript.info=TAX_BILLS_ISSUED_TYPE;BUYER_COMPANY_CODE;COMPANY_CODE;DEPARTMENT;\
                      NAME_LOC;NAME_ENG;PLANT_CODE;PLANT_NAME;LOCATION_CODE;DEPARTMENT_NAME_LOC;\
                      DEPARTMENT_NAME_ENG;LANGUAGE;COUNTRY;EMPLOYEE_NO;ID;POSITION;CITY;LOCATION_NAME;\
                      CTRL_CODE;OWN_CTRL_CODE_LIST;USER_TYPE;IS_ADMIN_USER;MENU_PROFILE_CODE;USER_IP;\
                      HOUSE_CODE;USER_OS_LANGUAGE;COMPANY_NAME;QM_CTRL_CODE;MM_CTRL_CODE;SHIPPER_TYPE;\
                      CTRL_TYPE_CODE_LIST;SELLER_PP_TYPE;AFFILIATED_COMPANY_FLAG;HOUSE_CODE;THEME;DATE_FORMAT;\
                      PUBLIC_EMAIL;BUSINESS_MODULE;WORK_TYPE;CTRL_TYPE;MY_SEAL;


#######################################################################################
# Project
#######################################################################################
# Priority
sepoa.module.priority=CBO,SEAL,CONTRACT,FRWK

# Module Path
sepoa.service.root.CONTRACT=$config{sepoa.work.base}/poadoceditor/Poa-Package/
sepoa.service.root.SEAL  =$config{sepoa.work.base}/poaseal/Poa-Package/
sepoa.service.root.CBO=$config{sepoa.work.base}/poasrm_cbo/000/CBO-Package/

# Custom Servlet Mapping
sepoa.servlet.mapping.SepoaActionController=sepoa.svl.util.SepoaActionController
sepoa.servlet.mapping.SepoaVaultThumb=sepoa.svl.util.SepoaVaultThumb
sepoa.servlet.mapping.SepoaPathToImageThumb=sepoa.svl.util.SepoaPathToImageThumb
sepoa.servlet.mapping.SepoaAttachDigitalSign=sepoa.contract.svl.SepoaAttachDigitalSign
sepoa.servlet.mapping.SepoaPathToImage=sepoa.svl.util.SepoaPathToImage
sepoa.servlet.mapping.SepoaDocumentUpload=sepoa.contract.svl.SepoaDocumentUpload
sepoa.servlet.mapping.sendInquiry=sepoa.svc.sendInquiry.sendInquiry
sepoa.servlet.mapping.SepoaSealRest=sepoa.seal.rest.SepoaSealRest

