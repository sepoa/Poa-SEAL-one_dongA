#######################################################################################
# File attach
#######################################################################################
# Extension
sepoa.file.attach.type = zip;ppt;gul;jpg;doc;xls;gif;bmp;txt;hwp;pdf;docx;xlsx;pptx;jpeg;png;hwpx;
sepoa.file.attach.img.type = jpg;jpeg;png;gif;bmp;

sepoa.file.image.type=image/.*;
sepoa.file.office.type=application/ms.*;application/vnd\.ms.*;application/openxmlformats-officedocument.*
sepoa.file.pdf.type=application/pdf
sepoa.file.tiff.type=application/tiff

# Max Size
sepoa.attach.maxsize=15

# Path Option
sepoa.file.attach.path.house_code=true
sepoa.file.attach.path.year=true
sepoa.file.attach.path.month=true
sepoa.file.attach.path.day=false
sepoa.file.attach.path.hash=2

# Default Path
sepoa.attach.upload      = Z:/ONESOURCE_SEAL/
sepoa.attach.download    = Z:/ONESOURCE_SEAL/

sepoa.attach.upload.CBO=$config{sepoa.work.base}/poasrm_cbo/000/CBO-Package/design/
sepoa.attach.download.CBO=$config{sepoa.work.base}/poasrm_cbo/000/CBO-Package/design/

# Each Path
#sepoa.attach.upload.PR   = D:/Dev/Log/attach/PR
#sepoa.attach.download.PR = D:/Dev/Log/attach/PR

# Ignore Session Check - File
sepoa.nosession.attach = NOT;CBO;seal;

sepoa.seal.process=mk2
#######################################################################################
# File Manager
#######################################################################################
sepoa.filemanager.base.path = $config{sepoa.attach.upload}
sepoa.filemanager.plugin.upload.before.req_seal=FileTypeValidator;ConvertPDF

# Max Size
sepoa.filemanager.file.max.size=50

# Policy
sepoa.filemanager.policy.path.house_code=true
sepoa.filemanager.policy.path.year=true
sepoa.filemanager.policy.path.month=true
sepoa.filemanager.policy.path.day=false
sepoa.filemanager.policy.path.hash=2

sepoa.filemanager.policy.layer.without.session=NOT

sepoa.filemanager.policy.cipher.alg=AES256

# plugin
sepoa.filemanager.plugin.all=History

sepoa.filemanager.plugin.upload.before=FileTypeValidator
sepoa.filemanager.plugin.upload.after=FileMetaData;FileEncryption

sepoa.filemanager.plugin.upload.after.cont_c=Converter;FileMetaData;FileEncryption
sepoa.filemanager.plugin.upload.after.cont_e=Converter;FileMetaData;FileEncryption
sepoa.filemanager.plugin.upload.after.cont_cc=Converter;FileMetaData;FileEncryption
sepoa.filemanager.plugin.upload.after.seal_image=FileMetaData;FileEncryption
sepoa.filemanager.plugin.upload.after.seal_atc=Converter;FileMetaData;FileEncryption

sepoa.filemanager.plugin.copy.before=FileMetaData;PartsMetaData
sepoa.filemanager.plugin.copy.after=FileMetaData;PartsMetaData

sepoa.filemanager.plugin.select.after=SelectDataAdjust;FileMetaData;PartsMetaData

sepoa.filemanager.plugin.modify.after=FileEncryption
sepoa.filemanager.plugin.modify.after.cont_c=Thumbnail;FileEncryption
sepoa.filemanager.plugin.modify.after.cont_e=Thumbnail;FileEncryption
sepoa.filemanager.plugin.modify.after.seal_image=Thumbnail;FileEncryption
sepoa.filemanager.plugin.modify.after.req_seal=Thumbnail;FileEncryption
sepoa.filemanager.plugin.modify.after.seal_atc=Thumbnail;FileEncryption

sepoa.filemanager.plugin.modify.meta=FileMetaData;PartsMetaData

#sepoa.filemanager.plugin.delete.after=PhysicalDelete

sepoa.filemanager.plugin.download.before=FileMetaData;PartsMetaData;DownloadAdjust

# converter plugin option
sepoa.filemanager.plugin.converter.after=PartsMetaData;Thumbnail;FileEncryption
sepoa.filemanager.plugin.converter.impossible.passthroug=true

# thumbnail plugin option
sepoa.filemanager.plugin.thumbnail.create=FileEncryption
sepoa.filemanager.plugin.thumbnail.size=300

# fileencryption plugin option
#sepoa.filemanager.plugin.fileencryption.scan_e=true

# file extention validator plugin option
sepoa.filemanager.plugin.filetypevalidator=files
sepoa.filemanager.plugin.filetypevalidator.cont_c=jpg;jpeg;png;gif;bmp;ppt;pptx;doc;docx;xls;xlsx;hwp;hwpx;pdf;

sepoa.filemanager.plugin.filetypevalidator.preset.images=jpg;jpeg;png;gif;bmp
sepoa.filemanager.plugin.filetypevalidator.preset.files=zip;ppt;gul;jpg;doc;xls;gif;bmp;txt;hwp;pdf;docx;xlsx;pptx;jpeg;png;hwpx;

# insert file meta data plugin option  (default : false);
sepoa.filemanager.plugin.filemetadata.logger=true
sepoa.filemanager.plugin.filemetadata.insert=UPLOAD.AFTER;CONVERTER.AFTER;COPY.AFTER;MODIFY.META
sepoa.filemanager.plugin.filemetadata.select=SELECT.AFTER;DOWNLOAD.BEFORE;COPY.BEFORE

sepoa.filemanager.plugin.filemetadata.cont_c=CONVERT;CONVERT_COUNT;FILE_TYPE
sepoa.filemanager.plugin.filemetadata.cont_e=CONVERT;CONVERT_COUNT;FILE_TYPE
sepoa.filemanager.plugin.filemetadata.cont_b=FILE_TYPE
sepoa.filemanager.plugin.filemetadata.cont_a=FILE_TYPE
sepoa.filemanager.plugin.filemetadata.seal_image=FILE_TYPE
sepoa.filemanager.plugin.filemetadata.req_seal=FIX_HTML
sepoa.filemanager.plugin.filemetadata.seal_atc=CONVERT;CONVERT_COUNT;FILE_TYPE

# insert part meta data plugin option  (default : false);
sepoa.filemanager.plugin.partsmetadata.logger=true
sepoa.filemanager.plugin.partsmetadata.insert=UPLOAD.AFTER;CONVERTER.AFTER;COPY.AFTER;MODIFY.META
sepoa.filemanager.plugin.partsmetadata.select=SELECT.AFTER;DOWNLOAD.BEFORE;COPY.BEFORE

sepoa.filemanager.plugin.partsmetadata.cont_c=FIX_HTML
sepoa.filemanager.plugin.partsmetadata.req_seal=FIX_HTML

# History plugin option
# sepoa.filemanager.plugin.history.active=true (default : false) 
sepoa.filemanager.plugin.history.active.cont_c=true
sepoa.filemanager.plugin.history.active.cont_e=true
sepoa.filemanager.plugin.history.active.cont_b=true
sepoa.filemanager.plugin.history.active.cont_a=true
sepoa.filemanager.plugin.history.active.req_seal=true
sepoa.filemanager.plugin.history.active.seal_image=true
sepoa.filemanager.plugin.history.active.seal_atc=true
sepoa.filemanager.plugin.history.active.all=true

sepoa.filemanager.plugin.history.doc.action=DOLINK.AFTER;CREATE.AFTER;DELETE.BEFORE;STATUS.AFTER;UNLINK.BEFORE;
sepoa.filemanager.plugin.history.file.action=UPLOAD.AFTER;MODIFY.AFTER;DELETE.AFTER;CONVERTER.AFTER;STATUS.AFTER;COPY.AFTER

#######################################################################################
# Sepoa PDF Renderer
#######################################################################################
sepoa.renderer.capture.pool.size=5

// 1 scale == 72 DPI
sepoa.renderer.capture.image.scale=2

sepoa.renderer.browser.chrome.path=C://Program Files/Google/Chrome/Application/chrome.exe

sepoa.renderer.resource.css=/resource/plugin/sepoasoft/ux/sepoa.ux.css;\
							/resource/plugin/sepoasoft/contract/sepoa.contract.module.css;

#######################################################################################
# Action Controller
#######################################################################################
sepoa.action.controller.contract = sepoa.svc.contract.SepoaContractService
sepoa.action.controller.contract.template = sepoa.svc.contract.SepoaContractTemplateService
sepoa.action.controller.seal.management = sepoa.svc.seal.SepoaSealManagementService
sepoa.action.controller.seal.req = sepoa.svc.seal.SepoaReqSealService
sepoa.action.controller.ext.req = sepoa.svc.seal.SepoaReqExternalService

sepoa.action.controller.sealmk2.management=sepoa.svc.sealmk2.SepoaSealManagementService
sepoa.action.controller.sealmk2.req=sepoa.svc.sealmk2.SepoaReqSealService
sepoa.action.controller.extmk2.req=sepoa.svc.sealmk2.SepoaReqExternalService
#######################################################################################
# Grid
#######################################################################################
sepoa.view.rowcount = 50000
sepoa.grid.copy = false
sepoa.grid.view.rowcount = 1000
sepoa.grid.height.min = 200

#######################################################################################
# DOC Converter
#######################################################################################
#Office[MS] to pdf
sepoa.converter.active=true
sepoa.converter.ms.active=true
sepoa.converter.ms.ext=doc;docx;ppt;pptx;xls;xlsx;
sepoa.converter.ms=/WEB-INF/converter/jacob/jacob-1.19-x64.dll
#sepoa.converter.ms=/WEB-INF/converter/MStoPDF.vbs
#sepoa.converter.ms=OpenOffice
#sepoa.converter.ms=Remote
#sepoa.converter.remote.url=http://localhost:19610/
#sepoa.converter.office.home=C:/Program Files (x86)/OpenOffice 4
#sepoa.converter.office.timeout=120000

#Office[Hancom] to pdf
sepoa.converter.hwp.active=true
sepoa.converter.hwp=/WEB-INF/converter/jacob/jacob-1.19-x64.dll
#sepoa.converter.hwp=Remote
sepoa.converter.hwp.ext=hwp;hwpx;

#Html to pdf
sepoa.converter.html=C:/Program Files/Google/Chrome/Application/chrome.exe

# pdf configuration
sepoa.pdf.html.encoding = <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
sepoa.pdf.background.img.agreement=
sepoa.pdf.background.img.progress=
sepoa.pdf.convert.path = D:/Dev/pdf/

#######################################################################################
# Approval
#######################################################################################
#법인인감 날인요청 품의
sepoa.approval.type.J01 = S
#사용인감 날인요청 품의
sepoa.approval.type.J02 = S
#사용인감 반출요청 품의
sepoa.approval.type.J03 = S
#법인인감 등록신청 품의
sepoa.approval.type.J04 = S
