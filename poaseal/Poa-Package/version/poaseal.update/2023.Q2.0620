<?xml version="1.0" encoding="UTF-8"?>
<body>
	<item ignore-error="true">
		<query vendor="MARIADB">
		<![CDATA[
			CREATE TABLE SCTGL (
				HOUSE_CODE varchar(5) NOT NULL COMMENT '하우스 코드',
				COMPANY_CODE varchar(20) NOT NULL COMMENT '회사코드',
				CONT_NO varchar(20) NOT NULL COMMENT '계약 문서 번호',
				CONT_GL_SEQ varchar(20) NOT NULL COMMENT '계약 문서 시퀀스 번호',
				ADD_DATE varchar(8) NOT NULL COMMENT '생성 일자',
				ADD_TIME varchar(6) NOT NULL COMMENT '생성 시간',
				ADD_USER_ID varchar(4000) NOT NULL COMMENT '생성자',
				CHANGE_DATE varchar(8) DEFAULT NULL COMMENT '변경 일자',
				CHANGE_TIME varchar(6) DEFAULT NULL COMMENT '변경 시간',
				CHANGE_USER_ID varchar(4000) DEFAULT NULL COMMENT '변경자',
				CONT_TYPE varchar(1) DEFAULT NULL COMMENT '계약타입 - 정형/비정형/수기계약 (S / N / M)',
				CONT_SUBJECT text DEFAULT NULL COMMENT '계약서 제목',
				DEL_FLAG varchar(1) DEFAULT NULL COMMENT '삭제여부',
				STATUS varchar(2) DEFAULT NULL COMMENT '상태(상신,결재중,결재완료,반려, 서명 진행중, 취소된 계약, 완료 계약서 첨부)',
				CATEGORY varchar(1) DEFAULT NULL COMMENT '카테고리',
				CREATOR varchar(1000) DEFAULT NULL COMMENT '생성자',
				CONT_METHOD varchar(1) DEFAULT NULL COMMENT '계약방법(D-디지털사인,C-인증서,S-수기,O-오프라인)',
				CONT_FORM_NO varchar(20) DEFAULT NULL COMMENT '템플릿 번호 (정형 계약서)',
				CONT_DATE varchar(8) DEFAULT NULL COMMENT '계약체결일',
				CONT_FROM varchar(8) DEFAULT NULL COMMENT '계약시작일',
				CONT_TO varchar(8) DEFAULT NULL COMMENT '계약종료일',
				EXPIRED_ALARM varchar(1) DEFAULT NULL COMMENT '만기도래 관리 여부(Y,N)',
				SUMMARY text DEFAULT NULL COMMENT '계약문서 요약내용',
				PRE_CONT_NUMBER varchar(20) DEFAULT NULL COMMENT '이전 계약번호(재계약일경우 사용됨)',
				GL_SEQ_REASON varchar(1) DEFAULT NULL,
				CONT_AMT varchar(4000) DEFAULT NULL COMMENT '계약금액',
				SIGN_ORDER varchar(3) DEFAULT NULL COMMENT '서명순서',
				DATA_SOURCE varchar(10) DEFAULT NULL COMMENT '데이터 출처(내부시스템 / 외부시스템[시스템타입])',
				INNER_MANAGER_NAME varchar(100) DEFAULT NULL,
				INNER_MANAGER_ID varchar(100) DEFAULT NULL,
				OUTER_COMPANY_NAME varchar(100) DEFAULT NULL,
				OUTER_COMPANY_CODE varchar(100) DEFAULT NULL,
				OUTER_MANAGER_NAME varchar(100) DEFAULT NULL,
				OUTER_MANAGER_ID varchar(100) DEFAULT NULL,
				PUSH_SEND_DATE varchar(8) DEFAULT NULL,
				AP_STATUS varchar(3) DEFAULT NULL,
				AP_MESSAGE text DEFAULT NULL,
				T_ID varchar(20) DEFAULT NULL,
				T_IP varchar(255) DEFAULT NULL,
				T_MESSAGE varchar(2000) DEFAULT NULL,
				T_NAME varchar(100) DEFAULT NULL,
				PRIMARY KEY (HOUSE_CODE,COMPANY_CODE,CONT_NO,CONT_GL_SEQ)
			)
		]]>
		</query>
	</item>
	
