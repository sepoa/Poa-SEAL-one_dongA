	<item ignore-error="true">
		<query vendor="MARIADB">
		<![CDATA[
			CREATE TABLE SCFGL (
				HOUSE_CODE varchar(5) NOT NULL COMMENT '하우스코드',
				COMPANY_CODE varchar(20) NOT NULL COMMENT '회사코드',
				CONT_FORM_NO varchar(20) NOT NULL COMMENT '계약 템플릿 번호',
				ADD_DATE varchar(8) NOT NULL COMMENT '생성일자',
				ADD_TIME varchar(6) NOT NULL COMMENT '생성시간',
				ADD_USER_ID varchar(4000) NOT NULL COMMENT '생성자 ID',
				CHANGE_DATE varchar(8) DEFAULT NULL COMMENT '변경일자',
				CHANGE_TIME varchar(6) DEFAULT NULL COMMENT '변경시간',
				CHANGE_USER_ID varchar(4000) DEFAULT NULL COMMENT '변경자 ID',
				DEL_FLAG varchar(1) DEFAULT NULL COMMENT '삭제여부',
				CONT_FORM_NAME text DEFAULT NULL COMMENT '템플릿 명',
				CONT_FORM_DESC text DEFAULT NULL COMMENT '템플릿 설명',
				STATUS varchar(5) DEFAULT NULL COMMENT '템플릿 상태',
				USE_FLAG varchar(1) DEFAULT NULL COMMENT '사용여부',
				CATEGORY varchar(1) DEFAULT NULL COMMENT '카테고리',
				CONT_METHOD varchar(1) DEFAULT NULL COMMENT '계약방법(D-디지털사인,C-인증서,S-수기,O-오프라인)',
				USE_FROM varchar(8) DEFAULT NULL COMMENT '사용기한 시작일',
				USE_TO varchar(8) DEFAULT NULL COMMENT '사용기한 종료일',
				APP_COMMENT text DEFAULT NULL COMMENT '비고',
				THUMB_FILE_NAME varchar(1000) DEFAULT NULL COMMENT '썸네일파일명',
				ROOT_PATH_TYPE varchar(10) DEFAULT NULL,
				CONT_TYPE varchar(1) DEFAULT NULL,
				SIGNER_CODE varchar(200) DEFAULT NULL,
				PRIMARY KEY (HOUSE_CODE,COMPANY_CODE,CONT_FORM_NO)
			)
		]]>
		</query>
	</item>
	
