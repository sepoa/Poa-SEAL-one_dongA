	<item ignore-error="true">
		<query vendor="MARIADB">
		<![CDATA[
			CREATE TABLE SCTDS (
				HOUSE_CODE varchar(5) NOT NULL COMMENT '하우스 코드',
				CONT_NO varchar(20) NOT NULL COMMENT '계약 문서 번호',
				CONT_GL_SEQ varchar(20) NOT NULL COMMENT '계약 문서 시퀀스 번호',
				SIGNER_NO varchar(20) NOT NULL COMMENT '서명참여자 고유 키 값',
				ADD_DATE varchar(8) NOT NULL COMMENT '생성 일자',
				ADD_TIME varchar(6) NOT NULL COMMENT '생성 시간',
				ADD_USER_ID varchar(4000) NOT NULL COMMENT '생성자',
				CHANGE_DATE varchar(8) DEFAULT NULL COMMENT '변경 일자',
				CHANGE_TIME varchar(6) DEFAULT NULL COMMENT '변경 시간',
				CHANGE_USER_ID varchar(4000) DEFAULT NULL COMMENT '변경자',
				SEQ varchar(6) NOT NULL COMMENT '순서',
				SIGNER_ID varchar(200) NOT NULL COMMENT '서명자ID ( 회사라면 회사코드, 개인이라면 개인ID )',
				SIGNER_NAME varchar(300) DEFAULT NULL COMMENT '서명자 ( 회사라면 회사명, 개인이라면 개인이름 )',
				SIGNER_EMAIL varchar(300) DEFAULT NULL COMMENT '서명자 이메일주소',
				SIGNER_PHONE varchar(100) DEFAULT NULL,
				SIGNER_COMPANY_CODE varchar(20) NOT NULL COMMENT '서명자 회사코드',
				SIGNER_COMPANY_NAME varchar(300) DEFAULT NULL COMMENT '서명자 회사명',
				SIGNER_COMPANY_OWNER varchar(300) DEFAULT NULL COMMENT '서명자 회사 대표',
				SIGNER_COMPANY_ADDR varchar(300) DEFAULT NULL COMMENT '서명자 회사 주소',
				TERMINATION_STATUS varchar(1) DEFAULT NULL COMMENT '서명상태값 (동의, 거부)',
				LINK varchar(50) DEFAULT NULL,
				SIGN_COMMENT varchar(4000) DEFAULT NULL COMMENT '서명의견',
				PRIMARY KEY (HOUSE_CODE,CONT_NO,CONT_GL_SEQ,SIGNER_NO)
			)
		]]>
		</query>
	</item>
	
