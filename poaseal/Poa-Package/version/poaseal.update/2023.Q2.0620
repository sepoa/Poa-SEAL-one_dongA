	<item ignore-error="true">
		<query vendor="MARIADB">
		<![CDATA[
			CREATE TABLE SBUPR (
				HOUSE_CODE varchar(5) NOT NULL COMMENT '하우스코드',
				BIZ_CODE varchar(20) NOT NULL COMMENT '거래처코드',
				BIZ_CATEGORY varchar(20) NOT NULL COMMENT '거래처분류 (C:도급처, S:수급처)',
				BIZ_TYPE varchar(20) NOT NULL COMMENT '거래처타입 (P:매입, S:매출)',
				ADD_DATE varchar(8) NOT NULL COMMENT '생성일자',
				ADD_TIME varchar(6) NOT NULL COMMENT '생성시간',
				ADD_USER_ID varchar(4000) NOT NULL COMMENT '생성자 ID',
				CHANGE_DATE varchar(8) DEFAULT NULL COMMENT '변경일자',
				CHANGE_TIME varchar(6) DEFAULT NULL COMMENT '변경시간',
				CHANGE_USER_ID varchar(4000) DEFAULT NULL COMMENT '변경자 ID',
				DEL_FLAG varchar(1) DEFAULT NULL COMMENT '삭제여부',
				SELLER_NAME_LOC varchar(500) DEFAULT NULL COMMENT '회사명',
				IRS_NO varchar(20) DEFAULT NULL COMMENT '사업자번호',
				ZIP_CODE varchar(10) DEFAULT NULL COMMENT '우편번호',
				ADDRESS_LOC varchar(1000) DEFAULT NULL COMMENT '주소',
				PHONE_NO varchar(100) DEFAULT NULL COMMENT '회사 전화번호',
				EMAIL varchar(500) DEFAULT NULL COMMENT '회사 EMAIL',
				CEO_NAME_LOC varchar(100) DEFAULT NULL COMMENT '대표자명',
				FOUNDATION_DATE varchar(8) DEFAULT NULL COMMENT '개업년월일',
				IF_FLAG varchar(1) DEFAULT NULL COMMENT '수동 등록 여부',
				PRIMARY KEY (HOUSE_CODE,BIZ_CODE,BIZ_CATEGORY, BIZ_TYPE)
			)
		]]>
		</query>
	</item>
	
