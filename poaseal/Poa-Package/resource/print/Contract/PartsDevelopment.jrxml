						<paragraph lineSpacing="Double" lineSpacingSize="1.0"/>
					</textElement>
					<text><![CDATA[1. 대흥알앤티 업체선정프로세스에 준하여 종합평가 결과로 공급업체 선정되었으며, 향후 개발진행에 대해 아래조건으로
    공급자/수요자 상호간 합의한다.]]></text>
				</staticText>
				<staticText>
					<reportElement mode="Opaque" x="0" y="0" width="30" height="92" backcolor="#E1E1E1" uuid="ef1ec30d-e16a-4d18-8ece-7c1ab3b5d76f">
						<property name="com.jaspersoft.studio.unit.x" value="px"/>
