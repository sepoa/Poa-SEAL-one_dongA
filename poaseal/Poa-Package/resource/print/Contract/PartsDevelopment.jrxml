			</componentElement>
			<staticText>
				<reportElement positionType="Float" x="0" y="420" width="555" height="15" uuid="f6e821eb-a3e5-4394-9bf3-8c2e1b6d1876">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<box leftPadding="10" rightPadding="10">
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="1훈고딕굴림 R" size="10"/>
				</textElement>
				<text><![CDATA[2. 공급자는 대흥알앤티 요구사항에 의거 품질목표 10PPM 미만, CAPA 부하율85% 이하를 만족해야 한다.]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="0" y="440" width="555" height="15" uuid="14407fce-787e-4b1d-b460-7befa63939d3">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<box leftPadding="10" rightPadding="10">
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="1훈고딕굴림 R" size="10"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<text><![CDATA[3. 공급자는 부품 개발과 관련하여 취득한 업무상, 기술상, 정보보안 외 "부품거래 기본 계약서" 내용을 준수한다.]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="0" y="460" width="555" height="15" uuid="f73d2ba0-6727-4455-8e5f-61ec4873339d">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<box leftPadding="10" rightPadding="10">
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="1훈고딕굴림 R" size="10"/>
				</textElement>
				<text><![CDATA[4. 공급자는 상기 부품개발에 대한 개발계획서를 부품개발계약일로 부터 7일內 제출한다.]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="0" y="480" width="555" height="30" uuid="66a3715d-f578-400f-b960-10ff5f5ea38a">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<box leftPadding="10" rightPadding="10">
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="1훈고딕굴림 R" size="10"/>
					<paragraph lineSpacing="Double" lineSpacingSize="1.0"/>
				</textElement>
				<text><![CDATA[5. 구매자는 공급자의 제품이 경쟁력이 없다고 판단되는 경우 가격, 기술, 설계, 품질면에서 보다 경쟁력 있는 다른 제품의 구매가 
    가능한 분야를 가능한 범위에서 공급자에게 통지한다. 공급자가 경쟁력 있는 가격 또는 상응하는 기술, 설계, 품질의 제품을 ]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="0" y="510" width="555" height="15" uuid="486e6f95-11b8-4fed-bf83-023f581120b8">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
				</reportElement>
				<box leftPadding="10" rightPadding="10">
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="1훈고딕굴림 R" size="10"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<text><![CDATA[    즉시 공급하기로 30일 내에 합의하지 않으면 구매자는 공급자에 대한 책임없이 계약을 해지하고 구매선을 변경할 수 있다.]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="0" y="531" width="555" height="15" uuid="bf7c4b9a-8ffe-4f40-ba4a-1f2b5b14950e">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.x" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<box leftPadding="10" rightPadding="10">
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="1훈고딕굴림 R" size="10"/>
					<paragraph lineSpacing="1_1_2"/>
				</textElement>
				<text><![CDATA[6. 공급자 개발일정 미준수 및 품질 불만족시 구매자는 서면 통보 후 부품개발계약 무효처리 및 이원화 할 수 있다.]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="0" y="551" width="555" height="30" uuid="ef5adbec-8a5d-4032-8ecf-d714119f6cdf">
					<property name="com.jaspersoft.studio.unit.width" value="px"/>
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<box leftPadding="10" rightPadding="10">
					<topPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineStyle="Solid" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="1훈고딕굴림 R" size="10"/>
					<paragraph lineSpacing="Double"/>
				</textElement>
				<text><![CDATA[7. 거래 유효기간은 대흥알앤티 SOP 기준 최소2년 유지를 합의하며, 개발중지 또는 사양변경, 공법변경에 따른 협력사 변경이 불
   가피 할 경우 본 계약의 효력은 상실된다.]]></text>
			</staticText>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true">
				<reportElement x="370" y="44" width="185" height="21" uuid="5b91906f-e7c9-4ed2-b7bc-fb21972bac0b">
