<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="DF_005" header="false">
    <form id="formObj" div="TkxhnIeVbJinIexvpH" form-id="DF_001"/>
    <button id="buttonObj">
        <btn div="TkxhnIeTwGinIeiRgr" id="download" type="exceldownload" img="down_24.png" toggle="false" reverse="false" onclick="downloadExcel(  )"/>
        <btn div="TkxhnIeTwGinIeiRgr" id="upload" type="excelupload" img="excel.png" toggle="false" reverse="false" onclick="uploadExcel(  )"/>
        <btn div="TkxhnIeTwGinIeiRgr" id="delete" text="{BUTTON.rowdelete}" toggle="false" reverse="false" onclick="doDelete(  )"/>
        <btn div="TkxhnIeTwGinIeiRgr" id="save" text="{BUTTON.insert}" toggle="false" reverse="false" onclick="doSave(  )"/>
    </button>
    <grid id="gridObj" div="TkxhnIegXKinIeIyeQ" grid-id="DF_005" drag="false" merge="false" dynamic="false">
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onTXE" callback="doSaveEnd"/>
    </grid>
    <variable>
        <var name="formBox" value="$($sObject._vp).find('#ivconIeJZeonIeaPXH')[0]"/>
        <var name="buttonBox" value="$($sObject._vp).find('#ivconIeirionIeZfAq')[0]"/>
        <var name="containerObj" value="$($sObject._vp).find('#ivconIeJZeonIekJdy')[0]"/>
    </variable>
    <onloadscript>
        <![CDATA[
            targetId = Sepoa.request.UPLOAD_ID;
            house_code = Sepoa.request.HOUSE_CODE;
            house_name = Sepoa.request.HOUSE_NAME;
            company_code = Sepoa.params.COMPANY_CODE;
            formObj.hideItem('searchImg');
            formObj.setValue('HOUSE_NAME', house_name);
            formObj.setValue('HOUSE_CODE', house_code);
            formObj.setValue('COMPANY_CODE', company_code);
        ]]></onloadscript>
    <userscript>
        <var name="targetId"/>
        <var name="house_code"/>
        <var name="house_name"/>
        <var name="company_code"/>
        <var name="gridData"/>
        <function name="uploadExcel" args="">
        <![CDATA[
            Confirm(Sepoa.cache.text.get('DF_001.doUpload'), function(result) {
                if (result) {
                    gridObj.loadExcel({});
                }
            });
        ]]>
        </function>
        <function name="doQueryEnd" args="">
        <![CDATA[
            for (var i = 0; i < gridObj.getRowsNum(); i++) {
                gridObj.cells2(i, gridObj.getColIndexById('ROW_NUM')).setValue(gridObj.getRowId(i));
            }
        ]]>
        </function>
        <function name="doSave" args="">
        <![CDATA[
            if (gridObj.getRowsNum() < 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.0004'));
                return;
            }
            gridObj.allRowsChecked('SELECTED', true);
            
            var selectedRow = gridObj.getGridChangedRows("SELECTED");
            if (!gridObj.validate()) {
                Alert(Sepoa.cache.text.get('MESSAGE.0002'));
                return;
            }
            
            Confirm(Sepoa.cache.text.get('MESSAGE.1018'), function(result) {
                if (result) {
                    gridObj.editStop();
                    dataOutput.setValue('TARGET_HOUSE', getOAObject('DF_005', 'formObj').getValue('HOUSE_CODE'));
                    dataOutput.setValue('TARGET_COMPANY', getOAObject('DF_005', 'formObj').getValue('COMPANY_CODE'));
                    var params = [];
                    params.push('mode=doSave');
                    params.push('PROCESS_ID=sepoa.svc.df.DF_005');
                    params.push('METHOD=doSave');
            
                    gridObj.postTransaction('/SepoaGrid.sux', params, 'SELECTED');
                }
            });
        ]]>
        </function>
        <function name="doSaveEnd" args="obj">
        <![CDATA[
            var status = obj.status;
            var message = obj.message;
            var gridData = JSON.parse(obj.params);
            
            for (var i = 0; i < gridData.length; i++) {
                gridObj.cells(gridData[i].ROW_NUM, gridObj.getColIndexById('STATUS')).setValue(gridData[i].STATUS);
                gridObj.cells(gridData[i].ROW_NUM, gridObj.getColIndexById('ERR_MSG')).setValue(gridData[i].ERR_MSG);
            }
            Alert(Sepoa.cache.text.get('DF_001.MSG_001'));
        ]]>
        </function>
        <function name="doDelete" args="">
        <![CDATA[
            var selectedRow = gridObj.getGridChangedRows("SELECTED");
            if (selectedRow.length < 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.1004'));
                return;
            }
            Confirm(Sepoa.cache.text.get('DF_001.doDelete'), function(result) {
                if (result) {
                    for (var i = 0; i < selectedRow.length; i++)
                        gridObj.deleteRow(selectedRow[i]);
                }
            });
        ]]>
        </function>
        <function name="downloadExcel" args="id">
        <![CDATA[
            targetId = id;
            var fileId = 'VENDOR_MASTER_Template.xlsx'
            sepoaExcelProcessor('down', 'DF_005', 'doExcelDownload', null, fileId);
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
    </template>
</body>