        ]]></onloadscript>
    <userscript>
        <var name="house_code"/>
        <var name="house_name"/>
        <var name="targetId"/>
        <var name="company_code"/>
        <function name="onButtonClick" args="id, flag">
        <![CDATA[
            if (house_code == '' ||
                formObj.getValue('HOUSE_CODE') == null || formObj.getValue('HOUSE_CODE').length < 1 ||
                formObj.getValue('HOUSE_NAME') == null || formObj.getValue('HOUSE_NAME').length < 1) {
                Alert(Sepoa.cache.text.get('DF_001.NO_CODE_ERR'));
                return;
            }
            if (flag == 'up') uploadFile(id);
            else downloadFile(id);
        ]]>
        </function>
        <function name="uploadFile" args="id">
        <![CDATA[
            targetId = id;
            var formId = 'upload' + id;
            url = '';
            switch (targetId) {
                case 'A':
                    title = Sepoa.cache.text.get('DF_001_1.USER_INFO');
                    url = '/Master/Info/UserInfoUpload.sux';
                    break;
                case 'B':
                    title = Sepoa.cache.text.get('DF_001_1.DEPT_INFO');
                    url = '/Master/Info/DepartmentInfoUpload.sux';
                    break;
                case 'C':
                    title = Sepoa.cache.text.get('DF_001_1.POSITION_INFO');
                    url = '/Master/Info/PositionInfoUpload.sux';
                    break;
                default:
                    Alert(Sepoa.cache.text.get('DF_001.ERR_INC'));
            }
            var params = {};
            params.UPLOAD_ID = targetId;
            params.HOUSE_CODE = house_code;
            params.HOUSE_NAME = house_name;
            params.COMPANY_CODE = company_code;
            
            var height = window.document.body.offsetHeight * 0.8;
            var width = window.document.body.offsetWidth * 0.8;
            PopupOpenPost(window.CONTEXT_NAME + url, params, null, width, height, title);
        ]]>
        </function>
        <function name="onFormButtonClick" args="name">
        <![CDATA[
            if (name == "searchImg") {
                if (window.document.body.offsetHeight < 600)
                    var height = window.document.body.offsetHeight * 0.8;
                else var height = 600;
            
                if (window.document.body.offsetWidth < 500)
                    var width = window.document.body.offsetWidth * 0.8;
                else var width = 500;
            
                var params = new Array();
                PopupCommonPost('DF0001', setFormData, params, null, width, height);
            }
        ]]>
        </function>
        <function name="setFormData" args="code, name, comp_code, irs">
        <![CDATA[
            formObj.setValue('HOUSE_NAME', name);
            formObj.setValue('HOUSE_CODE', code);
            formObj.setValue('COMPANY_CODE', comp_code);
            house_code = code;
            house_name = name;
            company_code = comp_code;
        ]]>
        </function>
