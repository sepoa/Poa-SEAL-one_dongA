<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="DF_003" header="false">
    <form id="formObj" div="hZRlkTfweplkTfJsMd" form-id="DF_001"/>
    <button id="buttonObj">
        <btn div="hZRlkTfoQwlkTflHxD" id="download" type="exceldownload" img="down_24.png" onclick="downloadExcel(  )"/>
        <btn div="hZRlkTfoQwlkTflHxD" id="upload" type="excelupload" img="excel.png" onclick="uploadExcel(  )"/>
        <btn div="hZRlkTfoQwlkTflHxD" id="delete" text="{BUTTON.rowdelete}" onclick="doDelete(  )"/>
        <btn div="hZRlkTfoQwlkTflHxD" id="save" text="{BUTTON.insert}" onclick="doSave(  )"/>
    </button>
    <grid id="gridObj" div="hZRlkTfzcEnkTfrfHl" grid-id="DF_003" drag="false" merge="false" dynamic="false">
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onTXE" callback="doSaveEnd"/>
        <event type="onEditCell" callback="onEditCell"/>
    </grid>
    <variable>
        <var name="formBox" value="$($sObject._vp).find('#hZRlkTfwgWlkTfESqI')[0]"/>
        <var name="buttonBox" value="$($sObject._vp).find('#hZRlkTfgeclkTfxONQ')[0]"/>
        <var name="containerObj" value="$($sObject._vp).find('#hZRlkTfwgWlkTfBkau')[0]"/>
    </variable>
    <onloadscript>
        <![CDATA[
            targetId = Sepoa.request.UPLOAD_ID;
            house_code = Sepoa.request.HOUSE_CODE;
            house_name = Sepoa.request.HOUSE_NAME;
            company_code = Sepoa.params.COMPANY_CODE;
            formObj.hideItem('searchImg');
            formObj.setValue('HOUSE_NAME', house_name);
            formObj.setValue('HOUSE_CODE', house_code);
            formObj.setValue('COMPANY_CODE', company_code);
            colIdxPos = gridObj.getColIndexById('POSITION_CODE');
            colIdxPosNameLoc = gridObj.getColIndexById('POSITION_NAME_LOC');
            colIdxPosNameEng = gridObj.getColIndexById('POSITION_NAME_ENG');
            colIdxPosNameJp = gridObj.getColIndexById('POSITION_NAME_JP');
            colIdxPosNameCn = gridObj.getColIndexById('POSITION_NAME_CN');
        ]]></onloadscript>
    <userscript>
        <var name="targetId"/>
        <var name="house_code"/>
        <var name="house_name"/>
        <var name="company_code"/>
        <var name="gridData"/>
        <var name="colIdxPos"/>
        <var name="colIdxPosNameLoc"/>
        <var name="colIdxPosNameEng"/>
        <var name="colIdxPosNameJp"/>
        <var name="colIdxPosNameCn"/>
        <function name="uploadExcel" args="">
        <![CDATA[
            if (gridObj.getRowsNum() == 0) {
                gridObj.loadExcel({});
            } else {
                Confirm(Sepoa.cache.text.get('DF_001.doUpload'), function(result) {
                    if (result) {
                        gridObj.loadExcel({});
                    }
                });
            }
        ]]>
        </function>
        <function name="doQueryEnd" args="">
        <![CDATA[
            for (var i = 0; i < gridObj.getRowsNum(); i++) {
                gridObj.cells2(i, gridObj.getColIndexById('ROW_NUM')).setValue(gridObj.getRowId(i));
            }
        ]]>
        </function>
        <function name="doSave" args="">
        <![CDATA[
            if (gridObj.getRowsNum() < 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.0004'));
                return;
            }
            gridObj.allRowsChecked('SELECTED', true);
            
            var selectedRow = gridObj.getGridChangedRows("SELECTED");
            if (!gridObj.validate()) {
                Alert(Sepoa.cache.text.get('MESSAGE.0002'));
                return;
            }
            
            Confirm(Sepoa.cache.text.get('MESSAGE.1018'), function(result) {
                if (result) {
                    gridObj.editStop();
                    dataOutput.setValue('TARGET_HOUSE', getOAObject('DF_003', 'formObj').getValue('HOUSE_CODE'));
                    dataOutput.setValue('TARGET_COMPANY', getOAObject('DF_003', 'formObj').getValue('COMPANY_CODE'));
                    var params = [];
                    params.push('mode=doSave');
                    params.push('PROCESS_ID=sepoa.svc.info.SepoaInfoUploadService');
                    params.push('METHOD=doPositionSave');
            
                    gridObj.postTransaction(window.CONTEXT_NAME+'/SepoaGrid.sux', params, 'SELECTED');
                }
            });
        ]]>
        </function>
        <function name="doSaveEnd" args="obj">
        <![CDATA[
            var status = obj.status;
            var message = obj.message;
            var gridData = JSON.parse(obj.params);
            
            for (var i = 0; i < gridData.length; i++) {
                gridObj.cells(gridData[i].ROW_NUM, gridObj.getColIndexById('STATUS')).setValue(gridData[i].STATUS);
                gridObj.cells(gridData[i].ROW_NUM, gridObj.getColIndexById('ERR_MSG')).setValue(gridData[i].ERR_MSG);
            }
            Alert(Sepoa.cache.text.get('DF_001.MSG_001'));
        ]]>
        </function>
        <function name="doDelete" args="">
        <![CDATA[
            var selectedRow = gridObj.getGridChangedRows("SELECTED");
            if (selectedRow.length < 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.1004'));
                return;
            }
            Confirm(Sepoa.cache.text.get('DF_001.doDelete'), function(result) {
                if (result) {
                    for (var i = 0; i < selectedRow.length; i++)
                        gridObj.deleteRow(selectedRow[i]);
                }
            });
        ]]>
        </function>
        <function name="downloadExcel" args="id">
        <![CDATA[
            targetId = id;
            var fileId = 'POSITION_MASTER_Template.xlsx'
            sepoaExcelProcessor('down', 'sepoa.svc.info.SepoaInfoUploadService', 'doPositionExcelDownload', null, fileId);
        ]]>
        </function>
        <function name="onEditCell" args="stage, rId, cInd, nValue, oValue">
        <![CDATA[
            if (stage==2) {
	        	if (cInd==colIdxPos) {
	        		if (gridObj.cells(rId, colIdxPos).getValue()=='') {
	        			return false;
	        		}
	        		dataOutput.setValue('HOUSE_CODE', formObj.getValue('HOUSE_CODE'));
	        		dataOutput.setValue('POSITION_CODE', gridObj.cells(rId, colIdxPos).getValue());
	        		doServiceAjax('sepoa.svc.info.SepoaInfoUploadService', 'CONNECTION', 'searchPosition', null, function(so){
	        			if (so.status == 1){
	        				var sf = new SepoaFormater(so.result[0]);
	        				gridObj.cells(rId, colIdxPosNameLoc).setValue(sf.getValue('POSITION_NAME_LOC'));
	        				gridObj.cells(rId, colIdxPosNameEng).setValue(sf.getValue('POSITION_NAME_ENG'));
	        				gridObj.cells(rId, colIdxPosNameJp).setValue(sf.getValue('POSITION_NAME_JP'));
	        				gridObj.cells(rId, colIdxPosNameCn).setValue(sf.getValue('POSITION_NAME_CN'));
	        			} else {
	        				Alert(so.message);
	        			}
	        		});
	        	}
        	}
        	return true;
        ]]>
        </function>
    </userscript>
