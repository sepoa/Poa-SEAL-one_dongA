<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="CT_940" header="false" pageCloseWarn="false">
    <button id="b3bbd718332e40978da16bd85569d4">
        <btn div="b3bbd718332e40978da16bd85569d4" id="TEMPLATE_DOWNLOAD" type="exceldownload" text="{BUTTON.TEMPLATE_DOWNLOAD}" onclick="onButtonClick( 'TEMPLATE' )"/>
        <btn div="b3bbd718332e40978da16bd85569d4" id="FILE_UPLOAD" type="fileattach" text="{BUTTON.EXCEL_UPLOAD}" onclick="onButtonClick( 'UPLOAD' )"/>
        <btn div="b3bbd718332e40978da16bd85569d4" id="SAVE" type="save" text="{BUTTON.save}" onclick="onButtonClick( 'SAVE' )"/>
    </button>
    <button id="ae61a5ae9e6f45de8cd429b401b008"/>
    <grid id="gridObj" div="a196be56b3a9495e89dfb2ebd38fc2" grid-id="CT_920" drag="false" merge="true" dynamic="true" exceldownload="true">
        <event type="onTXE" callback="doSaveEnd"/>
    </grid>
    <variable>
        <var name="b8482f61d7d3432f8dc39e99c5f898" value="$($sObject._vp).find('#b8482f61d7d3432f8dc39e99c5f898')[0]"/>
        <var name="bdb9920b228d4e14877dd5747ba2ba" value="$($sObject._vp).find('#bdb9920b228d4e14877dd5747ba2ba')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <function name="init" args="">
        <![CDATA[
        	gridObj.setColumnHidden(gridObj.getColIndexById('CONT_FROM_TO'), true);
            gridObj.setColumnHidden(gridObj.getColIndexById('ATTACH_IMG'), true);
            gridObj.setColumnHidden(gridObj.getColIndexById('CONT_FROM'), false);
            gridObj.setColumnHidden(gridObj.getColIndexById('CONT_TO'), false);
            gridObj.setColumnHidden(gridObj.getColIndexById('PRC_RESULT'), false);
            
            if(typeof(selfObj.close) != "undefined") {
        		selfObj.close = function(){
					Sepoa.params.callback();
					this.unload();
				}
        	}
        ]]>
        </function>
        <function name="doSaveEnd" args="res">
        <![CDATA[
        	let prcResult = JSON.parse(res.prcResult);
        	renderData(prcResult);
        ]]>
        </function>
        <function name="doUploadExcel" args="">
        <![CDATA[
            sepoaExcelProcessor('up', 'sepoa.svc.seal.SepoaReqSealService', 'doUploadContractHistoryExcel', doUploadFileCallback);
        ]]>
        </function>
        <function name="doUploadFileCallback" args="res">
        <![CDATA[
            if(res.status != 'true') {
            	Alert(Sepoa.cache.text.get("POA_CONTRACT.STATUS_105001") + "<br/>" + res.message);
            	return;
            } else {
            	let excelData = JSON.parse(res.result[0]);
            	renderData(excelData);
            }
        ]]>
        </function>
        <function name="renderData" args="dataObj">
        <![CDATA[
        	gridObj.clearAll(false);
        	for(let i of dataObj) {
           		let tmpItem = i;
           		let maxRowId = dhx4.newId();
           		gridObj.addRow(maxRowId, '', gridObj.getRowsNum());
           		
           		let tmpKeySet = Object.keys(i);
           		for(let j of tmpKeySet) {
            		gridObj.cells(maxRowId, gridObj.getColIndexById(j)).setValue(i[j]);
           		}
           	}
        ]]>
        </function>
        <function name="onButtonClick" args="name">
        <![CDATA[
            switch (name.toUpperCase()) {
                case "UPLOAD":
                    doUploadExcel();
                    break;
                case "SAVE":
                	doSaveHistoryData();
                    break;
            }
        ]]>
        </function>
        <function name="doSaveHistoryData" args="">
        <![CDATA[
			gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.seal.SepoaReqSealService', 'METHOD=doSaveContractHistoryExcelData']);        
        ]]>
        </function>
    </userscript>
