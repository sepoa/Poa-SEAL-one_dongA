<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="CT_910" header="false" pageCloseWarn="false" dataStore="false">
    <filterbar id="filterObj" div="aaee2e416a2f420f8488a0618e1d34">
        <calendar id="F_CALENDAR" button="year:0,month:0,week:-4,day:0" default="week:-4" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#CT102"/>
        <status id="F_STATUS" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#SLM992" label=""/>
        <keyword id="F_KEYWORD"/>
        <filter>
            <option id="F_CATEGORY" type="select" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#SL003"/>
            <option id="F_CONT_METHOD" type="select" combo="SL0047,{HOUSE_CODE}#{COMPANY_CODE}"/>
        </filter>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <button id="e2826f76ff80410b86cab05897763f">
        <btn div="e2826f76ff80410b86cab05897763f" id="EXCEL_UPLOAD" type="excelupload" text="{BUTTON.EXCEL_UPLOAD}" onclick="onButtonClick( 'UPLOAD' )"/>
        <btn div="e2826f76ff80410b86cab05897763f" id="delete" type="default" text="{BUTTON.delete}" onclick="onButtonClick( 'DELETE' )"/>
    </button>
    <grid id="gridObj" div="a196be56b3a9495e89dfb2ebd38fc2" grid-id="CT_920" drag="false" merge="true" dynamic="true" exceldownload="true">
        <event type="onRowSelect" callback="onRowSelect"/>
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onTXE" callback="doSaveEnd"/> 
    </grid>
    <variable>
        <var name="colObj" value="$($sObject._vp).find('#f3f79ac3109f4a1c8c47571321f63b')[0]"/>
        <var name="ae8ad170e01c4c7b8c8b2934398808" value="$($sObject._vp).find('#ae8ad170e01c4c7b8c8b2934398808')[0]"/>
        <var name="bdc31c8f4d7b4e7d8193b218939deb" value="$($sObject._vp).find('#bdc31c8f4d7b4e7d8193b218939deb')[0]"/>
    </variable>
    <onloadscript>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <function name="doQuery" args="">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.seal.SepoaReqSealService', 'METHOD=doSelectContractHistory']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="onRowSelect" args="id,ind">
        <![CDATA[
            let header = this.getColumnId(ind);
            if (header == "ATTACH_IMG") {
                doAttachFile(id);
            }
        ]]>
        </function>
        <function name="doAttachFile" args="rowId">
        <![CDATA[
            //기존에 등록된 문서가 있는지 확인( CONT_NO + "_" + CONT_GL_SEQ로 서버 확인 필요 )
            var config = {
                url: window.CONTEXT_NAME + '/SepoaActionController.sux',
                on: {
                    callback: function(res) {
                        if (res.status == "1") {
                            let result = JSON.parse(res.result[0]);
                            if (result["RESULT"] == "ATTACH_DOC_EMPTY") {
                                //없다면 파일 업로드 창 Open
                                doOpenFileExplorer(rowId);
                            } else {
                                //있다면 기존 파일 편집기 Open
                                let rowData = gridObj.getRowDataObject(rowId);
                                openAttachDocTemplateFile(rowData["CONT_NO"], rowData["CONT_GL_SEQ"]);
                            }
                        } else {
                            Alert(res.message);
                        }
                    }
                }
            };
            
            var params = {
                module: "seal" + (Sepoa.config.get('sepoa.seal.process') || "") + ".req",
                action: "doSelectContractHistoryFile",
                CONNECTION: "CONNECTION",
                DOC_DATA: JSON.stringify(gridObj.getRowDataObject(rowId))
            };
            
            sUtils.multipart.send(config, params); //파일 없을 경우
        ]]>
        </function>
        <function name="doUploadAttachDocTemplateFile" args="rowId, files">
        <![CDATA[
            var config = {
                multiple: false,
                url: window.CONTEXT_NAME + '/SepoaActionController.sux',
                ext: ['pdf'],
                on: {
                    callback: function(res) {
                        if (res.status == "1") {
                            let rowData = gridObj.getRowDataObject(rowId);
                            openAttachDocTemplateFile(rowData["CONT_NO"], rowData["CONT_GL_SEQ"]);
                        } else {
                            Alert(sUtils.cache.text.get('POA_CONTRACT.MESSAGE_0002'));
                        }
                    }
                }
            }
            
            var params = {
                module: "seal" + (Sepoa.config.get('sepoa.seal.process') || "") + ".req",
                action: "doUploadContractHistoryFile",
                CONNECTION: "TRANSACTION",
                DOC_DATA: JSON.stringify(gridObj.getRowDataObject(rowId)),
                files: files
            }
            
            sUtils.multipart.upload(config, params);
        ]]>
        </function>
        <function name="openAttachDocTemplateFile" args="contNo, contGlSeq">
        <![CDATA[
            //기존 문서가 있을 경우
            var docData = {
                KEY: contNo + "_" + contGlSeq,
                TARGET: "CONTRACT_HISTORY"
            };
            
            var btnConfigArr = [];
            btnConfigArr.push("DELETE");
            btnConfigArr.push("CLOSE");
            
            $popup = sUtils.popup.modal({
                url: window.CONTEXT_NAME + '/Contract/Module/SealModuleLayout.sux',
                params: {
                    DOC_DATA: JSON.stringify(docData),
                    CONT_MODULE: "VIEW",
                    WORK_TYPE: "T",
                    CALLER: "CONTRACT_HISTORY",
                    BTN_CONFIG: btnConfigArr
                },
                title: "계약서"
            });
            resizePopup();
            return;
        ]]>
        </function>
        <function name="doOpenFileExplorer" args="rowId">
        <![CDATA[
            var tmpFileInput = document.createElement('input'); //html의 input 요소 생성
            tmpFileInput.type = 'file';
            tmpFileInput.id = 'upload_file';
            tmpFileInput.name = 'upload_file';
            
            tmpFileInput.onchange = function(fe) {
                var files = fe.currentTarget.files;
                doUploadAttachDocTemplateFile(rowId, files);
            }
            
            tmpFileInput.click();
        ]]>
        </function>
        <function name="doQueryEnd" args="obj,count">
        <![CDATA[
            if (count == 0) {
                Alert("조회 결과가 없습니다.");
                return
            }
        ]]>
        </function>
        <function name="onSearch" args="">
        <![CDATA[
            doQuery();
        ]]>
        </function>
        <function name="onButtonClick" args="name">
        <![CDATA[
            switch (name.toUpperCase()) {
                case "UPLOAD":
                    doOpenUploadPopup();
                    break;
                case "DELETE":
                	doDeleteRow();
            }
        ]]>
        </function>
        <function name="doOpenUploadPopup" args="">
        <![CDATA[
            var width = Math.min(SUX.root.innerWidth * 0.7, 1280);
            var height = Math.min((SUX.root.innerHeight - 100) * 0.9, 800);
            PopupOpenPost('/Contract/Migration/Popup/ContractConfirmGrid.sux', {}, doOpenUploadPopupCallback, width, height, Sepoa.cache.text.get('SLM_910.UPLOAD_POPUP_TITLE'));
        ]]>
        </function>
        <function name="doOpenUploadPopupCallback" args="">
        <![CDATA[
            doQuery();
        ]]>
        </function>
        <function name="doDeleteRow" args="">
        <![CDATA[
            var selectedRow = gridObj.getGridChangedRows("SELECTED");
            gridObj.editStop();
            
            if (selectedRow.length < 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.1004'));
                return;
            }
            
            if (gridObj.getGridChangedRows("SELECTED").length > 0 && Confirm(Sepoa.cache.text.get('MESSAGE.1015'), function(result) {
                    if (result) {
                        gridObj.editStop();
                        gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.seal.SepoaReqSealService', 'METHOD=doDeleteContractHistory'], 'SELECTED');
            
                    }
                }));
        ]]>
        </function>
		<function name="doSaveEnd" args="">
        <![CDATA[
      		doQuery();
        ]]>
        </function>
    </userscript>
