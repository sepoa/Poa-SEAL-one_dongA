<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="CT_205_B_POPUP" header="false" pageCloseWarn="false">
    <filterbar id="filterObj_company" div="bc320e28d6284473851f2179f285e4">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="onSearchCompany"/>
    </filterbar>
    <grid id="gridObj_company" div="a0ac3b718e1547e8890d9034a3360b" grid-id="CT_205_B_1" drag="false" merge="false" dynamic="false" exceldownload="true">
        <event type="onRowSelect" callback="onRowSelectCompany"/>
    </grid>
    <filterbar id="filterObj_signer" div="f07e43953e134bf98ba8422424a47c">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="onSearchSigner"/>
    </filterbar>
    <grid id="gridObj_signer" div="bfebd826b3f1483f836939f7be6125" grid-id="CT_205_B_2" drag="false" merge="false" dynamic="false" exceldownload="true">
        <event type="onRowSelect" callback="onRowSelectSigner"/>
    </grid>
    <button id="btnObj">
        <btn div="f428f9716109409b8ffce39f411969" id="save" type="save" text="{BUTTON.save}" toggle="false" reverse="false" onclick="onButtonClick( 'SAVE' )"/>
        <btn div="f428f9716109409b8ffce39f411969" id="close" type="back" text="{BUTTON.close}" toggle="false" reverse="false" onclick="onButtonClick( 'CLOSE' )"/>
    </button>
    <usercss>
    <![CDATA[
    ]]>
    </usercss>
    <variable>
        <var name="bf55e04b0dba48558dbe57c1bf4e94" value="$($sObject._vp).find('#bf55e04b0dba48558dbe57c1bf4e94')[0]"/>
        <var name="ef38ceccf8af4dd780a626bf26d65e" value="$($sObject._vp).find('#ef38ceccf8af4dd780a626bf26d65e')[0]"/>
        <var name="f8ff49c954f946f8836535b9c86a41" value="$($sObject._vp).find('#f8ff49c954f946f8836535b9c86a41')[0]"/>
        <var name="a34802c5142e485d89847fe631ca53" value="$($sObject._vp).find('#a34802c5142e485d89847fe631ca53')[0]"/>
        <var name="a839c58b90754da48036e9cfbcdb62" value="$($sObject._vp).find('#a839c58b90754da48036e9cfbcdb62')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <function name="onReady">
        <![CDATA[
            
        ]]>
        </function>
        
        <function name="init">
        <![CDATA[
            if(Sepoa.request.CATEGORY) {
                dataOutput.setValue('CATEGORY', Sepoa.request.CATEGORY);
                doQueryCompany();
            }
            
            onReady();
        ]]>
        </function>
        
        <function name="doQueryCompany" args="">
        <![CDATA[
            dataOutput.addFilter(filterObj_company);
            gridObj_company.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.ct.CT_205_B_POPUP', 'METHOD=doQueryCompany']);
        ]]>
        </function>
        
        <function name="doQuerySigner" args="">
        <![CDATA[
            dataOutput.addFilter(filterObj_signer);
            gridObj_signer.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.ct.CT_205_B_POPUP', 'METHOD=doQuerySigner']);
        ]]>
        </function>
        
        <function name="onSearchCompany" args="">
        <![CDATA[
            doQueryCompany();
            gridObj_signer.clearAll();
        ]]>
        </function>
        
        <function name="onSearchSigner" args="">
        <![CDATA[
            if(dataOutput.getValue('SIGNER_COMPANY_CODE') == '') {
                Alert(sUtils.cache.text.get('CT_205_B_POPUP.MESSAGE_CHECK_COMPANY'));
            } else {
                doQuerySigner();
            }
        ]]>
        </function>
        
        <function name="onRowSelectCompany" args="rId,cId">
        <![CDATA[
            const data = gridObj_company.getRowDataObject(rId);
            if(data.SIGNER_COMPANY_CODE) {
 				gridObj_company.checkAll(false); 
                gridObj_company.cells(rId, gridObj_company.getColIndexById('SELECTED')).setValue(true);
                dataOutput.setValue('SIGNER_COMPANY_CODE', data.SIGNER_COMPANY_CODE);
                doQuerySigner();
            }
        ]]>
        </function>
        
        <function name="onRowSelectSigner" args="rId,cId">
        <![CDATA[
            const rowIds = gridObj_signer.getAllRowIds(',').split(',');
            gridObj_signer.checkAll(false); 
            gridObj_signer.cells(rId, gridObj_company.getColIndexById('SELECTED')).setValue(true);
        ]]>
        </function>
        
        <function name="onButtonClick" args="id">
        <![CDATA[
            switch (id) {
                case 'SAVE':
                    const selectedCompany = gridObj_company.getGridChangedRows('SELECTED');
                    const selectedSigner = gridObj_signer.getGridChangedRows('SELECTED');
                    
                    if(selectedCompany.length == 0) {
                        Alert(sUtils.cache.text.get('CT_205_B_POPUP.MESSAGE_CHECK_COMPANY'));
                        return;
                    }
                    
                    if(selectedSigner.length == 0) {
                        Alert(sUtils.cache.text.get('CT_205_B_POPUP.MESSAGE_CHECK_SIGNER'));
                        return;
                    }
                    
                    gridObj_company.getRowDataObject(selectedCompany)
                    
                    gridObj_signer.getRowDataObject(selectedSigner)
                    
                    const result = sUtils.object.extend(true, {}, gridObj_company.getRowDataObject(selectedCompany), gridObj_signer.getRowDataObject(selectedSigner));
                    
                    if (Sepoa.params && Sepoa.params.callback) {
                        Sepoa.params.callback(result);
                    }
                    
                    selfObj.close();
                    
                    break;
                case 'CLOSE':
                    selfObj.close();
                    break;
                default:
                    break;
            }
        ]]>
        </function>
    </userscript>
