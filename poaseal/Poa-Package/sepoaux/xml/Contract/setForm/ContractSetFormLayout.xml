<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="CT_206" header="false">
    <layout id="vtrDHacTRREHacieyl" div="vtrDHacTRREHacieyl" pattern="1C">
        <cell>
            <id>a</id>
            <fix_size>true,true</fix_size>
            <header view="true" type="contents" text="CT_206.LAYOUT_A_HEADER"/>
            <collapse icon="false" collapsed="false"/>
            <icon>menu</icon>
            <attach file="/Contract/setForm/ContractSetForm.xml"/>
        </cell>
    </layout>
    <onloadscript>
        <call name="onReady"/>
    </onloadscript>
    <userscript>
        <var name="$share" value="{childScreen:{}}"/>
        <function name="onReady">
        <![CDATA[
            if(Sepoa.request.isPopup){
                var config = {
                    document: {
                        CONT_TYPE: (Sepoa.request.CONT_TYPE || "B"),
                        CONT_NO:Sepoa.request.CONT_NO,
                        CONT_GL_SEQ:Sepoa.request.CONT_GL_SEQ
                    }
                }
                doOpenDocument(config);
            }else{
                const parents = $sObject._vp.parents('div.sepoaux.screen_area');
                if(parents.length > 0) {
                    callFunction('p', 'childScreenReady', [{
                        name:"FORM",
                        id: $sObject.aliasCode,
                        fn:{
                            doOpenDocument:doOpenDocument,
                            doClear:doClear
                        }
                    }]);
                } else {
                    $share.config = {
                        document : {},
                        data : {}
                    };
                }
            }
        ]]>
        </function>
        
        <function name="childScreenReady" args="config">
        <![CDATA[
            $share.childScreen[config.name] = config;
            if ($share.config && $share.config.data) {
                $share.childScreen[config.name].fn.doOpenDocument($share.config);
            }
        ]]>
        </function>
    
        <function name="doOpenDocument" args="data">
        <![CDATA[
            callFunction('CT_205', 'doOpenDocument', [data]);
        ]]>
        </function>
        <function name="doClear" args="">
        <![CDATA[
            callFunction('CT_205', 'doClear', []);
        ]]>
        </function>
        <function name="changeView" args="data">
        <![CDATA[
            const parents = $sObject._vp.parents('div.sepoaux.screen_area');
            if(parents.length > 0) {
                callFunction('p', 'changeView', [data]);
            } else {
                const option = {
                    id : 'CT_100_CONTRACT',
                    seq : '3',
                    label : Sepoa.cache.text.get('CT_101.TITLE_CONTRACT'),
                    url : '/Contract/Progress/ContractProgressCarousel.sux?alias=CONTRACT',
                    summary : 'N'
                };
                linkTo(option);
                SUX.root.getContentsCell(window).close();
            }
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        ZGl2PiJ9
    </template>
</body>