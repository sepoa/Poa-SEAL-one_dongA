<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="CT_301" header="false" pageCloseWarn="false">
    <layout id="GBvvrThwcFtOPcvIIK" div="GBvvrThwcFtOPcvIIK" pattern="2U">
        <cell>
            <id>a</id>
            <fix_size>true,true</fix_size>
            <header view="true" type="list"/>
            <collapse icon="false" collapsed="false"/>
            <icon>menu</icon>
            <width>400</width>
            <attach file="/Contract/CompanyManagement/ContractCompanyManagementTabbar.xml"/>
        </cell>
        <cell>
            <id>b</id>
            <fix_size>true,true</fix_size>
            <header view="true" type="contents"/>
            <collapse icon="false" collapsed="false"/>
            <attach file="/Contract/CompanyManagement/ContractCompanyManagementWrite.xml"/>
        </cell>
    </layout>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <variable>
        <var name="$share" value="{}"/>
    </variable>
    <userscript>
        <function name="init" args="">
        <![CDATA[
            if($share.data === undefined) {
                $share.data = {};
            }
            
            if($share.event === undefined) {
                $share.event = {};
                dhtmlx.extend($share.event, dhtmlx.EventSystem);
            }
            
            if($share.childScreen === undefined) {
                $share.childScreen = {};
            }
            
            initEvent();
        ]]>
        </function>
        
        <function name="initEvent" args="">
        <![CDATA[
            $share.event.attachEvent('onItemClick', onItemClick);
            $share.event.attachEvent('addCompany', addCompany);
            $share.event.attachEvent('doSaveEnd', doSaveEnd);
            $share.event.attachEvent('doDeleteEnd', doDeleteEnd);
        ]]>
        </function>
        
        <function name="childScreenReady" args="config">
        <![CDATA[
            const child = $share.childScreen[config.name] = config;
            if(child.share) {
                child.share.data = $share.data;
                child.share.event = $share.event;
            }
        ]]>
        </function>
        
        <function name="onItemClick" args="data">
        <![CDATA[
            if($share.childScreen['write']) {
                const target = $share.childScreen['write'];
                target.fn.loadData(data);
            }
        ]]>
        </function>
        
        <function name="addCompany" args="data">
        <![CDATA[
            if($share.childScreen['write']) {
                const target = $share.childScreen['write'];
                target.fn.addCompany(data);		
            }
        ]]>
        </function>
        
        <function name="doSaveEnd" args="">
        <![CDATA[
            if($share.childScreen['list']) {
                const target = $share.childScreen['list'];
                target.fn.doQuery();
            }
            
            if($share.data.INFO) {
                onItemClick($share.data.INFO);
            }
        ]]>
        </function>
        
        <function name="doDeleteEnd" args="">
        <![CDATA[
            if($share.childScreen['list']) {
                const target = $share.childScreen['list'];
                target.fn.doQuery();
            }
        ]]>
        </function>
    </userscript>
