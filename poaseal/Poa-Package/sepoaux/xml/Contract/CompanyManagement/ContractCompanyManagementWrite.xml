<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="CT_303" header="false" pageCloseWarn="false">
    <form id="formObj" div="GBvvrThsjssOPchQIu" form-id="CT_303">
        <event type="onChange" callback="onFormChange"/>
    </form>
    <button id="btnObj">
        <btn div="bc510547025244218684fa71421a3b" id="save" type="save" text="{BUTTON.save}" onclick="onButtonClick('SAVE')"/>
        <btn div="bc510547025244218684fa71421a3b" id="delete" type="delete" text="{BUTTON.delete}" onclick="onButtonClick('DELETE')"/>
        <btn div="bc510547025244218684fa71421a3b" id="modify" type="new" text="{BUTTON.modify}" onclick="onButtonClick('MODIFY')"/>
        <btn div="GBvvrThMHmsOPcIjSK" id="rowAdd" type="new" text="{BUTTON.rowadd}" toggle="false" reverse="false" onclick="onButtonClick('ROW_ADD')"/>
        <btn div="GBvvrThMHmsOPcIjSK" id="rowDelete" type="delete" text="{BUTTON.rowdelete}" toggle="false" reverse="false" onclick="onButtonClick('ROW_DELETE')"/>
    </button>
    <grid id="gridObj" div="eb086de9241c45568f7908c1d466ef" grid-id="CT_303" drag="false" merge="false" dynamic="false" exceldownload="true">
        <event type="onRowSelect" callback="onRowSelect"/>
        <event type="onEditCell" callback="onEditCell"/>
        <event type="onXLE" callback="onLoadGridDataEnd"/>
    </grid>
    <variable>
        <var name="$share" value="{}"/>
        <var name="fa7df0f7b8754a5286e0300ba02309" value="$($sObject._vp).find('#fa7df0f7b8754a5286e0300ba02309')[0]"/>
        <var name="a36f1b89cc5f481e8fbdc0bc241bb3" value="$($sObject._vp).find('#a36f1b89cc5f481e8fbdc0bc241bb3')[0]"/>
        <var name="container1" value="$($sObject._vp).find('#b3c99b8c49cf40978eb9963bac2bd5')[0]"/>
        <var name="ffc72b14736142848a6902dfb82a28" value="$($sObject._vp).find('#ffc72b14736142848a6902dfb82a28')[0]"/>
        <var name="container2" value="$($sObject._vp).find('#a34ff940d90c4e1d805de2ccc9e23b')[0]"/>
    </variable>
        <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <function name="init" args="">
        <![CDATA[
            if($share.childScreen === undefined) {
                $share.childScreen = {};
            }
            
            initComponent();
            initButton();
            onReady();
        ]]>
        </function>
        
        <function name="initComponent" args="">
        <![CDATA[
            for(let key of Object.keys(formObj.getFormData())) {
                formObj.setReadOnly(key, true);
            }
            
            gridObj.setReadOnly(true);
            gridObj.setColumnHidden(gridObj.getColIndexById('SELECTED'), true);
        ]]>
        </function>
        
        <function name="initButton" args="">
        <![CDATA[
            btnObj.btn('save').setHide();
            btnObj.btn('delete').setHide();
            btnObj.btn('modify').setHide();
            btnObj.btn('rowAdd').setHide();
            btnObj.btn('rowDelete').setHide();
        ]]>
        </function>
        
        <function name="onReady" args="">
        <![CDATA[
            const parents = $sObject._vp.parents('div.sepoaux.screen_area');
            if(parents.length > 0) {
                callFunction('p', 'childScreenReady', [{
                    name : 'write',
                    fn : {
                        loadData : loadData,
                        doClear : doClear,
                        addCompany : addCompany
                    },
                    share : $share
                }]);
            }
        ]]>
        </function>
        
        <function name="doClear" args="">
        <![CDATA[
            $share.data.INFO = {};
            $share.data.MANAGER = {};
            
            formObj.clear();
            gridObj.clearAll();
            
            initComponent();
            initButton();
        ]]>
        </function>
        
        <function name="addCompany" args="bizCategory">
        <![CDATA[
            doClear();
            setModifyMode('NEW', bizCategory);
        ]]>
        </function>
        
        <function name="loadData" args="data">
        <![CDATA[
            doClear();
            
            $share.data.INFO = parseData(data);
            loadFormData($share.data.INFO);
            loadGridData($share.data.INFO);
            
            btnObj.btn('modify').setShow();
        ]]>
        </function>
        
        <function name="loadFormData" args="data">
        <![CDATA[
            formObj.dataMapper(data, 'json');
        ]]>
        </function>
        
        <function name="onFormChange" args="id, value">
        <![CDATA[
            if(formObj.getItemType(id) == 'calendar') {
                $share.data.INFO[id] = sUtils.date.toString(value);
            } else {
                $share.data.INFO[id] = value;
            }
        ]]>
        </function>
        
        <function name="loadGridData" args="data">
        <![CDATA[
            if(data['$selected'] !== undefined) {
                delete data['$selected'];
            }
            
            dataOutput.clear();
            dataOutput.setObject(data);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.ct.CT_301', 'METHOD=doQuerySBUPI']);
            gridObj.clearAll(false);
        ]]>
        </function>
        
        <function name="onLoadGridDataEnd" args="">
        <![CDATA[
            $share.data.MANAGER.INFO = gridObj.getAllDataObject();
        ]]>
        </function>
        
        <function name="onRowSelect" args="rId, cId">
        <![CDATA[
            if(!gridObj._allCellReadOnly) {
                gridObj.cells(rId, gridObj.getColIndexById('SELECTED')).setValue(true);
            }
        ]]>
        </function>
        
        <function name="onEditCell" args="stage, rId, cInd, newValue, oldValue">
        <![CDATA[
            if(stage == 2) {
                if(gridObj.getColumnId(cInd) == 'USER_ID') {
                    const config = {
                        url : window.CONTEXT_NAME+'/SepoaActionController.sux',
                        async : false
                    }
                    
                    const params = {
                        module : 'sepoa.svc.ct.CT_303',
                        action : 'doCheckUserId',
                        CONNECTION : 'CONNECTION',
                        USER_ID : newValue
                    }
                    
                    const so = sUtils.multipart.send(config, params);
                    if(!so.result[0] === true) {
                        Alert(Sepoa.cache.text.get('CT_303.MESSAGE_WARNING_USER_ID'), () => {   // '올바르지 않은 ID 형태이거나, 이미 존재하는 ID 입니다.'
                            gridObj.cells(rId, cInd).setValue('');
                        });
                        return false;
                    }
                }
                
                if($share.data.MANAGER?.INFO) {
                    const data = gridObj.getRowDataObject(rId);
                    $share.data.MANAGER.INFO = $share.data.MANAGER.INFO.map(e => {
                        if(e.gr_id == data.gr_id) {
                            e = data;
                        }
                        return e;
                    });
                }
                
                if($share.data.MANAGER?.NEW) {
                    const data = gridObj.getRowDataObject(rId);
                    $share.data.MANAGER.NEW = $share.data.MANAGER.NEW.map(e => {
                        if(e.gr_id == data.gr_id) {
                            e = data;
                        }
                        return e;
                    });
                }
            }
            
            return true;
        ]]>
        </function>
        <function name="onButtonClick" args="type">
        <![CDATA[
            switch(type) {
                case 'SAVE' :
                    doSave();
                    break;
                case 'DELETE' :
                    doDelete();
                    break;
                case 'MODIFY' :
                    setModifyMode();
                    btnObj.btn('delete').setShow();
                    break;
                case 'ROW_ADD' :
                    addGridRow();
                    break;
                case 'ROW_DELETE' :
                    deleteGridRow();
                    break;
                default :
                    break;
            }
        ]]>
        </function>
        
        <function name="doSave" args="">
        <![CDATA[
            if(formObj.validate() === false) {
                Alert(Sepoa.cache.text.get('MESSAGE.0002'));    // '필수입력값을 입력해주세요.'
                return false;
            }
            
            if(gridObj.getSelectedRows('SELECTED').length > 0 && gridObj.validate('SELECTED') === false) {
                Alert(Sepoa.cache.text.get('MESSAGE.0003'));    // '필수 입력컬럼을 입력해주세요.'
                return false;
            }
            
            Confirm(Sepoa.cache.text.get('MESSAGE.1018'), (flag) => {   // '저장 하시겠습니까?'
                if(flag) {
                    const config = {
                        url : window.CONTEXT_NAME+'/SepoaActionController.sux',
                        contentType : 'json',
                        on : {
                            callback : (res, config, params) => {
                                if(res.status == '1') {
                                    Alert(sUtils.cache.text.get('MESSAGE.0054'), () => {    // '성공적으로 저장하였습니다.'
                                        doSaveEnd();
                                    })
                                } else {
                                    Alert(sUtils.cache.text.get('MESSAGE.1002'));    // '처리 중 오류가 발생하였습니다.'
                                }
                            }
                        }
                    }
                    const params = {
                        module : 'sepoa.svc.ct.CT_303',
                        action : 'doSave',
                        CONNECTION : 'TRANSACTION',
                        DATA : $share.data
                    }
                    
                    sUtils.multipart.send(config, params);
                }
            });
        ]]>
        </function>
        
        <function name="doSaveEnd" args="">
        <![CDATA[
            initComponent();
            initButton();
            $share.event.callEvent('doSaveEnd', []);
        ]]>
        </function>
        
        <function name="doDelete" args="">
        <![CDATA[
            if(sUtils.string.isBlank(formObj.getValue('BIZ_CODE'))) {
                Alert(Sepoa.cache.text.get('MESSAGE.0099'));    // '저장상태인 데이터만 삭제가 가능합니다.'
                return false;
            }
            
            Confirm(Sepoa.cache.text.get('MESSAGE.1015'), (flag) => {   // '삭제 하시겠습니까?'
                if(flag) {
                    const config = {
                        url : window.CONTEXT_NAME+'/SepoaActionController.sux',
                        contentType : 'json',
                        on : {
                            callback : (res, config, params) => {
                                if(res.status == '1') {
                                    Alert(sUtils.cache.text.get('MESSAGE.5107'), () => {    // '성공적으로 삭제하였습니다.'
                                        doDeleteEnd();
                                    })
                                } else {
                                    Alert(sUtils.cache.text.get('MESSAGE.1002'));    // '처리 중 오류가 발생하였습니다.'
                                }
                            }
                        }
                    }
                    const params = {
                        module : 'sepoa.svc.ct.CT_303',
                        action : 'doDelete',
                        CONNECTION : 'TRANSACTION',
                        DATA : $share.data
                    }
                    
                    sUtils.multipart.send(config, params);
                }
            });
        ]]>
        </function>
        
        <function name="doDeleteEnd" args="">
        <![CDATA[
            $share.event.callEvent('doDeleteEnd', []);
        ]]>
        </function>
        
        <function name="setModifyMode" args="mode, bizCategory">
        <![CDATA[
            for(let key of Object.keys(formObj.getFormData())) {
                if(mode == 'NEW') {
                    formObj.setReadOnly(key, false);
                } else {
                    if(['BIZ_CATEGORY', 'BIZ_TYPE'].includes(key) === false) {
                        formObj.setReadOnly(key, false);
                    }
                }
            }
            
            formObj.setValue('BIZ_CATEGORY', bizCategory);
            
            gridObj.setReadOnly(false);
            gridObj.setColumnHidden(gridObj.getColIndexById('SELECTED'), false);
            
            gridObj.forEachRow(rId => {
                gridObj.cells(rId, gridObj.getColIndexById('USER_ID'))?.setDisabled(true);
            })
            
            initButton();
            btnObj.btn('save').setShow();
            btnObj.btn('rowAdd').setShow();
            btnObj.btn('rowDelete').setShow();
        ]]>
        </function>
        
        <function name="addGridRow" args="">
        <![CDATA[
            const rowId = dhx.newId();
            gridObj.addRow(rowId, gridObj.getRowsNum());
            
            gridObj.cells(rowId, gridObj.getColIndexById('SELECTED')).setValue(true);
            
            const data = gridObj.getRowDataObject(rowId);
            if($share.data.MANAGER?.NEW === undefined) {
                $share.data.MANAGER.NEW = [];
            }
            
            $share.data.MANAGER.NEW.push(data);
        ]]>
        </function>
        
        <function name="deleteGridRow" args="">
        <![CDATA[
            for(let rowId of gridObj.getGridChangedRows('SELECTED')) {
                const data = gridObj.getRowDataObject(rowId);
                if($share.data.MANAGER?.DELETE === undefined) {
                    $share.data.MANAGER.DELETE = [];
                }
                
                const isTemp = $share.data.MANAGER?.NEW?.filter(e => e.gr_id == data.gr_id).length > 0;
                if(isTemp) {
                    $share.data.MANAGER.NEW = $share.data.MANAGER.NEW.filter(e => e.gr_id != data.gr_id);
                } else {
                    $share.data.MANAGER.DELETE.push(data);
                }
                
                gridObj.deleteRow(rowId);
            }
        ]]>
        </function>
        
        <function name="parseData" args="data">
        <![CDATA[
            const result = Object.entries(data).reduce((prev, cur) => {
                const [key, value] = cur;
                if(['$selected', 'randomseed', 'value'].includes(key) === false) {
                    prev[key.toUpperCase()] = value;
                }
                
                return prev;
            }, {});
            
            return result;
        ]]>
        </function>
    </userscript>
