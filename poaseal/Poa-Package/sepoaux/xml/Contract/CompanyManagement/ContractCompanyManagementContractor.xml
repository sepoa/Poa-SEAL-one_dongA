<body screen_id="CT_302_1" header="false" pageCloseWarn="false">
    <filterbar id="filterObj" div="eaECDUcowpoTHRfCOz">
        <keyword id="F_KEYWORD"/>
        <status id="F_STATUS" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#CT_301" label="BIZ_TYPE"/>
        <event type="onSearch" callback="doQuery"/>
    </filterbar>
    <button id="b0e76e52875e434585e02e9323ef95">
        <btn div="b0e76e52875e434585e02e9323ef95" id="add" type="icon" img="xi-plus" position="right" toggle="false" reverse="false" onclick="onButtonClick('ADD')"/>
    </button>
    <list id="listObj" div="PWsuwThUmoFIVvWpGl">
        <type>
            <template><![CDATA[<table class=sepoa_list_design><tr><td class="sepoa_list_font_bold sepoa_list_font_size_l">#SELLER_NAME_LOC#</td><td class=sepoa_list_align_right>#CEO_NAME_LOC#</td></tr><tr><td class=sepoa_list_align_left>#FOUNDATION_DATE#</td><td class=sepoa_list_align_right>#IRS_NO#</td></tr></table>]]></template>
        </type>
        <event type="onItemClick" callback="onItemClick"/>
        <event type="onXLE" callback="doQueryEnd"/>
    </list>
    <usercss>
    <![CDATA[
    ]]>
    </usercss>
    <variable>
        <var name="$share" value="{}"/>
        <var name="rVHwnIeyQJwnIeHwPF" value="$($sObject._vp).find('#rVHwnIeyQJwnIeHwPF')[0]"/>
        <var name="edabbb1752d34fbc86acae6048b90f" value="$($sObject._vp).find('#edabbb1752d34fbc86acae6048b90f')[0]"/>
        <var name="rVHwnIexQJwnIeIlPa" value="$($sObject._vp).find('#rVHwnIexQJwnIeIlPa')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <function name="init" args="">
        <![CDATA[
            onReady();
        ]]>
        </function>
        <function name="onReady" args="">
        <![CDATA[
            callFunction('p', 'childScreenReady', [{
                name : $sObject.alias,
                fn : {
                    doQuery:doQuery,
                    addCompany:addCompany
                },
                share : $share
            }]);
        ]]>
        </function>
        <function name="doQuery" args="param">
        <![CDATA[
            if(Sepoa.request.alias) {
                dataOutput.setValue('BIZ_CATEGORY', Sepoa.request.alias);
            }
            dataOutput.addFilter(filterObj);
            listObj.clearAll(false);
            listObj.load(window.CONTEXT_NAME + '/SepoaList.sux?PROCESS_ID=sepoa.svc.ct.CT_301&mode=doList&METHOD=doQuerySBUPR' + dataOutput.getParams());
        ]]>
        </function>
        <function name="doQueryEnd" args="">
        <![CDATA[
            if(listObj.dataCount() > 0) {
                listObj.select('0');
                onItemClick('0');
            } else {
                $share.event.callEvent('onItemClick', [{}]);
            }
        ]]>
        </function>
        <function name="onItemClick" args="index, event, element">
        <![CDATA[
            const data = listObj.item(index);
            $share.event.callEvent('onItemClick', [data]);
        ]]>
        </function>
        <function name="onButtonClick" args="type">
        <![CDATA[
            switch(type) {
                case 'ADD' : 
                    addCompany();
                    break;
                default :
                    break;
            }
        ]]>
        </function>
        <function name="addCompany" args="">
        <![CDATA[
            listObj.unselectAll();
            $share.event.callEvent('addCompany', []);
        ]]>
        </function>
    </userscript>
