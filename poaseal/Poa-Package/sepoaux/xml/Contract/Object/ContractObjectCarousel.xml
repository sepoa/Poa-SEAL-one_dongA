<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="CT_200" header="false" tpl="editor.tpl">
    <carousel id="carouselObj" div="DNFbNUcYOTYlGulpvH">
        <item id="LIST" >
            <attach file="/Contract/Object/ContractObjectLayout.xml"/>
        </item>
        <item id="FORM">
            <attach file="/Contract/setForm/ContractSetFormLayout.xml"/>
        </item>
    </carousel>
    <onloadscript>
    </onloadscript>
    <userscript>
        <var name="$share" value="{childScreen:{}}" />
        <function name="changeView" args="data">
    	<![CDATA[
    		var id = data.view.toUpperCase();
    		carouselObj.cells(id).setActive();
            
            if(id == "FORM"){
                $share.config = data;
                if($share.childScreen.FORM){
                    $share.childScreen.FORM.fn.doOpenDocument($share.config);
                }
            }else if(id == "LIST"){
                if($share.childScreen.FORM){
                    $share.childScreen.FORM.fn.doClear();
                }
            
                delete $share.config;
                callFunction("CT_201", 'doQuery', []);
            }
    	]]>
    	</function>
    	
        <function name="childScreenReady" args="config">
        <![CDATA[
            $share.childScreen[config.name] = config;
            if($share.config){
                $share.childScreen[config.name].fn.doOpenDocument($share.config);
            }
        ]]>
        </function>
    </userscript>
