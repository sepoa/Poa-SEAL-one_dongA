<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="SPC_021" header="false">
    <filterbar id="filterObj" div="SIDdmmeLshemmezvoJ">
        <calendar id="F_CALENDAR" button="year:0,month:0,week:-4,day:0" default="week:-4"/>
        <status id="SMR_STATUS" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#SM034" label=""/>
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="doQuery"/>
    </filterbar>
    <button id="btnObj">
        <btn div="SIDdmmeUGQfmmeAIpb" id="count" type="template" toggle="false" reverse="false"/>
    </button>
    <grid id="gridObj" div="SIDdmmesjHgmmeQuqz" grid-id="SPC_021" drag="false" merge="false" dynamic="false">
        <event type="onRowSelect" callback="onRowSelect"/>
        <event type="onXLE" callback="onXLE"/>
    </grid>
    <variable>
        <var name="SIDdmmeVdMfmmeUhLC" value="$($sObject._vp).find('#SIDdmmeVdMfmmeUhLC')[0]"/>
        <var name="SIDdmmeJBPfmmeZxDX" value="$($sObject._vp).find('#SIDdmmeJBPfmmeZxDX')[0]"/>
        <var name="SIDdmmeVdMfmmeYZgQ" value="$($sObject._vp).find('#SIDdmmeVdMfmmeYZgQ')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <function name="init">
        <![CDATA[
        	gridObj.setColumnHidden(gridObj.getColIndexById('SEAL_USE_TYPE'), true);
        	gridObj.setColumnHidden(gridObj.getColIndexById('SEAL_NAMES'), true);
        	gridObj.setColumnHidden(gridObj.getColIndexById('CONFIRM_DATE'), true);
        	doQuery();
        ]]>
        </function>
        <function name="doQuery" args="">
        <![CDATA[
            dataOutput.setValue('MODE', 'TODO');
            
            dataOutput.addFilter(filterObj);
            // 처리대상: 반입대기(RR)만
            dataOutput.setValue('SMR_STATUS', 'RR');
            gridObj.postConnection(window.CONTEXT_NAME+'/SepoaGrid.sux', ['mode=doQuery', 'METHOD=doSelectToDoList', 'PROCESS_ID=sepoa.svc.seal.SepoaReqCertExtService']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="doSearch" args="rowId">
        <![CDATA[
            var smrNumber = "";
            var applyType = "";
            gridObj.editStop();
            
			var status = gridObj.cells(rowId, gridObj.getColIndexById("SMR_STATUS")).getValue();
		    if (status == 'T') {
                Alert(Sepoa.cache.text.get('SLM_201.MESSAGE_NOT_TEMP_SEARCH'));
                return;
            }
			    
		    smrNumber = gridObj.cells(rowId, gridObj.getColIndexById("SMR_NUMBER")).getValue();
		    applyType = gridObj.cells(rowId, gridObj.getColIndexById("APPLY_TYPE")).getValue();
            
            if (smrNumber != '') {
                callFunction('p', 'changeMode', [applyType, smrNumber, 'VIEW']);
            }
        ]]>
        </function>
        <function name="onRowSelect" args="id, ind">
        <![CDATA[
        	let coverProgress = false;	// 더블클릭 방지용 프로그레스 모달을 켰는지
            var header = this.getColumnId(ind);
            
            if (['SUBJECT'].indexOf(header) > -1) {
            	const smrStatus = gridObj.cells(id, gridObj.getColIndexById('SMR_STATUS')).getValue();
            	// 처리대상: 반입대기(RR)만
            	if (smrStatus != 'RR') return;
            	sUtils.progress.on();
            	coverProgress = true;
            	doSearch(id);
            }
            if (coverProgress) { setTimeout(function() { sUtils.progress.off();}, 100);}
        ]]>
        </function>
        <function name="onXLE" args="obj, count">
        <![CDATA[
            if (count == 0) {
                return;
            }
            
            var msg = obj.getUserData("", "message");
            var status = obj.getUserData("", "status");
            if (status != "true") {
               // Alert(msg);
            }
            
            var rowCount = gridObj.getRowsNum();
            
            if (rowCount > 0) {
                var colSeqIndex = gridObj.getColIndexById('ROWNUM');
                if (colSeqIndex < 0) {
                	colSeqIndex = gridObj.getColIndexById('ROW_NUM');
                }
                if (colSeqIndex < 0) {
                	return;
                }
                
                var colRowNumIndex = gridObj.getColIndexById('ROW_NUM');
                var seqCount = rowCount;
            
                for (var i = 0; i < rowCount; i++) {
                    var rowID = gridObj.getRowId(i);
                    var rowNum = '';
                    // 숨김 ROW_NUM 컬럼이 있으면 DB 채번 사용
                    if (colRowNumIndex >= 0 && colRowNumIndex != colSeqIndex) {
                    	rowNum = gridObj.cells(rowID, colRowNumIndex).getValue();
                    }
                    if (rowNum) {
                    	gridObj.cells(rowID, colSeqIndex).setValue(rowNum);
                    } else if (colRowNumIndex < 0 || colRowNumIndex == colSeqIndex) {
                    	// ROW_NUM 전용 컬럼 없음: 서버 ROWNUM(채번) 유지, 조회순번으로 덮어쓰지 않음
                    } else {
                    	gridObj.cells(rowID, colSeqIndex).setValue(seqCount--);
                    }
                }
            }
        ]]>
        </function>
    </userscript>
