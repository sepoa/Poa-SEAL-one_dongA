<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="SUMMARY" header="false" tpl="editor.tpl">
    <carousel id="carouselObj" div="uLUFpEckTzKLnUDJDl"/>
    <onloadscript>
        <![CDATA[
        	Sepoa.dashBoard = sUtils.workflow.check('DSB');
            Sepoa.dashBoardUrl = Sepoa.config.get('sepoa.dashboard.url');
            window.changeCarousel = changeCarousel;
        ]]>
        <call name="initCarousel"/>
    </onloadscript>
    <userscript>
        <function name="initCarousel" args="">
        <![CDATA[
            if(Sepoa.dashBoard){
                carouselObj.addCell('dashBoard');
                carouselObj.cells('dashBoard').attachURL(window.CONTEXT_NAME+"/Summary/DashBoard/SummaryDashBoard.sux");
                carouselObj.cells('dashBoard').setActive();
            }
            carouselObj.addCell('summary');
            carouselObj.cells('summary').attachURL(window.CONTEXT_NAME+'/Summary/SummaryMenu.sux');
        ]]>
        </function>
        <function name="changeCarousel" args="id">
        <![CDATA[
            carouselObj.cells(id).setActive();
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
    </template>
</body>