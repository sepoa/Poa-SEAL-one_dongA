<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="FINDPW_002" header="false">
    <form id="formObj" div="PwaHlDeTlUIlDemwoV" form-id="FINDID">
        <event type="onKeydown" callback="onKeydown"/>
    </form>
    <button id="btnObj">
        <btn div="PwaHlDeSFXIlDepSsq" id="FIND" text="{FINDPW.BUTTON_OK}" toggle="false" reverse="false" onclick="doQuery(  )"/>
    </button>
    <usercss>
    <![CDATA[
        #FIND {
            /*margin-right:10px*/
            margin-left: -35px;
        }
        
        .dhxform_obj_material .dhxform_custom_required .dhxform_control .dhxform_select,
        .dhxform_obj_material .dhxform_custom_required .dhxform_control .dhxform_textarea {
            height: 35px;
            background-color: #fff;
        }
        
        .sepoaux_button .btn_default {
            width: 299px;
            margin-top: 10px;
            height: 35px;
            border-radius: 4px;
        }
    ]]>
    </usercss>
    <variable>
        <var name="PwaHlDeiuRIlDeYYE" value="$($sObject._vp).find('#PwaHlDeiuRIlDeYYE')[0]"/>
        <var name="PwaHlDeiuRIlDeimpb" value="$($sObject._vp).find('#PwaHlDeiuRIlDeimpb')[0]"/>
    </variable>
    <onloadscript>
        <![CDATA[
            if (Sepoa.info.LANGUAGE == undefined) {
                var language = navigator.systemLanguage;
                if (!language) {
                    language = navigator.language;
                }
                language = language.toUpperCase().substring(0, 2);
                Sepoa.info.LANGUAGE = language.toUpperCase().substring(0, 2);
            }
        ]]></onloadscript>
    <userscript>
        <function name="doQuery" args="">
        <![CDATA[
            var name = formObj.getValue("USER_NAME");
            var email = formObj.getValue("EMAIL");
            if (name.length < 1) {
                Alert(Sepoa.cache.text.get('FINDPW.INSERT_NAME'));
                return false;
            } else if (email.length < 1) {
                Alert(Sepoa.cache.text.get('FINDPW.INSERT_EMAIL'));
                return false;
            } else {
                doServiceAjax('sepoa.svc.common.FindPw', 'CONNECTION', 'doQueryID', null, function(so) {
                    if (so.status != 1) {
                        Alert(so.message);
                        return;
                    } else {
                        Alert(so.message);
                        window.selfObj.close();
                    }
                });
            }
        ]]>
        </function>
        <function name="onKeydown" args="inp, ev, name, value">
        <![CDATA[
            if (ev.keyCode == '13') {
                doQuery();
            }
        ]]>
        </function>
    </userscript>
