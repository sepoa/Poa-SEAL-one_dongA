<body screen_id="FINDPW_003" header="false">
    <form id="formObj" div="LOqHlDeeGbJlDeYOVS" form-id="FIND_PW">
        <event type="onKeydown" callback="onKeydown"/>
    </form>
    <button id="LOqHlDekScJlDewTSd">
        <btn div="LOqHlDekScJlDewTSd" id="FIND" text="{FINDPW.BUTTON_OK}" toggle="false" reverse="false" onclick="doUpdate(  )"/>
    </button>
    <usercss>
    <![CDATA[
        #FIND {
            /*margin-right:10px*/
            margin-left: -35px;
        }
        
        .dhxform_obj_material .dhxform_custom_required .dhxform_control .dhxform_select,
        .dhxform_obj_material .dhxform_custom_required .dhxform_control .dhxform_textarea {
            height: 35px;
            background-color: #fff;
        }
        
        .sepoaux_button .btn_default {
            width: 299px;
            margin-top: 10px;
            height: 35px;
            border-radius: 4px;
        }
    ]]>
    </usercss>
    <variable>
        <var name="LOqHlDeyJaJlDeZSJB" value="$($sObject._vp).find('#LOqHlDeyJaJlDeZSJB')[0]"/>
        <var name="LOqHlDeyJaJlDeCOxY" value="$($sObject._vp).find('#LOqHlDeyJaJlDeCOxY')[0]"/>
    </variable>
    <onloadscript/>
    <userscript>
        <function name="doUpdate" args="">
        <![CDATA[
            var userId = formObj.getValue("USER_ID");
            var email = formObj.getValue("EMAIL");
            if (userId.length < 1) {
                Alert(Sepoa.cache.text.get('FINDPW.INSERT_ID'));
                return false;
            } else if (email.length < 1) {
                Alert(Sepoa.cache.text.get('FINDPW.INSERT_EMAIL'));
                return false;
            } else {
                doServiceAjax('sepoa.svc.common.FindPw', 'TRANSACTION', 'doSendPWResetLink', null, function(so) {
                    if (so.status != 1) {
                        Alert(so.message);
                        return;
                    } else {
                        Alert(so.message);
                        window.selfObj.close();
                    }
                });
            }
        ]]>
        </function>
        <function name="onKeydown" args="inp, ev, name, value">
        <![CDATA[
            if (ev.keyCode == '13') {
                doUpdate();
            }
        ]]>
        </function>
    </userscript>
