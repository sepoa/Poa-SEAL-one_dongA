<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_202_3" header="false">
    <filterbar id="filterObj" div="CSgNbTbEzwNEtZhcYe">
        <keyword id="F_KEYWORD"/>
    </filterbar>
    <list id="listObj" div="CSgNbTbYCDOEtZhPGS">
        <type>
            <template><![CDATA[<table width=100% class=sepoa_list_design><tr><td class=sepoa_list_font_bold>#subject#</td></tr></table>]]></template>
        </type>
        <event type="onItemClick" callback="doRowSelect"/>
        <event type="onXLE" callback="doQueryEnd"/>
    </list>
    <onloadscript>
        <![CDATA[
            dataOutput.setValue('QUERY_MODE', 'doList');
        ]]>
        <call name="doQuery"/>
        <event obj="filterObj" type="onSearch">
            <function args="id">
            <![CDATA[
                if (id == 'filter' || id == 'search') {
                    doQuery();
                }
            ]]>
            </function>
        </event>
    </onloadscript>
    <userscript>
        <![CDATA[
            //조회
        ]]>
        <function name="doQuery" args="">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            var params = dataOutput.getParams();
            params += '&PROCESS_ID=sepoa.svc.admin.AD_202_3'
            params += '&METHOD=doQuery'
            listObj.load(window.CONTEXT_NAME + '/SepoaList.sux?mode=doList' + params);
            listObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="">
        <![CDATA[
            if (listObj.dataCount() > 0) {
                var id = listObj.idByIndex(0);
                listObj.select(id)
                doRowSelect(id);
            }
        ]]>
        </function>
        <![CDATA[
            //로우선택
        ]]>
        <function name="doRowSelect" args="id, ev, html">
        <![CDATA[
            callFunction('AD_202_2', 'doQuery', [listObj.get(id).notice_number]);
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
