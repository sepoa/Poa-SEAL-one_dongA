<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_202_1" header="false" tpl="editor.tpl">
    <carousel id="carouselObj" div="GczZxPcwhVsorpOrkL"/>
    <usercss>
    <![CDATA[
        .btnGroup{
            height:100%;
            width:100%;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .pagingBtn {
            height: 30px;
            width: 30px;
            cursor: pointer;
            border: 1px solid #DEDEDE;
            border-radius: 10%;
            margin-right: 5px;
            background-color: #ffffff;
            color: #000000;
        }
        .pagingBtn:first-child{
            margin:0px;
        }
        .pagingBtn:hover {
            background-color: #0288D1;
            color: #ffffff;
        }
        .active {
            background-color: #0288D1;
            color: #ffffff;
            border: none;
            outline: 0;
        }
    ]]>
    </usercss>
    <variable>
        <var name="pageControllerBox" value="$($sObject._vp).find('#zrLAdvdSFKBdvdjTVu')[0]"/>
        <var name="zrLAdvdRFKBdvdYEvG" value="$($sObject._vp).find('#zrLAdvdRFKBdvdYEvG')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
        <event obj="SUX" type="onWindowResize" callback="carouselResizeHandler"/>
    </onloadscript>
    <userscript>
        <var name="noticeList" value="Sepoa.request.NOTICELIST.split(',')"/>
        <function name="init">
        <![CDATA[
            carouselResizeHandler();
            drawPageNav();
            
            for (var i = 0; i < noticeList.length; i++) {
                carouselObj.addCell(noticeList[i]);
                carouselObj.cells(noticeList[i]).attachURL(window.CONTEXT_NAME + '/Admin/NoticeView/AdminNoticeViewView.sux?NOTICE_NUMBER=' + noticeList[i]);
            }
        ]]>
        </function>
        <function name="carouselResizeHandler" args="">
        <![CDATA[
            carouselObj.cont.parentElement.style.height= $sObject._vp[0].offsetHeight - pageControllerBox.offsetHeight + 'px';
        ]]>
        </function>
        <function name="drawPageNav" args="">
        <![CDATA[
            pageControllerBox.innerHTML = "";
            var group = pageControllerBox.appendChild($('<div class="btnGroup"></div>')[0]);
            for (var i = 0; i < noticeList.length; i++) {
                var btn = group.appendChild($('<button class="pagingBtn">' + (i + 1) + '</button>')[0]);
                btn._noticeNumber = noticeList[i];
                btn.onclick = function(){
                    $(pageControllerBox).find('.active').removeClass('active');
                    this.classList.add('active');
                    carouselObj.cells(this._noticeNumber).setActive();
                };
                if(i == 0){
                    btn.classList.add('active');
                }
            }
            
        ]]>
        </function>
        <function name="deleteCell" args="id">
        <![CDATA[
            carouselObj.cells(id).remove();
            
            var obj_length = Object.keys(carouselObj.ind).length;
            var tempArr = [];
            
            for (var i = 0; i < obj_length; i++) {
                tempArr[i] = carouselObj.ind[i];
            }
            
            noticeList = tempArr;
            
            var count = 0;
            
            for (var i in carouselObj.cdata) {
                count++;
            }
            
            if (count) {
                carouselObj.goFirst();
            } else {
                selfObj.close();
            }
            
            $('.btnGroup').empty();
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
    </template>
</body>