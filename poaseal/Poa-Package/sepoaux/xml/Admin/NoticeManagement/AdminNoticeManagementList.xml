<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_201_1" header="false">
    <filterbar id="filterObj" div="nMCHbTbgDLYDEfgDgS">
        <keyword id="F_KEYWORD"/>
        <filter>
            <option id="F_DATE" type="calendar"/>
            <option id="AFFILIATED_COMPANY" type="select" combo="AD1020,{HOUSE_CODE}"/> 
        </filter>
    </filterbar>
    <list id="listObj" div="nMCHbTbABUYDEfgACm">
        <type>
            <template><![CDATA[<table width=100% class=sepoa_list_design><col width=33%/><col width=33%/><col width=33%/><tr><td class=sepoa_list_font_bold colspan=2>#subject#</td><td class=\"sepoa_list_font_bold sepoa_list_align_right\"> #company_name#</td></tr><tr><td colspan=2><span><span>$DATE{publish_from_date}</span></span> ~ <span><span>$DATE{publish_to_date}</span></span></td><td class=sepoa_list_align_right>#notice_number#</td></tr><tr><td class=sepoa_list_font_bold>#add_user_name#</td><td class=\"sepoa_list_align_right listHighlight sepoa_list_font_bold\">#publish_flag_text#</td><td class=\"sepoa_list_font_bold sepoa_list_align_right\">#gongji_gubun_text#</td></tr></table>]]></template>
        </type>
        <event type="onItemClick" callback="doRowSelect"/>
        <event type="onXLE" callback="doQueryEnd"/>
    </list>
    <onloadscript>
        <![CDATA[
            dataOutput.setValue('QUERY_MODE', 'doList');
        ]]>
        <call name="doQuery"/>
        <event obj="filterObj" type="onSearch">
            <function args="id">
            <![CDATA[
                if (id == 'filter' || id == 'search') {
                    doQuery();
                }
            ]]>
            </function>
        </event>
        <call name="init"/>
    </onloadscript>
    <userscript>
    	<function name = "init" args = ""> 
    		<![CDATA[
    			 if (Sepoa.info.MASTER_COMPANY_FLAG != 'Y') {
          			filterObj.setHide("AFFILIATED_COMPANY");
                }
    		]]>				
    	</function>
        <function name="doQuery" args="">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            var params = dataOutput.getParams();
            params += '&PROCESS_ID=sepoa.svc.admin.AD_201'
            params += '&METHOD=doQueryList'
            listObj.load(window.CONTEXT_NAME + '/SepoaList.sux?mode=doList' + params);
            listObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="">
        <![CDATA[
            if (listObj.dataCount() > 0) {
                var id = listObj.idByIndex(0);
                listObj.select(id)
                doRowSelect(id);
            }
        ]]>
        </function>
        <function name="doRowSelect" args="id, ev, html">
        <![CDATA[
            callFunction('AD_201_2', 'doQuery', [listObj.get(id).notice_number]);
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        XG48L2Rpdj4ifQ==
    </template>
</body>