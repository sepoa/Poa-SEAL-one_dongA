<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_102_P_G" header="false" pageCloseWarn="false">
    <filterbar id="filterObj" div="KZRHtYfbwWHtYflAuU">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="doQuery"/>
    </filterbar>
    <button id="btnObj">
        <btn div="KZRHtYfCKwHtYfkqZt" id="EXCEL_UPLOAD" type="excelupload" text="{BUTTON.EXCEL_UPLOAD}" toggle="false" reverse="false" onclick="onButtonClick( 'upload' )"/>
        <btn div="KZRHtYfCKwHtYfkqZt" id="ROWADD" text="{BUTTON.rowadd}" toggle="false" reverse="false" onclick="onButtonClick( 'rowAdd' )"/>
        <btn div="KZRHtYfCKwHtYfkqZt" id="SAVE" text="{BUTTON.save}" toggle="false" reverse="false" onclick="onButtonClick( 'save' )"/>
        <btn div="KZRHtYfCKwHtYfkqZt" id="ROWDELETE" text="{BUTTON.rowdelete}" toggle="false" reverse="false" onclick="onButtonClick( 'rowDelete' )"/>
    </button>
    <grid id="gridObj" div="KZRHtYfeZnItYfpdFa" grid-id="AD_102_P_G" drag="false" merge="false" dynamic="false" exceldownload="true">
        <event type="onTXE" callback="onTXE"/>
        <event type="onEditCell" callback="onEditCell"/>
    </grid>
    <variable>
        <var name="KZRHtYfoJTHtYfJEKj" value="$($sObject._vp).find('#KZRHtYfoJTHtYfJEKj')[0]"/>
        <var name="KZRHtYfLgVHtYfunRj" value="$($sObject._vp).find('#KZRHtYfLgVHtYfunRj')[0]"/>
        <var name="KZRHtYfoJTHtYfxwPs" value="$($sObject._vp).find('#KZRHtYfoJTHtYfxwPs')[0]"/>
    </variable>
    <onloadscript>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <var name="rowCount"/>
        <function name="doQuery">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.admin.SepoaOrgManagementService', 'METHOD=doQueryPosition']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="onButtonClick" args="id">
        <![CDATA[
            switch (id.toUpperCase()) {
                case 'UPLOAD':
                    doOpenUploadPopup();
                    break;
            
                case 'ROWADD':
                    doRowAdd();
                    break;
            
                case 'SAVE':
                    doSave();
                    break;
            
                case 'ROWDELETE':
                    doRowDelete();
                    break;
            }
        ]]>
        </function>
        <function name="doOpenUploadPopup" args="">
        <![CDATA[
            var width = Math.min(SUX.root.innerWidth * 0.7, 640);
            var height = Math.min((SUX.root.innerHeight - 100) * 0.9, 800);
            PopupOpenPost('/Admin/OrganizationManagement/Popup/AdminOrganizationManagementPosition.sux', {}, doOpenUploadPopupCallback, width, height, Sepoa.cache.text.get('SLM_910.UPLOAD_POPUP_TITLE'));
        ]]>
        </function>
        <function name="doOpenUploadPopupCallback" args="">
        <![CDATA[
            doQuery();
        ]]>
        </function>
        <function name="doRowAdd" args="">
        <![CDATA[
            rowCount = gridObj.getRowsNum();
            
            var maxRowId = rowCount + 1;
            gridObj.addRow(maxRowId, '', gridObj.getRowsNum());
            gridObj.cells(maxRowId, gridObj.getColIndexById('SELECTED')).setValue("1");
        ]]>
        </function>
        <function name="doSave" args="">
        <![CDATA[
            if (gridObj.getGridChangedRows("SELECTED").length == 0) {
                Alert(Sepoa.cache.text.get('MESSAGE.1004'));
                return;
            }
            if (!gridObj.validate()) {
                Alert(Sepoa.cache.text.get('MESSAGE.0003'));
                return;
            }
            Confirm(Sepoa.cache.text.get('MESSAGE.1018'), function(result) {
                if (result) {
                    gridObj.editStop();
                    gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.admin.SepoaOrgManagementService', 'METHOD=doSavePosition'], 'SELECTED');
                }
            });
        ]]>
        </function>
        <function name="doRowDelete" args="">
        <![CDATA[
            if (gridObj.getGridChangedRows("SELECTED").length > 0 && Confirm(Sepoa.cache.text.get('MESSAGE.1015'), function(result) {
                    if (result) {
                        gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.admin.SepoaOrgManagementService', 'METHOD=doDeletePosition'], 'SELECTED');
                    }
                }));
        ]]>
        </function>
        <function name="onTXE" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if (status == "true") {
                doQuery();
            } else {
                Alert(message);
            }
        ]]>
        </function>
        <function name="onEditCell" args="stage, rId, cInd, nValue, oValue">
        <![CDATA[
            if (stage == 2) {
          		if( nValue != oValue ) {
              		gridObj.cells(rId, gridObj.getColIndexById('SELECTED')).setValue(true);
           		}
           		var header = gridObj.getColumnId(cInd); 
                if (header == 'POSITION' && nValue != oValue && oValue > '') {
                    Alert(Sepoa.cache.text.get('MESSAGE.1097')); //직급 코드는 수정할 수 없습니다. 삭제 후 추가 하세요. 
                    gridObj.cells(rId, gridObj.getColIndexById("POSITION")).setValue(oValue);
                }
			}
			return true;
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
    </template>
</body>