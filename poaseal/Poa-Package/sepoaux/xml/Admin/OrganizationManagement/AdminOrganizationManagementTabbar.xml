<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_102_T" header="false">
    <list id="listObj" div="tJSlDtdbMZlDtdsnTC">
        <type>
            <template><![CDATA[<table width=100% class=sepoa_list_design><col width=10%/><col width=70%/><tr><td></td><td><span class="docTitle#title#"></span>#description#</td></tr></table>]]></template>
        </type>
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onItemClick" callback="doRowSelect"/>
    </list>
    <usercss>
    <![CDATA[
        span.docTitle {
            font-size: 1.2em;
            letter-spacing: 2px;
        }
    ]]>
    </usercss>
    <onloadscript>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <function name="doQuery" args="">
        <![CDATA[
            var params = '&PROCESS_ID=sepoa.svc.admin.SepoaOrgManagementService&METHOD=doQueryList';
            listObj.load(window.CONTEXT_NAME + '/SepoaList.sux?mode=doList' + params);
            listObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="">
        <![CDATA[
        	listObj.select(listObj.first());
        ]]>
        </function>
        <function name="doRowSelect" args="id">
        <![CDATA[
            var carouselId = "";
            var changeHeaderText = "";
            
            if (id == 0) {
                carouselId = "companyGrid";
                callFunction('AD_102_C_G', 'doQuery', []);
                changeHeaderText = Sepoa.cache.text.get('AD_102_T.COMPANY_INFO');
            }
            if (id == 1) {
                carouselId = "dept";
                callFunction('AD_102_D_G', 'doQuery', []);
                changeHeaderText = Sepoa.cache.text.get('AD_102_T.DEPT_INFO'); 	
            }
            if (id == 2) {
            	carouselId = "position"
            	callFunction('AD_102_P_G', 'doQuery', []);
            	changeHeaderText =Sepoa.cache.text.get('AD_102_T.POSITION');    
            }
            if (id == 3) {
            	carouselId = "ctrl"
            	callFunction('AD_102_CT_G', 'doQuery', []);
            	changeHeaderText =Sepoa.cache.text.get('AD_102_T.CTRL_INFO');    
            }
            if (id == 4) {
            	carouselId = "ctrl_manager"
            	callFunction('AD_102_CT_M_G', 'doQuery', []);
            	changeHeaderText = Sepoa.cache.text.get('AD_102_T.CTRL_MANAGER_INFO');
            }
            callFunction('AD_102_C', 'carouselControl', [carouselId]);
            callFunction('p', 'changeHeaderText', ['b', changeHeaderText]);
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
    </template>
</body>