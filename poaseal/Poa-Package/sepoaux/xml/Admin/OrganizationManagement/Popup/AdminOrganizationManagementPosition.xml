<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_102_P_G_P" header="false" pageCloseWarn="false">
    <button id="btnObj">
        <btn div="a671843a75c849f3846ede8d0a7c64" id="TEMPLATE_DOWNLOAD" type="exceldownload" text="{BUTTON.template_download}" onclick="onButtonClick( 'TEMPLATE' )"/>
        <btn div="a671843a75c849f3846ede8d0a7c64" id="FILE_UPLOAD" type="fileattach" text="{BUTTON.EXCEL_UPLOAD}" onclick="onButtonClick( 'UPLOAD' )"/>
        <btn div="a671843a75c849f3846ede8d0a7c64" id="SAVE" type="save" text="{BUTTON.save}" onclick="onButtonClick( 'SAVE' )"/>
    </button>
    <grid id="gridObj" div="b04e3a6bf60f439e8cc5ea5763ab11" grid-id="AD_102_P_G_P" drag="false" merge="false" dynamic="false" exceldownload="true">
        <event type="onTXE" callback="doSaveEnd"/>
    </grid>
    <variable>
        <var name="f6fe387d919445f488ebe265a56c53" value="$($sObject._vp).find('#f6fe387d919445f488ebe265a56c53')[0]"/>
        <var name="af1ed724e0ee46aa8edce6baec79bb" value="$($sObject._vp).find('#af1ed724e0ee46aa8edce6baec79bb')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <function name="init" args="">
        <![CDATA[
            if (typeof(selfObj.close) != "undefined") {
                selfObj.close = function() {
                    Sepoa.params.callback();
                    this.unload();
                }
            }
        ]]>
        </function>
        <function name="onButtonClick" args="id">
        <![CDATA[
            switch (id) {
                case 'TEMPLATE':
                    break;
            
                case 'UPLOAD':
                    doUploadExcel();
                    break;
            
                case 'SAVE':
                    doUploadSave();
                    break;
            }
        ]]>
        </function>
        <function name="doUploadExcel" args="">
        <![CDATA[
            sepoaExcelProcessor('up', 'sepoa.svc.admin.SepoaOrgManagementService', 'doUploadPositionData', doUploadFileCallback);
        ]]>
        </function>
        <function name="doUploadFileCallback" args="res">
        <![CDATA[
            if (res.status != 'true') {
                Alert(Sepoa.cache.text.get("POA_CONTRACT.STATUS_105020") + "<br/>" + res.message);
                return;
            } else {
                let excelData = JSON.parse(res.result[0]);
                renderData(excelData);
            }
        ]]>
        </function>
        <function name="renderData" args="dataObj">
        <![CDATA[
            gridObj.clearAll(false);
            for (let i of dataObj) {
                let tmpItem = i;
                let maxRowId = dhx4.newId();
                gridObj.addRow(maxRowId, '', gridObj.getRowsNum());
            
                let tmpKeySet = Object.keys(i);
                for (let j of tmpKeySet) {
                    gridObj.cells(maxRowId, gridObj.getColIndexById(j)).setValue(i[j]);
                }
            }
        ]]>
        </function>
        <function name="doUploadSave" args="">
        <![CDATA[
            gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.admin.SepoaOrgManagementService', 'METHOD=doSavePositionData']);
        ]]>
        </function>
        <function name="doSaveEnd" args="obj">
        <![CDATA[
            let result = JSON.parse(obj.result);
            renderData(result);
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
        
        
