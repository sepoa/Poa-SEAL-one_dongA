<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_102_C_G" header="false" tpl="editor.tpl">
    <filterbar id="filterObj" div="VAFNntdUeONntdGZVC">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="doQuery"/>
    </filterbar>
    <button id="btnObj">
        <btn div="wtSBltdErZBltdRTNV" id="NEW" type="default" text="{BUTTON.new}" onclick="newCompany(  )"/>
        <btn div="wtSBltdErZBltdRTNV" id="DELETE" type="default" text="{BUTTON.delete}" onclick="deleteCompany(  )"/>
    </button>
    <grid id="gridObj" div="xhILktdfZJLktdyAhO" grid-id="AD_102_C" drag="false" merge="false" dynamic="false">
        <event type="onRowSelect" callback="onRowSelect"/>
        <event type="onTXE" callback="onTXE"/>
        <event type="onXLE" callback="doQueryEnd"/>
    </grid>
    <variable>
        <var name="fTbffvdpSfifvdBQHH" value="$($sObject._vp).find('#fTbffvdpSfifvdBQHH')[0]"/>
        <var name="fTbffvdvejifvddGzY" value="$($sObject._vp).find('#fTbffvdvejifvddGzY')[0]"/>
        <var name="fTbffvdoSfifvdpMID" value="$($sObject._vp).find('#fTbffvdoSfifvdpMID')[0]"/>
    </variable>
    <onloadscript>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <function name="deleteCompany" args="">
        <![CDATA[
            if(gridObj.getGridChangedRows("SELECTED").length > 0 && Confirm(Sepoa.cache.text.get('MESSAGE.1015'),function(result){
                if(result){
                    gridObj.postTransaction(window.CONTEXT_NAME+'/SepoaGrid.sux',['mode=doSave', 'PROCESS_ID=sepoa.svc.admin.SepoaOrgManagementService', 'METHOD=doDeleteRowCompany'],'SELECTED');
                }
            }));
        ]]>
        </function>
        <function name="doQuery" args="item">
        <![CDATA[
            callFunction(['p','p'],'changeHeaderText', ['b',Sepoa.cache.text.get('AD_102_C_G.companyinfo')]); //회사정보
            dataOutput.addFilter(filterObj);
            
            gridObj.postConnection(window.CONTEXT_NAME+'/SepoaGrid.sux',['mode=doQuery', 'PROCESS_ID=sepoa.svc.admin.SepoaOrgManagementService', 'METHOD=doQueryCompanyGrid']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="obj, rowCnt">
        <![CDATA[
            var msg        = obj.getUserData("", "message");
            var status    = obj.getUserData("", "status");
            if(status != "true"){
                Alert(msg);
            }
        ]]>
        </function>
        <function name="newCompany" args="">
        <![CDATA[
            callFunction('p', 'carouselControl', ['companyWrite']);
            callFunction('AD_102_C_C', 'addNewItem', []);
            callFunction(['p','p'],'changeHeaderText', ['b',Sepoa.cache.text.get('AD_102_C_G.company_register')]); //회사등록
        ]]>
        </function>
        <function name="onRowSelect" args="id, ind">
        <![CDATA[
            var header = gridObj.getColumnId(ind);
            var rowData = gridObj.getRowDataObject(id);
            
            if(header == "COMPANY_NAME"){
                callFunction('p', 'carouselControl', ['companyWrite']);
                callFunction('AD_102_C_C', 'doQuery', [rowData.COMPANY_CODE]);
            }
        ]]>
        </function>
        <function name="onTXE" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if(status=="true"){
                doQuery();
            }
            else{
                Alert(message);
            }
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        ZGl2PiJ9
    </template>
</body>