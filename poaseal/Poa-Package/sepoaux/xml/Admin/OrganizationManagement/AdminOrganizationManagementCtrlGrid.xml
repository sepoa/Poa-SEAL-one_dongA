<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_102_CT_G" header="false">
    <filterbar id="filterObj" div="DaCmkYfbPPmkYfbzQU">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="doQuery"/>
    </filterbar>
    <button id="btnObj">
        <btn div="DaCmkYfWeVmkYfrIdn" id="ROWADD" text="{BUTTON.rowadd}" onclick="doAddRow()"/>
        <btn div="DaCmkYfWeVmkYfrIdn" id="SAVE" text="{BUTTON.save}" onclick="doSave()"/>
        <btn div="DaCmkYfWeVmkYfrIdn" id="ROWDELETE" text="{BUTTON.rowdelete}" onclick="doDeleteRow()"/>
    </button>
    <grid id="gridObj" div="DaCmkYfeqBpkYfUbWf" grid-id="AD_102_CT" drag="false" merge="false" dynamic="false">
    	<event type="onXLE" callback="doQueryEnd"/>
    	<event type="onTXE" callback="doSaveEnd"/>
    	<event type="onEditCell" callback="onEditCell"/>
    	<event type="onRowSelect" callback="onRowSelect"/>
    </grid>
    <variable>
        <var name="DaCmkYfTpGmkYfhORL" value="$($sObject._vp).find('#DaCmkYfTpGmkYfhORL')[0]"/>
        <var name="DaCmkYfCZMmkYfjvVX" value="$($sObject._vp).find('#DaCmkYfCZMmkYfjvVX')[0]"/>
        <var name="DaCmkYfTpGmkYfdTOj" value="$($sObject._vp).find('#DaCmkYfTpGmkYfdTOj')[0]"/>
    </variable>
    <onloadscript>
    	<call name="doQuery"/>
    </onloadscript>
    <userscript>
    	<var name="rowId"/>
    	<function name="doQuery">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME+'/SepoaGrid.sux',['mode=doQuery', 'PROCESS_ID=sepoa.svc.admin.SepoaOrgManagementService', 'METHOD=doQueryCtrlGrid']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="obj, rowCnt">
        <![CDATA[
            var msg = obj.getUserData("", "message");
            var status = obj.getUserData("", "status");
            
            if(status != "true"){
                Alert(msg);
            }
        ]]>
        </function>
        <function name="doSaveEnd" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if (status == 'true') {
                Alert(message);
                doQuery();
            } else {
                Alert(message);
            }
        ]]>
        </function>
        <function name="onEditCell" args="stage, rId, cInd, nValue, oValue">
        <![CDATA[
        	let header = gridObj.getColumnId(cInd);
        
        	if (stage == 2) {
        		gridObj.cells(rId, gridObj.getColIndexById('SELECTED')).setValue(true);
        		if(header == 'CTRL_CODE'){
		            gridObj.forEachRowA(function(id) { 
						if(rId != id && nValue == gridObj.cells(id, gridObj.getColIndexById('CTRL_CODE')).getValue()){
							Alert("동일한 직무코드가 있습니다.");
							gridObj.cells(rId, cInd).setValue('');
							return ; 	
						}
					});
        		}
        	}
        	return true;
        ]]>
        </function>
    	<function name="doAddRow" args="item">
        <![CDATA[
            
            var rowCount = gridObj.getRowsNum();
            var maxRowId = rowCount + 1;
            var ctrlNumber = getDocumentNumber("CTRL"); // 직무채번
            
            gridObj.addRow(maxRowId,'',gridObj.getRowsNum());
            gridObj.cells(maxRowId, gridObj.getColIndexById('SELECTED')).setValue("1");
            gridObj.cells(maxRowId, gridObj.getColIndexById('CTRL_NUMBER')).setValue(ctrlNumber);
            
            gridObj.showRow(maxRowId);
        ]]>
        </function>
        <function name="doDeleteRow">
        <![CDATA[
            if(gridObj.getGridChangedRows("SELECTED").length > 0 && Confirm(Sepoa.cache.text.get('MESSAGE.1015'),function(result){
                if(result){
                    gridObj.postTransaction(window.CONTEXT_NAME+'/SepoaGrid.sux',['mode=doSave', 'PROCESS_ID=sepoa.svc.admin.SepoaOrgManagementService', 'METHOD=doDeleteCtrlGrid'],'SELECTED');
                }
            }));
        ]]>
        </function>
        <function name="doSave">
        <![CDATA[
        	if (gridObj.getGridChangedRows("SELECTED").length == 0) {
                Alert(Sepoa.cache.text.get('MESSAGE.1004'));
                return;
            }
            
            if (!gridObj.validate()) {
            	Alert(Sepoa.cache.text.get('MESSAGE.0003'));
            	return;
            }
            
            Confirm(Sepoa.cache.text.get('MESSAGE.1018'), function(result) {
                if (result) {
                    gridObj.editStop();
					gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.admin.SepoaOrgManagementService', 'METHOD=doSaveCtrlGrid'], 'SELECTED');
                }
            });
        ]]>
        </function>
		<function name="onRowSelect" args="rId, cInd">
        <![CDATA[
            var header = gridObj.getColumnId(cInd); 
            rowId = rId;
            
			if(header == 'COMPANY_CODE'){
            	PopupCommonPost('AD1020_4', popupCallback, [Sepoa.info.HOUSE_CODE]);
            }
        ]]>
        </function>
        <function name="popupCallback" args="companyCode">
        <![CDATA[
 			gridObj.cells(rowId, gridObj.getColIndexById("COMPANY_CODE")).setValue(companyCode);
        ]]>
        </function>
    </userscript>
