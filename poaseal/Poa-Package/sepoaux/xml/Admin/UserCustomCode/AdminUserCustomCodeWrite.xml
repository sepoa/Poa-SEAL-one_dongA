<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_014_4" header="false">
    <button id="btnObj">
        <btn div="ExQwxwdbYTwxwdXrfX" id="new" type="new" text="{BASE_BUTTON.NEW}" toggle="false" reverse="false" onclick="doNew(  )"/>
        <btn div="ExQwxwdbYTwxwdXrfX" id="delete" text="{BASE_BUTTON.DELETE}" toggle="false" reverse="false" onclick="doDelete(  )"/>
        <btn div="ExQwxwdbYTwxwdXrfX" id="save" type="save" text="{BASE_BUTTON.SAVE}" toggle="false" reverse="false" onclick="doSave(  )"/>
        <btn div="PtjmeQbYTFiCgdzZuQ" id="addRow" text="{BASE_BUTTON.ROW_ADD}" toggle="false" reverse="false" onclick="addRow(  )"/>
        <btn div="PtjmeQbYTFiCgdzZuQ" id="copyRow" text="{BASE_BUTTON.ROW_COPY}" toggle="false" reverse="false" onclick="addRow( &#39;copy&#39; )"/>
        <btn div="PtjmeQbYTFiCgdzZuQ" id="deleteRow" text="{BASE_BUTTON.ROW_DELETE}" toggle="false" reverse="false" onclick="deleteRow(  )"/>
    </button>
    <grid id="gridObj" div="QtjmeQbIQVjCgdzffT" grid-id="file:///resource/ux/admin/grid/AD_014_4.js" drag="false" merge="false" dynamic="false">
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onTXE" callback="doSaveEnd"/>
    </grid>
    <variable>
        <var name="formbox" value="$($sObject._vp).find('#JvjmeQbSmYQfQbvah')[0]"/>
        <var name="JvjmeQbOjdQfQbNjoh" value="$($sObject._vp).find('#JvjmeQbOjdQfQbNjoh')[0]"/>
        <var name="JvjmeQbSmYQfQbKOQl" value="$($sObject._vp).find('#JvjmeQbSmYQfQbKOQl')[0]"/>
    </variable>
    <onloadscript>
        <call name="dataOutput.setValue" args="'MODULE_TYPE','M000'"/>
        <call name="setGridDraw"/>
    </onloadscript>
    <userscript>
        <function name="addRow" args="mode">
        <![CDATA[
            var maxRowId = new Date().getTime() + '' + dhx4.newId();
            if (mode == 'copy') {
                var selectedRow = gridObj.getGridChangedRows("SELECTED");
                if (selectedRow.length < 1) {
                    Alert(Sepoa.cache.text.get('MESSAGE.9999'));
                }
                for (var i = 0; i < selectedRow.length; i++) {
                    gridObj.addRow(maxRowId, '', gridObj.getRowsNum());
                    gridObj.copyRowContent(selectedRow[i], maxRowId);
                    gridObj.cells(maxRowId, gridObj.getColIndexById('SELECTED')).setValue("1");
                    gridObj.cells(maxRowId, gridObj.getColIndexById('SAVED')).setValue("");
                    maxRowId = dhx4.newId();
                }
            } else {
                gridObj.addRow(maxRowId, '', gridObj.getRowsNum());
                gridObj.cells(maxRowId, gridObj.getColIndexById('SELECTED')).setValue("1");
                gridObj.cells(maxRowId, gridObj.getColIndexById('USE_FLAG')).setValue("1");
            }
            gridObj.showRow(maxRowId);
        ]]>
        </function>
        <function name="deleteRow" args="">
        <![CDATA[
            var selectedCount = gridObj.getSelectedRows('SELECTED');
            if (selectedCount.length == 0) {
                Alert("행을 선택해 주세요.");
            } else {
                Confirm(Sepoa.cache.text.get('MESSAGE.1015'), function(flag) {
                    if (flag) {
                        gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.admin.AD_014', 'METHOD=doDeleteCodeDetail'], 'SELECTED');
                    }
                });
            }
        ]]>
        </function>
        <function name="doDelete" args="">
        <![CDATA[
            var code = formObj.getValue('TYPE');
            Confirm('공통코드(' + code + ')를 ' + Sepoa.cache.text.get('MESSAGE.1015'), function(flag) {
                if (flag) {
                    doServiceAjax('sepoa.svc.admin.AD_014', 'CONNECTION', 'doDeleteCode', null, function(so) {
                        if (so.status == '1') {
                            Alert(Sepoa.cache.text.get('MESSAGE.0001'));
                            callFunction('AD_014_2', 'doQuery', []);
                        } else {
                            Alert(so.msg);
                        }
                    });
                }
            })
        ]]>
        </function>
        <function name="doNew" args="">
        <![CDATA[
            formObj.clear(false);
            formObj.setReadOnly('TYPE', false);
            gridObj.clearAll(false);
            callFunction(['p', 'p'], 'changeHeaderText', ['b', Sepoa.cache.text.get('AD_014.COMMON_CODE')])
        ]]>
        </function>
        <function name="doQuery" args="item">
        <![CDATA[
            if (item) {
                formObj.setValue('TYPE', item.code);
            }
            formObj.setReadOnly('TYPE', true);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.admin.AD_014', 'METHOD=doQueryCodeDetail']);
            gridObj.clearAll(false);
            doServiceAjax('sepoa.svc.admin.AD_014', 'CONNECTION', 'doQueryHeader', null, function(so) {
                if (so.status == '1') {
                    formObj.dataMapper(new SepoaFormater(so.result[0]));
                } else {
                    Alert(so.message);
                }
            });
        ]]>
        </function>
        <function name="doQueryEnd" args="obj, rowCnt">
        <![CDATA[
            var msg = obj.getUserData("", "message");
            var status = obj.getUserData("", "status");
            if (status != "true") {
                Alert(msg)
            }
        ]]>
        </function>
        <function name="doSave" args="">
        <![CDATA[
            gridObj.editStop();
            if (!formObj.validate()) {
                Alert(Sepoa.cache.text.get('MESSAGE.0002'));
                return;
            }
            Confirm(Sepoa.cache.text.get('MESSAGE.1018'), function(result) {
                if (result) {
                    gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.admin.AD_014', 'METHOD=doSaveCode'], 'SELECTED');
                }
            });
        ]]>
        </function>
        <function name="doSaveEnd" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if (status == 'true') {
                Alert(message);
                doQuery();
                callFunction('AD_014_2', 'doQuery', [true]);
            } else {
                Alert(message);
            }
        ]]>
        </function>
        <var name="formObj"/>
        <function name="setGridDraw" args="">
        <![CDATA[
            doServiceAjax('sepoa.svc.common.COMMON', 'CONNECTION', 'getActiveLanguage', void 0, function(so) {
                if (so.status != 1) {
                    Alert(so.message);
                    return;
                }
                var sf = new SepoaFormater(so.result[0]);
            
                var languageList = [];
            
                for (var i = 0; i < sf.getRowCount(); i++) {
                    if (i != 0) {
                        languageList.push({
                            type: "newcolumn"
                        });
                    }
                    languageList.push({
                        type: "input",
                        name: "TEXT1_" + sf.getValue("LANGUAGE", i),
                        label: sf.getValue("TEXT1", i)
                    });
                }
            
                //폼 셋팅
                var formOption = [{
                        type: "settings",
                        position: "label-top",
                        labelAlign: "left",
                        inputWidth: "150"
                    },
                    {
                        type: "block",
                        width: "auto",
                        blockOffset: "0",
                        list: [{
                            type: "input",
                            name: "TYPE",
                            label: Sepoa.cache.text.get("AD_014_4.TYPE")
                        },
                        {type:"newcolumn"},
                        {
                            type: "select",
                            name: "CLIENT_CUSTOM_FLAG",
                            label: Sepoa.cache.text.get("AD_014_4.CLIENT_CUSTOM_FLAG"),
                            options:[
                                {text:"", value:""},
                                {text:"Y", value:"Y"}
                            ]
                        }]
                    },
                    {
                        type: "block",
                        width: "auto",
                        blockOffset: "0",
                        list: languageList
                    }
                ];
            
                formObj = $sObject.formObj = new SepoaMultiDhtmlXFormObject(formbox, 'formObj', [formOption], true);
                formObj.enableLiveValidation(true);
                formObj.setReadOnly('TYPE', true);
            
                //그리드 셋팅
                var addTextColumnCount = 7;
                var secondHeader = [];
                for (var i = 0; i < gridObj.getColumnCount(); i++) {
                    secondHeader.push("#rspan");
                }
            
                for (var j = 1; j <= addTextColumnCount; j++) {
                    var firstFlag = true
                    for (var i = 0; i < sf.getRowCount(); i++) {
                        var ind = gridObj.getColumnsNum();
                        var header = 'TEXT' + j
                        if (!firstFlag) {
                            header = '#cspan';
                        } else {
                            firstFlag = false;
                        }
                        var code = 'TEXT' + j + '_' + sf.getValue('LANGUAGE', i);
                        var type = 'edtxt';
                        var width = 100;
                        var sort = '';
                        var align = 'left';
            
                        gridObj.insertColumn(ind, header, type, width, sort, align, 'center', void 0, 'white');
                        gridObj.setColumnId(ind, code);
                        for (var _idx in gridObj._validators.data) {
                            if (gridObj._validators.data[_idx] == void 0) {
                                gridObj._validators.data[_idx] = "";
                            }
                        }
                        gridObj.grid_col_id = gridObj.getColIdsArray();
            
                        secondHeader.push(sf.getValue('TEXT1', i));
                    }
                }
                gridObj.attachHeader(secondHeader);
                gridObj.setSizes();
            }, false);
        ]]>
        </function>
    </userscript>
