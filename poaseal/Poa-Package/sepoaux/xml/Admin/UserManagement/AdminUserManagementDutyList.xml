<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_019_4" header="false" tpl="editor.tpl">
    <button id="layoutBtnObj">
        <btn div="JRhyAUcwiCTZzgQahS" id="add" text="추가"/>
        <btn div="JRhyAUcwiCTZzgQahS" id="delete" text="삭제"/>
        <btn div="JRhyAUcwiCTZzgQahS" id="copy" text="복사"/>
        <btn div="JRhyAUcwiCTZzgQahS" id="save" text="저장"/>
    </button>
    <grid id="gridObj" div="JRhyAUcLnwSZzgQMEQ" grid-id="AD_019_4" drag="false" merge="false" dynamic="false"/>
    <onloadscript>
    	layoutBtnObj.btn('delete').setShow();
        layoutBtnObj.btn('save').setShow();
        layoutBtnObj.btn('add').setHide();
        layoutBtnObj.btn('copy').setHide();
        <![CDATA[
            //화면 버튼 이벤트의 분기를 정의
        ]]>
        <event obj="Sepoa" type="onButtonClick">
            <function args="id">
            <![CDATA[
                if(id == 'save'){
                    doSave();
                }else if(id == 'delete'){
                    doDelete();
                }
            ]]>
            </function>
        </event>
        <![CDATA[
            //doSaveEnd callBack function을 정의
        ]]>
        <event obj="gridObj" type="onTXE" callback="doSaveEnd_grid"/>
        <event obj="gridObj" type="onXLE" callback="doQueryEnd"/>
    </onloadscript>
    <userscript>
        <![CDATA[
            //화면 좌측 서비스 리스트 select시 호출되는 함수(리스트에서 호출됨)
        ]]>
        <function name="doDelete" args="">
        <![CDATA[
            dataOutput.addScreen('AD_019_2');
            if(gridObj.getGridChangedRows("SELECTED").length > 0 && Confirm(Sepoa.cache.text.get('MESSAGE.1015'),function(result){
                if(result){
                    gridObj.editStop();
                    gridObj.postTransaction(window.CONTEXT_NAME+'/SepoaGrid.sux',['PROCESS_ID=sepoa.svc.admin.AD_019_4','mode=doSave','method=doDelete'],'SELECTED');
                }
            }));
        ]]>
        </function>
        <function name="doQueryByList" args="">
        <![CDATA[
            dataOutput.addScreen('AD_019_2');
            gridObj.postConnection(window.CONTEXT_NAME+'/SepoaGrid.sux',['PROCESS_ID=sepoa.svc.admin.AD_019_4','mode=doQuery']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="obj, rowCnt">
        <![CDATA[
            layoutBtnObj.btn('delete').setShow();
            layoutBtnObj.btn('save').setShow();
            layoutBtnObj.btn('add').setHide();
            layoutBtnObj.btn('copy').setHide();
            //callFunction('parent','changeHeaderIcon',['a','show','delete,save']);
        ]]>
        </function>
        <function name="doSave" args="">
        <![CDATA[
            var checked=gridObj.getCheckedRows(gridObj.getColIndexById('REPRESENT_CTRL'));
            var value = gridObj.cells(checked,gridObj.getColIndexById('CTRL_NAME_LOC')).getValue();
            Confirm(value+Sepoa.cache.text.get('MESSAGE.5109'),function(result){
                if(result){
                    dataOutput.addScreen('AD_019_2');
                    gridObj.editStop();
                    gridObj.postTransaction(window.CONTEXT_NAME+'/SepoaGrid.sux',['PROCESS_ID=sepoa.svc.admin.AD_019_4','mode=doSave']);
                }
            });
        ]]>
        </function>
        <function name="doSaveEnd_grid" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if(status=='true'){
                Alert(message);
                callFunction(['parent','parent','parent','AD_019_2'],'doFormLoad', []);
                callFunction(['parent','AD_019_5'],'doQueryByList', [dataOutput.getValue('CTRL_PERSON_ID')]);
                doQueryByList();
            }else{
                Alert(message);
            }
        ]]>
        </function>
    </userscript>
