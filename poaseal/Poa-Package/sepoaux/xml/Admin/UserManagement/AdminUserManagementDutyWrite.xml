<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_019_5" header="false" tpl="editor.tpl">
    <button id="layoutBtnObj">
        <btn div="ZRhyAUcwspQczgQNFF" id="add" text="추가"/>
        <btn div="ZRhyAUcwspQczgQNFF" id="delete" text="삭제"/>
        <btn div="ZRhyAUcwspQczgQNFF" id="confirm" text="승인"/>
        <btn div="ZRhyAUcwspQczgQNFF" id="copy" text="복사"/>
        <btn div="ZRhyAUcwspQczgQNFF" id="update" text="수정"/>
        <btn div="ZRhyAUcwspQczgQNFF" id="cancel" text="취소"/>
        <btn div="ZRhyAUcwspQczgQNFF" id="save" text="저장"/>
    </button>
    <grid id="gridObj" div="ZRhyAUckKkQczgQLvS" grid-id="AD_019_5" drag="false" merge="false" dynamic="false"/>
    <onloadscript>
        <![CDATA[
        	layoutBtnObj.btn('save').setShow();
        	layoutBtnObj.btn('add').setShow();
	        layoutBtnObj.btn('delete').setHide();
	        layoutBtnObj.btn('confirm').setHide();
	        layoutBtnObj.btn('copy').setHide();
	        layoutBtnObj.btn('update').setHide();
	        layoutBtnObj.btn('cancel').setHide();
        ]]>
        <event obj="Sepoa" type="onButtonClick">
            <function args="id">
            <![CDATA[//화면 버튼 이벤트의 분기를 정의
                if(id == 'save'){
                    doSave();
                }else if(id == 'add'){
                    doChangeCarousel();
                }
            ]]>
            </function>
        </event>
        <![CDATA[
            //doSaveEnd callBack function을 정의
        ]]>
        <event obj="gridObj" type="onTXE" callback="doSaveEnd_grid"/>
        <event obj="gridObj" type="onXLE" callback="doQueryEnd"/>
    </onloadscript>
    <userscript>
        <![CDATA[
            //화면 좌측 서비스 리스트 select시 호출되는 함수(리스트에서 호출됨)
        ]]>
        <function name="doChangeCarousel" args="">
        <![CDATA[
            callFunction(['parent','parent'],'changeToCarousel2', []);
        ]]>
        </function>
        <function name="doQueryByList" args="arg">
        <![CDATA[
            dataOutput.addScreen('AD_019_2');
            gridObj.postConnection(window.CONTEXT_NAME+'/SepoaGrid.sux',['mode=doQuery','METHOD=doQuery','PROCESS_ID=sepoa.svc.admin.AD_019_5']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="obj, rowCnt">
        <![CDATA[
        	layoutBtnObj.btn('save').setShow();
        	layoutBtnObj.btn('add').setShow();
	        layoutBtnObj.btn('delete').setHide();
	        layoutBtnObj.btn('confirm').setHide();
	        layoutBtnObj.btn('copy').setHide();
	        layoutBtnObj.btn('update').setHide();
	        layoutBtnObj.btn('cancel').setHide();
            callFunction('parent','changeHeaderIcon',['b','show','save,add']);
        ]]>
        </function>
        <function name="doSave" args="">
        <![CDATA[
            dataOutput.addScreen('AD_019_2');
            Confirm(Sepoa.cache.text.get('MESSAGE.1018'),function(result){
                if(result){
                    gridObj.editStop();
                    gridObj.postTransaction(window.CONTEXT_NAME+'/SepoaGrid.sux',['mode=doSave','METHOD=doSave','PROCESS_ID=sepoa.svc.admin.AD_019_5'],'SELECTED');
                }
            });
        ]]>
        </function>
        <function name="doSaveEnd_grid" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if(status=='true'){
                Alert(message);
                callFunction(['parent','AD_019_4'],'doQueryByList', [dataOutput.getValue('CTRL_PERSON_ID')]);
                doQueryByList();
            }else{
                Alert(message);
            }
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        ICAgICAgICA8L2Rpdj5cbiAgICA8L2Rpdj5cbjwvZGl2PiJ9
    </template>
</body>