<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="CT_210" header="false" pageCloseWarn="false" delegate="false">
    <button id="btnObj">
        <btn div="a671843a75c849f3846ede8d0a7c64" id="TEMPLATE_DOWNLOAD" type="exceldownload" text="{BUTTON.template_download}" toggle="false" reverse="false" onclick="onButtonClick( 'TEMPLATE' )"/>
        <btn div="a671843a75c849f3846ede8d0a7c64" id="FILE_UPLOAD" type="fileattach" text="{BUTTON.EXCEL_UPLOAD}" toggle="false" reverse="false" onclick="onButtonClick( 'UPLOAD' )"/>
        <btn div="a671843a75c849f3846ede8d0a7c64" id="SAVE" type="save" text="{BUTTON.save}" toggle="false" reverse="false" onclick="onButtonClick( 'SAVE' )"/>
    </button>
    <grid id="gridObj" div="b04e3a6bf60f439e8cc5ea5763ab11" grid-id="CT_205_E" drag="false" merge="false" dynamic="false" exceldownload="true">
    </grid>
    <variable>
        <var name="f6fe387d919445f488ebe265a56c53" value="$($sObject._vp).find('#f6fe387d919445f488ebe265a56c53')[0]"/>
        <var name="af1ed724e0ee46aa8edce6baec79bb" value="$($sObject._vp).find('#af1ed724e0ee46aa8edce6baec79bb')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <var name="$share" value="{}"/>
        <function name="init" args="">
        <![CDATA[
            if(!sUtils.string.isBlank(Sepoa.request?.CONT_NO)){
	            dataOutput.setValue('DOC_NUMBER', Sepoa.request.CONT_NO);
	            dataOutput.setValue('CONT_ALL_DATA', JSON.stringify(Sepoa.params));
            }
        ]]>
        </function>
        <function name="onButtonClick" args="id">
        <![CDATA[
            switch (id) {
                case 'TEMPLATE':
                    window.open(window.CONTEXT_NAME + '/manual/Register_Contract_User_Template.xlsx', '_blank');
                	break;
                case 'UPLOAD':
                    doExcelUpload();
                    break;
                case 'SAVE':
                    doUploadSave();
                    break;
            }
        ]]>
        </function>
        <function name="doExcelDownload" args="">
        <![CDATA[
            sepoaExcelProcessor('down', 'sepoa.svc.ct.CT_205', 'doExcelDownload', null, 'CONTRACT_MULTI_SIGNER_GROUP.xlsx');
        ]]>
        </function>
        <function name="doExcelUpload" args="">
        <![CDATA[
            sepoaExcelProcessor('up', 'sepoa.svc.ct.CT_205', 'doExcelUpload', doUploadFileCallback);
        ]]>
        </function>
        <function name="doUploadFileCallback" args="res">
        <![CDATA[
            gridObj.clearAll(false);
            
            if(res.status == 'true') {
                const dataList = $share['SIGNER_GROUP'] = new SepoaFormater(res.result[0]).getArrayMap();
                for(const row of dataList) {
                    const rId = dhx.newId();
                    row['CATEGORY'] = 'S'   // S : 거래처
                    row['SIGNER_COMPANY_CODE'] = row['BIZ_CODE'];   // 거래처 코드
                    
                    gridObj.add(rId, row);
                }
            } else {
                Alert(res.message);
            }
        ]]>
        </function>
        <function name="doUploadSave" args="">
        <![CDATA[
            if($share['SIGNER_GROUP'] !== undefined) {
                Sepoa.params.callback($share['SIGNER_GROUP']);
                selfObj.close();
            } else {
                Alert('엑셀 파일을 업로드하여 주십시오.');
            }
        ]]>
        </function>
    </userscript>
