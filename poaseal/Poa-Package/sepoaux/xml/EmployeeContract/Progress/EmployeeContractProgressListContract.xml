<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="ECT_102" header="false" pageCloseWarn="false" delegate="false">
    <link>
    <![CDATA[
        <%
            List<String> ctrlCodeList = Arrays.asList(info.getSession("CTRL_CODE").split(","));
            boolean hasEmpContCreate = ctrlCodeList.contains("EMP_CONT_CREATE");
        %>
    ]]>
    </link>
    <filterbar id="filterObj" div="MCtsZhdfjwsZhdSknL">
        <calendar id="F_CALENDAR" button="year:0,month:0,week:-4,day:0" default="ADD_DATE#week:-4" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#ECT102"/>
        <status id="F_STATUS"/>
        <keyword id="F_KEYWORD"/>
        <filter>
            <option id="F_CONT_CATEGORY" type="select" combo="ECT0004,{HOUSE_CODE}#{LANGUAGE}"/>
        </filter>
        <event type="onSearch" callback="onSearch"/>
        <event type="onComboLoad" callback="onComboLoad"/>
    </filterbar>
    <button id="btnObj">
    </button>
    <grid id="gridObj" div="ASYDyZdgLzEyZdMSyF" grid-id="ECT_102_C" drag="false" merge="false" dynamic="false" exceldownload="true">
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onRowSelect" callback="onRowSelect"/>
        <event type="onEditCell" callback="onEditCell"/>
        <event type="onRowInserted" callback="onRowInserted"/>
    </grid>
    <usercss>
    <![CDATA[
        .attach-status-box {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .attach-status-box div {
            float: left;
        }
        
        .attach-status-attach-icon {
            display: none;
        }
        
        .attach-status-attach-icon-G {
            display: block;
            width: 29px;
            height: 29px;
            margin-left: 10px;
            background: center / cover url(/resource/design/imgs/grid/ATTAH_IMG.png);
        }
        
        .expired-bold-flag-Y {
            font-weight: bold;
            color: #d12832;
        }
        
        .contract-sign-status-G:after,
        .contract-sign-status-K:after,
        .contract-sign-status-C:after {
            content: "O"
        }
        
        .contract-sign-status-G.contract-sign-count-:after,
        .contract-sign-status-K.seller:after,
        .contract-sign-status-C.contract-sign-count-:after {
            content: "X"
        }
    ]]>
    </usercss>
    <variable>
        <var name="EtvofadWPxofadpUNx" value="$($sObject._vp).find('#EtvofadWPxofadpUNx')[0]"/>
        <var name="EtvofadAXSpfadiCyX" value="$($sObject._vp).find('#EtvofadAXSpfadiCyX')[0]"/>
        <var name="EtvofadWPxofaddSxt" value="$($sObject._vp).find('#EtvofadWPxofaddSxt')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <var name="$share" value="{}"/>
        <var name="$shareFnNames">
        <![CDATA[
            ['doQuery']
        ]]>
        </var>
        <function name="init">
        <![CDATA[
            $share.fn = {};
            for (var i in $shareFnNames) {
                var fnName = $shareFnNames[i];
                $share.fn[fnName] = $sObject[fnName];
            }
            
            callFunction('p', 'doGetScreenConfig', [$share]);
            callFunction('p', 'onChildScreenReady', [$share]);
            dataOutput.setValue('TYPE', $share.config.TYPE);
            initFilter();
            initButton();
            doQuery();
        ]]>
        </function>
        <function name="initFilter" args="">
        <![CDATA[
            filterObj.getItemById("F_STATUS").reloadCombo("SL0001," + Sepoa.info.HOUSE_CODE + "#" + Sepoa.info.LANGUAGE + "#ECT002");
            
            if ($share.config.FILTER && $share.config.FILTER.F_EXPIRED_VIEW) {
                filterObj.getItemById("F_EXPIRED_VIEW").setDefault("checked");
                filterObj.getItemById("F_EXPIRED_VIEW").setValue(true);
            }
        ]]>
        </function>
        <function name="onComboLoad" args="id, domList">
        <![CDATA[
            if (id == "F_STATUS") {
                domList.forEach(function(dom) {
                    dom.style.display = "none";
                    if (dom.comboText != "" && dom.comboText != undefined) {
                        if (dom.comboValue == "ALL" || $share.config.VIEW_OPTIONS[dom.comboValue]?.FILTER) {
                            dom.style.display = "flex";
                        }
                    }
                });
            
                if ($share.config.FILTER.F_STATUS) {
                    filterObj.getItemById("F_STATUS").setDefault($share.config.FILTER.F_STATUS);
                    filterObj.getItemById("F_STATUS").setValue($share.config.FILTER.F_STATUS);
                    doQuery();
                }
            }
        ]]>
        </function>
        <function name="initButton">
        <![CDATA[
            <% if(hasEmpContCreate) { %>
                btnObj.addButton({
                    "div": EtvofadQkWpfadeRTN,
                    "id": "SIGN_REQUEST",
                    "text": "{POA_CONTRACT.SIGN_NEXT}",
                    "type": "save",
                    onclick: doSignRequest
                });
            
                btnObj.addButton({
                    "div": EtvofadQkWpfadeRTN,
                    "id": "PUSH_RE_SEND",
                    "text": "{POA_CONTRACT.BUTTON_PUSH_RE_SEND}",
                    "type": "secondary",
                    onclick: doPushReSend
                });
                
                btnObj.addButton({
                    "div": EtvofadQkWpfadeRTN,
                    "id": "DELETE",
                    "text": "{POA_CONTRACT.BUTTON_DELETE}",
                    "type": "delete",
                    onclick: doDelete
                });
            <% } else { %>
            <% } %>
        ]]>
        </function>
        <function name="onSearch" args="id">
        <![CDATA[
            doQuery();
        ]]>
        </function>
        <function name="doQuery" args="">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.contract.SepoaEmployeeContractService', 'METHOD=doDocumentList']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="obj, rowCnt">
        <![CDATA[
            var status = obj.getUserData("", "status");
            var message = obj.getUserData("", "message");
            if (status != 'true') {
                Alert(message);
            }
        ]]>
        </function>
        <function name="onRowSelect" args="id, cind">
        <![CDATA[
            var header = gridObj.getColumnId(cind);
            var gridData = gridObj._getRowData(id);
            
            if (!(['SELECTED', 'EXPIRED_ALARM', 'CATEGORY'].indexOf(header) + 1)) {
                $share.fn.doChangeView(gridData);
            }
        ]]>
        </function>
        <function name="onEditCell" args="stage,rowId,cellInd,nValue,oValue">
        <![CDATA[
            var header = gridObj.getColumnId(cellInd);
            var gridData = gridObj.getRowDataObject(rowId);
            if (stage == 0) {} else if (stage == 1) {} else if (stage == 2) {}
            return true;
        ]]>
        </function>
        <function name="onRowInserted" args="tr">
        <![CDATA[
            $share.fn.doQueryDocumentExtraData(gridObj, tr);
        ]]>
        </function>
        <function name="doDelete">
        <![CDATA[
            var selectedRow = gridObj.getSelectedRows("SELECTED");
            var dataArray = [];
            for (var i in selectedRow) {
                dataArray.push(gridObj.getRowDataObject(selectedRow[i]));
            }
            $share.fn.doDeleteDocument(dataArray, doQuery);
        ]]>
        </function>
        <function name="doPushReSend">
        <![CDATA[
            var selectedRow = gridObj.getSelectedRows("SELECTED");
            var dataArray = [];
            for (var i in selectedRow) {
                dataArray.push(gridObj.getRowDataObject(selectedRow[i]));
            }
            $share.fn.doPushResend(dataArray);
        ]]>
        </function>
        <function name="doAfterProcess">
        <![CDATA[
            var selectedRow = gridObj.getSelectedRows("SELECTED");
            var dataArray = [];
            for (var i in selectedRow) {
                dataArray.push(gridObj.getRowDataObject(selectedRow[i]));
            }
            
            $share.fn.doAfterProcess(dataArray, doQuery);
        ]]>
        </function>
        <function name="doNewContract" args="">
        <![CDATA[
            $share.fn.doChangeView({
                DATA_SOURCE: 'NEW'
            });
        ]]>
        </function>
        <function name="doSignRequest" args="">
        <![CDATA[
        	var selectedRow = gridObj.getSelectedRows("SELECTED");
            var dataArray = [];
            for (var i in selectedRow) {
                dataArray.push(gridObj.getRowDataObject(selectedRow[i]));
            }
        	
        	if(dataArray.length == 0) {
        		Alert(Sepoa.cache.text.get("POA_CONTRACT.MESSAGE_0005"));
        		return false;
        	}
        	
        	if(dataArray.filter(e => e.CONT_STATUS != "EW").length > 0) {
        		Alert(Sepoa.cache.text.get("POA_CONTRACT.MESSAGE_0036"));
        		return false;
        	}
        	
			const data = {
				TARGET_DATA: dataArray
			};

			const config = {
                url: window.CONTEXT_NAME + '/SepoaActionController.sux',
                async: true,
                contentType: "json",
                on: {
					callback: (res, config, params) => {
						if(res.status == '1') {
							Alert(Sepoa.cache.text.get("POA_CONTRACT.MESSAGE_0037"), function(flag){
								if(flag) {
									doQuery();
								}
							})
						} else {
							Alert(Sepoa.cache.text.get("POA_CONTRACT.MESSAGE_0038"));
							return false;
						}					
					}
				}
            }
            
            const params = $.extend(true, {
                module: 'sepoa.svc.ct.ECT_205',
                action: 'doRequestSigning'
            }, data);
            
            sUtils.multipart.send(config, params)           
        ]]>
        </function>
    </userscript>
