<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="ECT_155" header="false">
    <link>
    <![CDATA[
        <%
            List<String> ctrlCodeList = Arrays.asList(info.getSession("CTRL_CODE").split(","));
            boolean hasEmpContCreate = ctrlCodeList.contains("EMP_CONT_CREATE");
        %>
    ]]>
    </link>
    <layout id="layoutObj" div="jpoJSTdWVqJSTdwkNx" pattern="1C">
        <cell>
            <id>a</id>
            <fix_size>true,true</fix_size>
            <header view="true" type="contents"/>
            <collapse icon="false" collapsed="false"/>
            <icon>menu</icon>
        </cell>
    </layout>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <function name="init">
        <![CDATA[
            <% if(hasEmpContCreate) { %>
                let url = '/EmployeeContract/Template/List/EmployeeContractTemplateListContainer.sux';
                if(sUtils.string.isBlank(Sepoa.request.alias) === false) {
                    url += '?alias=' + Sepoa.request.alias;
                }
                layoutObj.cells('a').attachURL(url);
                if ($sObject.alias == $sObject.aliasCode) {
                    Alert('not found type data');
                    return;
                }
                var contType = Sepoa.request.alias.substring(0, 1);
                var text = Sepoa.cache.text.get("ECT_155.TITLE_" + contType);
                changeHeaderText('a', text);
            <% } else { %>
                Alert(sUtils.cache.text.get('MESSAGE.0073'), () => {
                    SUX.root.getContentsCell(window).close();
                });
            <% } %>
        ]]>
        </function>
    </userscript>
