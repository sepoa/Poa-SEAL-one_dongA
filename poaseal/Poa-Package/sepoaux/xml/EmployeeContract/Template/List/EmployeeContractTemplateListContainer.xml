<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="ECT_151" header="false">
    <filterbar id="filterObj" div="xUxASTdQwxBggjiLXO">
        <calendar id="F_DATE" button="day:0" default="year:0"/>
        <status id="F_STATUS" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#ECT003"/> %
        <keyword id="F_KEYWORD"/>
        <filter>
            <option id="F_CATEGORY" type="select" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#ECT004"/>
            <option id="F_CONT_METHOD" type="select" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#ECT003"/>\
            <option id="F_CONT_FORM_NAME" type="text"/>
        </filter>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <button id="btnObj">
        <btn div="BatzfadzsUAgadtgav" id="DELETE" type="delete" text="{BUTTON.delete}" toggle="false" reverse="false" onclick="doDelete()"/>
        <btn div="BatzfadzsUAgadtgav" id="MODIFY" type="default" text="{BUTTON.modify}" toggle="false" reverse="false" onclick="doModifyTemplate()"/>
        <btn div="BatzfadzsUAgadtgav" id="COPY" type="default" text="{BUTTON.copy}" toggle="false" reverse="false" onclick="doCopy()"/>
        <btn div="BatzfadzsUAgadtgav" id="NEW" type="new" text="{BUTTON.new}" toggle="false" reverse="false" onclick="doCreateTemplate(  )"/>
    </button>
    <grid id="gridObj" div="TZQbNSebCabNSeazyr" grid-id="ECT_152" drag="false" merge="false" dynamic="false">
        <event type="onRowSelect" callback="onRowSelect"/>
        <event type="onXLE" callback="onXLE"/>
    </grid>
    <variable>
        <var name="LeZUSTdQZdUSTdCIsu" value="$($sObject._vp).find('#LeZUSTdQZdUSTdCIsu')[0]"/>
        <var name="LeZUSTdyAkUSTdwqkH" value="$($sObject._vp).find('#LeZUSTdyAkUSTdwqkH')[0]"/>
        <var name="LeZUSTdQZdUSTdrQsd" value="$($sObject._vp).find('#LeZUSTdQZdUSTdrQsd')[0]"/>
    </variable>
    <onloadscript>
        <call name="init" />
        <call name="doQuery" />
    </onloadscript>
    <userscript>
        <var name="$var" value="{}" />
        <function name="init">
        <![CDATA[
             $var.contType = Sepoa.request.alias.substring(0, 1);
             dataOutput.setValue('CONT_TYPE', $var.contType);
             
             if($var.contType == "E"){
                gridObj.reloadComboBox('CATEGORY', ['SL0001', '{HOUSE_CODE}#{LANGUAGE}#ECT004']);            
            }
        ]]>
        </function>
        
        <function name="onSearch">
        <![CDATA[
            doQuery();
        ]]>
        </function>
            
        <function name="doQuery">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.contract.SepoaContractTemplateService', 'METHOD=doDocumentList']);
            gridObj.clearAll(false);
        ]]>
        </function>
        
        <function name="onXLE" args="obj, rowCnt">
        <![CDATA[
            var status = obj.getUserData("", "status");
            if(status == 'true'){
                if(rowCnt ==0){
                    gridObj.objBox.classList.add("template-empty-data-warning");
                } else {
                    gridObj.objBox.classList.remove("template-empty-data-warning");
                }
            } else {
                Alert(obj.getUserData("", "message"));
            }
        ]]>
        </function>
        
        <function name="onRowSelect" args="id, cind">
        <![CDATA[
            var header = gridObj.getColumnId(cind);
            var gridData = gridObj._getRowData(id);
            if(header == "CONT_FORM_NAME"){
                sUtils.popup.modal({
                    url: window.CONTEXT_NAME + '/EmployeeContract/Module/EmployeeContractModuleLayout.sux',
                    title: sUtils.cache.text.get('POA_CONTRACT.TITLE_PREVIEW'),
                    params: {
                        CONT_MODULE: 'TEMPLATE_VIEW',
                        CONT_TYPE: $var.contType,
                        WORK_TYPE: 'T',
                        CONT_NO: gridData.CONT_FORM_NO,
                        CONT_GL_SEQ: '1'
                    }
                })
            } else if(header == 'HISTORY') {
                const params = {
                    CONT_NO : gridData['CONT_FORM_NO'],
                    CONT_GL_SEQ : '1'
                };
                
                sUtils.popup.modal({
                    url : `${window.CONTEXT_NAME}/EmployeeContract/Template/List/Popup/layout.sux`,
                    width : SUX.getModuleTop().innerWidth * 0.6,
                    height : SUX.getModuleTop().innerHeight * 0.4,
                    params : params,
                    title : sUtils.cache.text.get('ECT_152.HISTORY')
                });
            }
        ]]>
        </function>
        
        <function name="doCreateTemplate">
        <![CDATA[
            sUtils.popup.modal({
                url: window.CONTEXT_NAME + '/EmployeeContract/Template/Creation/EmployeeContractTemplateCreationCarousel.sux',
                title: sUtils.cache.text.get('POA_CONTRACT.TITLE_CREATION_TEMPLATE'),
                params:{
                    WORK_TYPE:'T',
                    CONT_TYPE:$var.contType,
                    callback : doCreateTemplateEnd
                }
            })
        ]]>
        </function>
        
        <function name="doCreateTemplateEnd">
        <![CDATA[
            doQuery();
        ]]>
        </function>
        
        <function name="doModifyTemplate">
        <![CDATA[
            var selected = gridObj.getSelectedRows('SELECTED'); 
            if(selected.length == 0){
               Alert(sUtils.cache.text.get('POA_CONTRACT.MESSAGE_0005'));
               return; 
            }else if(selected.length > 1){
               Alert(sUtils.cache.text.get('POA_CONTRACT.MESSAGE_0006'));
               return;
            }
            
            sUtils.popup.modal({
                url: window.CONTEXT_NAME + '/EmployeeContract/Template/Creation/EmployeeContractTemplateCreationCarousel.sux',
                title: sUtils.cache.text.get('POA_CONTRACT.TITLE_CREATION_TEMPLATE'),
                params:{
                    CONT_FORM_NO: gridObj._getRowData(selected[0]).CONT_FORM_NO,
                    WORK_TYPE: 'T',
                    CONT_TYPE:$var.contType
                }
            })
        ]]>
        </function>
        
        <function name="doDelete">
        <![CDATA[
            var selectedRow = gridObj.getSelectedRows("SELECTED");
            if(selectedRow.length < 0){
                Alert(sUtils.cache.text.get('POA_CONTRACT.MESSAGE_0005'));
                return;
            }
            if(selectedRow.length > 1){
                Alert(sUtils.cache.text.get('POA_CONTRACT.MESSAGE_0006'));
                return;
            }
            
            Confirm(sUtils.cache.text.get('POA_CONTRACT.MESSAGE_0009'), function(flag){
                if(flag){
                    var config = {
                        url:window.CONTEXT_NAME+'/SepoaActionController.sux',
                        on:{
                            callback:function(res, config, params){
                                if(!res.flag){
                                    Alert(res.message);
                                }else{
                                    doQuery();
                                }
                            }
                        }
                    }
                    
                    var params = {
                        module:"contract.template",
                        action:"doDocumentDelete",
                        CONT_NO:gridObj.getCellValue(selectedRow[0], 'CONT_FORM_NO'),
                        CONT_GL_SEQ:'1'
                    };
                    
                    sUtils.multipart.send(config, params);
                }
            });
        ]]>
        </function>
        
        <function name="doCopy" args="gridData, callback">
        <![CDATA[
            var selectedRow = gridObj.getSelectedRows("SELECTED");
            if(selectedRow.length < 0){
                Alert(sUtils.cache.text.get('POA_CONTRACT.MESSAGE_0005'));
                return;
            }
            if(selectedRow.length > 1){
                Alert(sUtils.cache.text.get('POA_CONTRACT.MESSAGE_0006'));
                return;
            }
            
            Confirm(sUtils.cache.text.get('POA_CONTRACT.MESSAGE_0010'), function(flag){
                if(flag){
                    var config = {
                        url:window.CONTEXT_NAME+'/SepoaActionController.sux',
                        on:{
                            callback:function(res, config, params){
                                if(!res.flag){
                                    Alert(res.message);
                                }else{
                                    sUtils.popup.modal({
                                        url: window.CONTEXT_NAME + '/EmployeeContract/Template/Creation/EmployeeContractTemplateCreationCarousel.sux',
                                        title: sUtils.cache.text.get('POA_CONTRACT.TITLE_CREATION_TEMPLATE'),
                                        params:{
                                            CONT_FORM_NO: res.result[0].CONT_FORM_NO,
                                            WORK_TYPE: 'T',
                                            CONT_TYPE:res.result[0].CONT_TYPE
                                        }
                                    })
                                    doQuery();
                                }
                            }
                        }
                    }
                    
                    var params = {
                        module:"contract.template",
                        action:"doDocumentCopy",
                        CONT_NO:gridObj.getCellValue(selectedRow[0], 'CONT_FORM_NO'),
                        CONT_GL_SEQ:'1'
                    };
                    
                    sUtils.multipart.send(config, params);
                }
            });
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
    </template>
</body>