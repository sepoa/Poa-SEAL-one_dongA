<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="PW_RESET" header="false">
	<link>
    <![CDATA[
        <script type="text/javascript">
            Sepoa.cache.text.load({
                url: CONTEXT_NAME + '/resource/ux/admin/langs/' + Sepoa.info.LANGUAGE + '/PW_RESET.js',
                def: CONTEXT_NAME + '/resource/ux/admin/langs/KO/PW_RESET.js'
            });
        </script>
    ]]>
    </link>
    <form id="formObj" div="LOqHlDeeGbJlDeYOVS" form-id="file:///resource/ux/admin/form/PW_RESET.js">
        <event type="onButtonClick" callback="onButtonClick"/>
        <event type="onChange" callback="onChange"/>
    </form>
    <button id="btnObj">
        <btn div="LOqHlDekScJlDewTSd" id="ACCEPT" type="primary" text="{BUTTON.confirm}" toggle="false" reverse="false" onclick="onButtonClick( 'ACCEPT' )"/>
        <btn div="LOqHlDekScJlDewTSd" id="CANCEL" type="back" text="{BASE_BUTTON.CANCEL}" toggle="false" reverse="false" onclick="onButtonClick( 'CANCEL' )"/>
    </button>
    <variable>
        <var name="LOqHlDeyJaJlDeZSJB" value="$($sObject._vp).find('#LOqHlDeyJaJlDeZSJB')[0]"/>
        <var name="LOqHlDeyJaJlDeCOxY" value="$($sObject._vp).find('#LOqHlDeyJaJlDeCOxY')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <function name="init">
        <![CDATA[
            var userId = Sepoa.request.USER_ID;
            var userName = Sepoa.request.USER_NAME;
            formObj.setValue('USER_ID', userId);
            formObj.setValue('USER_NAME', userName);
            formObj.setdisable('NEW_PASSWORD', true);
        ]]>
        </function>
        <function name="onButtonClick" args="id">
        <![CDATA[
            if (id == 'ACCEPT') {
                doSave();
            } else if (id == 'CANCEL') {
                selfObj.close();
            } else if (id == 'GEN_AUTO_PW') {
                generateAutoPassword();
            }
        ]]>
        </function>
        <function name="generateAutoPassword">
        <![CDATA[
            var genPwd = Math.random().toString(36).slice(2);
            formObj.setValue('NEW_PASSWORD', genPwd);
        ]]>
        </function>
        <function name="doSave">
        <![CDATA[
        	if(formObj.getValue('NEW_PASSWORD')==''){
        		Alert("자동생성버튼을 클릭하여 비밀번호를 생성해주시기 바랍니다.");
        		return;
        	};
        	
            Confirm(Sepoa.cache.text.get('BASE_MESSAGE.0001'), function(result) {
                if (result) {
                    var formResult = doServiceAjax('sepoa.svc.system.login.SepoaLoginService', 'TRANSACTION', 'resetPassword', null, function(formResult) {
                        if (formResult.status == 1) {
                            Alert(Sepoa.cache.text.get('BASE_MESSAGE.0002'), function(){ selfObj.close(); });
                            return;
                        } else {
                            Alert(Sepoa.cache.text.get('BASE_MESSAGE.0003'));
                        }
                    });
                }
            });
        ]]>
        </function>
        <function name="changeFormMailInput">
        <![CDATA[
            var sendMailFlag = formObj.getValue('SEND_MAIL_FLAG');
            if (sendMailFlag == '0') {
                formObj.hideItem('EMAIL');
            } else {
                formObj.showItem('EMAIL');
            }
        ]]>
        </function>
        <function name="onChange" args="name, value, state">
        <![CDATA[
            switch (name) {
                case "SEND_MAIL_FLAG":
                	changeFormMailInput();
                    break;
                default:
                    break;
            }
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
        
        
        PlxuICAgICAgICAgICAgPC9kaXY+XG4gICAgICAgIDwvZGl2PlxuICAgIDwvZGl2PlxuPC9kaXY+In0=
    </template>
</body>