<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="WINDOW_FORM" header="false">
    <button id="btnObj">
        <btn div="NTkExQefKsExQeHSYo" id="SAVE" type="save" text="{BUTTON.save}" onclick="doSave(  )"/>
        <btn div="NTkExQefKsExQeHSYo" id="REJECT" type="save" text="{BUTTON.save}" onclick="doReject(  )"/>
        <btn div="NTkExQefKsExQeHSYo" id="CANCEL" type="back" text="{BUTTON.close}" onclick="doClose(  )"/>
    </button>
    <variable>
        <var name="XEkTxQezeqTxQewMxJ" value="$($sObject._vp).find('#XEkTxQezeqTxQewMxJ')[0]"/>
        <var name="XEkTxQezeqTxQezMhp" value="$($sObject._vp).find('#XEkTxQezeqTxQezMhp')[0]"/>
        <var name="formContainer" value="$($sObject._vp).find('#NTkExQePutExQecjyk')[0]"/>
        <var name="NTkExQeOutExQeJEKI" value="$($sObject._vp).find('#NTkExQeOutExQeJEKI')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <var name="$share" value="{}"/>
        <function name="init">
        <![CDATA[
            $share.config = {
                form: Sepoa.request.form,
                data: Sepoa.params.data,
                callback: Sepoa.params.callback,
                mode: Sepoa.request.mode || '',
                placeholder:Sepoa.params.placeholder
            }
            drawForm();
            setViewMode();
            setSizes();
        ]]>
        </function>
        <function name="drawForm">
        <![CDATA[
            $share.formObj = new SepoaMultiDhtmlXFormObject(formContainer, 'form', [sUtils.cache.form.get($share.config.form)], true);
            if ($share.config.data) {
                $share.formObj.setData($share.config.data, "json");
            }
            if ($share.config.placeholder) {
            	$share.formObj.forEachItem(function(obj,itemId) { 
            		var ph = $share.config.placeholder[itemId];
            		if (ph) $share.formObj.getInput(itemId).placeholder = ph;
            	});
            }
        ]]>
        </function>
        <function name="setViewMode">
        <![CDATA[
        	if (!selfObj.vp.querySelector('.dhxwin_active .dhxwin_hdr').classList.contains('dhxwin_hdr_hidden')) {	//헤더가 있으면
	        	btnObj.showButton('CANCEL', false);
        	}
            if ($share.config.mode == 'VIEW') {
                btnObj.showButton('SAVE', false);
                btnObj.showButton('REJECT', false);
                $share.formObj.setViewMode(true);
            } else if($share.config.mode == 'REJECT'){
            	btnObj.showButton('REJECT', true);
            	btnObj.showButton('SAVE', false);
                $share.formObj.setViewMode(false);
            }else{// mode == 'WRITE'와 같음
                btnObj.showButton('SAVE', true);
                btnObj.showButton('REJECT', false);
                $share.formObj.setViewMode(false);
            }
        ]]>
        </function>
        <function name="doSave">
        <![CDATA[
            var result = $share.config.callback($share.formObj.getFormData(true));
            if (result === true) {
                doClose();
            } else {
                Alert(result);
            }
        ]]>
        </function>
        <function name="doReject">
        <![CDATA[
        	var data =$share.formObj.getFormData(true);
        	if(data.APP_COMMENT == ""){
        		Alert("반려사유를 입력해주세요.");
        	}else{
            	$share.config.callback($share.formObj.getFormData(true));
            	doClose();
            }
            
        ]]>
        </function>
        <function name="doClose">
        <![CDATA[
            selfObj.close();
        ]]>
        </function>
        <function name="setSizes">
        <![CDATA[
            var formCont = $share.formObj._parent;
            var formContWidth = formCont.offsetWidth;
            
            /*
            var adjustWidth = 999;
            for (var i = 0; i < formCont.children.length; i++) {
                var childWidth = formCont.children[i].offsetWidth;
                var dt = (formContWidth - childWidth);
                if (dt < adjustWidth) {
                    adjustWidth = dt;
                }
            }
            */
            var widthArr = [];
            for (var i = 0; i < formCont.children.length; i++) widthArr.push(formCont.children[i].offsetWidth);
            var adjustWidth = formContWidth - (widthArr.length ? Math.min.apply(null, widthArr) : 0);
            var hasHeader = !selfObj.vp.querySelector('.dhxwin_active .dhxwin_hdr').classList.contains('dhxwin_hdr_hidden');
            var height = $sObject._vp.find('.sepoaux_body_outer').outerHeight() + (hasHeader ? 70 : 15);
            var width = $sObject._vp[0].offsetWidth - adjustWidth;
            selfObj.setDimension(width, height);
        ]]>
        </function>
    </userscript>
