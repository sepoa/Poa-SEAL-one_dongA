    <onloadscript/>
    <userscript>
        <function name="onButtonClick" args="name">
        <![CDATA[
            switch (name) {
                case 'SAVE':
                    break;
                case 'BACK':
                    doBack();
                    break;
                case 'ROW_ADD':
                	doRowAdd();
                    break;
                case 'ROW_DELETE':
                	doRowDelete();
                    break;
                default:
                    break;
            }
        ]]>
        </function>
        <function name="doBack" args="">
        <![CDATA[
            pageClear();
            callFunction('SLM_300', 'doChangeCell', ['SLM_310']);
        ]]>
        </function>
        <function name="pageClear" args="">
        <![CDATA[
            gridClear();
            formClear();
        ]]>
        </function>
        <function name="gridClear" args="">
        <![CDATA[
        	gridObj.clearAll();
        ]]>
        </function>
        <function name="formClear" args="">
        <![CDATA[
        	formObj.clear();
        ]]>
        </function>        
        <function name="doRowAdd" args="">
        <![CDATA[
            var maxRowId = dhx4.newId();
            gridObj.addRow(maxRowId, '', gridObj.getRowsNum());
            gridObj.showRow(maxRowId);
        ]]>
        </function>      
        <function name="doRowDelete" args="">
        <![CDATA[
            var grid_array = gridObj.getGridChangedRows("SELECTED");
            if (grid_array.length < 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.MSG_1001'));
            } else {
                Confirm(Sepoa.cache.text.get('MESSAGE.1010'), function(result) {
                    if (result) {
                        for (var i in grid_array) {
                            gridObj.deleteRow(grid_array[i]);
                        }
                    }
                });
            }
        ]]>
        </function>            
        <function name="onChange" args="name, value, state">
        <![CDATA[
            //state is checkboxes, radio, btn2state controls only
            switch (name) {
                case "":
                    break;
                default:
                    break;
            }
        ]]>
        </function>
        <function name="onBeforeChange" args="name, oldValue, newValue">
        <![CDATA[
            //if return false then not inserted new values
            switch (name) {
                case "":
                    break;
                default:
                    break;
            }
            return true;
        ]]>
        </function>
        <function name="onXLE" args="">
        <![CDATA[
            
        ]]>
        </function>
        <function name="onRowSelect" args="id, ind">
        <![CDATA[
            var header = gridObj.getColumnId(ind);
        ]]>
        </function>
        <function name="onEditCell" args="stage, rId, cInd, nValue, oValue">
        <![CDATA[
            var header = gridObj.getColumnId(cInd);
            if (stage == 0) {
                return true;
            } else if (stage == 1) {
                return true;
            } else if (stage == 2) {
                return true;
            }
            return false;
        ]]>
        </function>
        <function name="onTXE" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if (status == "true") {} else {
                Alert(message);
            }
        ]]>
        </function>
    </userscript>
