<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="SLM_311" header="false">
    <filterbar id="cGbYtneHHdYtneaaQh" div="cGbYtneHHdYtneaaQh">
        <calendar id="F_CALENDAR"/>
        <status id="F_STATUS"/>
        <keyword id="F_KEYWORD"/>
    </filterbar>
    <button id="BYtLrnexjuLrneSybV">
        <btn div="BYtLrnexjuLrneSybV" id="ATTACH" text="서류첨부" onclick="onButtonClick( 'ATTACH' )"/>
        <btn div="BYtLrnexjuLrneSybV" id="SEND" text="SEND" onclick="onButtonClick( 'SEND' )"/>
    </button>
    <grid id="gridObj" div="xBfHrneCyjHrneOfym" grid-id="SLM_311" drag="false" merge="false" dynamic="false">
        <event type="onRowSelect" callback="onRowSelect"/>
        <event type="onEditCell" callback="onEditCell"/>
        <event type="onXLE" callback="onXLE"/>
        <event type="onTXE" callback="onTXE"/>
    </grid>
    <onloadscript/>
    <userscript>
        <function name="onButtonClick" args="name">
        <![CDATA[
            switch (name) {
                case "ATTACH":
                    doAttach();
                    break;
                case "SEND":
                    doSend();
                    break;
                default:
                    break;
            }
        ]]>
        </function>
        <function name="doSend" args="">
        <![CDATA[
            doServiceAjax('sepoa.svc.seal.SepoaSealManagementService', 'TRANSACTION', 'externalSelectSealList', {
                DOC_NO: '1111',
                MANAGE_NUMBER: '2222',
                APPLY_TYPE: "NE"
            }, function(so) {
                if (so.status == 1) {
                    formObj.dataMapper(new SepoaFormater(so.result[0]));
                    doLoadImg(manageNo + "_" + docNo);
                    return true;
                } else {
                    Alert(Sepoa.cache.text.get('MESSAGE.1002'));
                    doBack();
                    return false;
                }
            });
        ]]>
        </function>
        <function name="doAttach">
        <![CDATA[
            //행 하나만 선택하는 경우? 
            callFunction('SLM_300', 'doChangeCell', ['SLM_312']);
        ]]>
        </function>
        <function name="onRowSelect" args="id, ind">
        <![CDATA[
            var header = this.getColumId();
        ]]>
        </function>
        <function name="onEditCell" args="stage, rId, cInd, nValue, oValue">
        <![CDATA[
            var header = this.getColumId();
            if (stage == 0) {
                return true;
            } else if (stage == 1) {
                return true;
            } else if (stage == 2) {
                return true;
            }
            return false;
        ]]>
        </function>
        <function name="onXLE" args="obj, count">
        <![CDATA[
            var msg = obj.getUserData("", "message");
            var status = obj.getUserData("", "status");
            if (status != "true") {
                Alert(msg);
            }
        ]]>
        </function>
        <function name="onTXE" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if (status == "true") {} else {
                Alert(message);
            }
        ]]>
        </function>
    </userscript>
