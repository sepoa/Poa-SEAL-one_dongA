<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="SLM_205" header="false">
    <carousel id="carouselObj2" div="pAYIHyfzdnIHyfVTqt">
        <item id="USE_WRITE" render="lazy">
            <attach file="/Seal/Document/Use/SealDocumentUseWrite.xml"/>
        </item>
        <item id="CORP_WRITE" render="lazy">
            <attach file="/Seal/Document/Corp/SealDocumentCorpWrite.xml"/>
        </item>
        <item id="CERT_WRITE" render="lazy">
            <attach file="/Seal/Document/Cert/SealDocumentCertWrite.xml"/>
        </item>
    </carousel>
    <onloadscript/>
    <userscript>
        <function name="setDetailView" args="applyType, smrNumber, viewMode">
        <![CDATA[
            if (applyType == 'U') {
                callFunction('SLM_221', 'doQuery', [smrNumber, 'N', viewMode]);
                carouselObj2.cells("USE_WRITE").setActive();
            } else if (applyType == 'C') {
                callFunction('SLM_211', 'doQuery', [smrNumber, 'N', null, viewMode]);
                carouselObj2.cells("CORP_WRITE").setActive();
            } else if (applyType == 'D'){
            	callFunction('SLM_251', 'doQuery', [smrNumber, 'N', viewMode]);
                carouselObj2.cells("CERT_WRITE").setActive();
            }
        ]]>
        </function>
        <function name="doBack">
        <![CDATA[
            callFunction(['p', 'p'], 'doBack', []);
        ]]>
        </function>
    </userscript>
