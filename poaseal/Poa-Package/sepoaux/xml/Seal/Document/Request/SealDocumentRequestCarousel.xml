<body screen_id="SLM_202" header="false">
    <carousel id="carouselObj" div="lLnyypeCbBzypeTaDj">
        <item id="LIST">
            <attach file="/Seal/Document/Request/SealDocumentRequestList.xml"/>
        </item>
        <item id="USE_WRITE" render="lazy">
            <attach file="/Seal/Document/Use/SealDocumentUseWrite.xml"/>
        </item>
        <item id="CORP_WRITE" render="lazy">
            <attach file="/Seal/Document/Corp/SealDocumentCorpWrite.xml"/>
        </item>
        <item id="WRITE_GRIDLINE" render="lazy">
            <attach file="/Seal/Document/Request/SealDocumentGridLineLayout.xml"/>
        </item>
        <item id="CERT_WRITE" render="lazy">
            <attach file="/Seal/Document/Cert/SealDocumentCertWrite.xml"/>
        </item>
    </carousel>
    <onloadscript>
        <![CDATA[
            callFunction('SLM_221', 'setScreenMode', ['MY_REQ']);
            callFunction('SLM_211', 'setScreenMode', ['MY_REQ']);
            callFunction('SLM_251', 'setScreenMode', ['MY_REQ']);
        ]]></onloadscript>
    <userscript>
        <function name="changeMode" args="applyType, smrNumber, viewMode">
        <![CDATA[
            if (applyType == 'U') {
                callFunction('SLM_221', 'doQuery', [smrNumber, 'N', viewMode]);
                carouselObj.cells("USE_WRITE").setActive();
            } else if (applyType == 'C') {
                callFunction('SLM_211', 'doQuery', [smrNumber, 'N', viewMode]);
                carouselObj.cells("CORP_WRITE").setActive();
            } else if (applyType == 'D') {
            	callFunction('SLM_251', 'doQuery', [smrNumber, 'N', viewMode]);
                carouselObj.cells("CERT_WRITE").setActive();
            }
        ]]>
        </function>
        <function name="doBack">
        <![CDATA[
            callFunction('SLM_201', 'doQuery', []);
            carouselObj.cells("LIST").setActive();
        ]]>
        </function>
    </userscript>
