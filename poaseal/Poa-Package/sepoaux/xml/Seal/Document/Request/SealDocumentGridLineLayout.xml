<body screen_id="SLM_204" header="false">
    <layout id="containerLayout" div="nvRqAJfULUTxFuOaP" pattern="2E">
        <cell>
            <id>a</id>
            <fix_size>true,true</fix_size>
            <header view="false" type="contents"/>
