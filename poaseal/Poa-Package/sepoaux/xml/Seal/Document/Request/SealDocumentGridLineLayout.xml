            <attach file="/Seal/Document/Request/SealDocumentGridLineCarousel.xml"/>
        </cell>
    </layout>
    <onloadscript/>
    <userscript>
    	<function name="setHeaderText" args="text">
	    <![CDATA[
	    	changeHeaderText("a", text);
	    ]]>
	    </function>
        <function name="loadDetail" args="applyType, smrNumber, viewMode, paramObj, status">
        <![CDATA[
            if(status =='T'){
            	callFunction('AP_111', 'btn_false', ['Y']);//버튼 숨김
            }else{
            	callFunction('AP_111', 'doQuery', [paramObj, 'N']); // 결재선
            }
            callFunction('SLM_205', 'setDetailView', [applyType, smrNumber, viewMode]);
    
            if(paramObj != undefined){
            	containerLayout.cells("a").setText(paramObj.HEADER_TEXT);
	            dataOutput.setValue("LOAD_DATA_APP_TYPE", paramObj.APP_TYPE, true);
            }
        ]]>
        </function>
    </userscript>
