<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="SLM_203" header="false">
    <grid id="gridObj" div="McPfYYfflXfYYfRCzc" grid-id="SLM_203" drag="false" merge="false" dynamic="false">
    	<event type="onRowSelect" callback="onRowSelect"/>
        <event type="onXLE" callback="onXLE"/>
    </grid>
	<onloadscript>
    	<call name="doQuery"/>
    </onloadscript>
    <userscript>
    	<function name="doQuery">
    	<![CDATA[
    		dataOutput.setValue('SMR_NUMBER', Sepoa.request.SMR_NUMBER);
    		dataOutput.setValue('MODE', Sepoa.request.MODE);
    		if(Sepoa.config.get('sepoa.seal.process') =='mk2'){
    			gridObj.postConnection(window.CONTEXT_NAME+'/SepoaGrid.sux', ['mode=doQuery', 'METHOD=doSelectDocumentList', 'PROCESS_ID=sepoa.svc.sealmk2.SepoaReqSealService']);
    		}else {
    			gridObj.postConnection(window.CONTEXT_NAME+'/SepoaGrid.sux', ['mode=doQuery', 'METHOD=doSelectDocumentList', 'PROCESS_ID=sepoa.svc.seal.SepoaReqSealService']);
    		}
    		
    	]]>
    	</function>
    	<function name="onRowSelect" args="id, ind">
    	<![CDATA[
    		var header = gridObj.getColumnId(ind);
    		var mode = dataOutput.getValue('MODE');

    		if (header == 'REAL_ATTACH_IMG') {
    			vaultPopup({
	                attach_key: gridObj.cells(id, gridObj.getColIndexById("SMD_NUMBER")).getValue(),
	                type: "realSealDoc",
	                mode: mode,
	                callback: setAttach_callback,
	                rowId: id
	            });
    		}
    	]]>
    	</function>
    	<function name="setAttach_callback" args="e, a, r">
        <![CDATA[
            /*if (e.fileCount > 0) {
	            gridObj.cells(r.rowId, gridObj.getColIndexById('REAL_ATTACH_IMG')).setIcon('ATTACH_IMG2');
	            gridObj.cells(r.rowId, gridObj.getColIndexById('REAL_ATTACH_IMG')).cell.children[0].style = 'filter:none';
            } else {
	            gridObj.cells(r.rowId, gridObj.getColIndexById('REAL_ATTACH_IMG')).setIcon('ATTACH_IMG');
	            gridObj.cells(r.rowId, gridObj.getColIndexById('REAL_ATTACH_IMG')).cell.children[0].style = 'filter:none';
            }*/
            doQuery();
        ]]>
        </function>
        <function name="onXLE" args="obj, count">
        <![CDATA[
        	var flag = true;
        	for (var i=0; i<count; i++) {
            	if (gridObj.cells2(i, gridObj.getColIndexById('REAL_ATTACH_CNT')).getValue() > 0) {
            		gridObj.cells2(i, gridObj.getColIndexById('REAL_ATTACH_IMG')).setIcon('ATTACH_IMG2');
            		gridObj.cells2(i, gridObj.getColIndexById('REAL_ATTACH_IMG')).cell.children[0].style = 'filter:none';
            	} else {
            		flag = false;
            	}
            }
            window.parent.callFunction('SLM_201', 'realAttach', [{ROW_ID:Sepoa.request.ROW_ID, FLAG:flag}]);
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
    </template>
</body>