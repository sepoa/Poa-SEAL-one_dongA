    </grid>
    <variable>
        <var name="gridObj_title_view" value="$($sObject._vp).find('#e80345d3e3114bb28a17b5b0458afb')[0]"/>
        <var name="e337fc316b96496981909d472b9f56" value="$($sObject._vp).find('#e337fc316b96496981909d472b9f56')[0]"/>
        <var name="e7ed8ea975dc45e083fd08194ad4b3" value="$($sObject._vp).find('#e7ed8ea975dc45e083fd08194ad4b3')[0]"/>
        <var name="e8fbb491cbfe4ccf8ea814da3cb4e5" value="$($sObject._vp).find('#e8fbb491cbfe4ccf8ea814da3cb4e5')[0]"/>
        <var name="gridView" value="$($sObject._vp).find('#e2404cde33c247c882212d19e4db1b')[0]"/>
        <var name="gridObj_title" value="$($sObject._vp).find('#e68ef18ca20045e687457b2a3b385f')[0]"/>
        <var name="gridObj_btn" value="$($sObject._vp).find('#fcb3e587089a4f298defa7941af53c')[0]"/>
        <var name="ae66fc72aadf44bf8cdef82253295a" value="$($sObject._vp).find('#ae66fc72aadf44bf8cdef82253295a')[0]"/>
        <var name="be3d1d3356da4426818a6dcedcae3a" value="$($sObject._vp).find('#be3d1d3356da4426818a6dcedcae3a')[0]"/>
        <var name="gridArea" value="$($sObject._vp).find('#e8cde9cfb9c54ae485f4b34386abd9')[0]"/>
    </variable>
    <onloadscript>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <var name="selectedRowId"/>
        <function name="doQuery">
        <![CDATA[
            //결재자 등록
            gridObj_title.innerHTML = Sepoa.cache.text.get('SLM_133.APP_LINE_SUBJECT');
            gridObj_title.setAttribute('style', 'font-size:14px;padding-top: 25px;color:#404040;');
            dataOutput.setValue("KEY_NUMBER", Sepoa.request.KEY_NUMBER);
            //기존 결재자
            gridObj_title_view.innerHTML = Sepoa.cache.text.get('SLM_133.APP_LINE_NOW');
            gridObj_title_view.setAttribute('style', 'font-size:14px;padding-top: 25px;color:#404040;');
            gridObjView.setColumnHidden(gridObj.getColIndexById('SELECTED'), true);
            gridObjView.setColumnHidden(gridObj.getColIndexById('SEARCH_ID'), true);
            
            gridObjView.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'METHOD=doSelectAppLine', 'PROCESS_ID=sepoa.svc.setting.SLM_020']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="doSave">
        <![CDATA[
            if (gridObj.getRowsNum() > 0) {
                var infoFlag = true;
                var appDataFlag = [];
                gridObj.forEachRowA(function(id) {
                    var userId = gridObj.cells(id, gridObj.getColIndexById("APP_USER_ID")).getValue();
                    var userDept = gridObj.cells(id, gridObj.getColIndexById("APP_USER_DEPT")).getValue();
                    var appSort = gridObj.cells(id, gridObj.getColIndexById("APP_SORT")).getValue();
            
                    if (userId == '' || userDept == '' || appSort == '' || appSort == 0 || !checkNumber(appSort)) {
                        infoFlag = false;
                    }
                    appDataFlag.push(infoFlag)
                });
            
                if (appDataFlag.indexOf(false) > -1) {
                    Alert("결재자 등록 정보가 올바르게 작성되지 않았습니다.");
                    return;
                }
            
            }
            
            Confirm(Sepoa.cache.text.get('MESSAGE.1018'), function(result) {
                if (result) {
                    gridObj.editStop();
                    gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.setting.SLM_020', 'METHOD=doSaveAppLine']);
                }
            });
        ]]>
        </function>
        <function name="onRowSelect" args="id, ind">
        <![CDATA[
            var header = gridObj.getColumnId(ind);
            selectedRowId = id;
            
            if (header == "SEARCH_ID") {
                PopupCommonPost('SL0055', setAppPerson, [Sepoa.info.HOUSE_CODE, Sepoa.info.COMPANY_CODE]);
            }
            gridObj.cells(id, gridObj.getColIndexById('SELECTED')).setValue(true);
        ]]>
        </function>
        <function name="setAppPerson" args="userId, userName, userDept, userDeptName">
        <![CDATA[
            let userDataFlag = [];
            gridObj.forEachRowA(function(ids) {
                let overLapFlag = true;
                if (userId == gridObj.cells(ids, gridObj.getColIndexById('APP_USER_ID')).getValue()) {
                    overLapFlag = false;
                }
                userDataFlag.push(overLapFlag);
            });
            
            if (userDataFlag.indexOf(false) > -1) {
                gridObj.cells(selectedRowId, gridObj.getColIndexById('APP_USER_ID')).setValue('');
                gridObj.cells(selectedRowId, gridObj.getColIndexById('APP_USER_NAME')).setValue('');
                gridObj.cells(selectedRowId, gridObj.getColIndexById('APP_USER_DEPT')).setValue('');
                gridObj.cells(selectedRowId, gridObj.getColIndexById('APP_USER_DEPT_NAME')).setValue('');
                Alert("동일한 결재자가 이미 있습니다.");
                return;
            } else {
                gridObj.cells(selectedRowId, gridObj.getColIndexById('APP_USER_ID')).setValue(userId);
                gridObj.cells(selectedRowId, gridObj.getColIndexById('APP_USER_NAME')).setValue(userName);
                gridObj.cells(selectedRowId, gridObj.getColIndexById('APP_USER_DEPT')).setValue(userDept);
                gridObj.cells(selectedRowId, gridObj.getColIndexById('APP_USER_DEPT_NAME')).setValue(userDeptName);
            }
        ]]>
        </function>
        <function name="onXLE" args="obj, count,a">
        <![CDATA[
            var mode = obj.getUserData("", "mode");
            var status = obj.getUserData("", "status");
            var message = obj.getUserData("", "message");
            
            if (status == "true") {}
        ]]>
        </function>
        <function name="onTXE" args="obj, count">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            
            if (status == "true") {
                Alert(message);
                selfObj.close();
            }
        ]]>
        </function>
        <function name="doAddRow" args="">
        <![CDATA[
            var ydNumber = Sepoa.request.KEY_NUMBER;
            var maxRowId = dhx4.newId();
            gridObj.addRow(maxRowId, '', gridObj.getRowsNum());
            gridObj.cells(maxRowId, gridObj.getColIndexById('KEY_NUMBER')).setValue(ydNumber);
            gridObj.cells(maxRowId, gridObj.getColIndexById('APP_SORT')).setValue(0);
            gridObj.showRow(maxRowId);
        ]]>
        </function>
        <function name="doDeleteRow" args="">
        <![CDATA[
            var grid_array = gridObj.getGridChangedRows("SELECTED");
            
            if (grid_array.length < 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.MSG_1001'));
            } else {
                Confirm(Sepoa.cache.text.get('MESSAGE.1010'), function(result) {
                    if (result) {
                        for (var i in grid_array) {
                            gridObj.deleteRow(grid_array[i]);
                        }
                    }
                });
            }
        ]]>
        </function>
        <function name="onEditCell" args="stage, rId, cInd, nValue, oValue">
        <![CDATA[
            var header = gridObj.getColumnId(cInd);
            if (stage == 2) {
                if (header == 'APP_SORT') {
                    var serId = rId;
                    if (!checkNumber(nValue)) {
                        Alert("순번은 1 이상의 정수로 입력해주세요.");
                        return;
                    }
                    gridObj.forEachRow(function(rId) {
                        var appSort = gridObj.cells(rId, gridObj.getColIndexById('APP_SORT')).getValue();
                        if (serId != rId && appSort == nValue) {
                            Alert("결재 순서는 중복될 수 없습니다.");
                            gridObj.cells(serId, gridObj.getColIndexById('APP_SORT')).setValue('');
                            gridObj.cells(serId, gridObj.getColIndexById('SELECTED')).setValue(false);
                            return false;
                        }
                    })
            
                    gridObj.sortRows(gridObj.getColIndexById('APP_SORT'));
                }
            }
            return true;
        ]]>
        </function>
        <function name="checkNumber" args="str">
        <![CDATA[
            let string = str.toString().replace(/(^0+)/, ""); //왼쪽 0 제외
            if (['-', '.', '', '0'].indexOf(string) > -1) {
                return false;
            }
            let pattern = /^[0-9]+$/;
            return pattern.test(string);
        ]]>
        </function>
    </userscript>
