<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="SLM_602" header="false">
    <filterbar id="filterObj" div="FeiDlmeExCElmeDKGf">
        <calendar id="F_CALENDAR" button="year:0,month:0,week:-4,day:0" default="week:-4"/>
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="doQuery"/>
    </filterbar>
    <button id="btnObj">
        <btn div="FeiDlmeUWmElmeJcYF" id="count" type="template" toggle="false" reverse="false"/>
        <btn div="FeiDlmegKAFlmenEZd" id="req_use_seal" type="default" text="{SLM_602.req_use_seal}" onclick="onButtonClick( 'REQ_USE' )"/>
        <btn div="FeiDlmegKAFlmenEZd" id="req_corp_seal" type="default" text="{SLM_602.req_corp_seal}" onclick="onButtonClick( 'REQ_CORP' )"/>
    </button>
    <grid id="gridObj" div="kOKClmeEDEzNMcrODy" grid-id="SLM_602" drag="false" merge="false" dynamic="false">
        <event type="onRowSelect" callback="onRowSelect"/>
        <event type="onXLE" callback="onXLE"/>
    </grid>
    <variable>
        <var name="FeiDlmeJrrDlmerXpd" value="$($sObject._vp).find('#FeiDlmeJrrDlmerXpd')[0]"/>
        <var name="FeiDlmeSxFElmecXRW" value="$($sObject._vp).find('#FeiDlmeSxFElmecXRW')[0]"/>
        <var name="FeiDlmeIrrDlmeCxuk" value="$($sObject._vp).find('#FeiDlmeIrrDlmeCxuk')[0]"/>
    </variable>
    <onloadscript>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
    	<function name="onButtonClick" args="name">
        <![CDATA[
            switch (name) {
                case "REQ_USE":
                    doRequestUseSeal();
                    break;
                case "REQ_CORP":
                    doRequestCorpSeal();
                    break;
                default:
                    break;
            }
        ]]>
        </function>
        <function name="doQuery">
        <![CDATA[
            dataOutput.setValue('MODE', 'LIST');
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME+'/SepoaGrid.sux', ['mode=doQuery', 'METHOD=doGroupWareRequestList', 'PROCESS_ID=sepoa.svc.seal.SepoaReqSealService']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="doSelect_validation">
        <![CDATA[
        	var selectedRow = gridObj.getGridChangedRows("SELECTED");
                        
            if (selectedRow.length < 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.1004'));
                return;
            }
            
            if (selectedRow.length > 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.1006'));
                return;
            }
            return true;
        ]]>
        </function>
        <function name="doRequestUseSeal">
        <![CDATA[
        	if (!doSelect_validation()) {
                return;
            }
            //코드의 콤보값을 가지려면 gridObj.getCombo('컬럼ID').get('코드');
            var selectedRow = gridObj.getGridChangedRows("SELECTED");
            var rowData = gridObj._getRowData(selectedRow);
            rowData.USE_NUMBER = gridObj.getCombo('REQ_SEAL_USE_TYPE').get(rowData.REQ_SEAL_USE_TYPE);
			if (rowData.DOC_NUMBER != '') {//기존 문서 번호가 있을 경우
                var so = doServiceAjax('sepoa.svc.seal.SepoaReqSealService', 'CONNECTION', 'doQueryAttach', rowData, null, false);
                if (so.status == '1') {
                    if (so.result.length > 0) {
                        rowData.FILE_LIST = new SepoaFormater(so.result[0]).getArrayMap();
                    }
                }
			}else {
				rowData.FILE_LIST =[];
			}
			
            callFunction(['p','p'], 'viewUseSeal', [rowData]);
        ]]>
        </function>
        <function name="doRequestCorpSeal">
        <![CDATA[
        	if (!doSelect_validation()) {
                return;
            }
            
            var selectedRow = gridObj.getGridChangedRows("SELECTED");
            var rowData = gridObj._getRowData(selectedRow);
            rowData.USE_NUMBER = gridObj.getCombo('REQ_SEAL_USE_TYPE').get(rowData.REQ_SEAL_USE_TYPE);
			
			if (rowData.DOC_NUMBER != '') {//기존 문서 번호가 있을 경우
                var so = doServiceAjax('sepoa.svc.seal.SepoaReqSealService', 'CONNECTION', 'doQueryAttach', rowData, null, false);
                if (so.status == '1') {
                    if (so.result.length > 0) {
                        rowData.FILE_LIST = new SepoaFormater(so.result[0]).getArrayMap();
                    }
                }
			}else {
				rowData.FILE_LIST =[];
			}
			
            callFunction(['p','p'], 'viewCorpSeal', [rowData]);
        ]]>
        </function>
        <function name="onRowSelect" args="id, ind">
        <![CDATA[
            var header = this.getColumnId();
            var selected = gridObj.cells(id, gridObj.getColIndexById("SELECTED")).getValue();
            if (selected == 0) {
                gridObj.cells(id, gridObj.getColIndexById("SELECTED")).setValue(1);
            } else {
                gridObj.cells(id, gridObj.getColIndexById("SELECTED")).setValue(0);
            }
        ]]>
        </function>
        <function name="onXLE" args="obj, count">
        <![CDATA[
            if (count == 0) {
                Alert(Sepoa.cache.text.get('MESSAGE.1001'));
                return;
            }
        ]]>
        </function>
    </userscript>
