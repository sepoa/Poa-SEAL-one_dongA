<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="SLM_292" header="false">
    <filterbar id="filterObj" div="nmEkmVflzVkmVfirEY">
        <calendar id="F_CALENDAR" button="year:0,month:0,week:-4,day:0" default="week:-4"/>
        <keyword id="F_KEYWORD"/>
        <filter>
            <option id="F_ATTACH_FLAG" type="flag" checked="Y,N" unchecked="N" default="N"/>
            <option id="RE_FLAG" type="select" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#SM001_3"/>
        </filter>
        <event type="onSearch" callback="doQuery"/>
    </filterbar>
    <grid id="gridObj" div="nmEkmVfNlLomVfAFYF" grid-id="SLM_292" drag="false" merge="false" dynamic="false">
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onRowSelect" callback="onRowSelect"/>
    </grid>
    <variable>
        <var name="nmEkmVflPZlmVfHJbE" value="$($sObject._vp).find('#nmEkmVflPZlmVfHJbE')[0]"/>
        <var name="nmEkmVfkPZlmVfObJr" value="$($sObject._vp).find('#nmEkmVfkPZlmVfObJr')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <var name="selectedGridId"/>
        <function name="init">
        <![CDATA[
            if (Sepoa.request.status) {
                filterObj.setValue('SMR_STATUS', Sepoa.request.status);
            }
            doQuery();
        ]]>
        </function>
        <function name="doQuery">
        <![CDATA[
            dataOutput.setValue('MODE', 'LIST');
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME+'/SepoaGrid.sux', ['mode=doQuery', 'METHOD=doSelectTodoAttachDocList', 'PROCESS_ID=sepoa.svc.seal.SepoaReqSealService']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd">
        <![CDATA[
            for (var i = 0; i < gridObj.getRowsNum(); i++) {
                var reDeatil = [];
                reDetail = gridObj.cells2(i, gridObj.getColIndexById('RE_DETAIL')).getValue().split(',');
                for (var j = 0; j < reDetail.length; j++) {
                    switch (reDetail[j]) {
                        case 'E':
                            reDetail[j] = Sepoa.cache.text.get('SLM_292.ELECTRON');
                            break;
                        case 'R':
                            reDetail[j] = Sepoa.cache.text.get('SLM_292.REAL');
                            break;
                        case 'EE':
                            reDetail[j] = Sepoa.cache.text.get('SLM_292.ELECTRON_SIGN');
                            break;
                        case 'RE':
                            reDetail[j] = Sepoa.cache.text.get('SLM_292.REAL_SIGN');
                            break;
                        default:
                            break;
                    }
                }
                gridObj.cells2(i, gridObj.getColIndexById('RE_DETAIL')).setValue(reDetail.join(','));
            
                if (gridObj.cells2(i, gridObj.getColIndexById('ATTACH_FLAG')).getValue() == 'Y') {
                    gridObj.cells2(i, gridObj.getColIndexById('ATTACH_IMG')).setIcon('ATTACH_IMG2');
                    gridObj.cells2(i, gridObj.getColIndexById('ATTACH_IMG')).cell.children[0].style = 'filter:none';
                }
            }
        ]]>
        </function>
        <function name="onRowSelect" args="rId, cInd">
        <![CDATA[
            selectedGridId = rId;
            var confirm_val = false;
            if (gridObj.getColumnId(cInd) == 'ATTACH_IMG') {
                var smrNumber = gridObj.cells(rId, gridObj.getColIndexById("SMR_NUMBER")).getValue();
                var sdNumber = gridObj.cells(rId, gridObj.getColIndexById("SD_NUMBER")).getValue();
                var docNumber = smrNumber + '_' + sdNumber;
                callVaultPopup(docNumber);
            }else if(gridObj.getColumnId(cInd) == 'SUBJECT') {
            	if(Sepoa.info.CTRL_CODE.indexOf('ATTACH_CONFIRM') < 0 ){
            		Alert(Sepoa.cache.text.get('SLM_292.ATTACH_NOT_CONFIRM'));
            		return false;
            	}else {
					confirm_val = true;            		
            	}
            	smrNumber = gridObj.cells(rId, gridObj.getColIndexById("SMR_NUMBER")).getValue();
            	var appType = gridObj.cells(rId, gridObj.getColIndexById("APPLY_TYPE")).getValue();
            	callFunction('p', 'changeToDetail', [smrNumber, confirm_val, appType]);
            }
        ]]>
        </function>
        <function name="attach_callback" args="e, a, param">
        <![CDATA[
            doQuery();
        ]]>
        </function>
        <function name="callVaultPopup" args="attachNo">
        <![CDATA[
            var type = 'TODO_DOC';
            var mode = '';
            vaultPopup({
                attach_key: attachNo,
                type: type,
                mode: mode,
                callback: attach_callback
            });
        ]]>
        </function>
    </userscript>
