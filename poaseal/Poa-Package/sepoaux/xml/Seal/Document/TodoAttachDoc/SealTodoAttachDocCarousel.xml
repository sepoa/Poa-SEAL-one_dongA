<body screen_id="SLM_291" header="false">
    <carousel id="carouselObj" div="mxPimVfQqhimVfSkaJ">
        <item id="LIST">
            <attach file="/Seal/Document/TodoAttachDoc/SealTodoAttachDocList.xml"/>
        </item>
        <item id="CORP_WRITE" render="lazy">
            <attach file="/Seal/Document/Corp/SealDocumentCorpWrite.xml"/>
        </item>
        <item id="USE_WRITE" render="lazy">
            <attach file="/Seal/Document/Use/SealDocumentUseWrite.xml"/>
        </item>
        <item id="CERT_WRITE" render="lazy">
            <attach file="/Seal/Document/Cert/SealDocumentCertWrite.xml"/>
        </item>
    </carousel>
    <onloadscript/>
    <userscript>
    <function name="changeToDetail" args="smrNumber, confirm_val, appType">
        <![CDATA[
             if(appType == 'C'){
	            callFunction('SLM_211', 'doQuery', [smrNumber, 'N', 'ATTACH_CONFIRM','VIEW']);
             	carouselObj.cells("CORP_WRITE").setActive();
             }else if(appType == 'U'){
             	callFunction('SLM_221', 'doQuery', [smrNumber, 'N', 'ATTACH_CONFIRM','VIEW']);
             	carouselObj.cells("USE_WRITE").setActive();
             } else if (appType == 'D') {
            	callFunction('SLM_251', 'doQuery', [smrNumber, 'N', 'VIEW']);
                carouselObj.cells("CERT_WRITE").setActive();
            }
        ]]>
    </function>
    <function name="doBack" args="">
        <![CDATA[
             carouselObj.cells("LIST").setActive();
        ]]>
    </function>
    </userscript>
