<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="SLM_031" header="false">
    <filterbar id="filterObj" div="XvRQzmedWfhrGbDwCt">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <list id="listObj" div="XvRQzmegWghrGbiSTO">
        <type>
            <template><![CDATA[<table width=100% class=list_template><tr><td width=30% class=\"listBold listColorB\">#subject#</td></tr><tr><td style='float:right'>#app_type_loc#</td></tr></table>]]></template>
        </type>
        <event type="onItemClick" callback="onItemClick"/>
        <event type="onXLE" callback="onXLE"/>
    </list>
    <onloadscript>
    	<call name="doQueryList"/>
    </onloadscript>
    <userscript>
    	<var name="queryDataFlag"/>
    	<function name="doQueryList" args="flag">
    	<![CDATA[
    		queryDataFlag = flag;
            dataOutput.addFilter(filterObj);
            listObj.load(window.CONTEXT_NAME + '/SepoaList.sux?PROCESS_ID=sepoa.svc.setting.SLM_030&mode=doList&METHOD=doQueryList' + dataOutput.getParams());
    	]]>
    	</function>
        <function name="onItemClick" args="id, ev, html">
        <![CDATA[
            callFunction('SLM_032', 'doQuery', [listObj.get(id).house_code, listObj.get(id).company_code,listObj.get(id).use_number, listObj.get(id).subject, listObj.get(id).app_type]);
        ]]>
        </function>
        <function name="onXLE" args="">
        <![CDATA[
            if (!queryDataFlag) {
                if (listObj.dataCount() > 0) {
                    var id = listObj.first();
                    listObj.select(id);
                    onItemClick(id);
                }
            }
        ]]>
        </function>
        <function name="onSearch">
        <![CDATA[
        	doQuery();
        ]]>
        </function>
    </userscript>
