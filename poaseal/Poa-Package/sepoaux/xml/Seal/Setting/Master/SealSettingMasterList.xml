<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="SLM_021" header="false">
    <filterbar id="filterObj" div="StClymepLOlymeOxtr">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <list id="listObj" div="StClymecdLlymebDwf">
        <type>
            <template><![CDATA[<table width=100% class=sepoa_list_design><col width=55% /><col width=45%><tr><td class=sepoa_list_secondary>#subject#</td><tr><td colspan=2 class=\"sepoa_list_primary sepoa_list_align_right\"></td></tr></table>]]></template>
        </type>
        <event type="onItemClick" callback="doRowSelect"/>
        <event type="onXLE" callback="doQueryEnd"/>
    </list>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <function name="init" args="flag">
        <![CDATA[
            queryDataFlag = flag;
            dataOutput.addFilter(filterObj);
            listObj.load(window.CONTEXT_NAME + '/SepoaList.sux?PROCESS_ID=sepoa.svc.setting.SLM_020&mode=doList&METHOD=doQueryList' + dataOutput.getParams());
        ]]>
        </function>
        <function name="doRowSelect" args="id">
        <![CDATA[
            console.log(listObj.get(id));
            //callFunction('', '', [listObj.get(id)]);
        ]]>
        </function>
        <function name="doQueryEnd">
        <![CDATA[
            if (!queryDataFlag) {
                if (listObj.dataCount() > 0) {
                    var id = listObj.idByIndex(0);
                    listObj.select(id);
                    doRowSelect(id);
                }
            }
        ]]>
        </function>
        <function name="onSearch">
        <![CDATA[
            doQuery();
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
    </template>
</body>