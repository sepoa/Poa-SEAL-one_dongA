<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="SLM_161" header="false">
    <filterbar id="filterObj" div="uTebQpeaOjbQpeYcmn">
        <calendar id="F_CALENDAR" button="year:0,month:0,week:-4,day:0" default="week:-4"/>
        <status id="F_STATUS" combo="SL0044,{HOUSE_CODE}#{LANGUAGE}#SM032#Y"/>
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <button id="uTebQpezpkbQpeclv"/>
    <grid id="gridObj" div="uTebQpeOplbQpegPrT" grid-id="SLM_161" drag="false" merge="false" dynamic="false">
        <event type="onRowSelect" callback="onRowSelect"/>
        <event type="onEditCell" callback="onEditCell"/>
        <event type="onXLE" callback="onXLE"/>
        <event type="onTXE" callback="onTXE"/>
    </grid>
    <onloadscript>
        <![CDATA[
            doQuery();
        ]]></onloadscript>
    <userscript>
    	<var name="callbackData"/>
        <function name="doQuery" args="callbackParams">
        <![CDATA[
        	callbackData = callbackParams;
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.seal.SepoaSealManagementService', 'METHOD=doToDoList']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="onRowSelect" args="id, ind">
        <![CDATA[
        	let coverProgress = false;	// 더블클릭 방지용 프로그레스 모달을 켰는지
        	var header = gridObj.getColumnId(ind);
            
            if (['SUBJECT'].indexOf(header) > -1){
            	sUtils.progress.on();
            	coverProgress = true;
                doDetail(id, ind);
            }
            
            if (coverProgress) { setTimeout(function() { sUtils.progress.off();}, 100);}
        ]]>
        </function>
        <function name="doDetail" args="id, ind">
        <![CDATA[
            var docNo = gridObj.cells(id, gridObj.getColIndexById("DOC_NO")).getValue();
            var manageNo = gridObj.cells(id, gridObj.getColIndexById("MANAGE_NUMBER")).getValue();
            var applyType = gridObj.cells(id, gridObj.getColIndexById("APPLY_TYPE")).getValue();
            var status = gridObj.cells(id, gridObj.getColIndexById("STATUS")).getValue();
            
            switch (applyType) {
                case "NE":
                    callFunction('SLM_122', 'setMode', [manageNo, docNo]);
                    callFunction(['p', 'p'], 'changeCell', ['SLM_122']);
                    break;
                case "UP":
                    callFunction('SLM_132', 'setMode', [manageNo, docNo, applyType]);
                    callFunction(['p', 'p'], 'changeCell', ['SLM_132']);
                    break;
                case "RE":
                    callFunction('SLM_152', 'setMode', [manageNo, docNo]);
                    callFunction(['p', 'p'], 'changeCell', ['SLM_152']);
                    break;
                case "LO":
                    callFunction('SLM_142', 'setMode', [manageNo, docNo]);
                    callFunction(['p', 'p'], 'changeCell', ['SLM_142']);
                    break;
                default:
                    break;
            }
        ]]>
        </function>
        <function name="onButtonClick" args="name">
        <![CDATA[
            switch (name) {
                case "DETAIL":
                    doDetail();
                    break;
                case "UPDATE":
                    doUpdate();
                    break;
                case "DELETE":
                    break;
                default:
                    break;
            }
        ]]>
        </function>
        <function name="doUpdate" args="">
        <![CDATA[
            
        ]]>
        </function>
        <function name="onEditCell" args="stage, rId, cInd, nValue, oValue">
        <![CDATA[
            var header = gridObj.getColumnId();
            if (stage == 0) {
                return true;
            } else if (stage == 1) {
                return true;
            } else if (stage == 2) {
                return true;
            }
            return false;
        ]]>
        </function>
        <function name="onXLE" args="obj, count">
        <![CDATA[
            if (count == 0 && callbackData == undefined) {
                return;
            }
        ]]>
        </function>
        <function name="onTXE" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if (status == "true") {} else {
                Alert(message);
            }
        ]]>
        </function>
        <function name="onSearch" args="">
        <![CDATA[
            doQuery();
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
    </template>
</body>