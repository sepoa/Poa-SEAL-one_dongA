<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="SLM_111" header="false">
    <filterbar id="filterObj" div="JpEmvmekZWmvmecwAY">
        <calendar id="F_CALENDAR" button="year:0,month:0,week:-4,day:0" default="week:-4"/>
        <status id="F_STATUS" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#SM032" label=""/>
        <keyword id="F_KEYWORD"/>
        <filter>
            <option id="F_APPLY_TYPE" type="select" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#SM031"/>
        </filter>
        <event type="onSearch" callback="onSearch"/>
        <event type="onComboLoad" callback="onComboLoad"/>
    </filterbar>
    <button id="JpEmvmeTDumvmeJlmc">
    	<!-- <btn div="JpEmvmeTDumvmeJlmc" id="modify" text="{BUTTON.modify}" toggle="false" reverse="false" onclick="onButtonClick( 'UPDATE' )"/> -->
        <!-- <btn div="JpEmvmeTDumvmeJlmc" id="DELETE" text="{SLM_111.BTN_DELETE}" toggle="false" reverse="false" onclick="onButtonClick( 'DELETE' )"/> -->
    </button>
    <grid id="gridObj" div="JpEmvmegeZnvmeTPhl" grid-id="SLM_111" drag="false" merge="false" dynamic="false">
        <event type="onRowSelect" callback="onRowSelect"/>
        <event type="onEditCell" callback="onEditCell"/>
        <event type="onXLE" callback="onXLE"/>
        <event type="onTXE" callback="onTXE"/>
    </grid>
    <variable>
        <var name="viGOdteaPJOdtenOXe" value="$($sObject._vp).find('#viGOdteaPJOdtenOXe')[0]"/>
        <var name="viGOdtedqNOdteDamv" value="$($sObject._vp).find('#viGOdtedqNOdteDamv')[0]"/>
        <var name="viGOdteaPJOdteustB" value="$($sObject._vp).find('#viGOdteaPJOdteustB')[0]"/>
    </variable>
    <onloadscript>
    	<call name="init"/>
    </onloadscript>
    <userscript>
        <function name="init">
        <![CDATA[
        	if (Sepoa.request.manageType) {
        		filterObj.setValue('F_APPLY_TYPE', Sepoa.request.manageType);
        	}
        	doQuery();
    	]]>
        </function>
        <function name="doQuery" args="">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.seal.SepoaSealManagementService', 'METHOD=doRequestList']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="onRowSelect" args="id, ind">
        <![CDATA[
            var header = gridObj.getColumnId(ind);
            var selectedIdx = gridObj.getColIndexById('SELECTED');
            var isChecked = gridObj.cells(id, selectedIdx).isChecked();
       		let coverProgress = false;	// 더블클릭 방지용 프로그레스 모달을 켰는지
            
            if (ind == selectedIdx) {
                gridObj.checkAll(false);
                gridObj.cells(id, selectedIdx).setChecked(!isChecked);
            } else if (['SUBJECT'].indexOf(header) > -1){
            	sUtils.progress.on();
            	coverProgress = true;
                doDetail(id);
            }
            
            if (coverProgress) { setTimeout(function() { sUtils.progress.off();}, 100);}
        ]]>
        </function>
        <function name="onButtonClick" args="name">
        <![CDATA[
            switch (name) {
                case "DETAIL":
                    //doDetail();
                    break;
                case "UPDATE":
                    doUpdate();
                    break;
                case "DELETE":
                    doDelete();
                    break;
                default:
                    break;
            }
        ]]>
        </function>
        <function name="onComboLoad" args="comboName, itemList">
        <![CDATA[
            if (comboName == 'F_STATUS') {
	        	for(var filterIdx in filterObj.filterObjs) { if (filterIdx != undefined && filterObj.filterObjs[filterIdx].id == 'F_STATUS') break; }
	        	var comboObj = filterObj.filterObjs[filterIdx];
				var optionList = ['ALL'];	// ALL 전체, T 임시저장
				if (sUtils.workflow.check('US1635932969714') || sUtils.workflow.check('CS1635987524341') || sUtils.workflow.check('SM1635987582854') || sUtils.workflow.check('SR1635987653344') || sUtils.workflow.check('SL1635987694555')) optionList.push('I','R'); // 결재모듈
	        	if (sUtils.workflow.check('US1635932977187') || sUtils.workflow.check('CS1635987524638') || sUtils.workflow.check('SM1635987583152') || sUtils.workflow.check('SR1635987653583') || sUtils.workflow.check('SL1635987694835')) optionList.push('G','N'); // 법무팀 승인
	        	if (sUtils.workflow.check('US1635932982246')) optionList.push('S'); // 발송
	        	if (sUtils.workflow.check('US1636942527135')) optionList.push('V'); // 수령
	        	if (sUtils.workflow.check('US1635932983947') || sUtils.workflow.check('CS1635987529963') || sUtils.workflow.check('SM1635987588694') || sUtils.workflow.check('SR1635987653854') || sUtils.workflow.check('SL1635987695123')) optionList.push('C'); // 완료
				
				for (var i = 0; i < comboObj.comboList.length; i++) {
					if (optionList.indexOf(comboObj.comboList[i].comboValue) == -1) {
						comboObj.comboList.splice(i, 1);
						comboObj.comboListModal.getElementsByClassName('status_combo_list_item')[i].remove();
						--i;
					}
				}
        	}
        ]]>
        </function>
        <function name="doDetail" args="rowId">
        <![CDATA[
            var docNo = gridObj.cells(rowId, gridObj.getColIndexById("DOC_NO")).getValue();
            var manageNo = gridObj.cells(rowId, gridObj.getColIndexById("MANAGE_NUMBER")).getValue();
            var applyType = gridObj.cells(rowId, gridObj.getColIndexById("APPLY_TYPE")).getValue();
            var status = gridObj.cells(rowId, gridObj.getColIndexById("STATUS")).getValue();
            
            switch (applyType) {
                case "NE":
                    callFunction('SLM_122', 'setMode', [manageNo, docNo, 'LIST', status]);
                    callFunction(['p', 'p'], 'changeCell', ['SLM_122']);
                    break;
                case "UP":
                    callFunction('SLM_132', 'setMode', [manageNo, docNo, applyType, status]);
                    callFunction(['p', 'p'], 'changeCell', ['SLM_132']);
                    break;
                case "RE":
                    callFunction('SLM_152', 'setMode', [manageNo, docNo]);
                    callFunction(['p', 'p'], 'changeCell', ['SLM_152']);
                    break;
                case "LO":
                    callFunction('SLM_142', 'setMode', [manageNo, docNo]);
                    callFunction(['p', 'p'], 'changeCell', ['SLM_142']);
                    break;
                default:
                    break;
            }
        ]]>
        </function>
        <function name="doDelete" args="">
        <![CDATA[
            var selectedRows = gridObj.getSelectedRows('SELECTED');
            var rowCount = gridObj.getSelectedRows('SELECTED').length;
            
            if (rowCount < 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.1004')); //선택된 데이터가 없습니다.
                return;
            } else if (rowCount > 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.1006')); //하나 이상 선택할 수 없습니다.
                return;
            }
            
            //상태 : 작성중인 상태(T)만 삭제 가능 
            var docNo = gridObj.cells(selectedRows[0], gridObj.getColIndexById("DOC_NO")).getValue();
            var manageNo = gridObj.cells(selectedRows[0], gridObj.getColIndexById("MANAGE_NUMBER")).getValue();
            var applyType = gridObj.cells(selectedRows[0], gridObj.getColIndexById("APPLY_TYPE")).getValue();
            var status = gridObj.cells(selectedRows[0], gridObj.getColIndexById("STATUS")).getValue();
            
            
            if (status != "T") {
                Alert(Sepoa.cache.text.get('SLM_111.MESSAGE001')); //임시저장 상태의 문서만 삭제할 수 있습니다.
                return;
            }
            
            var data = {
                MANAGE_NUMBER: manageNo,
                DOC_NO: docNo
            };
            
            var serviceData = {
                TYPE: applyType,
                parameter: {
                    basic_info: data
                }
            };
            
            Confirm(Sepoa.cache.text.get('SLM_111.MESSAGE002'), function(flag) { //삭제하시겠습니까?
                if (flag) {
                    doServiceAjax('sepoa.svc.seal.SepoaSealManagementService', 'TRANSACTION', 'doDocumentDelete', {
                        SEAL_DATA: JSON.stringify(serviceData)
                    }, function(so) {
                        if (so.status == 1) {
                            Alert(Sepoa.cache.text.get('MESSAGE.0001'));
                            doQuery();
                        } else {
                            Alert(so.message);
                        }
                    });
                }
            });
        ]]>
        </function>
        <function name="doUpdate" args="">
        <![CDATA[
            
        ]]>
        </function>
        <function name="onEditCell" args="stage, rId, cInd">
        <![CDATA[
            if (stage == 0) {
                onRowSelect(rId, cInd);
            }
        ]]>
        </function>
        <function name="onXLE" args="obj, count">
        <![CDATA[
            if (count == 0) {
                return;
            }
        ]]>
        </function>
        <function name="onTXE" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if (status == "true") {} else {
                Alert(message);
            }
        ]]>
        </function>
        <function name="onSearch" args="">
        <![CDATA[
            doQuery();
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
    </template>
</body>