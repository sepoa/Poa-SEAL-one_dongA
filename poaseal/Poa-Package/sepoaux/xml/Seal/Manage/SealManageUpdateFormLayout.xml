<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="SLM_132" header="false">
    <layout id="KyAQymeedCQymelkho" div="KyAQymeedCQymelkho" pattern="1C">
        <cell>
            <id>a</id>
            <fix_size>true,true</fix_size>
            <header view="true" text="SLM_132.LAYOUT_A_HEADER"/>
            <collapse icon="false" collapsed="false"/>
            <icon>menu</icon>
            <attach file="/Seal/Manage/SealManageUpdateForm.xml"/>
        </cell>
    </layout>
    <onloadscript>
    <![CDATA[
    	var mode = Sepoa.request.MODE;
    	if(mode){
    		if(mode == 'NEW'){
    			callFunction('SLM_133', 'setModeByStatus', ['NEW']);
    		};
    	}     
    ]]>
    </onloadscript>
    <userscript>
    <function name="setMode" args="manageNo, docNo, applyType, status">
    <![CDATA[
		callFunction('SLM_133', 'doLoad', [manageNo, docNo, applyType, status]);
    ]]>
    </function>
    <function name="setUpdateMode" args="manageNo">
    <![CDATA[
		callFunction('SLM_133', 'setDirectUpdateMode', [{MANAGE_NUMBER:manageNo}]);
    ]]>
    </function>    
    <function name="changeToFirstCell" args="callbackParams">
    <![CDATA[
        callFunction('p', 'changeToFirstCell', [callbackParams]);
    ]]>
    </function>	    
    </userscript>
    <template editor="true">
        
        
        
        
        
    </template>
</body>