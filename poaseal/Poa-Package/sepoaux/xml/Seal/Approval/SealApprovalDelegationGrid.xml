<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AP_131" header="false">
    <filterbar id="filterObj" div="PSYpHJdGQujrGbUXox">
        <calendar id="F_CALENDAR" button="year:0,week:-4,week:-1,day:0" default="week:-4"/>
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <button id="CQtvHJdeDgyHJdxWBx">
        <btn div="CQtvHJdeDgyHJdxWBx" id="ADD_ROW" type="custom_1" text="{BUTTON.rowadd}" toggle="false" reverse="false" onclick="onButtonClick( 'ADD_ROW' )"/>
        <btn div="CQtvHJdeDgyHJdxWBx" id="COPY_ROW" type="custom_1" text="{BUTTON.copy}" toggle="false" reverse="false" onclick="onButtonClick( 'COPY_ROW' )"/>
        <btn div="CQtvHJdeDgyHJdxWBx" id="delete" type="custom_1" text="{BUTTON.delete}" toggle="false" reverse="false" onclick="onButtonClick( 'DEL' )"/>
        <btn div="CQtvHJdeDgyHJdxWBx" id="save" type="custom_2" text="{BUTTON.save}" toggle="false" reverse="false" onclick="onButtonClick( 'SAVE' )"/>
    </button>
    <grid id="gridObj" div="PSYpHJdnozjrGbRYJr" grid-id="AP_130" drag="false" merge="false" dynamic="false">
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onTXE" callback="doSaveEnd"/>
        <event type="onEditCell" callback="onEditCell"/>
        <event type="onRowSelect" callback="onRowSelect"/>
    </grid>
    <usercss>
    <![CDATA[
        div.gridbox_dhx_web.gridbox table.obj.row20px tr td img {
            width: 18px;
        }
    ]]>
    </usercss>
    <variable>
        <var name="AtARjOexXCRjOedRSh" value="$($sObject._vp).find('#AtARjOexXCRjOedRSh')[0]"/>
        <var name="AtARjOeElFRjOeuYQR" value="$($sObject._vp).find('#AtARjOeElFRjOeuYQR')[0]"/>
        <var name="AtARjOexXCRjOeMzLW" value="$($sObject._vp).find('#AtARjOexXCRjOeMzLW')[0]"/>
    </variable>
    <onloadscript>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <function name="onButtonClick" args="name">
        <![CDATA[
            switch (name) {
                case "ADD_ROW":
                    addRow();
                    break;
                case "COPY_ROW":
                    copyRow();
                    break;
                case "DEL":
                    doDelete();
                    break;
                case "SAVE":
                    doSave();
                    break;
                default:
                    break;
            }
        ]]>
        </function>
        <function name="addRow" args="">
        <![CDATA[
            var maxRowId = gridObj.getRowsNum();
            gridObj.addRow(++maxRowId, ',0', gridObj.getRowsNum());
            gridObj.cells(maxRowId, gridObj.getColIndexById('SELECTED')).cell.wasChanged = true;
            gridObj.cells(maxRowId, gridObj.getColIndexById('SELECTED')).setValue("1");
            gridObj.cells(maxRowId, gridObj.getColIndexById('HOUSE_CODE')).setValue(Sepoa.info.HOUSE_CODE);
            gridObj.setCellExcellType(maxRowId, gridObj.getColIndexById('MAND_TYPE'), 'comboro');
            gridObj.cells(maxRowId, gridObj.getColIndexById('MAND_TYPE')).setValue("01"); //결재
            gridObj.setCellExcellType(maxRowId, gridObj.getColIndexById('COMPANY_CODE'), 'comboro');
            gridObj.cells(maxRowId, gridObj.getColIndexById('COMPANY_CODE')).setValue(Sepoa.info.COMPANY_CODE);
            gridObj.setCellExcellType(maxRowId, gridObj.getColIndexById('GIVE_COMPANY_CODE'), 'comboro');
            gridObj.cells(maxRowId, gridObj.getColIndexById('GIVE_COMPANY_CODE')).setValue(Sepoa.info.COMPANY_CODE);
            gridObj.setCellExcellType(maxRowId, gridObj.getColIndexById('RECE_COMPANY_CODE'), 'comboro');
            gridObj.cells(maxRowId, gridObj.getColIndexById('RECE_COMPANY_CODE')).setValue(Sepoa.info.COMPANY_CODE);
            gridObj.cells(maxRowId, gridObj.getColIndexById('GIVE_USER_ID')).setValue(Sepoa.info.ID);
            gridObj.cells(maxRowId, gridObj.getColIndexById('GIVE_USER_NAME')).setValue(Sepoa.info.NAME_LOC);
            gridObj.showRow(maxRowId);
        ]]>
        </function>
        <function name="copyRow" args="grid">
        <![CDATA[
            var selectedRow = gridObj.getSelectedRows("SELECTED");
            if (selectedRow.length < 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.9999'));
            }
            var maxRowId = gridObj.getRowsNum();
            for (var i = 0; i < selectedRow.length; i++) {
                gridObj.addRow(++maxRowId, '', gridObj.getRowsNum());
                gridObj.copyRowContent(selectedRow[i], maxRowId);
                gridObj.cells(selectedRow[i], gridObj.getColIndexById('DELEGATION_KEY')).setValue("");
                gridObj.cells(selectedRow[i], gridObj.getColIndexById('SELECTED')).cell.wasChanged = false;
                gridObj.cells(selectedRow[i], gridObj.getColIndexById('SELECTED')).setValue("0");
            }
            gridObj.showRow(maxRowId);
        ]]>
        </function>
        <function name="doDelete" args="">
        <![CDATA[
            gridObj.editStop();
            var selectedRows = gridObj.getSelectedRows('SELECTED');
            if (selectedRows.length < 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.1004'));
                return;
            }
            Confirm(Sepoa.cache.text.get('MESSAGE.1015'), function(result) {
                if (result) {
                    ///dataOutput.addScreen('MG_003_1');
                    gridObj.postTransaction(window.CONTEXT_NAME+'/SepoaGrid.sux', ['mode=doSave', 'METHOD=doDelete', 'PROCESS_ID=sepoa.svc.approval.SepoaApprovalService'], "SELECTED");
                }
            });
        ]]>
        </function>
        <function name="doQuery" args="">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery','PROCESS_ID=sepoa.svc.approval.SepoaApprovalService','METHOD=doQueryDelegation']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="obj, count">
        <![CDATA[
            var msg = obj.getUserData("", "message");
            var status = obj.getUserData("", "status");
            if (status == "false") {
                Alert(msg);
            }
            
            for (var i = 1; i < count + 1; i++) {
                gridObj.cells(i, gridObj.getColIndexById('ADD_DATE')).setDisabled(true);
            }
        ]]>
        </function>
        <function name="doSave" args="">
        <![CDATA[
            gridObj.editStop();
            
            if (!gridObj.validate("SELECTED")) {
                Alert(Sepoa.cache.text.get('MESSAGE.0002')); 
                return;
            }
            
            var selectedRows = gridObj.getSelectedRows('SELECTED');
            if (selectedRows.length < 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.1004')); 
                return;
            } else if (!gridObj.validate("SELECTED")) {
                Alert(Sepoa.cache.text.get('MESSAGE.0002')); 
                return;
            }
            for (var i = 0; i < gridObj.getRowsNum(); i++) {
                var start_date = gridObj.cells(gridObj.getRowId(i), gridObj.getColIndexById("START_DATE")).getValue();
                var end_date = gridObj.cells(gridObj.getRowId(i), gridObj.getColIndexById("END_DATE")).getValue();
                if (start_date > end_date) {
                    Alert((i + 1) + Sepoa.cache.text.get('MG_003_1.DATE_ERROR'));
                    return;
                }
            }
            Confirm(Sepoa.cache.text.get('MESSAGE.1018'), function(result) {
                if (result) {
                    gridObj.postTransaction(window.CONTEXT_NAME+'/SepoaGrid.sux', ['mode=doSave', 'METHOD=doDelegation', 'PROCESS_ID=sepoa.svc.approval.SepoaApprovalService'], "SELECTED");
                }
            });
        ]]>
        </function>
        <function name="doSaveEnd" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if (status == 'true') {
                Alert(message);
                doQuery();
            } else {
                Alert(message);
            }
        ]]>
        </function>
        <function name="onEditCell" args="stage, rId, cInd, nValue, oValue">
        <![CDATA[
            var header = gridObj.getColumnId(cInd);
            selected_rId = rId;
            if (stage == 0) {
                return true;
            } else if (stage == 1) {
                return true;
            } else if (stage == 2) {
                var call_type = 'G'; //F:form,G:grid
                if (header == 'GIVE_COMPANY_CODE') {
                    gridObj.cells(selected_rId, gridObj.getColIndexById('GIVE_USER_ID')).setValue("");
                    gridObj.cells(selected_rId, gridObj.getColIndexById('GIVE_USER_NAME')).setValue("");
                }
                if (header == 'RECE_COMPANY_CODE') {
                    gridObj.cells(selected_rId, gridObj.getColIndexById('RECE_USER_ID')).setValue("");
                    gridObj.cells(selected_rId, gridObj.getColIndexById('RECE_USER_NAME')).setValue("");
                }
                return true;
            }
            return false;
        ]]>
        </function>
        <function name="onRowSelect" args="rId, cInd">
        <![CDATA[
            var header = gridObj.getColumnId(cInd);
            selected_rId = rId;
            if (!gridObj.cells(rId, gridObj.getColIndexById('MAND_TYPE')).isDisabled()) {
                var house_code = gridObj.cells(selected_rId, gridObj.getColIndexById('HOUSE_CODE')).getValue();
                if (header == 'GIVE_SEARCH_IMG') { //
                    var give_company_code = gridObj.cells(selected_rId, gridObj.getColIndexById('GIVE_COMPANY_CODE')).getValue();
                    if (give_company_code != "") {
                        PopupCommonPost('SP0019', setGiveUserToGrid, [Sepoa.info.HOUSE_CODE, give_company_code, '', '']);
                    }
                } else if (header == 'RECE_SEARCH_IMG') { //대리결재자 클릭시 
                    var rece_company_code = gridObj.cells(selected_rId, gridObj.getColIndexById('RECE_COMPANY_CODE')).getValue();
                    if (rece_company_code != "") {
                        PopupCommonPost('SL0055', setReceUserToGrid, [Sepoa.info.HOUSE_CODE, rece_company_code]);
                    }
                }
            }
        ]]>
        </function>
        <function name="onSearch" args="flag">
        <![CDATA[
            if (flag == "filter") {
                doQuery();
            } else if (flag == "search") {
                doQuery();
            }
        ]]>
        </function>
        <function name="setGiveUserToGrid" args="code, name">
        <![CDATA[
            gridObj.cells(selected_rId, gridObj.getColIndexById('GIVE_USER_ID')).setValue(code);
            gridObj.cells(selected_rId, gridObj.getColIndexById('GIVE_USER_NAME')).setValue(name);
        ]]>
        </function>
        <function name="setReceUserToGrid" args="code, name">
        <![CDATA[
            gridObj.cells(selected_rId, gridObj.getColIndexById('RECE_USER_ID')).setValue(code);
            gridObj.cells(selected_rId, gridObj.getColIndexById('RECE_USER_NAME')).setValue(name);
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
    </template>
</body>