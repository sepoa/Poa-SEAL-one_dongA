<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="SLM_201_EXTRA" header="false" pageCloseWarn="false">
    <form id="formObj" div="f15037d94b6b43648df02f1a1476c7" form-id="SLM_201_EXTRA"/>
    <button id="a0ce35ed21294cda87b2f122526e64">
        <btn div="a0ce35ed21294cda87b2f122526e64" id="save" type="save" text="{BUTTON.save}" onclick="onButtonClick( 'save' )"/>
        <btn div="a0ce35ed21294cda87b2f122526e64" id="cancel" type="default" text="{BUTTON.cancel}" onclick="onButtonClick( 'back' )"/>
    </button>
    <onloadscript>
    	<call name="init"/>
    </onloadscript>
    <userscript>
    <var name="smrNumber"/>
        <function name="init">
        <![CDATA[
        	if(Sepoa.request.SMR_NUMBER){
        		smrNumber = Sepoa.request.SMR_NUMBER;
        	};
        	
        	doQuery(smrNumber);
        ]]>
        </function>
        <function name="onButtonClick" args="id">
        <![CDATA[
			switch (id.toUpperCase()) {
                case 'SAVE':
                	doSave();
                    break;
            
                case 'BACK':
                	doBack();
                    break;
            }
        ]]>
        </function>
        <function name="doSave" args="id">
        <![CDATA[
        	dataOutput.setValue("SMR_NUMBER", smrNumber);
			    Confirm(Sepoa.cache.text.get('MESSAGE.1018'),function(result){
			        if(result){
			            doServiceAjax('sepoa.svc.seal.cbo.SepoaReqSealExtrainfo','TRANSACTION','doSaveExtrainfo', null, function(so){
			                if (so.status == 1) {
			                    Alert(Sepoa.cache.text.get('MESSAGE.1022'));
			                    Sepoa.params.callback();
                    			selfObj.close();
			                } else {
			                    Alert(formResult.message);
			                    return;
			                }
			            });
			        }
			    });
        ]]>
        </function>
        <function name="doQuery" args="smrNumber">
        <![CDATA[
			doServiceAjax('sepoa.svc.seal.cbo.SepoaReqSealExtrainfo','CONNECTION','doQueryExtrainfo', {
				SMR_NUMBER :smrNumber
			 }, function(so){
				 if(so.result.length > 0) {
				 	const sf = new SepoaFormater(so.result[0]);
				 	const result = sf.getArrayMap()[0];
				 	if(result.DATA) {
				 		try {
				 			const formData = JSON.parse(result.DATA);
				 			formObj.dataMapper(formData, 'json');
				 		} catch(e){
				 			console.log(e)
				 		}
				 	}
				 }
			});
        ]]>
        </function>
        <function name="doBack" args="id">
        <![CDATA[
                    Sepoa.params.callback();
                    selfObj.close();
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
    </template>
</body>