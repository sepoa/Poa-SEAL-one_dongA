<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="SLM_121" header="false">
    <filterbar id="filterObj" div="roVGwmetGgGwmewhNY">
        <!-- <calendar id="F_CALENDAR" button="year:0,month:0,week:-4,day:0" default="week:-4"/> -->
        <status id="SEAL_STATUS" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#SM005"/>
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <button id="btnObj">
        <btn div="roVGwmesEmGwmenYjL" id="DETAIL" text="{SLM_121.BTN_DETAIL}" onclick="onButtonClick( 'DETAIL' )"/>
        <btn div="roVGwmesEmGwmenYjL" id="SAVE" text="{SLM_121.BTN_SAVE}" onclick="onButtonClick( 'SAVE' )"/>
        <btn div="roVGwmesEmGwmenYjL" id="NEW" text="{SLM_121.BTN_NEW}" onclick="onButtonClick( 'NEW' )"/>
        <btn div="roVGwmesEmGwmenYjL" id="EDIT" text="{SLM_121.BTN_EDIT}" onclick="onButtonClick( 'EDIT' )"/>
        <btn div="roVGwmesEmGwmenYjL" id="UPDATE" text="{SLM_121.BTN_UPDATE}" onclick="onButtonClick( 'UPDATE' )"/>
    </button>
    <grid id="gridObj" div="roVGwmeHgVHwmevoVQ" grid-id="SLM_121" drag="false" merge="false" dynamic="false">
        <event type="onRowSelectSync" callback="onRowSelect"/>
        <event type="onEditCell" callback="onEditCell"/>
        <event type="onXLE" callback="onXLE"/>
        <event type="onTXE" callback="onTXE"/>
    </grid>
    <variable>
        <var name="cnIPdtepOLPdteRfxU" value="$($sObject._vp).find('#cnIPdtepOLPdteRfxU')[0]"/>
        <var name="cnIPdtehzMPdtejlTz" value="$($sObject._vp).find('#cnIPdtehzMPdtejlTz')[0]"/>
        <var name="cnIPdtepOLPdtetJKz" value="$($sObject._vp).find('#cnIPdtepOLPdtetJKz')[0]"/>
    </variable>
    <onloadscript>
        <![CDATA[
            doQuery();
            btnInitSetting();
        ]]></onloadscript>
    <userscript>
        <var name="$sealManagerProfile" value="Sepoa.config.get('sepoa.seal.manager.porfile.code').toUpperCase()"/>
        <var name="$systemManagerProfile" value="Sepoa.config.get('sepoa.system.manager.profile.code').toUpperCase()"/>
        <function name="btnInitSetting" args="">
        <![CDATA[
        	hideAllBtn();
        	var userProfileCode = Sepoa.info.MENU_PROFILE_CODE;
        	
            if (Sepoa.info.CTRL_CODE.indexOf('MANAGE_CONFIRM') > -1) {//인감책임자
                btnObj.btn('NEW').setShow();
                btnObj.btn('UPDATE').setShow();
                btnObj.btn('SAVE').setShow();
            }else if(userProfileCode == $systemManagerProfile){//시스템관리자
            	btnObj.btn('NEW').setShow();
            	btnObj.btn('EDIT').setShow();
            	btnObj.btn('SAVE').setShow();
            }
        ]]>
        </function>
        <function name="doQuery" args="">
        <![CDATA[
            //인감관리자의 경우 자기가 관리하는 인감만 조회
            if ($sealManagerProfile.split(',').indexOf(Sepoa.info.MENU_PROFILE_CODE.toUpperCase()) > -1) {
                dataOutput.setValue('SEAL_MG_USER_ID', Sepoa.info.ID);
            }
            
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.seal.SepoaSealManagementService', 'METHOD=doSealList']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="onButtonClick" args="name">
        <![CDATA[
            switch (name) {
                case "DETAIL":
                    doDetail();
                    break;
                case "SAVE":
                    doSave();
                    break;
                case "NEW":
                    doNew();
                    break;
                case "EDIT":
                	doEdit();
                	break;
                case "UPDATE":
                	doUpdate();
                	break;    
                default:
                    break;
            }
        ]]>
        </function>
        <function name="doEdit" args="">
        <![CDATA[
        	var selectedRows = gridObj.getSelectedRows('SELECTED');
            var rowCount = gridObj.getSelectedRows('SELECTED').length;
            
            if (rowCount == 0) {
                Alert(Sepoa.cache.text.get('MESSAGE.1004')); //선택된 데이터가 없습니다.
                return;
            }
            
            if (rowCount > 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.1006'));//하나 이상 선택할 수 없습니다.
                return;
            }
            
            var sealStatus = gridObj.cells(selectedRows[0], gridObj.getColIndexById("SEAL_STATUS")).getValue();
            if(sealStatus != 'C'){
            	Alert(Sepoa.cache.text.get('MESSAGE.CHECK_THE_STATUS')); //상태가 등록인 인감만 변경이 가능합니다.
                return;
            }
            
            var manageNo = gridObj.cells(selectedRows[0], gridObj.getColIndexById("MANAGE_NUMBER")).getValue();
            
            callFunction('SLM_122', 'setUpdate', [manageNo]);     
            callFunction('SLM_122', 'changeHeaderText', ['a', Sepoa.cache.text.get('SLM_121.BTN_EDIT')]);
        	callFunction(['p', 'p'], 'changeCell', ['SLM_122']);
        ]]>
        </function>
        <function name="doUpdate" args="">
        <![CDATA[
            var selectedRows = gridObj.getSelectedRows('SELECTED');
            var rowCount = gridObj.getSelectedRows('SELECTED').length;
            
            if (rowCount == 0) {
                Alert(Sepoa.cache.text.get('MESSAGE.1004')); //선택된 데이터가 없습니다.
                return;
            }
            
            if (rowCount > 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.1006'));//하나 이상 선택할 수 없습니다.
                return;
            }
            
            var sealStatus = gridObj.cells(selectedRows[0], gridObj.getColIndexById("SEAL_STATUS")).getValue();
            if(sealStatus != 'C'){
            	Alert(Sepoa.cache.text.get('MESSAGE.CHECK_THE_STATUS')); //상태가 등록인 인감만 변경이 가능합니다.
                return;
            }
            
            var manageNo = gridObj.cells(selectedRows[0], gridObj.getColIndexById("MANAGE_NUMBER")).getValue();
            
            callFunction('SLM_132', 'setUpdateMode', [manageNo]);
            callFunction('SLM_122', 'changeHeaderText', ['a', Sepoa.cache.text.get('SLM_121.BTN_UPDATE')]);              
        	callFunction(['p', 'p'], 'changeCell', ['SLM_132']);
        ]]>
        </function>        
        <function name="doDetail" args="id">
        <![CDATA[
            var manageNo = gridObj.cells(id, gridObj.getColIndexById("MANAGE_NUMBER")).getValue();
            
            callFunction('SLM_122', 'setModeSeal', [manageNo]);
            callFunction('SLM_122', 'changeHeaderText', ['a', Sepoa.cache.text.get('SLM_121.BTN_DETAIL')]);
            callFunction(['p', 'p'], 'changeCell', ['SLM_122']);
        ]]>
        </function>
        <function name="doSave" args="">
        <![CDATA[
            var selectedRows = gridObj.getSelectedRows('SELECTED');
            var rowCount = gridObj.getSelectedRows('SELECTED').length;
            
            if (rowCount == 0) {
                Alert(Sepoa.cache.text.get('MESSAGE.1004')); //선택된 데이터가 없습니다.
                return;
            }
            
            var statusArr = [];
            for (var i = 0; i < selectedRows.length; i++) {
                statusArr.push(gridObj._getRowData(selectedRows[i]).SEAL_STATUS);
            }
            
            var stausFlag = statusArr.every(function(status) {
                return status == 'C';
            });
            
            if (!stausFlag) {
                Alert(Sepoa.cache.text.get('SLM_121.MESSAGE001'));
                return;
            }
            
            Confirm(Sepoa.cache.text.get('MESSAGE.1018'), function(result) {
                if (result) {
                    gridObj.editStop();
                    gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.seal.SepoaSealManagementService', 'METHOD=doSealFlagUpdateService'], 'SELECTED');
                }
            });
        ]]>
        </function>
        <function name="doNew" args="">
        <![CDATA[
            callFunction('SLM_123', 'setModeByStatus', ['NEW_RM'])
            callFunction('SLM_122', 'changeHeaderText', ['a', Sepoa.cache.text.get('SLM_121.BTN_NEW')]);
            callFunction(['p', 'p'], 'changeCell', ['SLM_122']);
        ]]>
        </function>
        <function name="onRowSelect" args="id, ind">
        <![CDATA[
        	let coverProgress = false;	// 더블클릭 방지용 프로그레스 모달을 켰는지
        	
            var subjectColumn = gridObj.getColIndexById("SUBJECT");
            var electronFlag = gridObj.getColIndexById("ELECTRON_FLAG");
            var realFlag = gridObj.getColIndexById("REAL_FLAG");
            var externalFlag = gridObj.getColIndexById("EXTERNAL_FLAG");
            
            var selectedColumn = gridObj.getColIndexById('SELECTED');
            var isChecked = gridObj.cells(id, selectedColumn).isChecked();
            
            if (ind == subjectColumn) {
            	sUtils.progress.on();
            	coverProgress = true;
                doDetail(id);
            }
            
            if (coverProgress) { setTimeout(function() { sUtils.progress.off();}, 100);}
        ]]>
        </function>
        <function name="onEditCell" args="stage, rId, cInd">
        <![CDATA[
            var header = gridObj.getColumnId(cInd);
            var sealType = gridObj.cells(rId, gridObj.getColIndexById("SEAL_TYPE")).getValue();
            var sealStatus = gridObj.cells(rId, gridObj.getColIndexById("SEAL_STATUS")).getValue();
            
            if (header == 'ELECTRON_FLAG' || header == 'REAL_FLAG' || header == 'EXTERNAL_FLAG') {
                if (sealStatus != "C") {
                    return false;
                }
                if (sealType == "C" && header == 'EXTERNAL_FLAG'){
                    return false;                
                }
                if (sealType == "E" && header == 'EXTERNAL_FLAG'){
                    return false;
                }
            }
            
            if (stage == 0) {
                return true;
            }
            return false;
        ]]>
        </function>
        <function name="onXLE" args="obj, count">
        <![CDATA[
            if (count == 0) {
                Alert(Sepoa.cache.text.get('MESSAGE.1001'));
                return;
            }
        ]]>
        </function>
        <function name="onTXE" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if (status == "true") {
                Alert(Sepoa.cache.text.get('MESSAGE.0001'));
                doQuery();
            } else {
                Alert(message);
            }
        ]]>
        </function>
        <function name="onSearch" args="">
        <![CDATA[
            doQuery();
        ]]>
        </function>
        <function name="hideAllBtn" args="">
        <![CDATA[
            btnObj.forEachBtn(function(id) {
                btnObj.btn(id).setHide();
            })
        ]]>
        </function>        
    </userscript>
