<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="SLM_261" header="false">
    <filterbar id="filterObj" div="dcQiupeALZiupefwLm">
        <calendar id="F_CALENDAR" button="year:0,month:0,week:-12,day:0" default="week:-12"/>
        <keyword id="F_KEYWORD"/>
        <filter>
            <option id="REQ_DOC_TYPE" type="select" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#SLM_261_1"/>
            <option id="REQ_USE_FLAG" type="flag"/>
            <option id="REQ_DATE" type="calendar"/>
        </filter>
        <event type="onSearch" callback="doQuery"/>
    </filterbar>
    <button id="btnObj">
        <btn div="dcQiupeBkZiupeEOvR" id="addrow" type="default" text="{BUTTON.rowadd}" toggle="false" reverse="false" onclick="onButtonClick( 'ADDROW' )"/>
        <btn div="dcQiupeBkZiupeEOvR" id="save" type="default" text="{BUTTON.save}" toggle="false" reverse="false" onclick="onButtonClick( 'SAVE' )"/>
        <btn div="dcQiupeBkZiupeEOvR" id="delete" type="default" text="{BUTTON.delete}" toggle="false" reverse="false" onclick="onButtonClick( 'DELETE' )"/>
    </button>
    <grid id="gridObj" div="AKghupenozjrGbRYJr" grid-id="SLM_260" drag="false" merge="false" dynamic="false">
        <event type="onRowSelect" callback="onRowSelect"/>
        <event type="onTXE" callback="doSaveEnd"/>
        <event type="onXLE" callback="onXLE"/>
    </grid>
    <variable>
        <var name="dcQiupejhViupeaaJh" value="$($sObject._vp).find('#dcQiupejhViupeaaJh')[0]"/>
        <var name="dcQiupekrXiupeqFOX" value="$($sObject._vp).find('#dcQiupekrXiupeqFOX')[0]"/>
        <var name="dcQiupejhViupeOShu" value="$($sObject._vp).find('#dcQiupejhViupeOShu')[0]"/>
    </variable>
    <onloadscript>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <function name="doQuery">
        <![CDATA[
        	gridObj.setColumnHidden(gridObj.getColIndexById('REAL_DOC_FLAG'), true);
        	gridObj.setColumnHidden(gridObj.getColIndexById('ELEC_DOC_FLAG'), true);
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'METHOD=doSelectCorpAttachDocHeader', 'PROCESS_ID=sepoa.svc.seal.SepoaReqSealService']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="onButtonClick" args="id">
        <![CDATA[
            if (id == 'ADDROW') {
                doAddRow();
            } else if (id == 'SAVE') {
                doSave();
            } else if (id == 'DELETE') {
                doDelete();
            }
        ]]>
        </function>
        <function name="doAddRow">
        <![CDATA[
            var maxRowId = dhx4.newId();
            var sdNumber = getDocumentNumber("SMI");
            gridObj.addRow(maxRowId, '', gridObj.getRowsNum());
            gridObj.cells(maxRowId, gridObj.getColIndexById('REAL_DOC_FLAG')).setValue("1");
            gridObj.cells(maxRowId, gridObj.getColIndexById('USE_FLAG')).setValue("1");
            gridObj.cells(maxRowId, gridObj.getColIndexById('SMI_NUMBER')).setValue(sdNumber);
            gridObj.showRow(maxRowId);
        ]]>
        </function>
        <function name="doSave">
        <![CDATA[
            var selectedRows = gridObj.getGridChangedRows("SELECTED");
            if (selectedRows.length < 1) {
                Alert(Sepoa.cache.text.get('SLM_260.MESSAGE_SELECT_ROW'));
                return;
            }
            
            if (!gridObj.validate()) {
                return;
            }
            
            if (!docFlagChk()) {
                return;
            }
            
            Confirm(Sepoa.cache.text.get('MESSAGE.1018'), function(result) {
                if (result) {
                    gridObj.editStop();
                    gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'METHOD=doSaveCorpAttachDocHeader', 'PROCESS_ID=sepoa.svc.seal.SepoaReqSealService'], 'SELECTED');
                }
            });
        ]]>
        </function>
        <function name="docFlagChk" args="">
        <![CDATA[
        	var selectedRow = gridObj.getGridChangedRows("SELECTED");
        	for (var i = selectedRow.length - 1; i == 0; i--) {
                var r_doc_val = gridObj.cells(selectedRow[i], gridObj.getColIndexById('REAL_DOC_FLAG')).getValue();
                var e_doc_val = gridObj.cells(selectedRow[i], gridObj.getColIndexById('ELEC_DOC_FLAG')).getValue();
                var start_val = gridObj.cells(selectedRow[i], gridObj.getColIndexById('START_DATE')).getValue();
                var end_val   = gridObj.cells(selectedRow[i], gridObj.getColIndexById('END_DATE')).getValue();
                
                if (r_doc_val == "0" && e_doc_val == "0") {
                    Alert(Sepoa.cache.text.get('SLM_261.CHOICE_DOC_FLAG'));// 실물, 전자교부 둘중 하나 이상 선택해주세요
                    return false;
                }
                
                if(start_val >= end_val){
                	Alert(Sepoa.cache.text.get('MESSAGE.MSG_1002')); // 날짜 입력이 잘못되었습니다.
                	return false;                	
                }
            }
            
            return true;
        ]]>
        </function>
        <function name="doDelete">
        <![CDATA[
            var selectedRow = gridObj.getGridChangedRows("SELECTED");
            for (var i = selectedRow.length - 1; i >= 0; i--) {
                var a = gridObj.cells(selectedRow[i], gridObj.getColIndexById('SMI_NUMBER')).getValue();
                if (a == "") {
                    gridObj.deleteRow(selectedRow[i]);
                }
            }
            if (gridObj.getGridChangedRows("SELECTED").length > 0 && Confirm(Sepoa.cache.text.get('MESSAGE.1015'), function(result) {
                    if (result) {
                        gridObj.editStop();
                        gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.seal.SepoaReqSealService', 'METHOD=doDeleteCorpAttachDocHeader'], 'SELECTED');
                    }
                }));
        ]]>
        </function>
        <function name="doSaveEnd" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if (status == 'true') {
                Alert(message);
                Sepoa.cache.combo.clear();
                doQuery();
            } else {
                Alert(message);
            }
        ]]>
        </function>
        <function name="onSearch" args="flag">
        <![CDATA[
            if (flag == "filter") {} else if (flag == "search") {}
        ]]>
        </function>
        <function name="onRowSelect" args="id, ind">
        <![CDATA[
            var header = this.getColumnId(ind);
            
            if (header == "ATTACH_IMG") { //교부서류 클릭시
                var attKey = gridObj.cells(id, gridObj.getColIndexById("ATTACH_NO")).getValue();
                doAttachFile(id, attKey);
            }
        ]]>
        </function>
        <function name="doAttachFile" args="id, attach_key">
        <![CDATA[
            var type = "smi_doc";
            var mode = "";
            //var limit = 1; // 첨부파일 갯수 제한
            
            vaultPopup({
                attach_key: attach_key,
                type: type,
                mode: mode,
                callback: setAttach_callback,
                rowId: id
            });
        ]]>
        </function>
        <function name="setAttach_callback" args="e, a, r">
        <![CDATA[
            if (e.fileCount > 0) {
                gridObj.cells(r.rowId, gridObj.getColIndexById("ATTACH_NO")).setValue(e.attach_key);
                gridObj.cells(r.rowId, gridObj.getColIndexById('ATTACH_IMG')).cell.style.filter = '';
                gridObj.cells(r.rowId, gridObj.getColIndexById('ATTACH_IMG')).setIcon('ATTACH_IMG2');
                gridObj.cells(r.rowId, gridObj.getColIndexById('ATTACH_IMG')).cell.children[0].style = 'filter:none';
            } else {
                gridObj.cells(r.rowId, gridObj.getColIndexById("ATTACH_NO")).setValue('');
                gridObj.cells(r.rowId, gridObj.getColIndexById('ATTACH_IMG')).cell.children[0].style = '';
            }
        ]]>
        </function>
        <function name="onXLE" args="obj, count">
        <![CDATA[
            if (count == 0) {
                Alert(Sepoa.cache.text.get('MESSAGE.1001'));
                return;
            } else {
            	for (var i = 0; i < gridObj.getRowsNum(); i++) {
            		gridObj.cells(i+1, gridObj.getColIndexById('DOC_TYPE')).setDisabled(true);
	            	if (gridObj.cells(i+1, gridObj.getColIndexById('ATTACH_NO')).getValue() != '') {
	                    gridObj.cells(i+1, gridObj.getColIndexById('ATTACH_IMG')).setIcon('ATTACH_IMG2');
	                    gridObj.cells(i+1, gridObj.getColIndexById('ATTACH_IMG')).cell.children[0].style = 'filter:none';
	                }
            	}
            }
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
    </template>
</body>