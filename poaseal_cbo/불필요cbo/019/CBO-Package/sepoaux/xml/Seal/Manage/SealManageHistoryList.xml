<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="SLM_611" header="false" pageCloseWarn="false">
    <filterbar id="filterObj" div="roVGwmetGgGwmewhNY">
        <calendar id="F_CALENDAR" button="year:0,month:0,week:-4,day:0" default="week:-4"/>
        <keyword id="F_KEYWORD"/>
        <filter>
            <option id="SEAL_TYPE" type="select" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#SM001_2"/>
            <option id="AFFILIATED_COMPANY" type="select" combo="AD1020,{HOUSE_CODE}"/>
        </filter>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <button id="btnObj"/>
    <grid id="gridObj" div="roVGwmeHgVHwmevoVQ" grid-id="SLM_611" drag="false" merge="false" dynamic="false" exceldownload="true">
        <event type="onXLE" callback="onXLE"/>
        <event type="onTXE" callback="onTXE"/>
    </grid>
    <variable>
        <var name="cnIPdtepOLPdteRfxU" value="$($sObject._vp).find('#cnIPdtepOLPdteRfxU')[0]"/>
        <var name="cnIPdtehzMPdtejlTz" value="$($sObject._vp).find('#cnIPdtehzMPdtejlTz')[0]"/>
        <var name="cnIPdtepOLPdtetJKz" value="$($sObject._vp).find('#cnIPdtepOLPdtetJKz')[0]"/>
    </variable>
    <onloadscript>
        <![CDATA[
        	if(Sepoa.info.MASTER_COMPANY_FLAG == 'Y' && Sepoa.info.MENU_PROFILE_CODE == Sepoa.config.get('sepoa.system.manager.profile.code')){
            	filterObj.setShow('AFFILIATED_COMPANY');
            } else{
            	filterObj.setHide('AFFILIATED_COMPANY');
            }
            doQuery();
        ]]></onloadscript>
    <userscript>
        <var name="$sealManagerProfile" value="Sepoa.config.get('sepoa.seal.manager.porfile.code').toUpperCase()"/>
        <var name="$systemManagerProfile" value="Sepoa.config.get('sepoa.system.manager.profile.code').toUpperCase()"/>
        <function name="doQuery" args="">
        <![CDATA[
            //인감관리자의 경우 자기가 관리하는 인감만 조회
            if ($sealManagerProfile.split(',').indexOf(Sepoa.info.MENU_PROFILE_CODE.toUpperCase()) > -1) {
                dataOutput.setValue('SEAL_MG_USER_ID', Sepoa.info.ID);
            }
            
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.seal.SepoaSealManagementService', 'METHOD=doSealHistoryList']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="onXLE" args="obj, count">
        <![CDATA[
            if (count == 0) {
                return;
            }
        ]]>
        </function>
        <function name="onTXE" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if (status == "true") {
                Alert(Sepoa.cache.text.get('MESSAGE.0001'));
                doQuery();
            } else {
                Alert(message);
            }
        ]]>
        </function>
        <function name="onSearch" args="">
        <![CDATA[
            doQuery();
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
    </template>
</body>