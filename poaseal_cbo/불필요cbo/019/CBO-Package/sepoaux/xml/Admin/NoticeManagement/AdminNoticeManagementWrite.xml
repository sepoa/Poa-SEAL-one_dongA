<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_201_2" header="false" pageCloseWarn="false" dataStore="false">
    <link>
    <![CDATA[
        <script type="text/javascript" src="<%=CONTEXT_NAME%>/resource/plugin/tinymce/tinymce.min.js"></script>
        <script src="<%=CONTEXT_NAME%>/resource/plugin/tinymce/webeditor.js" type="text/javascript"></script>
    ]]>
    </link>
    <button id="btnObj">
        <btn div="YNCHbTbUiWVIEfgHQf" id="new" type="new" text="{BUTTON.new}" onclick="doNew(  )"/>
        <btn div="YNCHbTbUiWVIEfgHQf" id="update" type="save" text="{BUTTON.update}" onclick="changeMode( 'insert' )"/>
        <btn div="YNCHbTbUiWVIEfgHQf" id="delete" type="delete" text="{BUTTON.delete}" onclick="doDelete(  )"/>
        <btn div="YNCHbTbUiWVIEfgHQf" id="cancel" text="{BUTTON.cancel}" onclick="doCancel(  )"/>
        <btn div="YNCHbTbUiWVIEfgHQf" id="save" type="save" text="{BUTTON.save}" onclick="doSave(  )"/>
    </button>
    <form id="formObj" div="YNCHbTbsqMVIEfgmaj" form-id="AD_201">
        <event type="onUploadFile" callback="attach_callback"/>
        <event type="onButtonClick" callback="onButtonClick"/>
    </form>
    <usercss>
    <![CDATA[
        .sepoa-editor-wrapper {
            height: 100%;
            width: 100%;
            position: relative;
            display: block;
        }
        
        #EDITOR_AREA {
            height: 100%;
            width: 100%;
        }
    ]]>
    </usercss>
    <onloadscript>
        <call name="createEditorArea"/>
        <call name="initTinyMCE" args="'#EDITOR_AREA', mceloadend, Sepoa.info.LANGAUGE"/>
        <var name="cnt" value="'0'"/>
        <var name="text_cnt" value="0"/>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <function name="init" args="">
        <![CDATA[
            if (Sepoa.info.MASTER_COMPANY_FLAG != 'Y') {
                formObj.hideItem("COMPANY_NAME");
                formObj.hideItem("AFFILIATED_COMPANY");
                formObj.hideItem("AFFILIATED_COMPANY_LIST");
            
            }
            
            var parDiv = document.querySelector('.dhx_vault_material');
            parDiv.style.marginTop = '5px';
            
            var label = document.createElement('label');
            
            var files = Sepoa.config.get('sepoa.attach.maxsize');
            
            label.textContent = '첨부파일은 ' + files + 'MB까지 업로드 가능합니다.';
            
            parDiv.parentNode.insertBefore(label, parDiv);
        ]]>
        </function>
        <function name="attach_callback" args="n, e, a, param">
        <![CDATA[
            dataOutput.setValue("ATTACH_NO", e.attach_key);
        ]]>
        </function>
        <function name="changeMode" args="mode">
        <![CDATA[
            btnObj.showButton(null, false)
            if (mode == 'view') {
                tinyMCE.activeEditor.setMode("readonly")
                formObj.setViewMode(true);
                formObj.hideItem("COMPANY_NAME");
                formObj.hideItem("AFFILIATED_COMPANY");
                formObj.hideItem("AFFILIATED_COMPANY_LIST");
                formObj.showItem('NOTICE_NUMBER');
                btnObj.showButton('new,update,delete', true)
            } else {
                tinyMCE.activeEditor.setMode("code");
                formObj.setViewMode(false);
                if (Sepoa.info.MASTER_COMPANY_FLAG != 'Y') {
                    formObj.hideItem("COMPANY_NAME");
                    formObj.hideItem("AFFILIATED_COMPANY");
                    formObj.hideItem("AFFILIATED_COMPANY_LIST");
                } else {
                    formObj.showItem("COMPANY_NAME");
                    formObj.showItem("AFFILIATED_COMPANY");
                    formObj.showItem("AFFILIATED_COMPANY_LIST");
                }
                formObj.hideItem('NOTICE_NUMBER');
                btnObj.showButton('save,cancel', true)
            }
        ]]>
        </function>
        <function name="clearForm" args="">
        <![CDATA[
            formObj.clear();
        ]]>
        </function>
        <function name="doNew" args="">
        <![CDATA[
            clearForm();
            tinyMCE.activeEditor.setContent('');
            changeMode('insert');
        ]]>
        </function>
        <function name="doCancel" args="">
        <![CDATA[
            setData();
            changeMode('view')
        ]]>
        </function>
        <function name="doDelete" args="">
        <![CDATA[
            if (!formObj.getValue('NOTICE_NUMBER')) {
                Alert(Sepoa.cache.text.get('AD_201.MESSAGE0003'));
                return;
            }
            
            doServiceAjax('sepoa.svc.admin.AD_201', 'TRANSACTION', 'doDelete', null, function(so) {
                if (so.status == 1) {
                    clearForm();
                    tinyMCE.activeEditor.setContent('');
                    //vaultObj.setAttachKey();
                    changeMode('view');
                    callFunction('AD_201_1', 'doQuery', []);
                } else {
                    Alert(so.message);
                }
            });
        ]]>
        </function>
        <function name="doQuery" args="noticeNumber">
        <![CDATA[
            if (Sepoa.info.MASTER_COMPANY_FLAG != 'Y') {
                formObj.setValue("COMPANY_CODE", Sepoa.info.COMPANY_CODE);
            }
            doServiceAjax('sepoa.svc.admin.AD_201', 'CONNECTION', 'doQuery', {
                NOTICE_NUMBER: noticeNumber
            }, function(so) {
                if (so.status == 1) {
                    changeMode('view');
                    var sf = new SepoaFormater(so.result[0]);
                    var sf2 = new SepoaFormater(so.result[1]);
                    setData(sf, sf2);
                } else {
                    Alert(so.message);
                }
            });
        ]]>
        </function>
        <function name="doSave" args="flag">
        <![CDATA[
            if (!formObj.validate() || tinyMCE.activeEditor.getContent() == '') {
                Alert(Sepoa.cache.text.get('MESSAGE.0002'));
                return;
            }
            
            if (Sepoa.info.MASTER_COMPANY_FLAG != 'Y') {
            
                dataOutput.getValue(formObj.setValue("COMPANY_CODE", Sepoa.info.COMPANY_CODE));
            }
            dataOutput.setValue("CONTENT", tinyMCE.activeEditor.getContent());
            formObj.setValue("ATTACH_NO", dataOutput.getValue('ATTACH_NO'));
            
            doServiceAjax('sepoa.svc.admin.AD_201', 'TRANSACTION', 'doSave', null, function(so) {
                if (so.status == 1) {
                    changeMode('view');
                    formObj.setValue('NOTICE_NUMBER', so.message);
                    callFunction('AD_201_1', 'doQuery', []);
                } else {
                    Alert(so.message);
                }
            });
        ]]>
        </function>
        <function name="mceloadend" args="">
        <![CDATA[
            tinymceReady = true;
            if (tinymceContent != '') {
                tinyMCE.activeEditor.setContent(tinymceContent);
            }
            
            if (formObj.getValue('NOTICE_NUMBER') != '') {
                changeMode('view');
            } else {
                changeMode('insert');
            }
            editorResize();
        ]]>
        </function>
        <function name="editorResize">
        <![CDATA[
            var f = tinyMCE.activeEditor.iframeElement;
            tinyMCE.activeEditor.iframeElement.style.height = $('.sepoa-editor-wrapper')[0].offsetHeight - f.offsetTop - 5 + "px"
        ]]>
        </function>
        <function name="setData" args="sf, sf2">
        <![CDATA[
            if (!sf) {
                sf = tempData;
                sf2 = tempContent;
            } else {
                tempData = sf;
                tempContent = sf2;
            }
            if (!sf) return;
            var c = '';
            for (var i = 0; i < sf2.getRowCount(); i++) {
                c += sf2.getValue('CONTENT', i);
            }
            c = c.replaceAll("\\\"", "\"");
            c = sUtils.string.decodeHTML(c);
            if (!tempData) {
                clearForm();
            } else {
                formObj.dataMapper(sf);
                if (!tinymceReady) {
                    tinymceContent = c;
                } else {
                    tinyMCE.activeEditor.setContent(c);
                }
            }
        ]]>
        </function>
        <function name="createEditorArea" args="">
        <![CDATA[
            var target = formObj.getContainer("EDITOR_BOX");
            if (!formObj._editorInnerBox) {
                target.style.minHeight = "100%";
                formObj._editorInnerBox = target.appendChild($('<div class="sepoa-editor-wrapper"><div id="EDITOR_AREA"></div></div>')[0]);
            }
            formObj._editorInnerBox.style.width = (formObj._editorInnerBox.offsetWidth - 2) + 'px';
            formObj._editorInnerBox.style.height = formObj._parent.offsetHeight - sUtils.element.getOffset(formObj._editorInnerBox).top + 'px'
        ]]>
        </function>
        <var name="tempContent" value="null"/>
        <var name="tempData" value="null"/>
        <var name="tinymceContent" value="''"/>
        <var name="tinymceReady" value="false"/>
        <function name="onButtonClick" args="">
        <![CDATA[
            PopupCommonPost('AD201_1', serchCompanyCallback, [Sepoa.info.HOUSE_CODE]);
        ]]>
        </function>
        <function name="serchCompanyCallback" args="companyCode">
        <![CDATA[
            formObj.setValue('COMPANY_CODE', companyCode);
            const code = [];
            const name = [];
            
            for (const item of companyCode) {
                if (item.length === 2 && typeof item[0] === 'string' && typeof item[1] === 'string') {
                    code.push(item[0]);
                    name.push(item[1]);
                }
            }
            
            
            
            dataOutput.getValue(formObj.setValue('AFFILIATED_COMPANY', name));
            dataOutput.getValue(formObj.setValue('COMPANY_CODE', code));
        ]]>
        </function>
    </userscript>
