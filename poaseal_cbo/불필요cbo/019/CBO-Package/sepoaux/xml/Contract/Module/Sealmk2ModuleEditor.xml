    <userscript>
        <var name="$share" value="{}"/>
        <function name="onReady">
        <![CDATA[
            callFunction('p', 'childScreenReady', [{
                doOpenDocument:doOpenDocument,
                doUpdateShare:doUpdateShare
            }]);
            
            if($share.config.module.CONT_MODULE == "VIEW"){
               	layoutObj.cells('a').setMinWidth(0);
                layoutObj.cells('a').setWidth(0);
            }
        ]]>
        </function>
        
        <function name="doOpenDocument" args="config">
        <![CDATA[
            $share.config = config;
            drawEditor();
            sUtils.ux.setSizes();
            doQueryImageList();
        ]]>
        </function>
        
        <function name="drawEditor">
        <![CDATA[
            $share.contObj = new SepoaContractObject(getEditorOptions());
            $share.contObj.draw();
            if($share.config.module.SMR_STATUS == "C"){
            	//$share.contObj.setWatermark("전자날인문서");
            } 
        ]]>
        </function>
        
        <function name="setScreenMode">
        <![CDATA[
            $share.contObj.setMode($share.config.module.CONT_MODULE);
        ]]>
        </function>
        
        <function name="doQueryImageList">
        <![CDATA[
        	//PDF 정보 조회로 변경필요
        	console.log($share);
        	var imageServlet = sUtils.url.toQueryString({
                module:$share.config.editor.options.SERVICE,
                action:'doImage',
                KEY : $share.config.document.DOC_DATA.KEY,
                FILE_ID:'$.{FILE_ID}',
                id:'$.{FILE_ID}__',
                ran:'$CURRENT{TIME_STRING}',
                's-token':'$CONFIG{TOKEN}'
            }, false);
            
            $share.contObj.setImageServlet(window.CONTEXT_NAME+'/SepoaActionController.sux?'+imageServlet)
        
            var config = {
                url:window.CONTEXT_NAME+'/SepoaActionController.sux',
                on:{
                    callback:function(res, config, params){
                        if(res.status == "1" && res.result){
                            for(let data of res.result[0]) {
                                data.FILE_TYPE = 'doc';
                            }
                        	if ($share.config.module.CONT_MODULE == 'VIEW') {
                            	$share.contObj.load(res.result[0], "json", true);
                            } else {
                            	$share.contObj.load(res.result[0], "json", false);
                            }
                            doDataMapping();
                        }else{
                            Alert(res.message);
                        }
                    }
                }
            }
            var params = {
            	module:$share.config.editor.options.SERVICE,
                action: "doImageList",
                CONNECTION: "CONNECTION"
            };
            params.KEY = $share.config.document.DOC_DATA.KEY,
            params.LAYER = $share.config.document.DOC_DATA.TARGET,
            params.REQ_SEAL_INFO = $share.config.document.DOC_DATA.REQ_SEAL_INFO
            
            sUtils.multipart.send(config, params);
        ]]>
        </function>
        
        <function name="doDataMapping">
        <![CDATA[
            var data = {};
            if($share.config.document.DOC_INFO_DATA){
                data.data = $.extend(true, {}, $share.config.document.DOC_ITEM, $share.config.document.DOC_INFO_DATA);
            }
            if($share.config.document.SIGNER){
                data.signer = $share.config.document.SIGNER;
            }
            
            $share.contObj.setData(data);
        ]]>
        </function>
           
        <function name="doUpdateShare" args="">
        <![CDATA[
            $share.config.document.EDITOR_HTMLS = $share.contObj.getHtml();
            
            if($share.config.editor.header){
                for(var i in $share.config.editor.header){
                    var headerItem = $share.config.editor.header[i];
                    switch(headerItem.type){
                    case "form":
                        if(!headerItem.obj.validate()){
                            Alert(sUtils.cache.text.get('POA_CONTRACT.MESSAGE_0003'));
                            return false;
                        }
                        $share.config.document.DOC_INFO_DATA = $.extend(true, {}, $share.config.document.DOC_INFO_DATA, headerItem.obj.getFormData(true));
                        break;
                    }
                }
            }
            
            if($share.config.module.WORK_TYPE == "C"){
                if(!$share.config.document.DOC_INFO_DATA){
                    $share.config.document.DOC_INFO_DATA={}
                }
                $share.config.document.DOC_INFO_DATA.SIGNER_CODE = $share.contObj.getSignNumber()
            }
            
            return true;
        ]]>
        </function>
        
        <function name="getEditorOptions">
        <![CDATA[
            $share.config.editor.options = {
                T:{
                    SERVICE:'seal'+(Sepoa.config.get('sepoa.seal.process')||'')+'.req',
                    SEAL:{
                        CONTORL:true
                    }
                }, 
                C:{
                    SERVICE:'seal'+(Sepoa.config.get('sepoa.seal.process')||'')+'.req',
                    SEAL:{
                        CONTROL:false
                    },
                    COMMON:{
                    	CONTROL:false
                    }
                }
            }[$share.config.module.WORK_TYPE];
        
        
        	var moduleItems = {
                editor:{
                    layout:"b",
                    config:{
                        mapping:{                             //if the key value of the data is different, change
                            ID:'$.{FILE_ID}__$.{PART_ID}',    //default : ID
                            IMAGE:"$.{FILE_ID}__$.{PART_ID}"                        //default : ID ; enter to use a different key
                        },
                        view: $share.config.module.CONT_MODULE == 'EDITOR' ? false : true 
                    }
                },
                preview:[{
                    layout:"c",
                    config:{
                        mapping:{		//if the key value of the data is different, change
                            ID:"$.{FILE_ID}__$.{PART_ID}",	//default : ID
                            IMAGE:"$.{FILE_ID}__$.{PART_ID}"  //default : ID ; enter to use a different key
                        },
                        dynamic:true,	//default : true
                        type:['doc']
                    }
                }]
            }
            
            if($share.config.screenType == "MOBILE"){
            	moduleItems.preview = [];
            	layoutObj.cells('c').setMinWidth(0);
                layoutObj.cells('c').setWidth(0);
            	
            }
        	var useContItem = false;
            if($share.config.module.CONT_MODULE == "EDITOR"){
                if($share.config.module.WORK_TYPE == "T"){
                    useContItem = true;    
                }   
            }
            
            if(useContItem){
	        	moduleItems=$.extend(true, moduleItems, {
                    items:{
                        layout:"a",   		//contract item draw location
                        item:{
                            service:{ 		//custom item query service
                                PROCESS_ID:"sepoa.svc.seal"+(Sepoa.config.get('sepoa.seal.process')||'')+".SepoaReqSealService",
                                METHOD:"doSelectSignItem",
                                PARAMS:{
                                    ITEM_TYPE: $share.config.module.ITEM_TYPE || 'COMMON',
                                    CATEGORY: $share.config.module.ITEM_CATEGORY || 'COMMON',
                                    VIEW_ITEMS : $share.config.module.VIEW_ITEMS || 'EDIT'
                                }
                            }
                            ,basicItem:false
                            ,title:"항목"
                            ,resizeable : {
                            	seal : false
                            }
                        },
                        extraItem:{
	                        service:{
	                            PROCESS_ID:"sepoa.svc.seal"+(Sepoa.config.get('sepoa.seal.process')||'')+".SepoaReqSealService",
	                            METHOD:"doSelectSealItem",
	                            PARAMS:{
	                                ITEM_TYPE:'SEAL',
	                                CATEGORY: 'SEAL'
	                            }
	                            ,basicItem:false
	                            ,title:"날인"
	                            ,resizeable : {
	                            	seal : false
	                            }
	                        }
	                    }
	                }
                });
	            
	            if($share.config.document.DOC_DATA.SELECT_SEAL_LIST) {
	            	moduleItems.items.extraItem = {
						data : $share.config.document.DOC_DATA.SELECT_SEAL_LIST[0]
						,title : '날인'
	            	};
	            }
	        }
            
            return {
                layout:layoutObj,
                workType:$share.config.module.WORK_TYPE,
                module:moduleItems,
                header:$share.config.editor.header
            }
        ]]>
        </function>
        <function name="doZoom" args="mode">
        <![CDATA[
        	//var $wrapper = $('.contract-editor-list-item-img');
        	var $wrapper = $('.contract-editor-list-item-wrapper');
        	$('.contract-item-layer').css('height', '100%');
        	$('.contract-item-layer').css('width', '100%');
        	
            var width = $wrapper.css('width').replace('px', '')*1;
            if (mode == 'OUT') {
            	var goalWidth = width - 120;
            	if (goalWidth <= 120) return false;
            } else {	// mode == 'IN'
            	var goalWidth = width + 120;
            	var widthLimit = $wrapper.parent().width();
            	if (widthLimit < goalWidth) return false;
            }
            $wrapper.css('width', goalWidth+'px');
            $('.contract-editor-list-item-wrapper > *').css('width', goalWidth+'px');
        ]]>
        </function>
        
        <function name="getItemsList">
        <![CDATA[
        	var itemsObj = {
        		TOTAL : {},
        		PAGES : {}
        	};
        	var keyClsStart = 'contract-item-box-code-';
        	var valClsStart = 'contract-item-box-seal-code-';
            _vp.find('.contract-item-box').each(function(idx,el) {
            	let key;
            	let val;
            	Array.from(el.classList).find(function(clsName) { 
            		if (clsName.startsWith(keyClsStart)) {
            			key = clsName.replace(keyClsStart, '');
            		} else if (clsName.startsWith(valClsStart)) {
            			val = clsName.replace(valClsStart, '');
            		}
            		if (key && val) return true;
            	});
            	if (!itemsObj.TOTAL[key]) itemsObj.TOTAL[key] = new Array();
            	itemsObj.TOTAL[key].push(val);
            	
            	let page = $(el).parents('.contract-editor-list-li').index() + 1;
            	if (!itemsObj.PAGES[page]) itemsObj.PAGES[page] = new Object();
            	if (!itemsObj.PAGES[page][key]) itemsObj.PAGES[page][key] = new Array();
            	itemsObj.PAGES[page][key].push(val);
            });
            
            return itemsObj;
        ]]>
        </function>
