<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="SLM_412" header="false">
    <filterbar id="filterObj" div="PlYzqseGQujrGbUXox">
        <calendar id="F_CALENDAR" button="year:0,month:0,week:-4,day:0" default="week:-4"/>
        <keyword id="F_KEYWORD"/>
        <filter id="F_FILTER">
            <option id="REQ_SEAL_USE_TYPE" type="select" combo="SL0047,{HOUSE_CODE}#{COMPANY_CODE}"/>
<!--             <option id="APPLY_TYPE" type="select" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#SM003"/> -->
        </filter>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <grid id="gridObj" div="PlYzqsenozjrGbRYJr" grid-id="SLM_261" drag="false" merge="false" dynamic="false">
        <event type="onRowSelect" callback="onRowSelect"/>
        <event type="onXLE" callback="doQueryEnd"/>
    </grid>
    <variable>
        <var name="jQXErseVVuErsezvOg" value="$($sObject._vp).find('#jQXErseVVuErsezvOg')[0]"/>
        <var name="jQXErseVVuErseZewI" value="$($sObject._vp).find('#jQXErseVVuErseZewI')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
    	<function name="init">
    	<![CDATA[
    		if(Sepoa.request && Sepoa.request.docType == "D") {
    			gridObj.setColumnHidden(gridObj.getColIndexById('RE_FLAG'), 1);
    			gridObj.setColumnHidden(gridObj.getColIndexById('REQ_SEAL_USE_TYPE'), 1);
    			gridObj.setColLabel(18 , '증명서 발급 이력 보고서');
    			gridObj.setColWidth(18, 140);
    			filterObj.setHide("F_FILTER");
    		}
    		doQuery();
    	]]>
    	</function>
        <function name="onSearch" args="flag">
        <![CDATA[
            doQuery();
        ]]>
        </function>
        <function name="onRowSelect" args="id, ind">
        <![CDATA[
        	let coverProgress = false;	// 더블클릭 방지용 프로그레스 모달을 켰는지
            var header = this.getColumnId(ind);
            var smrNumber = gridObj.cells(id, gridObj.getColIndexById("SMR_NUMBER")).getValue();
            let applyType = gridObj.cells(id, gridObj.getColIndexById("APPLY_TYPE")).getValue();
            if (header == 'ATTACH_IMG') {
                doOpenAuditTrailPopup(smrNumber, applyType);
            } else if (['SUBJECT'].indexOf(header) > -1){
            	sUtils.progress.on();
            	coverProgress = true;
            	let applyType = ((Sepoa.request && Sepoa.request.docType == "D") ? 'D' : 'U');
                callFunction('p', 'changeMode', [applyType, smrNumber, 'VIEW']);
            }
            
            if (coverProgress) { setTimeout(function() { sUtils.progress.off();}, 100);}
        ]]>
        </function>
        <function name="doQueryEnd" args="obj, count">
        <![CDATA[
            if (count == 0) {
                return;
            }
            
            const attachIconColIdx = gridObj.getColIndexById('ATTACH_IMG');
            gridObj.forEachRow(function(rId){
	            gridObj.cells(rId, attachIconColIdx).cell.children[0].style = 'filter:none';
            });
        ]]>
        </function>
        <function name="doQuery">
        <![CDATA[
        	if(Sepoa.request.docType && Sepoa.request.docType == "D") {
        		dataOutput.setValue('APPLY_TYPE', 'D');
        	} else {
	            dataOutput.setValue('APPLY_TYPE', 'U');
        	} 
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME+'/SepoaGrid.sux', ['mode=doQuery', 'METHOD=doSelectLedgerList', 'PROCESS_ID=sepoa.svc.seal.SepoaReqSealService']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="doOpenAuditTrailPopup" args="smrNumber, applyType">
        <![CDATA[
        	var process_id ;
        	
        	if(Sepoa.config.get('sepoa.seal.process') == "mk2"){
        		process_id = "sepoa.svc.sealmk2.SepoaReqSealService"
        	}else{
        		process_id = "sepoa.svc.seal.SepoaReqSealService"
        	}
        	
        	if(sUtils.workflow.check('MA1693206115042')) {
	            var config = {
	                url:window.CONTEXT_NAME+'/SepoaActionController.sux',
	                on:{
	                    callback:function(res, config, params){
	                        if(res.flag){
	                            
	                        }else{
	                        	console.log(arguments);
	                            Alert(Sepoa.cache.text.get('POA_CONTRACT.STATUS_' + res.status));
	                        }
	                    }
	                }
	            }
	            
				var downloadParam = {
					module: process_id,
	                action: "doLoadPdf",
	                CONNECTION: "CONNECTION",
	                PROCESS_ID: process_id,
					SMR_NUMBER: smrNumber,
					TYPE: (applyType == "D"? "CERT_AUDITTRAIL" : "AUDITTRAIL")
				}
				
	            sUtils.multipart.download(config, downloadParam);
            } else {
            
	        	const height = (SUX.getModuleTop().innerHeight - 40) * 0.95;
	            sUtils.popup.modal({
	                url: window.CONTEXT_NAME + '/UxDefault/Common/PDFViewer.sux',
	                params: {
	                    SMR_NUMBER: smrNumber,
	                    PROCESS_ID: process_id,
	                    METHOD: "doLoadPdf",
	                    TYPE: (applyType == "D"? "CERT_AUDITTRAIL" : "AUDITTRAIL")
	                },
	                height:height,
	               	title: (applyType == "D" ? Sepoa.cache.text.get('AUDIT_TRAIL_POPUP.TITLE_CERT') : Sepoa.cache.text.get('AUDIT_TRAIL_POPUP.TITLE'))
	            });
            }
        	
            return;
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
        
        
        ICAgICAgICAgICAgPC9kaXY+XG4gICAgICAgIDwvZGl2PlxuICAgIDwvZGl2PlxuPC9kaXY+In0=
    </template>
</body>