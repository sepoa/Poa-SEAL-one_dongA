<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="SLM_125" header="false">
    <filterbar id="filterObj" div="qBJABreoAKABresypT">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <grid id="gridObj" div="mwdvAreqZlvArejnIA" grid-id="SLM_125" drag="false" merge="false" dynamic="false">
        <event type="onRowSelect" callback="onRowSelect"/>
        <event type="onEditCell" callback="onEditCell"/>
        <event type="onXLE" callback="onXLE"/>
        <event type="onTXE" callback="onTXE"/>
    </grid>
    <onloadscript>
    <![CDATA[
       	selfObj._dndUnloadModule();
    
    	doQuery();
    ]]>
    </onloadscript>
    <userscript>
        <function name="doQuery" args="">
        <![CDATA[
        	var workType = Sepoa.request.WORK_TYPE;
        	
		 	switch (workType) {
            	case "UPDATE":
		            if (sUtils.workflow.check('SM1638865322885')) { //변경-사용자소속부서기준 검색 모듈
						dataOutput.setValue("USER_DEPT", Sepoa.info.DEPARTMENT);
		            } else {
		            	dataOutput.setValue("SEAL_MG_USER_ID", Sepoa.info.ID);
		            }
                	break;
            	case "RETURN":
		            if (sUtils.workflow.check('SR1638865367996')) { //반납-사용자소속부서기준 검색 모듈
						dataOutput.setValue("USER_DEPT", Sepoa.info.DEPARTMENT);
		            } else {
		            	dataOutput.setValue("SEAL_MG_USER_ID", Sepoa.info.ID);
		            }           	
                	break;
            	case "LOSS":
		            if (sUtils.workflow.check('SL1638865750070')) { //분실-사용자소속부서기준 검색 모듈
						dataOutput.setValue("USER_DEPT", Sepoa.info.DEPARTMENT);
		            } else {
		            	dataOutput.setValue("SEAL_MG_USER_ID", Sepoa.info.ID);
		            }
                	break;                	                	
			}
        
            dataOutput.addFilter(filterObj);
            dataOutput.setValue("SEAL_STATUS", "C");
            dataOutput.setValue("SEAL_TYPE", "U");
            
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.seal.SepoaSealManagementService', 'METHOD=doSealList']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="onRowSelect" args="id, ind">
        <![CDATA[
            var header = this.getColumnId();
            var manageNumber = gridObj.cells(id, gridObj.getColIndexById("MANAGE_NUMBER")).getValue();
            var sealStatus = gridObj.cells(id, gridObj.getColIndexById("SEAL_STATUS")).getValue();
            if(sealStatus != "C"){
            	Alert(Sepoa.cache.text.get('SLM_143.MESSAGE007'));
            	return;
            }
            
            var data = {
                MANAGE_NUMBER: manageNumber
            };
            Sepoa.params.callback(data);
            window.selfObj.close();
        ]]>
        </function>
        <function name="onEditCell" args="stage, rId, cInd, nValue, oValue">
        <![CDATA[
            var header = this.getColumnId();
            if (stage == 0) {
                return true;
            } else if (stage == 1) {
                return true;
            } else if (stage == 2) {
                return true;
            }
            return false;
        ]]>
        </function>
		<function name="onXLE" args="obj, count">
        <![CDATA[
            if (count == 0) {
                Alert(Sepoa.cache.text.get('MESSAGE.1001'));
                return;
            }
        ]]>
        </function>
        <function name="onTXE" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if (status == "true") {} else {
                Alert(message);
            }
        ]]>
        </function>
        <function name="onSearch" args="flag">
        <![CDATA[
            doQuery();
        ]]>
        </function>
    </userscript>
