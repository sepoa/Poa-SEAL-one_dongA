<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AP_102" header="false">
    <filterbar id="filterObj" div="FeiDlmeExCElmeDKGf">
        <calendar id="F_CALENDAR" button="year:0,month:0,week:-4,day:0" default="week:-4"/>
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="doQuery"/>
        <event type="onComboLoad" callback="onStatusComboLoad"/>
    </filterbar>
    <grid id="gridObj" div="kOKClmeEDEzNMcrODy" grid-id="AP_102" drag="false" merge="false" dynamic="false">
        <event type="onRowSelect" callback="onRowSelect"/>
        <event type="onXLE" callback="onXLE"/>
    </grid>
    <onloadscript>
    	<call name="init" />
    </onloadscript>
    <userscript>
    	<function name="init">
        <![CDATA[
        	var hideCols = [];
        	switch(Sepoa.request.MODE) {
        		case 'DONE' :
        			break;
        		case 'TURN' :
        			hideCols = ['APP_STATUS', 'ACCEPT_REASON', 'ACCEPT_DATE'];
        			break;
        	}
        	for (var i in hideCols) gridObj.setColumnHidden(gridObj.getColIndexById(hideCols[i*1]), true);
            doQuery();
        ]]>
        </function>
        <function name="onStatusComboLoad" args="id, comboList">
        <![CDATA[
            
        ]]>
        </function>
        <function name="doQuery">
        <![CDATA[
            dataOutput.setValue('MODE', Sepoa.request.MODE);
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME+'/SepoaGrid.sux', ['mode=doQuery', 'METHOD=doQuery', 'PROCESS_ID=sepoa.svc.approval.SepoaApprovalService']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="onRowSelect" args="id, ind">
        <![CDATA[
        	let coverProgress = false;	// 더블클릭 방지용 프로그레스 모달을 켰는지
        	var header = gridObj.getColumnId(ind);
        	if (header == 'APP_SUBJECT') {
	            var app_subject = gridObj.cells(id, gridObj.getColIndexById("APP_SUBJECT")).getValue()
	            var paramObj = {
	            	COMPANY_CODE : gridObj.cells(id, gridObj.getColIndexById("COMPANY_CODE")).getValue()
	            	, APP_NO : gridObj.cells(id, gridObj.getColIndexById("APP_NO")).getValue()
	            	, APP_NO_SEQ : gridObj.cells(id, gridObj.getColIndexById("APP_NO_SEQ")).getValue()
	            	, APP_TYPE : gridObj.cells(id, gridObj.getColIndexById("APP_TYPE")).getValue()
	            	, APP_SUBJECT : app_subject
	            	, HEADER_TEXT : Sepoa.cache.text.get('AP_101.TITLE_' + Sepoa.request.MODE) + ' > ' + app_subject
	            	, RE_FLAG : gridObj.cells(id, gridObj.getColIndexById("RE_FLAG")).getValue()
	            	, SUX_WKEY1 : gridObj.cells(id, gridObj.getColIndexById("SUX_WKEY1")).getValue()
	            	, SUX_WKEY2 : gridObj.cells(id, gridObj.getColIndexById("SUX_WKEY2")).getValue()
	            	, SUX_WKEY3 : gridObj.cells(id, gridObj.getColIndexById("SUX_WKEY3")).getValue()
	            	, SUX_WKEY4 : gridObj.cells(id, gridObj.getColIndexById("SUX_WKEY4")).getValue()
	            	, SUX_WKEY5 : gridObj.cells(id, gridObj.getColIndexById("SUX_WKEY5")).getValue()
	            	, SUX_WKEY6 : gridObj.cells(id, gridObj.getColIndexById("SUX_WKEY6")).getValue()
	            	, SUX_WKEY7 : gridObj.cells(id, gridObj.getColIndexById("SUX_WKEY7")).getValue()
	            	, SUX_WKEY8 : gridObj.cells(id, gridObj.getColIndexById("SUX_WKEY8")).getValue()
	            	, SUX_WKEY9 : gridObj.cells(id, gridObj.getColIndexById("SUX_WKEY9")).getValue()
	            	, SUX_WKEY10 : gridObj.cells(id, gridObj.getColIndexById("SUX_WKEY10")).getValue()
	            }
	            sUtils.progress.on();
            	coverProgress = true;
	            callFunction(['p','p'], 'viewDetail', [paramObj]);
        	}
        	
        	if (coverProgress) { setTimeout(function() { sUtils.progress.off();}, 100);}
        ]]>
        </function>
        <function name="onXLE" args="obj, count">
        <![CDATA[
            if (count == 0) {
                return;
            }
        ]]>
        </function>
    </userscript>
