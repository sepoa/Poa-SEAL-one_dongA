<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_102_D_G" header="false">
    <filterbar id="filterObj" div="jFYSAudBoWVAudKwtU">
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="doQuery"/>
    </filterbar>
    <button id="btnObj">
        <btn div="jFYSAudFPXVAudGByG" id="ROWADD"  text="{BUTTON.rowadd}" toggle="false" reverse="false" onclick="doAddRow(  )"/>
        <btn div="jFYSAudFPXVAudGByG" id="SAVE"  text="{BUTTON.save}" toggle="false" reverse="false" onclick="doSave(  )"/>
        <btn div="jFYSAudFPXVAudGByG" id="ROWDELETE"  text="{BUTTON.rowdelete}" toggle="false" reverse="false" onclick="doDeleteRow(  )"/>
    </button>
    <grid id="gridObj" div="jFYSAudObRVAudOiQL" grid-id="AD_102_D" drag="false" merge="false" dynamic="false">
        <event type="onTXE" callback="doSaveEnd"/>
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onEditCell" callback="onEditCell"/>
        <event type="onRowSelect" callback="onRowSelect"/>
    </grid>
    <variable>
        <var name="AVbffvdYEDhfvdFCvl" value="$($sObject._vp).find('#AVbffvdYEDhfvdFCvl')[0]"/>
        <var name="AVbffvdjzGhfvdlAbb" value="$($sObject._vp).find('#AVbffvdjzGhfvdlAbb')[0]"/>
        <var name="AVbffvdXEDhfvdtRrU" value="$($sObject._vp).find('#AVbffvdXEDhfvdtRrU')[0]"/>
        <var name="rowCount" />
        <var name="tmpRows" value="[]"/> 
    </variable>
    <onloadscript>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <function name="doAddRow" args="item">
        <![CDATA[
	        var getCompanyCode = Sepoa.info.COMPANY_CODE ;
            rowCount = gridObj.getRowsNum();
	        
            var maxRowId = rowCount + 1;
            gridObj.addRow(maxRowId, '', gridObj.getRowsNum());
            gridObj.cells(maxRowId, gridObj.getColIndexById('SELECTED')).setValue("1");
            gridObj.cells(maxRowId, gridObj.getColIndexById('COMPANY_CODE')).setValue(getCompanyCode);
            tmpRows.push(maxRowId);
        ]]>
        </function>
        <function name="doDeleteRow" args="">
        <![CDATA[
            if (gridObj.getGridChangedRows("SELECTED").length > 0 && Confirm(Sepoa.cache.text.get('MESSAGE.1015'), function(result) {
				if (result) {
					var deleteOk = true;
                        for (rowid = 1; rowid <= gridObj.getRowsNum(); rowid++) {
                            var selectRow = gridObj.cells(rowid, gridObj.getColIndexById("SELECTED")).getValue();
                            if (selectRow == '1') {
                                var myDept = gridObj.cells(rowid, gridObj.getColIndexById("DEPT")).getValue();
                                var myDeptName = gridObj.cells(rowid, gridObj.getColIndexById("DEPT_NAME_LOC")).getValue();
                                for (row = 1; row <= gridObj.getRowsNum(); row++) {
                                    if (row != rowid) { // 내가 선택한 라인을 제외한 전체 라인 
                                        var parentD = gridObj.cells(row, gridObj.getColIndexById("PARENT_DEPT")).getValue();
                                        var childDept = gridObj.cells(row, gridObj.getColIndexById("DEPT_NAME_LOC")).getValue();
                                        if (parentD == myDept) { // 상위부서 가 내 부서랑 같으면. 나를 상위부서로 갖고있는 하위부서를 get 함
                                        	if(myDeptName == ''){ // 그리드PK컬럼이 널값이라면, 신규행추가한상태이므로 break;
                                        		break;
                                        	}else {
                                            Alert(childDept + Sepoa.cache.text.get('MESSAGE.1093'));
                                            deleteOk = false;
                                            break;
                                            }
                                        }
                                    }
                                }
                            }
                        }
            
                        if (deleteOk) {
                            gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.admin.SepoaOrgManagementService', 'METHOD=doDeleteDeptGrid'], 'SELECTED');
                        }
                    }
                }));
        ]]>
        </function>
        <function name="doQuery" args="item">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.admin.SepoaOrgManagementService', 'METHOD=doQueryDeptGrid']);
            gridObj.clearAll(false);     
        ]]>
        </function>
        <function name="doQueryEnd" args="obj, rowCnt">
        <![CDATA[
            if (rowCnt < 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.1001')); // 조회된 데이터가 없습니다.
                return;
            }
            tmpRows=[];
        ]]>
        </function>
        <function name="onEditCell" args="stage, rId, cInd, nValue, oValue">
        <![CDATA[
        	rowCount = gridObj.getRowsNum();
        	
            if (stage == 2) {
          		if( nValue != oValue ) {
              		gridObj.cells(rId, gridObj.getColIndexById('SELECTED')).setValue(true);
           		}
           		// 동일한 부서코드가 이미 존재할경우 유효성검사
                if (gridObj.getColumnId(cInd) == "DEPT") {
                    for (row = 1; row <= rowCount; row++) {
                        if (row != rId) { 
                            var selectDept = gridObj.cells(row, gridObj.getColIndexById("DEPT")).getValue();
                            if (selectDept != '' && selectDept == nValue) {
                                Alert(Sepoa.cache.text.get('MESSAGE.1096')); // 동일한 부서 코드가 존재합니다.
                                gridObj.cells(rId, gridObj.getColIndexById("DEPT")).setValue(oValue);
                                return;
                            }
                        }
                    }
                    if (tmpRows.indexOf(rId) == -1 && nValue != oValue && oValue > '') {
                        Alert(Sepoa.cache.text.get('MESSAGE.1092')); //부서 코드는 수정할 수 없습니다. 삭제 후 추가 하세요.
                        gridObj.cells(rId, gridObj.getColIndexById("DEPT")).setValue(oValue);
                    }
                }
                
            }
            return true;
        ]]>
        </function>
        <var name="rowId"/>
        <function name="onRowSelect" args="rId, cInd">
        <![CDATA[
            var header = gridObj.getColumnId(cInd); 
            rowId = rId;
            if(header == 'PARENT_DEPT_NAME'){
            	doSerchPopup();
            }
        ]]>
        </function>
        <function name="doSerchPopup" args="">
        <![CDATA[
            PopupCommonPost('AD1020_3', doSerchPopupCallback, [Sepoa.info.HOUSE_CODE, Sepoa.info.COMPANY_CODE]);
        ]]>
        </function>
        <function name="doSerchPopupCallback" args="parent_dept, parent_dept_name">
        <![CDATA[
        	var dept = gridObj.cells(rowId, gridObj.getColIndexById("DEPT")).getValue();
        	
        	if(dept == parent_dept){
				Alert(Sepoa.cache.text.get('MESSAGE.1090'));
	        } else {
		        gridObj.cells(rowId, gridObj.getColIndexById("PARENT_DEPT")).setValue(parent_dept);	
		        gridObj.cells(rowId, gridObj.getColIndexById('SELECTED')).setValue("1");
		        gridObj.cells(rowId, gridObj.getColIndexById("PARENT_DEPT_NAME")).setValue(parent_dept_name);	
	        }
        ]]>
        </function>
        <function name="doSaveEnd" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            
            if (status == "true") {
                Alert(message);
                doQuery();
                tmpRows = [];
            } else {
                Alert(message);
            }
        ]]>
        </function>
        <function name="doSave" args="">
        <![CDATA[
            if (gridObj.getGridChangedRows("SELECTED").length == 0) {
                Alert(Sepoa.cache.text.get('MESSAGE.1004'));
                return;
            }
            if (!gridObj.validate()) {
                Alert(Sepoa.cache.text.get('MESSAGE.0003'));
                return;
            }
            Confirm(Sepoa.cache.text.get('MESSAGE.1018'), function(result) {
                if (result) {
                    gridObj.editStop();
                    gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.admin.SepoaOrgManagementService', 'METHOD=doSaveDeptGrid'], 'SELECTED');
                }
            });
        ]]>
        </function>
    </userscript>
