<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="LoginSSO" header="false" tpl="editor.tpl">
    <link>
    <![CDATA[
    <%
    	String ssoToken = request.getParameter("raw_ssoToken");
    	String domainName = request.getParameter("raw_domainName");
    	
    	com.spit.sso.Client client = new com.spit.sso.Client();
    	String[] results = client.validSSO(domainName, "sms.nonssl", ssoToken);
    	String userId = null;
    	if(results != null) {
    		userId = results[0];
    		request.getSession().setAttribute("ssoToken", ssoToken);
    		request.getSession().setAttribute("domainName", domainName);
    	}	

		Map<String, Object> allData = new HashMap<String, Object>();
		Map<String, String> headerData = new HashMap<String, String>();
		headerData.put("ID", userId);
		allData.put(SepoaDataMapper.KEY_HEADER_DATA, headerData);

		Object[] o = new Object[]{allData};
		SepoaOut so = ServiceConnector.doService(info, "sepoa.svc.login.cbo_013.LoginSSO", "CONNECTION", "loginSSO", o);
		String flag = String.valueOf(so.flag);
    %>
        <script type="text/javascript" src="<%=CONTEXT_NAME%>/resource/plugin/sepoasoft/login/login.js"></script>
        <script type="text/javascript">
            Sepoa.cache.text.load([{
                url:CONTEXT_NAME+'/resource/ux/admin/langs/'+(Sepoa.request.LANGAUGE || 'KO')+'/POA_BASE.js'
            }]);
        </script>
    ]]>
    </link>
    <variable>
        <var name="mainFrame" value="$($sObject._vp).find('#inSwtpdwDUwtpdiAjq')[0]" />
        <var name="inSwtpdvDUwtpdyJYG" value="$($sObject._vp).find('#inSwtpdvDUwtpdyJYG')[0]" />
    </variable>
    <onloadscript>
        <call name="init" />
    </onloadscript>
    <userscript>
        <var name="$var" value="{}" />
        <function name="init">
        <![CDATA[
			if(<%=flag%> == 'true'){
				location.href = window.CONTEXT_NAME + "/Main.sux";
			} else {
				location.href = window.CONTEXT_NAME + "/";
			}
        ]]>
        </function>
        
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        ICAgICAgICAgICAgICAgPC9kaXY+XG4gICAgICAgICAgICA8L2Rpdj5cbiAgICAgICAgPC9kaXY+XG4gICAgPC9kaXY+XG48L2Rpdj4ifQ==
    </template>
</body>