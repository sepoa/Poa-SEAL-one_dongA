<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="TEMPLATE_DATA_MAPPING_POPUP" header="false" pageCloseWarn="false">
    <link>
    </link>
    <button id="e122995b8e5745f6892093e23e8e73">
        <btn div="e122995b8e5745f6892093e23e8e73" id="SAVE" type="default" text="{BUTTON.save}" toggle="false" reverse="false" onclick="doSave(  )"/>
    </button>
    <usercss>
	<![CDATA[
		.set-approval-container {
    		overflow-y: auto;
		}
	]]>
    </usercss>
    <variable>
        <var name="container" value="$($sObject._vp).find('#NJdjrVdUzejrVdWVIX')[0]"/>
        <var name="NJdjrVdUzejrVdkNCA" value="$($sObject._vp).find('#NJdjrVdUzejrVdkNCA')[0]"/>
        <var name="a2eb2bdfef4349a786b997320976a3" value="$($sObject._vp).find('#a2eb2bdfef4349a786b997320976a3')[0]"/>
        <var name="b6d4fef874fe45588ca8a42fab4e9b" value="$($sObject._vp).find('#b6d4fef874fe45588ca8a42fab4e9b')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
		<![CDATA[
           	selfObj._dndUnloadModule();
		]]>
	</onloadscript>
    <userscript>
        <function name="doSave" args="">
		<![CDATA[
			if(!$formObj.validate()) {
				Alert("입력되지 않은 항목이 있습니다.")
				return;
			}
		
			let returnData = $formObj.getFormData();
			returnData["ROW_NUM"] = Sepoa.request["ROW_NUM"];
			Sepoa.params.callback(returnData);
   			selfObj.close();
		]]>
        </function>
        <function name="init" args="">
		<![CDATA[
			let formId = Sepoa.request["TEMPLATE_FORM"];
			let smrStatus = Sepoa.request["SMR_STATUS"];
			
			if(formId == "" || formId == null) {
				Alert(Sepoa.cache.text.get("SLM_251.NOT_EXIST_TEMPLATE"));
           		return;
			}

			let formOption = Sepoa.cache.form.get(formId);
			if(formOption == null) {
				Alert(Sepoa.cache.text.get("SLM_251.NOT_EXIST_TEMPLATE_FORM"), function(flag) {
					if(flag) {
						selfObj.close();
					}
				}.bind(this));
				return;
			}
			
			$formObj = new SepoaMultiDhtmlXFormObject(container, 'attachDocTemplateForm', [formOption], true);
			$formObj.attachEvent("onButtonClick", onButtonClick);
			
			let legacyData = Sepoa.params["TEMPLATE_MAPPING_DATA"];
			if(legacyData != null && legacyData != "") {
				$formObj.dataMapper(JSON.parse(legacyData), "JSON");
			}
			
			if($formObj.getValue("REQ_AT_NUMBER") == null || $formObj.getValue("REQ_AT_NUMBER") == "") {
				let docNumber = getDocumentNumber("CERT");
				$formObj.setValue("REQ_AT_NUMBER", docNumber);
			}
			
			setSize();
			let formItem = $formObj.getFormData();
			if(smrStatus != 'T'){
				for(let key of Object.keys(formItem)) {
                    $formObj.setReadOnly(key, true);
                }
                
                if(formId == "ATTACH_DOC_WARRANT_POSCOFLOW"){ 
                	$formObj.setReadOnly('DEPT_SEARCH', true);
                } else if(formId == "ATTACH_DOC_USESEAL_POSCOFLOW") {
					$formObj.setReadOnly('USE_SEARCH', true);
	                $formObj.setReadOnly('SEAL_SEARCH', true);
                }
			}
		]]>
        </function>
        <function name="setSize" args="">
        <![CDATA[
        	let formDom = $formObj._parent.children[0];
        	let w = 800;
        	let h = 600;
        	selfObj[selfObj.name].setDimension(w, h);
        	selfObj[selfObj.name].center();
        	SUX.callEvent('onWindowResize', []);
        ]]>
        </function>
        <function name="onButtonClick" args="name">
        <![CDATA[
        	let formId = Sepoa.request["TEMPLATE_FORM"];
        	
        	if(formId == "ATTACH_DOC_WARRANT_POSCOFLOW") {
        		//위임장 이벤트
        		
        		if(name == "DEPT_SEARCH") {
		        	PopupCommonPost('SP0015', warrantDeptSelectCallback, [Sepoa.info.HOUSE_CODE, Sepoa.info.COMPANY_CODE], '', 400, 400);
        		}
        	} else if(formId == "ATTACH_DOC_USESEAL_POSCOFLOW") {
        		//사용인감계 이벤트
        		if(name == "SEAL_SEARCH") {
        			if (sUtils.workflow.check('US1637133464814')) { // 용도기준 검색
                		if ($formObj.getValue("REQ_USE") == "") {
                    		Alert(Sepoa.cache.text.get('SLM_221.MSG_0035'));
                    		return false;
                		}
            		}
        			
        			var params = {
	                    SEAL_USE_TYPE: $formObj.getValue("REQ_USE_NUMBER"),
	                    APPLY_TYPE : 'U',
	                    SEAL_TYPE: 'U',
	                    SELECT_OPTION : 'SINGLE'
	                };
        			
        			var height = Math.min((SUX.getModuleTop().innerHeight) * 0.9, 800);
                	PopupOpenPost('/Seal/Document/Common/Popup/SealDocumentWriteSealPopupLayout.sux', params, manageImgPopupCallback, 500, height, Sepoa.cache.text.get('SLM_221.SELECT_SEAL'));
        		} else if(name == "USE_SEARCH") {
        			doOpenSealUsePopup();
        		}
        	}
        ]]>
        </function>
        <function name="doOpenSealUsePopup" args="">
        <![CDATA[
            //용도 팝업
            if (sUtils.workflow.check('US1637133452574')) { // 부서기준 검색
                var module = "SP0068_DP";
            } else {
                var module = "SP0068";
            }
            
            if (module == "SP0068_DP") {
                var re = 'E';
                var popupParam = [Sepoa.info.HOUSE_CODE, Sepoa.info.COMPANY_CODE, re, Sepoa.info.DEPARTMENT];
            } else {
                var popupParam = [Sepoa.info.HOUSE_CODE, Sepoa.info.COMPANY_CODE];
            }
            
            var height = Math.min((SUX.getModuleTop().innerHeight) * 0.9, 500);
            const width = 500;
            PopupCommonPost(module, sealUseTypePopupCallback, popupParam, '', width, height);
        ]]>
        </function>
        <function name="sealUseTypePopupCallback" args="data">
        <![CDATA[
            $formObj.setValue('REQ_USE', arguments[1]);
            $formObj.setValue('REQ_USE_NUMBER', arguments[2]);
        ]]>
        </function>
        <function name="manageImgPopupCallback" args="data">
        <![CDATA[
        	for(var i in data) {
        		let item = data[i];
        		$formObj.setValue('USE_SEAL_PROOF', item.MANAGE_NUMBER);
            	$formObj.setValue('SEAL_SUBJECT', item.SUBJECT);
        	}
        ]]>
        </function>
        <function name="warrantDeptSelectCallback" args="dept, dept_loc">
        <![CDATA[
        	$formObj.setValue("REQ_DEPT", dept);
        	$formObj.setValue("REQ_DEPT_LOC", dept_loc);
        ]]>
        </function>
    </userscript>
