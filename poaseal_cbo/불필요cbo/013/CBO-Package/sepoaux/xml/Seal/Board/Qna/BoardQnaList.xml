<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="QA_002_1" header="false">
    <filterbar id="filterObj" div="AnUVDRcAxMkzsShHhf">
        <calendar id="F_WRITE_DATE" button="year:0,week:-4,week:-1,day:0" default="week:-1"/>
        <keyword id="KEYWORD"/>
        <filter>
            <option id="F_KEYWORD" type="text"/>
            <option id="F_ADD_USER" type="text"/>
        </filter>
    </filterbar>
    <button id="btnObj">
        <btn div="AnUVDRcsspkzsSheFZ" id="SEARCH" type="custom_2" text="{BUTTON.search}" toggle="false" reverse="false" onclick="onButtonClick( 'SEARCH' )"/>
        <btn div="AnUVDRcsspkzsSheFZ" id="QA_WRITE" type="custom_1" text="{BUTTON.new}" toggle="false" reverse="false" onclick="onButtonClick( 'QA_WRITE' )"/>
    </button>
    <grid id="gridObj" div="AnUVDRcssrjzsShZbx" grid-id="QA_002_1" drag="false" merge="false" dynamic="false">
        <event type="onXLE" callback="onXLE"/>
        <event type="onRowSelect" callback="onRowSelect"/>
        <event type="onEditCell" callback="onEditCell"/>
    </grid>
    <usercss>
    <![CDATA[
        >.container {
            padding: 0 20px 0 20px;
            width: calc(100% - 40px);
        }
    ]]>
    </usercss>
    <variable>
        <var name="pSGBtVcSNJBtVcZMhV" value="$($sObject._vp).find('#pSGBtVcSNJBtVcZMhV')[0]"/>
        <var name="pSGBtVcLDMBtVcJcLJ" value="$($sObject._vp).find('#pSGBtVcLDMBtVcJcLJ')[0]"/>
        <var name="pSGBtVcRNJBtVcOjI" value="$($sObject._vp).find('#pSGBtVcRNJBtVcOjI')[0]"/>
    </variable>
    <onloadscript>
        <var name="userType" value="Sepoa.info.USER_TYPE"/>
        <![CDATA[
            if (userType == "S") {
                filterObj.filterPull.filter.items.F_USER_COMPANY.activeItem.parentNode.parentNode.parentNode.parentNode.hidden = true;
            }
        ]]>
        <event obj="filterObj" type="onSearch">
            <function args="id">
            <![CDATA[
                if (id == 'filter' || id == 'search') {
                    doQuery();
                }
            ]]>
            </function>
        </event>
        <event obj="Sepoa" type="onWindowResize">
            <function args="">
            <![CDATA[
                resizeGrid();
            ]]>
            </function>
        </event>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
    	<function name="onButtonClick" args="name">
        <![CDATA[
            switch (name) {
                case "SEARCH":
                    doQuery();
                    break;
                case "QA_WRITE":
                    callFunction('QA_002', 'changeFrame', ['write']);
                    break;
                default:
                    break;
            }
        ]]>
		</function>
        <function name="doQuery" args="">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery','PROCESS_ID=sepoa.svc.board.SepoaQAService','METHOD=doQuery']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="obj, rowCnt">
        <![CDATA[
        ]]>
        </function>
        <function name="onXLE" args="obj, count">
        <![CDATA[
            var msg = obj.getUserData("", "message");
            var status = obj.getUserData("", "status");
            if (status != "true") {
                Alert(msg);
            }
            
            var rowCount = gridObj.getRowsNum();
            
            if (rowCount > 0) {
                var colSeqIndex = gridObj.getColIndexById('ROWNUM');
                var seqCount = rowCount;
            
                for (var i = 0; i < rowCount; i++) {
                    var rowID = gridObj.getRowId(i);
            
                    gridObj.cells(rowID, colSeqIndex).setValue(seqCount--);
                }
            }
        ]]>
        </function>
        <function name="onRowSelect" args="rId, cInd">
        <![CDATA[
            var header = gridObj.getColumnId(cInd);
            var qnaNumber = gridObj.gridGetCellValueId(rId, 'QNA_NUMBER');
            if (header == 'SUBJECT') {
                callFunction('QA_002', 'changeFrame', ['view', qnaNumber]);
            }
        ]]>
        </function>
        <function name="onEditCell" args="stage, rId, cInd, nValue, oValue">
        <![CDATA[
        	var header = gridObj.getColumnId(cInd);
        	let ctrlArr = Sepoa.info.CTRL_CODE.split(",");
            let ctrlFlag = (ctrlArr.indexOf("QnA_MANAGER") > 0);
            
			if(ctrlFlag && stage == 2 && header === "CHECK_FLAG" && (oValue != nValue)) {
				var rowData = gridObj._getRowData(rId);
				doServiceAjax('sepoa.svc.board.SepoaQAService', 'TRANSACTION', 'doCheckFlagUpdate', rowData, function(so) {
					if (so.status == 1) {
						gridObj.cells(rId, gridObj.getColIndexById(header)).setValue(nValue);
					} else {
						Alert(so.meesage);
						return;
					}
				});
			}
        ]]>
        </function>
        <var name="selected_rId"/>
    </userscript>
