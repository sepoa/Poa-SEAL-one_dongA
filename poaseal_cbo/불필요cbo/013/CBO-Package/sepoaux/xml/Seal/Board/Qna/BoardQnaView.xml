    <userscript>
        <![CDATA[
            (function(window) {
                window.htmlentities = {
                    encode: function(str) {
                        var buf = [];
            
                        for (var i = str.length - 1; i >= 0; i--) {
                            buf.unshift(['&#', str[i].charCodeAt(), ';'].join(''));
                        }
            
                        return buf.join('');
                    },
                    decode: function(str) {
                        return str.replace(/&#(\d+);/g, function(match, dec) {
                            return String.fromCharCode(dec);
                        });
                    }
                };
            })(window);
        ]]>
        <var name="legal_menu_profile" value="Sepoa.config.get('sepoa.legal.default.profile_code').split(',');"/>
        <var name="arrayMap" value="[]"/>
        <function name="doQuery" args="qnaNumber">
        <![CDATA[
            var so = doServiceAjax('sepoa.svc.board.SepoaQAService', 'CONNECTION', 'getDetail', {
                QNA_NUMBER: qnaNumber
            }, function(so) {
                if (so.status == 1) {
                    var sf = new SepoaFormater(so.result[0]);
                    if (sf.getRowCount() > 0) {
                        formObj.dataMapper(sf);
                        if (sf.getValue('content') != undefined) {
                            formObj.getContainer("EDITOR_BOX").innerHTML = sf.getValue('content').replaceAll("\\\"", "\"");
                        }
                        vaultObj.setAttachKey(sf.getValue('ATTACH_NO', 0));
            
                        dataOutput.setValue("QNA_NUMBER", sf.getValue('QNA_NUMBER'));
                        dataOutput.setValue("REPLY_CNT", sf.getValue('REPLY_CNT'));
                        dataOutput.setValue("WRITER_ID", sf.getValue('ADD_USER_ID'));
            
                        if (so.result[1] != undefined) {
                            var sf2 = new SepoaFormater(so.result[1]);
                            setComment(sf2);
                        }
                    } else {
                        Alert(Sepoa.cache.text.get('QA_002.MESSAGE_NO_DATA'));
                        callFunction('QA_002', 'changeFrame', ['list']);
                    }
                } else {
                    Alert(so.message);
                }
            });
        ]]>
        </function>
        <function name="onButtonClick" args="name">
        <![CDATA[
            var replyCnt = dataOutput.getValue("REPLY_CNT");
            var writer_id = dataOutput.getValue("WRITER_ID");
            
            if (name == 'QA_DELETE') { //게시물 삭제
                if (replyCnt > 0) {
                    Alert(Sepoa.cache.text.get('QA_002.MESSAGE_CANNOT_DELETE'));
                    return false;
                }
                if (writer_id != Sepoa.info.ID && legal_menu_profile.indexOf(Sepoa.info.MENU_PROFILE_CODE) < 0) {
                    Alert(Sepoa.cache.text.get('QA_002.MESSAGE_NO_PERMISSION'));
                    return false;
                }
                doDelete();
            } else if (name == 'QA_UPDATE') { //게시물 수정
                if (replyCnt > 0) {
                    Alert(Sepoa.cache.text.get('QA_002.MESSAGE_CANNOT_UPDATE'));
                    return false;
                }
                if (writer_id != Sepoa.info.ID) {
                    Alert(Sepoa.cache.text.get('QA_002.MESSAGE_NO_PERMISSION'));
                    return false;
                }
                doUpdate();
            } else if (name == 'QA_BACK') { //이전
                callFunction('QA_002', 'changeFrame', ['list']);
            } else if (name == 'RE_SAVE') {
                doSave();
            }
        ]]>
        </function>
        <function name="attach_callback" args="e, a, param">
        <![CDATA[
            dataOutput.setValue("ATTACH_NO", e.attach_key);
        ]]>
        </function>
        <function name="callVaultPopup" args="attachNo">
        <![CDATA[
            var type = 'REP'
            var mode = 'VI';
            vaultPopup({
                attach_key: attachNo,
                type: type,
                mode: mode,
                callback: setAttach_callback
            });
        ]]>
        </function>
        <function name="changeDateFormat" args="date">
        <![CDATA[
            var year = date.substr(0, 4);
            var month = date.substr(4, 2);
            var day = date.substr(6, 2);
            return year + '-' + month + '-' + day;
        ]]>
        </function>
        <function name="changeTimeFormat" args="time">
        <![CDATA[
            var hour = time.substr(0, 2);
            var min = time.substr(2, 2);
            return hour + ':' + min;
        ]]>
        </function>
        <function name="commentDelete" args="qnaNum, qnaSeq, userId">
        <![CDATA[
            if (userId != Sepoa.info.ID && legal_menu_profile.indexOf(Sepoa.info.MENU_PROFILE_CODE) < 0) {
                Alert(Sepoa.cache.text.get('QA_002.MESSAGE_NO_PERMISSION'));
                return false;
            }
            if (Confirm(Sepoa.cache.text.get('MESSAGE.1015'), function(result) {
                    if (result) {
                        dataOutput.setValue("mode", "REPLY");
                        dataOutput.setValue("QNA_NUMBER", qnaNum);
                        dataOutput.setValue("QNA_SEQ", qnaSeq);
                        var so = doServiceAjax('sepoa.svc.board.SepoaQAService', 'TRANSACTION', 'doDelete', null, function(so) {
                            if (so.status == 1) {
                                callFunction('QA_002', 'changeFrame', ['view', qnaNum]);
                            } else {
                                Alert(so.message);
                            }
                        });
                    }
                }));
        ]]>
        </function>
        <function name="commentRow" args="commentMap">
        <![CDATA[
            if (!commentMap)
                return;
            comment = commentMap.CONTENT.replaceAll("\\\"", "\"");
            var div = document.createElement('div');
            var attach_btn = '<button disabled class="commentRow_vault_empty"></button>';
            if (commentMap.ATTACH_NO != 0) {
                attach_btn = '<button class="commentRow_vault"></button>';
            }
            div.innerHTML = '<div class="commentDiv" id=' + commentMap.QNA_SEQ + '>' +
                '<div class="commentRow_info">' +
                '<div class="commentRow_name"><strong>' +
                commentMap.ADD_USER_NAME +
                '</strong> 님</div>' +
                '<div class="commentRow_buttonBox">' +
                attach_btn +
                '<div class="commentRow_Date">' +
                changeDateFormat(commentMap.ADD_DATE) + ' ' + changeTimeFormat(commentMap.ADD_TIME) + '</div>' +
                '<button class="delButton">삭제</button>' +
                '</div>' +
                '</div>' +
                '<div class="commentRow_content">' +
                comment +
                '</div>' +
                '</div>';
            formObj.getContainer("COMMENT").appendChild(div);
            
            
            div.getElementsByTagName('button')[0].onclick = (function(attach_no) {
                return function() {
                    callVaultPopup(attach_no);
                }
            })(commentMap.ATTACH_NO);
            div.getElementsByTagName('button')[1].onclick = (function(qna_number, qna_seq, add_user_id) {
                return function() {
                    commentDelete(qna_number, qna_seq, add_user_id);
                }
            })(commentMap.QNA_NUMBER, commentMap.QNA_SEQ, commentMap.ADD_USER_ID);
        ]]>
        </function>
        <function name="doDelete" args="">
        <![CDATA[
            if (Confirm(Sepoa.cache.text.get('MESSAGE.1015'), function(result) {
                    if (result) {
                        dataOutput.setValue("QNA_NUMBER", dataOutput.getValue("QNA_NUMBER"));
                        var so = doServiceAjax('sepoa.svc.board.SepoaQAService', 'TRANSACTION', 'doDelete', null, function(so) {
                            if (so.status == 1) {
                                callFunction('QA_002', 'changeFrame', ['list']);
                            } else {
                                Alert(so.message);
                            }
                        });
                    }
                }));
        ]]>
        </function>
        <function name="doSave" args="">
        <![CDATA[
            var comments = tinyMCE.activeEditor.getContent();
            if (!comments) {
                Alert(Sepoa.cache.text.get('MESSAGE.0002'));
                return;
            }
            var qnaNum = dataOutput.getValue("QNA_NUMBER");
            dataOutput.setValue("QNA_NUMBER", qnaNum);
            dataOutput.setValue("CONTENT", comments);
            dataOutput.setValue("mode", "REPLY");
            if (Confirm(Sepoa.cache.text.get('MESSAGE.1018'), function(result) {
                    if (result) {
                        var so = doServiceAjax('sepoa.svc.board.SepoaQAService', 'TRANSACTION', 'doSave', null, function(so) {
                            if (so.status == 1) {
                                callFunction('QA_002', 'changeFrame', ['view', qnaNum]);
                            } else {
                                Alert(so.message);
                            }
                        });
                    }
                }));
        ]]>
        </function>
        <function name="doUpdate" args="">
        <![CDATA[
            callFunction('QA_002', 'changeFrame', ['update', dataOutput.getValue('QNA_NUMBER')]);
        ]]>
        </function>
        <function name="getArrayMap" args="sf, idx">
        <![CDATA[
            var cols = sf.columns;
            for (var i = 0; i < cols.length; i++) {
                arrayMap[cols[i]] = sf.dataMap[cols[i]][idx];
            }
            return arrayMap;
        ]]>
        </function>
        <function name="setAttach_callback" args="e, a, r">
        <![CDATA[
            
        ]]>
        </function>
        <function name="setComment" args="sf2">
        <![CDATA[
            var commentMap = null;
            for (var i = 0; i < sf2.getRowCount(); i++) {
                //commentMap = sf2.getArrayMap()[i];
                commentMap = getArrayMap(sf2, i);
                commentRow(commentMap);
            }
            formObj_0.style.height = "auto";
            commentCount = sf2.getRowCount();
        ]]>
        </function>
        <function name="setTinyMCEsize" args="">
        <![CDATA[
            var target = formObj2.getContainer("EDITOR_BOX2");
            var height = document.body.offsetHeight - dhx.absTop(formObj2.getContainer("EDITOR_BOX2")) - 80;
            target.style.height = height + 'px';
            target.style.border = 'solid 1px rgba(0,0,0,0.2)'
        ]]>
        </function>
