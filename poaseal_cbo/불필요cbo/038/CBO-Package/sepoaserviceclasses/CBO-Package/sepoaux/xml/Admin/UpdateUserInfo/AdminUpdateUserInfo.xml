<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="AD_051" header="false" pageCloseWarn="true">
    <button id="layoutBtnObj">
        <btn div="oEtAYXcLRYBwtdxnpt" id="SAVE" type="default" text="{BASE_BUTTON.SAVE}" toggle="false" reverse="false" onclick="doSave(  )"/>
        <btn div="oEtAYXcLRYBwtdxnpt" id="CANCEL" type="delete" text="{BASE_BUTTON.CANCEL}" toggle="false" reverse="false" onclick="doCancel(  )"/>
    </button>
    <form id="formObj" div="jEtAYXckUHOvtdxtsn" form-id="file:///resource/ux/admin/form/AD_051.js">
        <event type="onFocus" callback="onFocus"/>
    </form>
    <tabbar id="tabbarObj" div="mEtAYXcDDJovtdxjat">
        <item id="BASIC" name="AD_051.TABBAR_BASIC_NAME" selected="true"/>
        <item id="CHANGE_PASS" name="AD_051.TABBAR_CHANGE_PASS_NAME"/>
    </tabbar>
    <usercss>
    <![CDATA[
        div#formbox { 
            height: 200px;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        
        div.dhx_cell_cont_tabbar div.form_area {
            display: flex;
            justify-content: center;      
        }
        
        div.dhxtabbar_base_material div.dhxtabbar_tabs div.dhxtabbar_tabs_base div.dhxtabbar_tabs_cont_left {
            display: flex;
            width: 100% !important;
            justify-content: center;
        }
        
        .dhxtabbar_tabs_top .dhxtabbar_tab {
            width: 176px !important;
        }
        
        .sepoa-user-info-seal-view .dhxform_container{
            text-align: center;
        }
        .sepoa-user-info-seal-view img{
            max-width:100%;
            max-height:100%;
        }
        
        .policy-msg-box span:not(.title){
            color:red;
        }
    ]]>
    </usercss>
    <variable>
        <var name="zvlHQIezkOJQIefnpb" value="$($sObject._vp).find('#zvlHQIezkOJQIefnpb')[0]"/>
        <var name="conObj" value="$($sObject._vp).find('#zvlHQIeykOJQIeWDgK')[0]"/>
    </variable>
    <onloadscript>
		<call name="initPolicy" />
        <call name="initTabbar"/>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <var name="$share" value="{}" />
        <var name="loadEmail"/>
        <var name="loadP1"/>
        <var name="loadP2"/>
        <var name="loadATTACH"/>
        
        <function name="initPolicy">
        <![CDATA[
            sUtils.connector.api('service',{
                target:{
                    name:"sepoa.svc.admin.AD_050",
                    action:"getPasswordPolicy"
                }
            }).then((res)=>{
                if(res.status == 1){
                    $share.policy = res.result[0]; 
                }
            })
        ]]>
        </function>
        <function name="initTabbar" args="">
        <![CDATA[
            $share.form = {};
            
			tabbarObj._hideTab('BASIC');
			tabbarObj._setTabActive('CHANGE_PASS'); 
       
            $share.form.basic = tabbarObj.tabs('BASIC').attachForm(void 0, 'basicFormObj', [sUtils.cache.form.load('/resource/ux/admin/form/AD_051_1.js')]);
            $share.sealVaultObj = $share.form.basic._apiConnector('getVault', ['ATTACH_NO_SEAL']);
            $share.sealVaultObj.f.removeAttribute('multiple');
            $share.sealVaultObj.f.setAttribute('accept', 'image/*');
            $share.sealVaultObj.conf.param = 'ATTACH_NO_SEAL';
            
            $share.sealVaultObj.attachEvent('onUploadFile', onUploadFile);
            $share.sealVaultObj.attachEvent('onBeforeFileAdd', onBeforeFileAdd);
            
            $share.form2 = {};
            $share.form2.pass = tabbarObj.tabs('CHANGE_PASS').attachForm(void 0, 'passFormObj', [sUtils.cache.form.load('/resource/ux/admin/form/AD_051_2.js')]);
        ]]>
        </function>
        <function name="doQuery" args="">
        <![CDATA[
            doServiceAjax('sepoa.svc.admin.AD_050', 'CONNECTION', 'doQuery', null, function(obj) {
                if (obj.status != 1) {
                    Alert(obj.message);
                    return;
                }
                sf = new SepoaFormater(obj.result[0]);
                if (sf.getRowCount() > 0) {
                    formObj.dataMapper(sf);
            
                    for (var i in tabbarObj.t) {
                        if (tabbarObj.t[i].cell.dataObj && tabbarObj.t[i].cell.dataObj.dataMapper) {
                            tabbarObj.t[i].cell.dataObj.dataMapper(sf);
                        }
                    }
                    
                    $share.form.basic.setValue('ATTACH_NO_SEAL', 'USER_'+sf.getValue('USER_ID', 0)+'_SEAL_IMG');
                    
                    loadEmail = $share.form.basic.getValue('EMAIL')
                    loadP1 = $share.form.basic.getValue('PHONE_NO1')
                    loadP2 = $share.form.basic.getValue('PHONE_NO2')
                    loadATTACH = $share.form.basic.getValue('ATTACH_NO_SEAL')
                }
            });
        ]]>
        </function>
        
        <function name="onUploadFile" args="e, a, p">
        <![CDATA[
            var cont = $share.form.basic.getContainer(p+"_VIEW");
            cont.innerHTML = '';
            
            if(e.fileCount > 0){
				cont.appendChild($(sUtils.string.dataReplacer('<img src="' + (window.CONTEXT_NAME ? window.CONTEXT_NAME : '') + '/SepoaPathToImage.sux?attach_key=$.{attach_key}&attach_seq=$.{serverName}&random=$CURRENT{TIME_STRING}"></img>', {attach_key:e.attach_key, serverName: this.getData()[0].serverName}))[0]);
            }
        ]]>
        </function>
        
        <function name="onBeforeFileAdd">
        <![CDATA[
            if(this.getData().length > 0){
                Alert(sUtils.cache.text.get('AD_050.0007'));
                return false;
            }
            return true;
        ]]>
        </function>
        
        <function name="doCancel" args="">
        <![CDATA[
            SUX.root.location.href = window.CONTEXT_NAME + "/Main.sux";
        ]]>
        </function>
        <function name="onKeyUp" args="inp, ev, name, value">
        <![CDATA[
            if(name.startsWith("NEW_PASSWORD_")){
                checkPassPolicy();   
            }
        ]]>
        </function>
        <function name="checkPassPolicy">
        <![CDATA[
            const passOrg    = $share.form.pass.getValue("NEW_PASSWORD_1");
            const passRepeat = $share.form.pass.getValue("NEW_PASSWORD_2");
            
            const msgStack = [];
            if(passOrg != passRepeat){
                msgStack.push(`<span>${sUtils.cache.text.get('AD_051_2.MESSAGE_SAME_INPUT')}</span>`);
            }
            if($share.policy.lengthMin > passOrg.length){
                msgStack.push(`<span>${sUtils.string.dataReplacer(sUtils.cache.text.get('AD_051_2.MESSAGE_POLICY_LENGTH_MIN'), $share.policy)}</span>`);
            }
            
            if($share.policy.lengthMax < passOrg.length){
                msgStack.push(`<span>${sUtils.string.dataReplacer(sUtils.cache.text.get('AD_051_2.MESSAGE_POLICY_LENGTH_MAX'), $share.policy)}</span>`);
            }
            
            if($share.policy.inSpecial && passOrg.match(/^[0-9|a-z|A-Z]*$/g)){
                msgStack.push(`<span>${sUtils.cache.text.get('AD_051_2.MESSAGE_POLICY_SPECIAL')}</span>`);
            }
            
            if($share.policy.inUpper && !passOrg.match(/^.*[A-Z].*$/g)){
                msgStack.push(`<span>${sUtils.cache.text.get('AD_051_2.MESSAGE_POLICY_UPPER')}</span>`);
            }
            
            if($share.policy.inLower && !passOrg.match(/^.*[a-z].*$/g)){
                msgStack.push(`<span>${sUtils.cache.text.get('AD_051_2.MESSAGE_POLICY_LOWER')}</span>`);
            }
            
            if($share.policy.inNumber && !passOrg.match(/^.*[0-9].*$/g)){
                msgStack.push(`<span>${sUtils.cache.text.get('AD_051_2.MESSAGE_POLICY_NUMBER')}</span>`);
            }
            
            if(msgStack.length > 0){
                if(!$share.policyMessageArea){
                    $share.policyMessageArea = $share.form.pass._parent.children[0].appendChild(sUtils.element.create(`<div class="policy-msg-box"></div>`));
                }
                msgStack.splice(0, 0, `<span class="title">${sUtils.cache.text.get('AD_051_2.MESSAGE_POLICY_FAIL')}</span>`);
                $share.policyMessageArea.innerHTML = msgStack.join('</br>')
                $share.policyPass = false;  
            }else if($share.policyMessageArea){
                $share.policyMessageArea.innerHTML = '';
                $share.policyPass = true;
            }
        ]]>
        </function>
        <function name="doSave" args="">
        <![CDATA[
        	if(tabbarObj._isTabActive('CHANGE_PASS')){
        		if($share.form2.pass.getValue('PASS_WORD') == ''){
	        		Alert("기존 비밀번호를 기입하세요.");
	        		return;
	        	}else if(!checkPwExist($share.form2.pass.getValue('PASS_WORD'))){
	        		Alert("기존 비밀번호와 일치하지 않습니다.");
	        		return;
	        	}else if($share.form2.pass.getValue('NEW_PASSWORD_1') == ''){
	        		Alert("새 비밀번호를 기입하세요.");
	        		return;
	        	}else if (checkPass($share.form2.pass.getValue('NEW_PASSWORD_1')) == false) {
	                Alert("비밀번호는 대문자 , 소문자 , 숫자  , 특수문자(!@#$%^*+=-) 를  <br>1개 이상씩 포함해서 10자 이상 20자 미만으로 조합해주세요.");
	                return;
	            }else if($share.form2.pass.getValue('NEW_PASSWORD_2') == ''){
	        		Alert("새 비밀번호 확인을 기입하세요.");
	        		return;
	        	}else if (!checkPassword()) {
	                Alert(Sepoa.cache.text.get('AD_051.MESSAGE_0001')); //새로운 비밀번호가 서로 같지 않습니다.
	                return;
	            }	
        	}else if(tabbarObj._isTabActive('BASIC')){
        		if(loadEmail == $share.form.basic.getValue('EMAIL') && loadP1 == $share.form.basic.getValue('PHONE_NO1') &&
        			loadP2 == $share.form.basic.getValue('PHONE_NO2') && loadATTACH == $share.form.basic.getValue('ATTACH_NO_SEAL')){
        			Alert("변경 사항이 없습니다.");
        			return;
        		}
        	}
        	
            Confirm(Sepoa.cache.text.get("MESSAGE.1018"), function(result) {
                if (result) {
                    doServiceAjax('sepoa.svc.admin.AD_050', 'TRANSACTION', 'doSave', undefined, function(obj) {
                        if (obj.status != 1) {
                            Alert(sUtils.cache.text.get("AD_051.MESSAGE_" + obj.status));
                            return;
                        } else {
                            Alert(Sepoa.cache.text.get("MESSAGE.0001"), function() {
                                SUX.root.location.href = window.CONTEXT_NAME + "/Main.sux";
                            });
                        }
                    });
                }
            }, false);
        ]]>
        </function>
        <function name="onFocus" args="name">
        <![CDATA[
            if (name == "NEW_PASSWORD_2") {
                if (!$share.form.pass.getValue('NEW_PASSWORD_1')) {
                    $share.form.pass._apiConnector('getInput', 'NEW_PASSWORD_1').focus();
                }
            } else if (name == "NEW_PASSWORD_1") {
                if (!$share.form.pass.getValue('PASS_WORD')) {
                    $share.form.pass._apiConnector('getInput', 'PASS_WORD').focus();
                }
            }
        ]]>
        </function>
        <function name="checkPass" args="str">
        <![CDATA[
            var reg = /^(?=.*[a-z])(?=.*[A-Z])(?=.*[!@#$%^*+=-])(?=.*[0-9]).{10,20}$/;
            
            return reg.test(str);
        ]]>
        </function>
        <function name="checkPassword" args="">
        <![CDATA[
            if ($share.form2.pass.getValue('NEW_PASSWORD_1') != $share.form2.pass.getValue('NEW_PASSWORD_2')) {
                return false;
            }
            return true;
        ]]>
        </function>
        <function name="checkPwExist" args="pw">
        <![CDATA[
        	let id = Sepoa.info.ID;
        	let result ;
        	doServiceAjax('sepoa.svc.system.login.SepoaLoginService', 'CONNECTION', 'docheckpwexist', {PASSWORD : pw, ID : id}, function(so) {
               if(so.status != 1){
                    result = 'false';
               }else{
               		result = 'true';
               }
            },false);
            
            if(result == 'false'){
            	return false;
            }else{
            	return true;
            }
        ]]>
        </function>
    </userscript>
