<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="CT_302" header="false" pageCloseWarn="false">
    <tabbar id="tabbarObj" div="GBvvrThaOysOPcSFXM">
        <event type="onTabChanged" callback="onTabChanged"/>
    </tabbar>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <variable>
        <var name="$share" value="{}"/>
    </variable>
    <userscript>
        <function name="init" args="">
        <![CDATA[
            if($share.childScreen === undefined) {
                $share.childScreen = {};
            }
            
            initTabbar();
            onReady();
        ]]>
        </function>
        
        <function name="initTabbar" args="">
        <![CDATA[
            const contractorId = 'C';
            tabbarObj.addTab(contractorId, '동아제약');
            tabbarObj.cells(contractorId).attachURL('/Contract/CompanyManagement/ContractCompanyManagementContractor.sux?alias=' + contractorId);
            tabbarObj.cells(contractorId).setActive();
            
            const contracteeId = 'S';
            tabbarObj.addTab(contracteeId, '계약상대방');
            tabbarObj.cells(contracteeId).attachURL('/Contract/CompanyManagement/ContractCompanyManagementContractor.sux?alias=' + contracteeId);
        ]]>
        </function>
        
        <function name="onReady" args="">
        <![CDATA[
            const parents = $sObject._vp.parents('div.sepoaux.screen_area');
            if(parents.length > 0) {
                callFunction('p', 'childScreenReady', [{
                    name : 'list',
                    fn : {
                        doQuery : doQuery
                    },
                    share : $share
                }]);
            }
        ]]>
        </function>
        
        <function name="childScreenReady" args="config">
        <![CDATA[
            const child = $share.childScreen[config.name] = config;
            if(child.share) {
                child.share.data = $share.data;
                child.share.event = $share.event
            }
            
            if($share.queue) {
                const target = $share.childScreen[$share.queue.name];
                if(target) {
                    target.fn[$share.queue.task].call();
                    delete $share.queue;
                }
            }
        ]]>
        </function>
        
        <function name="doQuery" args="id">
        <![CDATA[
            if(!id) {
                id = tabbarObj.getActiveTab();
            }
            
            const target = 'CT_302_1_' + id;
            if($share.childScreen?.[target]) {
                $share.childScreen[target].fn.doQuery();
            } else {
                $share.queue = {
                    name : target,
                    task : 'doQuery'
                }
            }
        ]]>
        </function>
        
        <function name="onTabChanged" args="id">
        <![CDATA[
        	if(id != 'S'){ // 수급처 자동조회 OFF
	            doQuery(id);
        	}
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
    </template>
</body>