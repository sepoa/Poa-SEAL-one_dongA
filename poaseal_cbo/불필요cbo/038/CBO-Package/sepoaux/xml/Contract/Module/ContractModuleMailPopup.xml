<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="CT_502_L_P" header="false" pageCloseWarn="false" delegate="false">
    <form id="formObj" div="b8c06eed422d4ee784f53762a71b97" form-id="CT_502_L_P"/>
    <onloadscript>
        <![CDATA[
     
        ]]>
        <call name="init"/>
         <event obj="formObj" type="onButtonClick">
            <function args="id">
            <![CDATA[
            	debugger
            	var mailSendYn;
            	
            	if(id == 'SEND_BTN'){
	            	mailSendYn = 'Y';

					let emailString = Sepoa.request.EX_SIGNER_EMAIL;
					// form POST 등으로 넘어오면서 줄바꿈이 &#13;&#10; 로 인코딩된 경우 실제 줄바꿈으로 복원
					if(typeof emailString === 'string'){
						emailString = emailString.replace(/&#13;&#10;/g, '\n').replace(/&#10;/g, '\n').replace(/&#13;/g, '\n');
					}
					if(!emailString || emailString.length === 0){
						Alert('계약서를 전송할 이메일 주소가 없습니다.');
						selfObj.close();
						return;
					}
					emailString = emailString + '\n이 주소로 보내시는 게 맞습니까?';
					Confirm(emailString, function(result) {
						if (result) {
							Sepoa.params.callback(mailSendYn);
							selfObj.close();
						}
					});
            	} else if(id == 'CANSEL_BTN'){
            		mailSendYn = 'N';
					Sepoa.params.callback(mailSendYn);
					selfObj.close();
            	}
            	
            ]]>
            </function>
        </event>
     </onloadscript>
     <userscript>
	        <function name="init" args="">
	          
	        </function>
	        
	        <function name="doCloseEnd">
	        <![CDATA[
	        	if(Sepoa.request.isPopup && Sepoa.request.isRealPopup){
	                if(!Sepoa.request.onLink){
	                    window.close();
	                }else{
	                    document.location.reload();
	                }
	            }else if(Sepoa.request.isPopup){
	                selfObj.close();
	            }else{
	              //  doClear();
	              //  callFunction('p', 'changeView', [{view:'LIST'}])
	            }
	        ]]>
	        </function>
	        <function name="setPopupWindowDisplay" args="display">
	        <![CDATA[
	            if(window.parent) {
	                const vp = window.parent.sUtils.popup.getWindowObject('CONTRACT_APPROVAL_POPUP').vp
	                vp.style.display = display;
	            }
	        ]]>
	        </function>
	    </userscript>
    <template editor="true">
        
        
        
        
        
    </template>
</body>