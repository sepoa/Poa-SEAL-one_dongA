<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="CT_102_G" header="false" pageCloseWarn="false">
    <button id="btnObj">
        <btn div="fbd7543f724844388bea4ffe32f037" id="UPDATE_BTN" type="save" text="{POA_CONTRACT.AUDIT_TRAIL_ACTION_DOCUMENT_UPDATE}" toggle="false" reverse="false" onclick="onButtonClick( 'UPDATE_BTN' )"/>
    </button>
    <form id="formObj" div="ecb3f4451c234d028a9f0d4842ae55" form-id="CT_102">
    	<event type="onChange" callback="onChange"/>
    </form>
    <grid id="gridObj" div="a077f47163ad4ed581d8356caff94a" grid-id="CT_102_GP" drag="false" merge="false" dynamic="false" exceldownload="true"/>
    <onloadscript>
        <call name="loadData"/>
        <function name="onButtonClick" args="name">
        <![CDATA[
        	console.log(name);
            switch (name) {
                case "UPDATE_BTN":
                    doUpdate();
                    break;
                default:
                    break;
            }
        ]]>
        </function>
    </onloadscript>
    <userscript>
        <function name="loadData">
        <![CDATA[
            let newData = Sepoa.params.DATA;
            dataOutput.setValue("CONT_NO", newData.CONT_NO);
            dataOutput.setValue("CONT_GL_SEQ", newData.CONT_GL_SEQ);
            
            doServiceAjax('sepoa.svc.ct.CT_205', 'CONNECTION', 'doSelectContractData', {CONT_NO: newData.CONT_NO, CONT_GL_SEQ:newData.CONT_GL_SEQ}, function(so) {
            	if(so.status == '1') {
            		let resultData = JSON.parse(so.result[1]);
            		setHeaderData(resultData);
            		setSignerData(resultData.SIGNER);
            	} else {
            		Alert("조회에 실패하였습니다.")
            		return false;
            	}
            });
        ]]>
        </function>
        <function name="setHeaderData" args="data">
        <![CDATA[
            for(const [key, value] of Object.entries(data)) {
				formObj.setValue(key.replace('EX_', ''), value);
			}
			
			if("0" == data['EX_TAX_AMT']){
            	formObj.setValue('TAX_CHK','1');
           	} else {
           		formObj.setValue('TAX_CHK','0');
           	}
        ]]>
        </function>
        <function name="setSignerData" args="data">
    	<![CDATA[
    		let targetArr = gridObj.getColIdsArray();
    		
    		for (let i of data) {
    			const rowId = dhx.newId();
                let tmpItem = i;
                gridObj.addRow(rowId, '', gridObj.getRowsNum());
                let tmpKeySet = Object.keys(i);
                for (let j of tmpKeySet) {
                	
                	if(targetArr.indexOf(j) > -1){
	                    gridObj.cells(rowId, gridObj.getColIndexById(j)).setValue(i[j]);
                	}
                }
			}
    	]]>
    	</function>
        <function name="doUpdate" args="">
        <![CDATA[
        	if(!formObj.validate()) {
        		Alert("필수 입력항목이 입력되지 않았습니다.");
        		return false;
        	}
        	
			// 수정을 누르면 해당 데이터베이스들에 업데이트 되어야함.
			dataOutput.setValue("SIGNER_INFO", JSON.stringify(gridObj.getAllDataObject()));
			doServiceAjax('sepoa.svc.ct.CT_205', 'TRANSACTION', 'doUpdateModifyContract', null, function(so) {
				if (so.status == '1') {
					Alert(sUtils.cache.text.get('CT_102.UPDATE_CONT_SUCCESS'));
					Sepoa.params.callback(so.status);
					selfObj.close();
				} else {
					Alert(sUtils.cache.text.get('POA_CONTRACT.UPDATE_CONT_SUCCESS'));
					return;
				}
			})
        ]]>
        </function>
        <function name="onChange" args="name, value, state">
        <![CDATA[
        	if(name == 'TAX_CHK') {
            	if("0" == formObj.getValue('TAX_CHK')){
	            	const taxAmt = parseInt(formObj.getValue('SUPPLY_AMT') || 0) * 0.1;
                	formObj.setValue('TAX_AMT', taxAmt.toString());
                    const contAmt = parseInt(formObj.getValue('SUPPLY_AMT') || 0) + parseInt(formObj.getValue('TAX_AMT') || 0);
                    formObj.setValue('CONT_AMT', contAmt.toString());
				} else {
					const contAmt = parseInt(formObj.getValue('SUPPLY_AMT') || 0);
	            	const taxAmt = parseInt(0);
	            	formObj.setValue('CONT_AMT', contAmt.toString());
	            	formObj.setValue('TAX_AMT', taxAmt.toString());
				}
				            	
            } else {
            	if(['SUPPLY_AMT'].includes(name)) {
					if("0" == formObj.getValue('TAX_CHK')){
						const taxAmt = parseInt(formObj.getValue('SUPPLY_AMT') || 0) * 0.1;
						formObj.setValue('TAX_AMT', taxAmt.toString());
						const contAmt = parseInt(formObj.getValue('SUPPLY_AMT') || 0) + parseInt(formObj.getValue('TAX_AMT') || 0);
						formObj.setValue('CONT_AMT', contAmt.toString());
	                } else {
						const contAmt = parseInt(formObj.getValue('SUPPLY_AMT') || 0);
						formObj.setValue('CONT_AMT', formObj.getValue('SUPPLY_AMT'));
	                }
	                
	            }
        	}
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
    </template>
</body>