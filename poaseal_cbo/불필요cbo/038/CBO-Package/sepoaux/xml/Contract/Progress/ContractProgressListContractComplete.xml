<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="CT_102" header="false" pageCloseWarn="false">
    <filterbar id="filterObj" div="MCtsZhdfjwsZhdSknL">
        <calendar id="F_CALENDAR" button="year:0,month:0,week:-4,day:0" default="ADD_DATE#week:-12" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#CT102"/>
        <keyword id="F_KEYWORD"/>
        <filter>
            <option id="F_OUTER_IRS_NO" type="text"/>
            <option id="F_CONT_FORM_NAME" type="popup">
                <popup code="CT0005" value="{HOUSE_CODE}#{COMPANY_CODE}"/>
            </option>
            <option id="F_CONT_CATEGORY" type="select" combo="CT0004,{HOUSE_CODE}#{LANGUAGE}"/>
            <option id="F_EXPIRED_VIEW" type="flag"/>
            <option id="F_SEQ_LAST_VIEW" type="flag"/>
            <option id="F_INNER_IRS_NO" type="text"/>
        </filter>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <button id="btnObj">
        <btn div="EtvofadQkWpfadeRTN" id="ALTERATION" type="default" text="{POA_CONTRACT.BUTTON_ALTERATION}" module="CT1634260430709" onclick="doAlteration(  )"/>
        <btn div="EtvofadQkWpfadeRTN" id="PUSH_RE_SEND" type="primary" text="{POA_CONTRACT.BUTTON_PUSH_RE_SEND}" onclick="doPushReSend(  )"/>
        <btn div="EtvofadQkWpfadeRTN" id="CONT_UPDATE" type="save" text="{POA_CONTRACT.AUDIT_TRAIL_ACTION_DOCUMENT_UPDATE}" onclick="onUpdateButtonClick( 'CONT_UPDATE' )"/>
        <btn div="EtvofadQkWpfadeRTN" id="REJECT" type="reject" text="{POA_CONTRACT.REVIEWER_STATUS_RR}" onclick="onRejectButtonClick( 'REJECT' )"/>
    </button>
    <grid id="gridObj" div="ASYDyZdgLzEyZdMSyF" grid-id="CT_102_CC" drag="false" merge="false" dynamic="false" exceldownload="true">
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onTXE" callback="doTransactionEnd"/>
        <event type="onRowSelect" callback="onRowSelect"/>
        <event type="onEditCell" callback="onEditCell"/>
        <event type="onRowInserted" callback="onRowInserted"/>
    </grid>
    <usercss>
    <![CDATA[
        .attach-status-box {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .attach-status-box div {
            float: left;
        }
        
        .attach-status-attach-icon {
            display: none;
        }
        
        .attach-status-attach-icon-G {
            display: block;
            width: 29px;
            height: 29px;
            margin-left: 10px;
            background: center / cover url(/resource/design/imgs/grid/ATTAH_IMG.png);
        }
        
        .expired-bold-flag-Y {
            font-weight: bold;
            color: #d12832;
        }
    ]]>
    </usercss>
    <variable>
        <var name="EtvofadWPxofadpUNx" value="$($sObject._vp).find('#EtvofadWPxofadpUNx')[0]"/>
        <var name="EtvofadAXSpfadiCyX" value="$($sObject._vp).find('#EtvofadAXSpfadiCyX')[0]"/>
        <var name="EtvofadWPxofaddSxt" value="$($sObject._vp).find('#EtvofadWPxofaddSxt')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <var name="$share" value="{}"/>
        <var name="$shareFnNames">
        <![CDATA[
            ['doQuery']
        ]]>
        </var>
        <function name="init">
        <![CDATA[
            $share.fn = {};
            for (var i in $shareFnNames) {
                var fnName = $shareFnNames[i];
                $share.fn[fnName] = $sObject[fnName];
            }
            
            callFunction('p', 'onChildScreenReady', [$share]);
            dataOutput.setValue('TYPE', $share.config.TYPE);
            initDesign();
            initFilter();
            initButton();
            doQuery();
        ]]>
        </function>
        <function name="initDesign">
        <![CDATA[
            var styleText = '.sepoa-contract-last-gl-Y{\n' +
                '    background-color:$.{GRID_CELL_TYPE_SECONDARY_COLOR};\n' +
                '    color:$.{GRID_CELL_TYPE_SECONDARY_TEXT_COLOR};\n' +
                '    font-size:$.{GRID_CELL_TYPE_SECONDARY_FONT_SIZE}px;\n' +
                '    font-weight:$.{GRID_CELL_TYPE_SECONDARY_FONT_WEIGHT};\n' +
                '    font-style:$.{GRID_CELL_TYPE_SECONDARY_FONT_STYLE};\n' +
                '    text-decoration:$.{GRID_CELL_TYPE_SECONDARY_FONT_STYLE};\n' +
                '}'
            
            sUtils.cache.client.get('DESIGN.GRID_CELL_TYPE_SECONDARY_COLOR');
            styleText = sUtils.string.dataReplacer(styleText, sUtils.cache.client.data.server.DESIGN);
            
            document.body.appendChild($('<style>' + styleText + '</style>')[0]);
        ]]>
        </function>
        <function name="initFilter" args="">
        <![CDATA[
            if ($share.config.FILTER && $share.config.FILTER.F_EXPIRED_VIEW) {
                filterObj.getItemById("F_EXPIRED_VIEW").setDefault("checked");
                filterObj.getItemById("F_EXPIRED_VIEW").setValue(true);
            }
        ]]>
        </function>
        <function name="initButton">
        <![CDATA[
            if (Sepoa.info.MENU_PROFILE_CODE == "MUP2011020001") {
                btnObj.showButton('REJECT', true);
            } else {
                btnObj.showButton('REJECT', false);
            }
            
            if (Sepoa.info.USER_TYPE == 'S') {
                btnObj.showButton('ALTERATION', false);
                btnObj.showButton('DESTRUCTION', false);
                btnObj.showButton('AFTER_PROCESS_RESTART', false);
            }
        ]]>
        </function>
        <function name="onSearch" args="id">
        <![CDATA[
            doQuery();
        ]]>
        </function>
        <function name="doQuery" args="">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.ct.CT_205', 'METHOD=doDocumentList']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="obj, rowCnt">
        <![CDATA[
            var status = obj.getUserData("", "status");
            var message = obj.getUserData("", "message");
            if (status != 'true') {
                Alert(message);
            }
            
            var rowCount = gridObj.getRowsNum();
            
            if (rowCount > 0) {
                var colSeqIndex = gridObj.getColIndexById('ROWNUM');
                var seqCount = rowCount;
            
                for (var i = 0; i < rowCount; i++) {
                    var rowID = gridObj.getRowId(i);
            
                    gridObj.cells(rowID, colSeqIndex).setValue(seqCount--);
                }
            }
        ]]>
        </function>
        <function name="onRowSelect" args="id, cind">
        <![CDATA[
            var header = gridObj.getColumnId(cind);
            var gridData = gridObj._getRowData(id);
            
            if (header == 'AUDIT_TRAIL') {
                sUtils.popup.modal({
                    url: window.CONTEXT_NAME + '/UxDefault/Common/PDFViewer.sux',
                    height: SUX.getModuleTop().innerHeight * 0.90,
                    params: {
                        PROCESS_ID: 'sepoa.svc.contract.SepoaContractService',
                        METHOD: 'viewAuditTrail',
                        CONT_NO: gridData.CONT_NO,
                        CONT_GL_SEQ: gridData.CONT_GL_SEQ
                    },
                    title: sUtils.cache.text.get('POA_CONTRACT.AUDIT_TRAIL_MAIN_HEADER')
                })
            } else if (!(['SELECTED', 'EXPIRED_ALARM', 'CATEGORY'].indexOf(header) + 1)) {
                $share.fn.doChangeView(gridData);
            }
        ]]>
        </function>
        <function name="onEditCell" args="stage,rowId,cellInd,nValue,oValue">
        <![CDATA[
            var header = gridObj.getColumnId(cellInd);
            var gridData = gridObj.getRowDataObject(rowId);
            if (stage == 2) {
                if (header == "EXPIRED_ALARM" || header == "CATEGORY") {
                    gridObj._doOnRowSelect(rowId, gridObj.getColIndexById('SELECTED'));
            
                    var params = {
                        CONT_NO: gridData.CONT_NO,
                        CONT_GL_SEQ: gridData.CONT_GL_SEQ,
                    };
                    params[header] = nValue;
            
                    var mode = null;
                    if (header == "EXPIRED_ALARM") {
                        mode = "doChangeAlarm";
                    } else if (header == "CATEGORY") {
                        mode = "doChangeCategory";
                    }
                    return $share.fn.doUpdateDocumentInfo(mode, params);
                }
            }
            return true;
        ]]>
        </function>
        <function name="onRowInserted" args="tr">
        <![CDATA[
            //$share.fn.doQueryDocumentExtraData(gridObj, tr);
        ]]>
        </function>
        <function name="doAlteration" args="">
        <![CDATA[
            var selectedRow = gridObj.getSelectedRows("SELECTED");
            var dataArray = [];
            for (var i in selectedRow) {
                dataArray.push(gridObj.getRowDataObject(selectedRow[i]));
            }
            $share.fn.doAlterationDocument(dataArray, doQuery);
        ]]>
        </function>
        <function name="doTermination">
        <![CDATA[
            var selectedRow = gridObj.getSelectedRows("SELECTED");
            var dataArray = [];
            for (var i in selectedRow) {
                dataArray.push(gridObj.getRowDataObject(selectedRow[i]));
            }
            $share.fn.doTerminationDocument(dataArray, doQuery);
        ]]>
        </function>
        <function name="doAfterProcess">
        <![CDATA[
            var selectedRow = gridObj.getSelectedRows("SELECTED");
            var dataArray = [];
            for (var i in selectedRow) {
                dataArray.push(gridObj.getRowDataObject(selectedRow[i]));
            }
            
            $share.fn.doAfterProcess(dataArray, doQuery);
        ]]>
        </function>
        <function name="doPushReSend">
        <![CDATA[
            const selectedRow = gridObj.getSelectedRows("SELECTED");
            if (selectedRow.length <= 0) {
                Alert(sUtils.cache.text.get('POA_CONTRACT.MESSAGE_0005')); // 선택된 행이 없습니다.
                return;
            }
            
            if (selectedRow.length > 1) {
                Alert(sUtils.cache.text.get('POA_CONTRACT.MESSAGE_0006')); // 하나의 행만 선택해주세요.
                return;
            }
            
            const data = gridObj.getRowDataObject(selectedRow[0]);
            const options = {
                url: window.CONTEXT_NAME + '/Contract/Progress/ContractProgressListPushResendPopup.sux',
                params: {
                    DATA: data,
                    callback: (data) => {
                        console.log(data);
                    }
                },
                width: SUX.getModuleTop().outerWidth * 0.35,
                height: SUX.getModuleTop().outerHeight * 0.35,
                title: sUtils.cache.text.get('POA_CONTRACT.BUTTON_PUSH_RE_SEND') // '알림 재전송'
            };
            
            sUtils.popup.modal(options);
        ]]>
        </function>
        <function name="onUpdateButtonClick" args="id">
        <![CDATA[
            let selectedRow = gridObj.getSelectedRows("SELECTED");

            if (id == "CONT_UPDATE") {
           		let creator = gridObj.cells(selectedRow[0], gridObj.getColIndexById("CREATOR")).getValue();
           		
            	if(Sepoa.info.MENU_PROFILE_CODE !== "MUP2011020001" && Sepoa.info.ID.toUpperCase() != creator.toUpperCase()) {
            		Alert("자신이 상신한 문서만 수정할 수 있습니다."); // 선택된 행이 없습니다.
                    return;
            	}
            
                if (selectedRow.length <= 0) {
                    Alert(sUtils.cache.text.get('POA_CONTRACT.MESSAGE_0005')); // 선택된 행이 없습니다.
                    return;
                }
            
                if (selectedRow.length > 1) {
                    Alert(sUtils.cache.text.get('POA_CONTRACT.MESSAGE_0006')); // 하나의 행만 선택해주세요.
                    return;
                }
                
	            let contStatus = gridObj.cells(selectedRow[0], gridObj.getColIndexById("CONT_STATUS")).getValue();
                
  				if (Sepoa.info.MENU_PROFILE_CODE !== "MUP2011020001") {
					if ( contStatus == 'A' || contStatus == 'F') {
						Alert(sUtils.cache.text.get('POA_CONTRACT.REJECT_CAN_UPDATE'));
						return;
					} 
				}
                
		        let data = gridObj.getRowDataObject(selectedRow[0]);
           		doControlPopup(data);

            }
        ]]>
        </function>
        <function name="doControlPopup" args="data">
        <![CDATA[
	        const options = {
	            url: window.CONTEXT_NAME + '/Contract/Progress/ContractProgressGridPopup.sux',
	            params: {
	                DATA: data,
	                callback: function(res) {
	                    if (res == "1") {
	                        doQuery();
	                    } else {
	                        Alert(sUtils.cache.text.get('POA_CONTRACT.UPDATE_CONT_FAIL'));
	                    }
	                }
	            },
	            width: SUX.getModuleTop().outerWidth * 0.6,
	            height: SUX.getModuleTop().outerHeight * 0.7,
	            title: sUtils.cache.text.get('POA_CONTRACT.AUDIT_TRAIL_ACTION_DOCUMENT_UPDATE') // '계약정보 수정'
	        };
	        
	        sUtils.popup.modal(options);
        ]]>
        </function>
		<function name="onRejectButtonClick" args="id">
		<![CDATA[
			if (id == "REJECT") {
  				gridObj.postTransaction(window.CONTEXT_NAME + "/SepoaGrid.sux", ['mode=doSave', 'PROCESS_ID=sepoa.svc.ct.CT_205', 'METHOD=doRejectCont'], "SELECTED");
			}
		]]>
		</function>
		<function name="doTransactionEnd">
		<![CDATA[
			doQuery();
		]]>
		</function>
    </userscript>
