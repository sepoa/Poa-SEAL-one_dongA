    </variable>
    <usercss>
    <![CDATA[
		/* CSS Document */
		/* reset */    
		html,body,form {
			width:100%;
		}
		body {
			width:100%; margin:0; padding:0;  font-size:13px; line-height:14px;  font-family:"맑은 고딕", "Malgun Gothic"; color:#000; 
		}
		table[cellspacing="1"]:not{
			border-collapse:collapse;
		}
		fieldset,img {
			border:0 none
		}
		h1,h2,h3,h4,h5,h6 {
			font-size:100%; font-weight:normal;
		}
		q:before,q:after {
			content:"";
		} /*인용구 "" 없애기*/
		a {
			text-decoration:none; color:#222; cursor:pointer; font-family:"맑은 고딕", "Malgun Gothic", AppleGothic, Sans-serif;
		}
		a:hover {
			text-decoration:none; font-family:"맑은 고딕", "Malgun Gothic", AppleGothic, Sans-serif;
		}
		img,input {
			border:0; outline:none;
		}
		img,input,select {
			vertical-align:middle;
		}
		textarea {
			font-family:arial, "맑은 고딕", "Malgun Gothic", AppleGothic, Sans-serif !important; font-size:13px; border:1px solid #c6c6c6; border-radius:3px;
		}
		input::-ms-clear {
			display:none;
		}
		select.selectype01 {
			padding:0 9px; background:#fff url(../images/NxCommon/select_bg.png) no-repeat right center; font-size:13px; color:#000; font-family:"맑은 고딕", "Malgun Gothic", AppleGothic, Sans-serif; border:1px solid #e0e0e0; box-shadow:none !important; -webkit-appearance:none; -moz-appearance:none; appearance:none;
		}
		
		/* rest 추가 */
		html,body{
			height:100%; margin:0; padding:0; font-family:arial, "맑은 고딕", "Malgun Gothic", AppleGothic, Sans-serif; font-size:12px; font-weight:normal; line-height:100%; color:#000;
		}
		/*dl,dt,dd,ul,ol,li,h1,h2,h3,h4,h5,h6,pre,form,fieldset,p,tbody,tfoot,thead,th,td:not(.table_form_info_draft table td),label,img {
			margin:0; padding:0; border:0; line-height:1.2em;
		}*/
		dl,dt,dd,ul,ol,li,h1,h2,h3,h4,h5,h6,pre,form,fieldset,p,tbody,tfoot,thead,th,td,label,img {
			margin:0; padding:0; line-height:1.2em;
		}
		img,input,textarea,select,button,label {
			vertical-align:middle;outline:none;
		}
		img,input,textarea {
			margin:0; padding:0;
		}
		ul,ol {
			margin:0; padding:0; list-style:none;
		}
		table[cellspacing="1"]:not{
			border-spacing:0; 
		}
		a {
			color:#000;
		}
		a,a:visited,a:hover,a:active{
			text-decoration:none;
		}
		mark {
			background:none;
		}
		button {
			outline:none; border:none; background:none;
		}
		* {
			-webkit-box-sizing:border-box; box-sizing:border-box;
		}
		
		.error {
			padding-top:167px; text-align:center;
		}
		.error .error_img {
			margin-bottom:50px;
		}
		.error .error_tit {
			margin-bottom:20px; font-size:40px; font-weight:bold;
		}
		.error .error_subtit {
			margin-bottom:54px; font-size:22px; font-weight:bold;
		}
		.error .error_cont {
			font-size:16px; color:#94959a; line-height:1.8;
		}
		.error .error_cont img {
			vertical-align:baseline;
		}
		.error .btn_error {
			margin:40px 0;
		}
		.error .btn_error a {
			margin:0 auto; padding:14px 42px; background:#565a6e; border-radius:3px; font-size:16px; color:#fff; display:inline-block;
		}
	]]>
    </usercss>
    <onloadscript>
        <call name="init" />
    </onloadscript>
    <userscript>
        <function name="init">
        <![CDATA[
        	const errorPageHtml = `
        		<div class="error">
					<div class="error_img">
						<img alt="" src='data:image/png;base64,'/>
					</div>
					<p class="error_tit">페이지를 찾을 수 없습니다.</p>
					<p class="error_subtit">이용에 불편을 드려 죄송합니다.</p>
					<p class="error_cont">
					찾으시려는 페이지의 주소가 잘못 입력되었거나<br />
					페이지 주소의 변경 혹은 삭제로 인해 요청하신 페이지를 찾을 수가 없습니다.<br />
					입력하신 페이지의 주소가 정확한지 확인하신 후 다시 시도해 보시기 바랍니다.<br /><br />
					관련 문의사항은 e-Click로 문의 주시기 바랍니다.<br />
					<img alt="" src='data:image/png;base64,'/>1588-7514 (해외:02-2075-2000)
				</div>
        	`; 
            $sObject._vp[0].innerHTML = errorPageHtml;
        ]]>
        </function>
    </userscript>
