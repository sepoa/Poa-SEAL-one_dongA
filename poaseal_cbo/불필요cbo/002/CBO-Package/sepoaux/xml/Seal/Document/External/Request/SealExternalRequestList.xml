<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="SLM_511" header="false">
    <filterbar id="filterObj" div="FeiDlmeExCElmeDKGf">
        <calendar id="F_CALENDAR" button="year:0,month:0,week:-4,day:0" default="week:-4"/>
        <status id="SMR_STATUS" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#SM034" label="상태"/>
        <keyword id="F_KEYWORD"/>
        <filter>
            <option id="REQ_SEAL_USE_TYPE" type="select" combo="SL0047,{HOUSE_CODE}#{COMPANY_CODE}"/>
        </filter>
        <event type="onSearch" callback="doQuery"/>
        <event type="onComboLoad" callback="onComboLoad"/>
    </filterbar>
    <button id="btnObj">
        <btn div="FeiDlmeUWmElmeJcYF" id="count" type="template" toggle="false" reverse="false"/>
        <btn div="FeiDlmegKAFlmenEZd" id="update" type="default" text="{BUTTON.update}" toggle="false" reverse="false" onclick="doUpdate(  )"/>
        <btn div="FeiDlmegKAFlmenEZd" id="delete" type="default" text="{BUTTON.delete}" toggle="false" reverse="false" onclick="doDelete(  )"/>
    </button>
    <grid id="gridObj" div="kOKClmeEDEzNMcrODy" grid-id="SLM_511" drag="false" merge="false" dynamic="false">
        <event type="onRowSelectSync" callback="onRowSelect"/>
        <event type="onTXE" callback="doSaveEnd"/>
        <event type="onXLE" callback="onXLE"/>
    </grid>
    <variable>
        <var name="FeiDlmeJrrDlmerXpd" value="$($sObject._vp).find('#FeiDlmeJrrDlmerXpd')[0]"/>
        <var name="FeiDlmeSxFElmecXRW" value="$($sObject._vp).find('#FeiDlmeSxFElmecXRW')[0]"/>
        <var name="FeiDlmeIrrDlmeCxuk" value="$($sObject._vp).find('#FeiDlmeIrrDlmeCxuk')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
    	<function name="init">
        <![CDATA[
        	if (Sepoa.request.status) {
        		filterObj.setValue('SMR_STATUS', Sepoa.request.status);
        	}
        	doQuery();
    	]]>
        </function>
        <function name="doSearch" args="rowId">
        <![CDATA[
			var smrNumber = "";
            var applyType = "";
            gridObj.editStop();
                        
            if (rowId) {
            	var selectedRow = rowId;
            } else {
	            var selectedRows = gridObj.getGridChangedRows("SELECTED");
                if (selectedRows.length < 1) {
                    Alert(Sepoa.cache.text.get('MESSAGE.1004'));
                    return;
                }
                
                if (selectedRows.length > 1) {
                    Alert(Sepoa.cache.text.get('SLM_501.MESSAGE_SELECT_ONE_REQ'));
                    return;
                }
                var selectedRow = selectedRows[0];
            }
			
			var status = gridObj.cells(selectedRow, gridObj.getColIndexById("SMR_STATUS")).getValue();
			if (status == 'T') {
                Alert(Sepoa.cache.text.get('SLM_201.MESSAGE_NOT_TEMP_SEARCH'));
                return;
            }
			    
			smrNumber = gridObj.cells(selectedRow, gridObj.getColIndexById("SMR_NUMBER")).getValue();
			applyType = gridObj.cells(selectedRow, gridObj.getColIndexById("APPLY_TYPE")).getValue();
			
			
			if (smrNumber != '') {
			    callFunction('p', 'changeMode', [smrNumber, applyType, 'VIEW']);
			}
        ]]>
        </function>
        
        <function name="doUpdate">
        <![CDATA[
			var selectedRow = gridObj.getGridChangedRows("SELECTED");
			var smrNumber = "";
			var applyType = "";
			gridObj.editStop();
			
			if (selectedRow.length < 1) {
			    Alert(Sepoa.cache.text.get('MESSAGE.1004'));
			    return;
			}
			
			if (selectedRow.length > 1) {
			    Alert(Sepoa.cache.text.get('SLM_501.MESSAGE_SELECT_ONE_REQ'));
			    return;
			}
			
			for (var i in selectedRow) {
			    var status = gridObj.cells(selectedRow[i], gridObj.getColIndexById("SMR_STATUS")).getValue();
			    if (status != 'T' && status != 'F' && status != 'R') {
			        Alert(Sepoa.cache.text.get('SLM_501.MESSAGE_NOT_TEMP_UPDATE'));
			        return;
			    }
			    smrNumber = gridObj.cells(selectedRow[i], gridObj.getColIndexById("SMR_NUMBER")).getValue();
			    applyType = gridObj.cells(selectedRow[i], gridObj.getColIndexById("APPLY_TYPE")).getValue();
			}
			
			if (smrNumber != '') {
			    callFunction('p', 'changeMode', [smrNumber, applyType, 'EDITOR']);
			}
        ]]>
        </function>
        <function name="doDelete">
        <![CDATA[
			var selectedRow = gridObj.getGridChangedRows("SELECTED");
			var smrNumber = "";
			var applyType = "";
			gridObj.editStop();
			
			if (selectedRow.length < 1) {
			    Alert(Sepoa.cache.text.get('MESSAGE.1004'));
			    return;
			}
			
			for (var i in selectedRow) {
			    var status = gridObj.cells(selectedRow[i], gridObj.getColIndexById("SMR_STATUS")).getValue();
			    if (status != 'T') {
			        Alert(Sepoa.cache.text.get('SLM_501.MESSAGE_NOT_TEMP_DELETE'));
			        return;
			    }
			}
			
			if (gridObj.getGridChangedRows("SELECTED").length > 0 && Confirm(Sepoa.cache.text.get('MESSAGE.1015'), function(result) {
			        if (result) {
			            gridObj.editStop();
			            gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doSave', 'PROCESS_ID=sepoa.svc.seal.SepoaReqExternalService', 'METHOD=doDeleteRequestInfo'], 'SELECTED');
			
			        }
			    }));
        ]]>
        </function>
		<function name="onComboLoad" args="comboName, itemList">
        <![CDATA[
        	if (comboName == 'SMR_STATUS') {
	        	for(var filterIdx in filterObj.filterObjs) { if (filterIdx != undefined && filterObj.filterObjs[filterIdx].id == 'SMR_STATUS') break; }
	        	var comboObj = filterObj.filterObjs[filterIdx];
				var optionList = ['ALL', 'T'];	// ALL 전체, T 임시저장
				if (sUtils.workflow.check('ET1644372420935')) optionList.push('I','R'); // 결재모듈
	        	if (sUtils.workflow.check('ET1644374538390')) optionList.push('W','F'); // 인감관리자 승인
	        	if (sUtils.workflow.check('ET1647222908416')) optionList.push('RW','RR'); // 반납모듈
	        	if (sUtils.workflow.check('ET1644375000197')) optionList.push('C'); // 완료
				
				for (var i = 0; i < comboObj.comboList.length; i++) {
					if (optionList.indexOf(comboObj.comboList[i].comboValue) == -1) {
						comboObj.comboList.splice(i, 1);
						comboObj.comboListModal.getElementsByClassName('status_combo_list_item')[i].remove();
						--i;
					}
				}
        	}
        ]]>
        </function>
        <function name="doQuery">
        <![CDATA[
			dataOutput.setValue('MODE', 'LIST');
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME+'/SepoaGrid.sux', ['mode=doQuery', 'METHOD=doSelectRequestList', 'PROCESS_ID=sepoa.svc.seal.SepoaReqExternalService']);
            gridObj.clearAll(false);      
        ]]>
        </function>
        <function name="onRowSelect" args="id, ind">
        <![CDATA[
            
                    
                        var header = this.getColumnId(ind);
                        var selected = gridObj.cells(id, gridObj.getColIndexById("SELECTED")).getValue();
                        if (selected == 0) {
                            gridObj.cells(id, gridObj.getColIndexById("SELECTED")).setValue(1);
                        } else {
                            gridObj.cells(id, gridObj.getColIndexById("SELECTED")).setValue(0);
                        }
                    
        	if (['SMR_NUMBER', 'SUBJECT'].indexOf(header) > -1) {
            	const smrStatus = gridObj.cells(id, gridObj.getColIndexById('SMR_STATUS')).getValue();
            	if (smrStatus == 'T') return;
            	doSearch(id);
            } else if (header == 'SMR_STATUS') {
           		const smrNumber = gridObj.cells(id, gridObj.getColIndexById('SMR_NUMBER')).getValue();
           		const smrStatus = gridObj.cells(id, gridObj.getColIndexById('SMR_STATUS')).getValue();
           		if (smrStatus == 'T') return;
            	doServiceAjax('sepoa.svc.seal.cbo_002.SepoaReqSealServiceCbo', 'CONNECTION', 'getNoDoc2', {SMR_NUMBER:smrNumber}, function(so) {
	            	if (so.status == 1) {
	            		const noDoc2 = so.result[0];	// 그룹웨어 결재문서 조회 키
	            		if (noDoc2 == '') return;
		            	const width = Math.min(SUX.root.innerWidth * 0.7, 1280);
					    const height = Math.min((SUX.root.innerHeight - 100) * 0.9, 800);
					    const gwDomain = Sepoa.config.get('groupware.domain');
					    const gwUrl = "https://" + gwDomain + "/WebSite/Approval/FormLinkForDOC_SAMHO.aspx?NODOC=" + noDoc2;
		            	PopupOpenPostReal(gwUrl, width, height, 'gwApplyDocument');
	            	} else {
	                	Alert(so.message);
	                	return;
	                }
	            });
            }
        ]]>
        </function>
        <function name="doSaveEnd" args="obj">
        <![CDATA[
            
                    
                        var mode = obj.mode;
                        var status = obj.status;
                        var message = obj.message;
                        if (status == 'true') {
                            Alert(message);
                            doQuery();
                        } else {
                            Alert(message);
                        }
                    
                    
        ]]>
        </function>
        <function name="onXLE" args="obj, count">
        <![CDATA[
            
                    
                        if (count == 0) {
                            Alert(Sepoa.cache.text.get('MESSAGE.1001'));
                            return;
                        }
                    
                    
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
        
    </template>
</body>