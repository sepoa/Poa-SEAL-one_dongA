<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="CT_102" header="false">
    <filterbar id="filterObj" div="MCtsZhdfjwsZhdSknL">
        <calendar id="F_CALENDAR" button="year:0,month:0,week:-4,day:0" default="ADD_DATE#week:-12" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#CT102"/>
        <status id="F_STATUS"/>
        <keyword id="F_KEYWORD"/>
        <filter>
            <option id="F_CONT_CATEGORY" type="select" combo="CT0004,{HOUSE_CODE}#{LANGUAGE}"/>
            <option id="F_INNER_IRS_NO" type="text"/>
            <option id="F_OUTER_IRS_NO" type="text"/>
            <!-- <option id="F_CONT_FORM_NAME" type="popup">
                <popup code="CT0005" value="{HOUSE_CODE}#{COMPANY_CODE}"/>
            </option>
            <option id="F_EXPIRED_VIEW" type="flag"/> -->
        </filter>
        <event type="onSearch" callback="onSearch"/>
        <event type="onComboLoad" callback="onComboLoad"/>
    </filterbar>
    <button id="btnObj">
        <btn div="EtvofadQkWpfadeRTN" id="NEW_CONT" type="secondary" text="{CT_102.NEW_CONT}" onclick="doNewContract(  )"/>
        <btn div="EtvofadQkWpfadeRTN" id="DELETE" type="delete" text="{POA_CONTRACT.BUTTON_DELETE}" onclick="doDelete(  )"/>
        <btn div="EtvofadQkWpfadeRTN" id="SIGN_REQUEST" type="save" text="{CT_102.SIGN_REQUEST}" onclick="doSignRequest(  )" module="CT1681092295115"/>
<!-- 		 <btn div="EtvofadQkWpfadeRTN" id="PUSH_RE_SEND" type="primary" text="{POA_CONTRACT.BUTTON_PUSH_RE_SEND}" onclick="doPushReSend(  )"/> -->
<!--         <btn div="EtvofadQkWpfadeRTN" id="AFTER_PROCESS_RESTART" type="secondary" text="{POA_CONTRACT.BUTTON_AFTER_PROCESS_RESTART}" onclick="doAfterProcess(  )"/> -->
    </button>
    <grid id="gridObj" div="ASYDyZdgLzEyZdMSyF" grid-id="CT_102_C" drag="false" merge="false" dynamic="false">
        <event type="onXLE" callback="doQueryEnd"/>
        <event type="onRowSelect" callback="onRowSelect"/>
        <event type="onEditCell" callback="onEditCell"/>
        <event type="onRowInserted" callback="onRowInserted"/>
    </grid>
    <usercss>
    <![CDATA[
        .attach-status-box {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .attach-status-box div {
            float: left;
        }
        
        .attach-status-attach-icon {
            display: none;
        }
        
        .attach-status-attach-icon-G {
            display: block;
            width: 29px;
            height: 29px;
            margin-left: 10px;
            background: center / cover url(/resource/design/imgs/grid/ATTAH_IMG.png);
        }
        
        .expired-bold-flag-Y {
            font-weight: bold;
            color: #d12832;
        }
        
        .contract-sign-status-G:after, .contract-sign-status-K:after, .contract-sign-status-C:after {
            content: "O"
        }
        
        .contract-sign-status-G.contract-sign-count-:after , .contract-sign-status-K.seller:after , .contract-sign-status-C.contract-sign-count-:after{
            content: "X"
        }
    ]]>
    </usercss>
    <variable>
        <var name="EtvofadWPxofadpUNx" value="$($sObject._vp).find('#EtvofadWPxofadpUNx')[0]"/>
        <var name="EtvofadAXSpfadiCyX" value="$($sObject._vp).find('#EtvofadAXSpfadiCyX')[0]"/>
        <var name="EtvofadWPxofaddSxt" value="$($sObject._vp).find('#EtvofadWPxofaddSxt')[0]"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <var name="$share" value="{}"/>
        <var name="$shareFnNames">
        <![CDATA[
            ['doQuery']
        ]]>
        </var>
        <function name="init">
        <![CDATA[
            $share.fn = {};
            for (var i in $shareFnNames) {
                var fnName = $shareFnNames[i];
                $share.fn[fnName] = $sObject[fnName];
            }
            
            callFunction('p', 'doGetScreenConfig', [$share]);
            callFunction('p', 'onChildScreenReady', [$share]);
            dataOutput.setValue('TYPE', $share.config.TYPE);
            initFilter();
            initButton();
            doQuery();
        ]]>
        </function>
        <function name="initFilter" args="">
        <![CDATA[
            filterObj.getItemById("F_STATUS").reloadCombo("SL0001," + Sepoa.info.HOUSE_CODE + "#" + Sepoa.info.LANGUAGE + "#CT002");
            
            if ($share.config.FILTER && $share.config.FILTER.F_EXPIRED_VIEW) {
                filterObj.getItemById("F_EXPIRED_VIEW").setDefault("checked");
                filterObj.getItemById("F_EXPIRED_VIEW").setValue(true);
            }
        ]]>
        </function>
        <function name="onComboLoad" args="id, domList">
        <![CDATA[
            if (id == "F_STATUS") {
                domList.forEach(function(dom) {
                    dom.style.display = "none";
                    if (dom.comboText != "" && dom.comboText != undefined) {
                        if (dom.comboValue == "ALL" || $share.config.VIEW_OPTIONS[dom.comboValue]?.FILTER) {
                            dom.style.display = "flex";
                        }
                    }
                });
            
                if ($share.config.FILTER.F_STATUS) {
                    filterObj.getItemById("F_STATUS").setDefault($share.config.FILTER.F_STATUS);
                    filterObj.getItemById("F_STATUS").setValue($share.config.FILTER.F_STATUS);
                    doQuery();
                }
            }
        ]]>
        </function>
        <function name="initButton">
        <![CDATA[
            if (Sepoa.info.USER_TYPE == 'S') {
                btnObj.showButton('DELETE', false);
                btnObj.showButton('NEW_CONT', false);
                btnObj.showButton('PUSH_RE_SEND', false);
                btnObj.showButton('AFTER_PROCESS_RESTART', false);
                btnObj.showButton('SIGN_REQUEST', false);
            }
        ]]>
        </function>
        <function name="onSearch" args="id">
        <![CDATA[
            doQuery();
        ]]>
        </function>
        <function name="doQuery" args="">
        <![CDATA[
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', ['mode=doQuery', 'PROCESS_ID=sepoa.svc.ct.CT_205', 'METHOD=doDocumentList']);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="doQueryEnd" args="obj, rowCnt">
        <![CDATA[
            var status = obj.getUserData("", "status");
            var message = obj.getUserData("", "message");
            if (status != 'true') {
                Alert(message);
            }
           
            
            var rowCount = gridObj.getRowsNum();
            
            if (rowCount > 0) {
                var colSeqIndex = gridObj.getColIndexById('ROWNUM');
                var seqCount = rowCount;
            
                for (var i = 0; i < rowCount; i++) {
                    var rowID = gridObj.getRowId(i);
            
                    gridObj.cells(rowID, colSeqIndex).setValue(seqCount--);
                }
            }
            
            
        ]]>
        </function>
        <function name="onRowSelect" args="id, cind">
        <![CDATA[
            var header = gridObj.getColumnId(cind);
            var gridData = gridObj._getRowData(id);
            if(header == 'AUDIT_TRAIL') {
                sUtils.popup.modal({
                    url : window.CONTEXT_NAME + '/UxDefault/Common/PDFViewer.sux',
                    height : SUX.getModuleTop().innerHeight * 0.90,
                    params : {
                        PROCESS_ID : 'sepoa.svc.contract.SepoaContractService',
                        METHOD : 'viewAuditTrail',
                        CONT_NO : gridData.CONT_NO,
                        CONT_GL_SEQ : gridData.CONT_GL_SEQ
                    },
                    title : sUtils.cache.text.get('POA_CONTRACT.AUDIT_TRAIL_MAIN_HEADER')
                })
            } else if (!(['SELECTED', 'EXPIRED_ALARM', 'CATEGORY'].indexOf(header) + 1)) {
                $share.fn.doChangeView(gridData);
            }
        ]]>
        </function>
        <function name="onEditCell" args="stage,rowId,cellInd,nValue,oValue">
        <![CDATA[
            var header = gridObj.getColumnId(cellInd);
            var gridData = gridObj.getRowDataObject(rowId);
            if (stage == 0) {} else if (stage == 1) {} else if (stage == 2) {}
            return true;
        ]]>
        </function>
        <function name="onRowInserted" args="tr">
        <![CDATA[
            $share.fn.doQueryDocumentExtraData(gridObj, tr);
        ]]>
        </function>
        <function name="doDelete">
        <![CDATA[
            var selectedRow = gridObj.getSelectedRows("SELECTED");
            var dataArray = [];
            for (var i in selectedRow) {
                dataArray.push(gridObj.getRowDataObject(selectedRow[i]));
            }
            $share.fn.doDeleteDocument(dataArray, doQuery);
        ]]>
        </function>
        <function name="doPushReSend">
        <![CDATA[
            const selectedRow = gridObj.getSelectedRows("SELECTED");
            if(selectedRow.length <= 0) {
                Alert(sUtils.cache.text.get('POA_CONTRACT.MESSAGE_0005'));      // 선택된 행이 없습니다.
                return;
            }
            
            if(selectedRow.length > 1) {
                Alert(sUtils.cache.text.get('POA_CONTRACT.MESSAGE_0006'));      // 하나의 행만 선택해주세요.
                return;
            }
            
            const data = gridObj.getRowDataObject(selectedRow[0]);
            const options = {
                url : window.CONTEXT_NAME + '/Contract/Progress/ContractProgressListPushResendPopup.sux',
                params : {
                    DATA : data,
                    callback : (data) => {
                    
                    }
                },
                width : SUX.getModuleTop().outerWidth * 0.35,
                height : SUX.getModuleTop().outerHeight * 0.35,
                title : sUtils.cache.text.get('POA_CONTRACT.BUTTON_PUSH_RE_SEND')       // '알림 재전송'
            };
            
            sUtils.popup.modal(options);
        ]]>
        </function>
        <function name="doAfterProcess">
        <![CDATA[
            var selectedRow = gridObj.getSelectedRows("SELECTED");
            var dataArray = [];
            for (var i in selectedRow) {
                dataArray.push(gridObj.getRowDataObject(selectedRow[i]));
            }
            
            $share.fn.doAfterProcess(dataArray, doQuery);
        ]]>
        </function>
        <function name="doNewContract" args="">
        <![CDATA[
        	
            var selected = gridObj.getSelectedRows("SELECTED");
            
            if(selected.length > 1) {
            	Alert('선택된 문서가 2개 이상입니다.');
            	return;
            } else {
	            var gridData = gridObj._getRowData(selected);
	            $share.fn.doChangeView(gridData);
            
            }
            
        ]]>
        </function>
        <function name="doSignRequest" args="">
        <![CDATA[
            var selected = gridObj.getSelectedRows("SELECTED");
            
            if (selected.length == 0) {
                Alert(sUtils.cache.text.get('POA_CONTRACT.MESSAGE_0005'));
                return;
            } else if (selected.length > 1) {
                Alert(sUtils.cache.text.get('POA_CONTRACT.MESSAGE_0006'));
                return;
            } else {
	            for (var i in selected) {
	                //var reqAttachCnt  = gridObj.cells(selected[i], gridObj.getColIndexById('REQ_ATTACH_CNT')).getValue();
	                var contStatus    = gridObj.cells(selected[i], gridObj.getColIndexById('CONT_STATUS')).getValue();
	                var outerSignFlag = gridObj.cells(selected[i], gridObj.getColIndexById('OUTER_SIGN_FLAG'));
	                var innerSignFlag = gridObj.cells(selected[i], gridObj.getColIndexById('INNER_SIGN_FLAG'));
	                var regexO = /contract-sign-status-(G|K|C)/;
	                var regexX = /contract-sign-status-(G\s*contract-sign-count-(\s|$)|K\s*seller|C\s*contract-sign-count-(\s|$))/;
	                
	                //console.log(regexO.test(outerSignFlag.cell.querySelector('span').classList.value) + " || " + regexO.test(innerSignFlag.cell.querySelector('span').classList.value));
	                //console.log(regexX.test(outerSignFlag.cell.querySelector('span').classList.value) + " || " + regexX.test(innerSignFlag.cell.querySelector('span').classList.value));
	                
	                if (contStatus != 'G') {
	                    Alert(Sepoa.cache.text.get('POA_CONTRACT.MESSAGE_0100'));
	                    return;
	                } else {
	                	if (!regexO.test(outerSignFlag.cell.querySelector('span').classList.value)
		                		|| regexX.test(outerSignFlag.cell.querySelector('span').classList.value)) {
		                	Alert(Sepoa.cache.text.get('POA_CONTRACT.MESSAGE_0101'));
		                    return;
		                }
	                }
	            }
            }
        	if(sUtils.workflow.check('CT1681295715467')){//단일계약승인자 지정여부
        		var option_id = sUtils.workflow.getOptions('CT1681295715467');
        		doSignRequestCallback(option_id);
        	}else{
	        	PopupCommonPost('SP0001', doSignRequestCallback, [Sepoa.info.HOUSE_CODE, Sepoa.info.LANGUAGE, 'SIGN_APP']);
        	}
        ]]>
        </function>
        
        <function name="doSignRequestCallback" args="id">
        <![CDATA[
            dataOutput.setValue("APPROVAL_ID", id);
            Confirm(Sepoa.cache.text.get('CT_102.SIGN_REQUEST_CONFIRM'), function(flag){//서명을 요청하시겠습니까?
            	if (flag) {
            		var params = [];
		            params.push('mode=doSave');
		            params.push('PROCESS_ID=sepoa.svc.ct.CT_102');
		            params.push('METHOD=doSignRequest');
					gridObj.postTransaction(window.CONTEXT_NAME + '/SepoaGrid.sux', params, 'SELECTED');
            	}
            });
        ]]>
        </function>
    </userscript>
