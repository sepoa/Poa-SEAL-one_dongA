<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="CT_502_APPROVAL" header="false" pageCloseWarn="false">
    <link>
    <![CDATA[
        <link href="<%=CONTEXT_NAME%>/resource/design/css/approvalLine/ApprovalLine.css" rel="stylesheet" type="text/css" />
        <script src="<%=CONTEXT_NAME%>/resource/plugin/sepoasoft/approvalLine/ContractSetApproval.js" type="text/javascript"></script>
    ]]>
    </link>
    <variable>
        <var name="container" value="$($sObject._vp).find('#NJdjrVdUzejrVdWVIX')[0]"/>
        <var name="NJdjrVdUzejrVdkNCA" value="$($sObject._vp).find('#NJdjrVdUzejrVdkNCA')[0]"/>
        <var name="appLine"/>
        <var name="$share" value="{}"/>
    </variable>
    <onloadscript>
        <call name="init"/>
    </onloadscript>
    <userscript>
        <function name="init" args="">
        <![CDATA[
            setPopupWindowDisplay('none');
            
            if(Sepoa.params) {
                $share = Sepoa.params;
            }
            
            if($share.config?.document?.CONT_NO && $share.config.document.CONT_GL_SEQ) {
                const config = {
                     url: window.CONTEXT_NAME + '/SepoaActionController.sux',
                     contentType : 'json',
                     async : false
                 }
                
                const params = sUtils.object.extend(true, {}, $share.config.document, {
                    module : 'sepoa.svc.approval.SepoaGWApprovalService',
                    action : 'sendApproval',
                    APPLY_TYPE : 'CONTRACT'
                });
                
                const so = sUtils.multipart.send(config, params);
                if(so.status == 1) {
                    const width = Math.min(SUX.getModuleTop().innerWidth * 0.70, 1280);
                    const height = Math.min(SUX.getModuleTop().innerHeight * 0.90, 800);
                    const url = so.result[0];
                    const popupParam = JSON.parse(so.result[1]);
                    
                    const limit = 1000 * 60 * 10;       // 10 mins
                    const start = performance.now();
                    PopupOpenPostReal(url, width, height, params.CONT_NO, popupParam);
                    const popupWindow = sUtils.popup.getWindowObject(params.CONT_NO);
                    const intervalId = setInterval(() => {
                        const duration = performance.now() - start;
                        if(duration >= limit) {
                            popupWindow.close();
                            $share.editor.fn.doClose(true);
                            clearInterval(intervalId);
                            selfObj.close();
                        }
                        
                        if(popupWindow.closed) {
                            $share.editor.fn.doClose(true);
                            clearInterval(intervalId);
                            selfObj.close();
                        }
                    }, 500);
                } else {
                    Alert(so.message);
                    selfObj.close();
                }
            }
        ]]>
        </function>
        
        <function name="setPopupWindowDisplay" args="display">
        <![CDATA[
            if(window.parent) {
                const vp = window.parent.sUtils.popup.getWindowObject('CONTRACT_APPROVAL_POPUP').vp
                vp.style.display = display;
            }
        ]]>
        </function>
    </userscript>
    <template editor="true">
        
        
        
        
        
        
