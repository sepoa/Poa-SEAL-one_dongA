<?xml version="1.0" encoding="UTF-8"?>
<body screen_id="CMR_002" header="false">
    <filterbar id="filterObj" div="YAUQsReYydQsRevcLE">
        <calendar id="F_CALENDAR" button="year:0,month:0,week:-4,day:0" default="CONT_DATE#week:-4" combo="SL0001,{HOUSE_CODE}#{LANGUAGE}#CT102"/>
        <status id="F_STATUS"/>
        <keyword id="F_KEYWORD"/>
        <event type="onSearch" callback="onSearch"/>
    </filterbar>
    <button id="btnObj">
        <btn div="YAUQsReWReQsReaPPr" id="request" text="{CMR_001.Request}" toggle="false" reverse="false" onclick="onButtonClick( 'request' )"/>
    </button>
    <grid id="gridObj" div="YAUQsReNYARsReaeqq" grid-id="CMR_001" drag="false" merge="false" dynamic="false">
        <event type="onXLE" callback="onXLE"/>
        <event type="onTXE" callback="onTXE"/>
        <event type="onRowSelect" callback="onRowSelect"/>
    </grid>
    <variable>
        <var name="a1" value="$($sObject._vp).find('#YAUQsRebZWQsRewHIh')[0]"/>
        <var name="a2" value="$($sObject._vp).find('#YAUQsReHgZQsReOoAo')[0]"/>
        <var name="columnObj" value="$($sObject._vp).find('#YAUQsRebZWQsReqpSd')[0]"/>
    </variable>
    <onloadscript>
        <call name="doQuery"/>
    </onloadscript>
    <userscript>
        <function name="onButtonClick" args="id">
        <![CDATA[
            if (id == 'request') {
                doRequest();
            }
        ]]>
        </function>
        <function name="doQuery" args="id">
        <![CDATA[
            var params = [];
            params.push('mode=doQuery');
            params.push('PROCESS_ID=sepoa.svc.cmr.CMR_001');
            params.push('METHOD=doQuery');
            dataOutput.addFilter(filterObj);
            gridObj.postConnection(window.CONTEXT_NAME + '/SepoaGrid.sux', params);
            gridObj.clearAll(false);
        ]]>
        </function>
        <function name="doRequest" args="">
        <![CDATA[
            //gridObj.allRowsChecked('SELECTED', true);
            if (gridObj.getRowsNum() < 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.0004'));
                return;
            }
            var selectedRows = gridObj.getGridChangedRows("SELECTED");
            if (selectedRows < 1) {
                Alert(Sepoa.cache.text.get('MESSAGE.1004'));
                return;
            }
            if (!selectedRows.validate()) {
                Alert(Sepoa.cache.text.get('MESSAGE.0002'));
                return;
            }
            Confirm(Sepoa.cache.text.get("CMR_001.Confirm"), function(result) {
                if (result) {
                    gridObj.postTransaction('/SepoaGrid.sux', ['mode=doSave', 'METHOD=doRequest', 'PROCESS_ID=sepoa.svc.cmr.CMR_001'], "SELECTED");
                }
            });
        ]]>
        </function>
        <function name="onSearch" args="flag">
        <![CDATA[
            console.log(flag);
            doQuery();
        ]]>
        </function>
        <function name="onXLE" args="obj, count">
        <![CDATA[
            var msg = obj.getUserData("", "message");
            var status = obj.getUserData("", "status");
            if (status != "true") {
                Alert(msg);
            }
        ]]>
        </function>
        <function name="onTXE" args="obj">
        <![CDATA[
            var mode = obj.mode;
            var status = obj.status;
            var message = obj.message;
            if (status == "true") {
                Alert(Sepoa.cache.text.get('MESSAGE.0001'));
                doQuery();
            } else {
                Alert(message);
            }
        ]]>
        </function>
        <function name="onRowSelect" args="id, ind">
        <![CDATA[
            var header = this.getColumId();
            console.log('(' + id + ' , ' + ind + ') ' + gridObj.cells(id, ind).getValue());
        ]]>
        </function>
    </userscript>
